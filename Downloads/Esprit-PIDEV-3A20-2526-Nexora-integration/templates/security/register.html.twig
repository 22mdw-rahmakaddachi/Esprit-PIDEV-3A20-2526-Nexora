{% extends 'base.html.twig' %}
{% block title %}Créer un compte — Nexora{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-center" style="min-height:80vh">
    <div class="w-100" style="max-width:480px" data-aos="fade-up">

        <div class="text-center mb-4">
            <h2 style="font-family:'Playfair Display',serif;color:var(--primary-dark)">
                Créer un compte
            </h2>
            <p class="text-muted small">Rejoignez Nexora dès maintenant</p>
        </div>

        <div class="p-4 rounded-4 bg-white shadow-sm" style="border:1px solid #ede5ff">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold small" style="color:var(--primary-dark)">Prénom</label>
                    {{ form_widget(form.prenom, {'attr': {'class': 'form-control rounded-3' ~ (form.prenom.vars.errors|length ? ' is-invalid' : ''), 'placeholder': 'Votre prénom'}}) }}
                    {% if form.prenom.vars.errors|length %}
                        <div class="invalid-feedback d-block">{{ form_errors(form.prenom) }}</div>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold small" style="color:var(--primary-dark)">Nom</label>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control rounded-3' ~ (form.nom.vars.errors|length ? ' is-invalid' : ''), 'placeholder': 'Votre nom'}}) }}
                    {% if form.nom.vars.errors|length %}
                        <div class="invalid-feedback d-block">{{ form_errors(form.nom) }}</div>
                    {% endif %}
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold small" style="color:var(--primary-dark)">Email</label>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control rounded-3' ~ (form.email.vars.errors|length ? ' is-invalid' : ''), 'placeholder': 'votre@email.com'}}) }}
                    {% if form.email.vars.errors|length %}
                        <div class="invalid-feedback d-block">{{ form_errors(form.email) }}</div>
                    {% endif %}
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold small" style="color:var(--primary-dark)">Numéro de téléphone</label>
                    {{ form_widget(form.num, {'attr': {'class': 'form-control rounded-3' ~ (form.num.vars.errors|length ? ' is-invalid' : ''), 'placeholder': '00000000'}}) }}
                    {% if form.num.vars.errors|length %}
                        <div class="invalid-feedback d-block">{{ form_errors(form.num) }}</div>
                    {% endif %}
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold small" style="color:var(--primary-dark)">Mot de passe</label>
                    {{ form_widget(form.mdp, {'attr': {'class': 'form-control rounded-3' ~ (form.mdp.vars.errors|length ? ' is-invalid' : ''), 'placeholder': '••••••••'}}) }}
                    {% if form.mdp.vars.errors|length %}
                        <div class="invalid-feedback d-block">{{ form_errors(form.mdp) }}</div>
                    {% endif %}
                </div>
            </div>

            <button type="submit" class="btn w-100 rounded-pill fw-semibold mt-4"
                    style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;padding:11px">
                <i class="bi bi-person-plus-fill me-2"></i>Créer mon compte
            </button>
            {{ form_end(form) }}

            <hr style="border-color:#ede5ff;margin:20px 0">
            <p class="text-center text-muted small mb-0">
                Déjà un compte ?
                <a href="{{ path('app_login') }}" style="color:var(--primary);font-weight:600">Se connecter</a>
            </p>
        </div>

    </div>
</div>
{% endblock %}
