<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.GestionPaiementsController" 
      spacing="20" style="-fx-background-color: #F3F4F6; -fx-padding: 20;">

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="💳 Gestion des Paiements" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Actualiser" onAction="#handleRefresh" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 6;"/>
    </HBox>

    <!-- Statistiques -->
    <HBox spacing="15">
        <!-- Total Paiements -->
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="Total Paiements" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <Label fx:id="totalPaiementsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
        </VBox>
        
        <!-- En Attente -->
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="En Attente" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <Label fx:id="enAttenteLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
        </VBox>
        
        <!-- Validés -->
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="Validés" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <Label fx:id="validesLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </VBox>
        
        <!-- Montant Total -->
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="Montant Total Validé" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
            <Label fx:id="montantTotalLabel" text="0,000 TND" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
        </VBox>
    </HBox>

    <!-- Filtres -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Filtrer par statut:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <ComboBox fx:id="filtreStatut" prefWidth="200" style="-fx-font-size: 14px;"/>
    </HBox>

    <!-- Table des paiements -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Liste des Paiements" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
        
        <TableView fx:id="paiementsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colCommandeId" text="Demande" prefWidth="100"/>
                <TableColumn fx:id="colMethode" text="Méthode" prefWidth="180"/>
                <TableColumn fx:id="colMontant" text="Montant" prefWidth="120"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="200"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Légende -->
    <HBox spacing="20" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Légende:" style="-fx-font-weight: bold;"/>
        <Label text="✓ = Valider" style="-fx-text-fill: #27ae60;"/>
        <Label text="✗ = Refuser" style="-fx-text-fill: #e74c3c;"/>
        <Label text="👁 = Détails" style="-fx-text-fill: #3498db;"/>
    </HBox>

</VBox>
