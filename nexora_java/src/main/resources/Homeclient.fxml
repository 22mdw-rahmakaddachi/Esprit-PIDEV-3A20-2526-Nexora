<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="720.0" prefWidth="1200.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.homeclient">

    <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- Top Bar -->
        <top>
            <HBox alignment="CENTER_LEFT" prefHeight="60" spacing="10" styleClass="top-bar-white">
                <Text styleClass="logo-top-white" text="NEXORA" />
                <Text styleClass="version-top-white" text="• Espace Client" />
                <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="btn-danger" text="Déconnexion" />
            </HBox>
        </top>

        <!-- Left Menu -->
        <left>
            <VBox prefWidth="220" spacing="25" styleClass="menu-white">

                <VBox prefHeight="278.0" prefWidth="195.0" spacing="15">
                    <Label styleClass="menu-header-white" text="MENU PRINCIPAL" />

                    <Button mnemonicParsing="false" onAction="#showeactivite" styleClass="menu-btn-white" text="📅 Gestion Activités" />
                    <Button mnemonicParsing="false" onAction="#showecomerce" styleClass="menu-btn-white" text="🛒 E-commerce" />
                    <Button mnemonicParsing="false" onAction="#showedestination" styleClass="menu-btn-white" text="🌍 Destinations" />
                    <Button mnemonicParsing="false" onAction="#showReclamation" styleClass="menu-btn-white" text="⭐ Avis" />
                    <Button mnemonicParsing="false" onAction="#showereclamatione" styleClass="menu-btn-white" text="➕ Nouvelle Réclamation" />
                </VBox>
            </VBox>
        </left>

        <!-- Center Content -->
        <center>
            <AnchorPane fx:id="contentPane" styleClass="center-white" />
        </center>

    </BorderPane>
</AnchorPane>
