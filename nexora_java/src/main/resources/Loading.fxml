<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.control.Label?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.LoadingController"
           prefHeight="600.0" prefWidth="800.0" 
           stylesheets="@style.css"
           style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">
    
    <children>
        <VBox alignment="CENTER" spacing="50">
            
            <!-- Logo et Titre -->
            <VBox alignment="CENTER" spacing="15">
                <Text text="NEXORA" fill="WHITE" 
                      style="-fx-font-size: 56px; -fx-font-weight: 800; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0, 0, 8);" />
                <Text text="Travel Management System" fill="rgba(255,255,255,0.95)" 
                      style="-fx-font-size: 18px; -fx-font-weight: 500;" />
            </VBox>
            
            <!-- Zone d'animation de l'avion -->
            <Pane prefHeight="250.0" prefWidth="700.0">
                
                <!-- Ligne courbe (chemin de vol) -->
                <Path fx:id="flightPath" stroke="rgba(255,255,255,0.4)" strokeWidth="3" 
                      strokeLineCap="ROUND" fill="transparent">
                    <elements>
                        <MoveTo x="50" y="125" />
                        <LineTo x="150" y="75" />
                        <LineTo x="250" y="125" />
                        <LineTo x="350" y="175" />
                        <LineTo x="450" y="125" />
                        <LineTo x="550" y="75" />
                        <LineTo x="650" y="125" />
                    </elements>
                </Path>
                
                <!-- Avion animé -->
                <Label fx:id="airplane" text="✈" layoutX="50" layoutY="110"
                       style="-fx-font-size: 40px; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 4);" />
                
                <!-- Nuages décoratifs -->
                <Label fx:id="cloud1" text="☁" layoutX="100" layoutY="30" opacity="0.3"
                       style="-fx-font-size: 50px; -fx-text-fill: white;" />
                
                <Label fx:id="cloud2" text="☁" layoutX="500" layoutY="40" opacity="0.25"
                       style="-fx-font-size: 45px; -fx-text-fill: white;" />
                
                <Label fx:id="cloud3" text="☁" layoutX="300" layoutY="180" opacity="0.28"
                       style="-fx-font-size: 55px; -fx-text-fill: white;" />
                
                <!-- Étoiles scintillantes -->
                <Circle fx:id="star1" centerX="150" centerY="80" radius="3" fill="white" opacity="0.6" />
                
                <Circle fx:id="star2" centerX="400" centerY="60" radius="2" fill="white" opacity="0.5" />
                
                <Circle fx:id="star3" centerX="550" centerY="120" radius="2.5" fill="white" opacity="0.55" />
            </Pane>
            
            <!-- Texte de chargement -->
            <VBox alignment="CENTER" spacing="20">
                <Text text="Chargement en cours..." 
                      fill="WHITE" style="-fx-font-size: 20px; -fx-font-weight: 600;" />
                
                <!-- Points animés -->
                <HBox alignment="CENTER" spacing="10">
                    <Circle fx:id="dot1" radius="8" fill="white" opacity="0.5" />
                    <Circle fx:id="dot2" radius="8" fill="white" opacity="0.5" />
                    <Circle fx:id="dot3" radius="8" fill="white" opacity="0.5" />
                    <Circle fx:id="dot4" radius="8" fill="white" opacity="0.5" />
                    <Circle fx:id="dot5" radius="8" fill="white" opacity="0.5" />
                </HBox>
            </VBox>
            
        </VBox>
    </children>
    
</StackPane>
