<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PanierController">
    <content>
        <VBox spacing="20.0" style="-fx-background-color: #F8FAFC; -fx-padding: 20;">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <children>
                        <Text text="🛒 MON PANIER" style="-fx-fill: #1F2937; -fx-font-size: 24px; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleRefresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 16; -fx-cursor: hand;" text="🔄 Actualiser" />
                    </children>
                </HBox>

                <!-- Contenu principal -->
                <HBox spacing="20" alignment="TOP_LEFT">
                    <children>
                        <!-- Liste des produits dans le panier -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-min-width: 600;">
                            <children>
                                <VBox fx:id="panierContainer" spacing="15">
                                    <!-- Les cartes de produits seront ajoutées dynamiquement ici -->
                                </VBox>
                                
                                <!-- Message si panier vide -->
                                <VBox fx:id="emptyMessage" alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 60; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" visible="true">
                                    <children>
                                        <Text text="🛒" style="-fx-font-size: 64px;" />
                                        <Text text="Votre panier est vide" style="-fx-fill: #6B7280; -fx-font-size: 20px; -fx-font-weight: bold;" />
                                        <Text text="Ajoutez des produits depuis le catalogue" style="-fx-fill: #9CA3AF; -fx-font-size: 14px;" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Résumé de la commande -->
                        <VBox spacing="20" style="-fx-min-width: 350; -fx-max-width: 350;">
                            <children>
                                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                                    <children>
                                        <Text text="Résumé de la commande" style="-fx-fill: #1F2937; -fx-font-size: 18px; -fx-font-weight: bold;" />
                                        
                                        <Separator />
                                        
                                        <!-- Code Promo -->
                                        <VBox spacing="8">
                                            <Text text="Code promo" style="-fx-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                            <HBox spacing="8">
                                                <TextField fx:id="codePromoField" promptText="Entrez votre code" style="-fx-pref-width: 180;" />
                                                <Button fx:id="appliquerCodeBtn" onAction="#handleAppliquerCode" text="Appliquer" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-cursor: hand;" />
                                            </HBox>
                                            <Label fx:id="reductionLabel" text="-0.000 TND" style="-fx-text-fill: #27ae60; -fx-font-size: 14px; -fx-font-weight: bold;" visible="false" />
                                        </VBox>
                                        
                                        <Separator />
                                        
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Text text="Nombre d'articles:" style="-fx-fill: #6B7280; -fx-font-size: 14px;" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="itemCountLabel" text="0" style="-fx-text-fill: #1F2937; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                            </children>
                                        </HBox>
                                        
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Text text="Total:" style="-fx-fill: #1F2937; -fx-font-size: 20px; -fx-font-weight: bold;" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="totalLabel" text="0.00 DH" style="-fx-text-fill: #2980b9; -fx-font-size: 24px; -fx-font-weight: bold;" />
                                            </children>
                                        </HBox>
                                        
                                        <Separator />
                                        
                                        <Button onAction="#handleValiderCommande" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 15 30; -fx-cursor: hand; -fx-background-radius: 8;" text="✓ Valider la commande" prefWidth="Infinity" />
                                        
                                        <Button onAction="#handleViderPanier" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;" text="🗑️ Vider le panier" prefWidth="Infinity" />
                                    </children>
                                </VBox>
                                
                                <!-- Informations supplémentaires -->
                                <VBox spacing="10" style="-fx-background-color: #EFF6FF; -fx-background-radius: 8; -fx-padding: 15;">
                                    <children>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <children>
                                                <Text text="✓" style="-fx-fill: #2563EB; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                                <Text text="Livraison gratuite" style="-fx-fill: #1E40AF; -fx-font-size: 13px;" />
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <children>
                                                <Text text="✓" style="-fx-fill: #2563EB; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                                <Text text="Paiement sécurisé" style="-fx-fill: #1E40AF; -fx-font-size: 13px;" />
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <children>
                                                <Text text="✓" style="-fx-fill: #2563EB; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                                <Text text="Retour sous 14 jours" style="-fx-fill: #1E40AF; -fx-font-size: 13px;" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
