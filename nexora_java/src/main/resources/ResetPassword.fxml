<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="500.0" prefWidth="700.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ResetPasswordController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar-white">
            <padding><Insets top="16" right="32" bottom="16" left="32"/></padding>
            <Text styleClass="logo-top-white" text="NEXORA" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <HBox alignment="CENTER" style="-fx-background-color: #F8FAFC;">
            <VBox spacing="24" styleClass="panel-white" prefWidth="450" alignment="CENTER">
                <padding><Insets top="48" right="48" bottom="48" left="48"/></padding>

                <VBox alignment="CENTER" spacing="8">
                    <Text text="NOUVEAU MOT DE PASSE" styleClass="page-title" />
                    <Label text="Choisissez un nouveau mot de passe sécurisé" style="-fx-text-fill: #6B7280; -fx-font-size: 14px;" />
                </VBox>

                <VBox spacing="20" prefWidth="350">
                    <padding><Insets top="24"/></padding>

                    <VBox spacing="12">
                        <Label text="Nouveau mot de passe" styleClass="field-label-white" />
                        <PasswordField fx:id="newPasswordField" styleClass="field-white-simple" promptText="••••••••" />
                        <Label text="Minimum 6 caractères recommandés" style="-fx-text-fill: #6B7280; -fx-font-size: 12px; -fx-font-style: italic;" />
                    </VBox>

                    <Button onAction="#resetPassword" styleClass="btn-violet" text="Modifier le mot de passe" prefWidth="Infinity">
                        <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
                    </Button>
                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>