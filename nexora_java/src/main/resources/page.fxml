<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.pageController">

    <!-- ═══════════════════════════════════════
         SIDEBAR GAUCHE
    ═══════════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar-purple" prefWidth="245" spacing="0">

            <!-- Logo -->
            <HBox styleClass="sidebar-logo-box" alignment="CENTER_LEFT" spacing="10">
                <Label text="✦" style="-fx-text-fill: #A78BFA; -fx-font-size: 18px;" />
                <Text styleClass="sidebar-logo-text" text="NEXORA" />
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="ADMIN" styleClass="sidebar-logo-badge" />
            </HBox>

            <!-- Profil -->
            <VBox alignment="CENTER" spacing="6" style="-fx-padding: 24 20 20 20;">
                <StackPane>
                    <Circle radius="32" fill="rgba(255,255,255,0.12)" />
                    <Circle radius="32" stroke="rgba(255,255,255,0.25)" strokeWidth="1.5" fill="transparent" />
                    <Label text="⚙️" style="-fx-font-size: 28px;" />
                </StackPane>
                <Label styleClass="sidebar-profile-name" text="Administrateur" />
                <Label text="Espace Administrateur" styleClass="sidebar-profile-email" />
            </VBox>

            <!-- Ligne séparatrice -->
            <Pane styleClass="sidebar-divider" style="-fx-margin: 0 16;" >
                <padding><Insets left="16" right="16"/></padding>
            </Pane>

            <!-- Menu -->
            <VBox spacing="2" style="-fx-padding: 12 10 8 10;">
                <Label text="ADMINISTRATION" styleClass="sidebar-section-label" />
                <Button mnemonicParsing="false" onAction="#showUsers"
                        styleClass="sidebar-btn" text="👥   Gestion Utilisateurs" prefWidth="Infinity" />
                <Button mnemonicParsing="false" onAction="#showeactivite"
                        styleClass="sidebar-btn" text="📋   Gestion Activités" prefWidth="Infinity" />
                <Button mnemonicParsing="false" onAction="#showecomerce"
                        styleClass="sidebar-btn" text="🛍️   Gestion E-commerce" prefWidth="Infinity" />
                <Button mnemonicParsing="false" onAction="#showCategories"
                        styleClass="sidebar-btn" text="📂   Gestion Catégories" prefWidth="Infinity" />
                <Button mnemonicParsing="false" onAction="#showCodesPromo"
                        styleClass="sidebar-btn" text="🎫   Codes Promo" prefWidth="Infinity" />

                <Label text="FINANCES &amp; SUPPORT" styleClass="sidebar-section-label" />
                <Button mnemonicParsing="false" onAction="#showPaiements"
                        styleClass="sidebar-btn" text="💳   Gestion Paiements" prefWidth="Infinity" />
                <Button mnemonicParsing="false" onAction="#showReclamations"
                        styleClass="sidebar-btn" text="📝   Gestion Réclamations" prefWidth="Infinity" />

                <Label text="CONTENU" styleClass="sidebar-section-label" />
                <Button mnemonicParsing="false" onAction="#showedestination"
                        styleClass="sidebar-btn" text="🌍   Gestion Destinations" prefWidth="Infinity" />
                <Button mnemonicParsing="false" onAction="#showeavis"
                        styleClass="sidebar-btn" text="⭐   Gestion Avis" prefWidth="Infinity" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Ligne séparatrice bas -->
            <Pane styleClass="sidebar-divider">
                <padding><Insets left="16" right="16"/></padding>
            </Pane>

            <!-- Déconnexion -->
            <VBox style="-fx-padding: 10 10 20 10;">
                <Button mnemonicParsing="false" onAction="#handleLogout"
                        styleClass="sidebar-logout-btn" text="🚪   Déconnexion" prefWidth="Infinity" />
            </VBox>

        </VBox>
    </left>

    <!-- ═══════════════════════════════════════
         TOP BAR
    ═══════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="dashboard-topbar">
            <!-- Titre page -->
            <Label text="🏠" style="-fx-font-size: 16px;" />
            <Label text="Tableau de bord" styleClass="topbar-page-title" />
            <Label text="Administration" styleClass="topbar-badge" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Actions rapides -->
            <Button text="🔔" styleClass="topbar-btn-icon" />
            <Button text="⚙️" styleClass="topbar-btn-icon" />
            <Button mnemonicParsing="false" onAction="#handleLogout"
                    style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8 18; -fx-background-radius: 10; -fx-cursor: hand;"
                    text="Déconnexion" />
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════
         CONTENU CENTRAL
    ═══════════════════════════════════════ -->
    <center>
        <AnchorPane fx:id="contentPane" styleClass="main-dashboard-area" />
    </center>

</BorderPane>
