<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.reclamationController"
            prefWidth="900" prefHeight="700">

    <top>
        <Label text="Gestion des Réclamations"
               style="-fx-font-size:22px; -fx-font-weight:bold; -fx-padding:20;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding:20;">

            <TitledPane text="Mes Activités Acceptées" expanded="true">
                <TableView fx:id="tableActivites" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="200"/>
                        <TableColumn fx:id="colLieu" text="Lieu" prefWidth="200"/>
                        <TableColumn fx:id="colActionActivite" text="Réclamer" prefWidth="150"/>
                    </columns>
                </TableView>
            </TitledPane>

            <VBox fx:id="zoneAjout"
                  visible="false"
                  spacing="10"
                  style="-fx-background-color:#f4f4f4; -fx-padding:15; -fx-background-radius:10;">

                <Label text="Ecrire votre réclamation"
                       style="-fx-font-size:16px; -fx-font-weight:bold;" />

                <TextArea fx:id="txtDescription" prefHeight="80"/>

                <HBox spacing="10">
                    <Button text="Enregistrer"
                            style="-fx-background-color:#4CAF50; -fx-text-fill:white;"
                            onAction="#ajouterReclamation"/>

                    <Button text="Annuler"
                            style="-fx-background-color:#f44336; -fx-text-fill:white;"
                            onAction="#annulerReclamation"/>
                </HBox>
            </VBox>

            <TitledPane text="Mes Réclamations" expanded="true">
                <TableView fx:id="tableReclamations" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="colActiviteRec" text="Activité" prefWidth="200"/>
                        <TableColumn fx:id="colDescriptionRec" text="Description" prefWidth="300"/>
                        <TableColumn fx:id="colStatutRec" text="Statut" prefWidth="150"/>
                        <TableColumn fx:id="colActionRec" text="Actions" prefWidth="200"/>
                    </columns>
                </TableView>
            </TitledPane>

        </VBox>
    </center>

</BorderPane>