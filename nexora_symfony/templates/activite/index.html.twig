{% extends 'base.html.twig' %}
{% block title %}Activités — NEXORA{% endblock %}

{% block body %}

<div class="breadcrumb-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item active">Activités</li>
                </ol>
            </nav>

            {# ── ICÔNE MES ACTIVITÉS ── #}
            <div class="d-flex align-items-center gap-2">
                <a href="{{ path('app_mes_activites') }}"
                   class="nav-icon-btn"
                   title="Mes activités">
                    <i class="bi bi-clock-history"></i>
                    <span class="nav-icon-badge" id="badge-historique" style="display:none">0</span>
                    <span class="nav-icon-tooltip">Mes activités</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    {# ── WIDGET CONSEIL IA MÉTÉO ── #}
    <div class="mb-5" data-aos="fade-down">
        <div style="border-radius:16px;border:1.5px solid #ede5ff;background:#faf8ff;overflow:hidden;">

            {# Header #}
            <div style="padding:14px 20px;background:linear-gradient(135deg,#f3eeff,#faf8ff);border-bottom:1px solid #ede5ff;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <span style="font-weight:700;font-size:1rem;color:var(--primary-dark);">
                    🌤️ Conseil IA — Activités selon la météo
                </span>
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <select id="meteo-lieu" class="form-select form-select-sm rounded-pill"
                            style="min-width:160px;border-color:#ede5ff;font-size:0.85rem;">
                        {% for l in lieux %}
                        <option value="{{ l }}" {{ lieuActif == l ? 'selected' : '' }}>📍 {{ l }}</option>
                        {% endfor %}
                    </select>
                    <input type="datetime-local" id="meteo-date"
                           class="form-control form-control-sm rounded-pill"
                           style="max-width:200px;border-color:#ede5ff;font-size:0.85rem;"
                           min="{{ 'now'|date('Y-m-d') }}T00:00"
                           value="{{ 'now'|date('Y-m-d') }}T{{ 'now'|date('H') }}:00">
                    <button onclick="loadConseilMeteo()"
                            style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;border-radius:50px;padding:6px 16px;font-size:0.85rem;font-weight:600;cursor:pointer;">
                        <i class="bi bi-magic me-1"></i>Analyser
                    </button>
                </div>
            </div>

            {# Chargement #}
            <div id="conseil-loading" style="display:none;padding:16px 20px;text-align:center;color:#aaa;font-size:0.85rem;">
                <i class="bi bi-arrow-repeat" style="animation:spin 1s linear infinite;margin-right:6px;"></i>
                Analyse météo en cours…
            </div>

            {# Résultat #}
            <div id="conseil-content" style="display:none;padding:16px 20px;">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;" class="conseil-grid">

                    {# Météo résumé #}
                    <div id="conseil-meteo-card" style="padding:12px 16px;border-radius:12px;border:1px solid #f0ebff;">
                        <div style="font-weight:700;font-size:0.82rem;color:#888;margin-bottom:8px;">CONDITIONS MÉTÉO</div>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span id="conseil-meteo-emoji" style="font-size:2rem;"></span>
                            <div>
                                <div id="conseil-meteo-temp" style="font-weight:700;font-size:1.1rem;"></div>
                                <div id="conseil-meteo-desc" style="font-size:0.8rem;color:#888;"></div>
                                <div id="conseil-meteo-details" style="font-size:0.75rem;color:#aaa;margin-top:2px;"></div>
                            </div>
                        </div>
                    </div>

                    {# Conseil IA #}
                    <div style="padding:12px 16px;border-radius:12px;background:#f9f7ff;border:1px solid #ede5ff;">
                        <div style="font-weight:700;font-size:0.82rem;color:#888;margin-bottom:8px;">CONSEIL IA</div>
                        <div style="display:flex;align-items:flex-start;gap:8px;">
                            <span id="conseil-emoji" style="font-size:1.4rem;"></span>
                            <div id="conseil-texte" style="font-size:0.88rem;color:#444;line-height:1.5;"></div>
                        </div>
                    </div>

                </div>

                {# Activités recommandées #}
                <div id="conseil-recommandees-box" style="margin-top:14px;display:none;">
                    <div style="font-weight:700;font-size:0.82rem;color:#28a745;margin-bottom:8px;">
                        ✅ Activités recommandées pour cette météo
                    </div>
                    <div id="conseil-recommandees" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
                </div>

                {# Activités déconseillées #}
                <div id="conseil-deconseillees-box" style="margin-top:10px;display:none;">
                    <div style="font-weight:700;font-size:0.82rem;color:#dc3545;margin-bottom:8px;">
                        ⚠️ Activités à éviter par ce temps
                    </div>
                    <div id="conseil-deconseillees" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
                </div>

            </div>

            {# Erreur #}
            <div id="conseil-error" style="display:none;padding:14px 20px;color:#dc3545;font-size:0.85rem;">
                <i class="bi bi-exclamation-triangle me-1"></i>
                <span id="conseil-error-msg"></span>
            </div>

        </div>
    </div>

    {# FILTRES LIEU + TYPE #}
    <div class="mb-4" data-aos="fade-down">
        <form method="GET" action="{{ path('app_activites') }}" class="d-flex flex-wrap align-items-center gap-3">

            {# Filtre Type #}
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold small" style="color:var(--primary)">
                    <i class="bi bi-funnel me-1"></i>Type :
                </span>
                <select name="type" onchange="this.form.submit()"
                        class="form-select form-select-sm rounded-pill"
                        style="min-width:180px;border-color:#ede5ff;color:var(--primary);font-size:0.88rem">
                    <option value="">🌟 Tous les types</option>
                    {% for t in ['Sport','Culture','Gastronomie','Aventure','Bien-être','Autre'] %}
                    <option value="{{ t }}" {{ typeActif == t ? 'selected' : '' }}>{{ t }}</option>
                    {% endfor %}
                </select>
            </div>

            {# Filtre Lieu #}
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold small" style="color:var(--primary)">
                    <i class="bi bi-geo-alt me-1"></i>Lieu :
                </span>
                <select name="lieu" onchange="this.form.submit()"
                        class="form-select form-select-sm rounded-pill"
                        style="min-width:200px;border-color:#ede5ff;color:var(--primary);font-size:0.88rem">
                    <option value="">🌍 Tous les gouvernorats</option>
                    {% for l in lieux %}
                    <option value="{{ l }}" {{ lieuActif == l ? 'selected' : '' }}>📍 {{ l }}</option>
                    {% endfor %}
                </select>
            </div>

            {# Bouton effacer si filtre actif #}
            {% if typeActif or lieuActif %}
            <a href="{{ path('app_activites') }}"
               class="btn btn-sm rounded-pill px-3"
               style="border:1.5px solid #ddd;color:#888;font-size:0.82rem">
                <i class="bi bi-x me-1"></i>Effacer les filtres
            </a>
            {% endif %}

        </form>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-right">
        <h2 class="section-title mb-0">
            {% if typeActif and lieuActif %}{{ typeActif }} à {{ lieuActif }}
            {% elseif typeActif %}Activités : {{ typeActif }}
            {% elseif lieuActif %}Activités à {{ lieuActif }}
            {% else %}Toutes les activités{% endif %}
        </h2>
        <span class="badge rounded-pill px-3 py-2" style="background:#f0ebff;color:var(--primary)">
            {{ activites|length }} activité(s)
        </span>
    </div>

    <div class="row g-4">
        {% for activite in activites %}
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="{{ (loop.index0 % 3) * 100 }}">
            <div class="activity-card card h-100">
                <div class="img-wrap" style="height:200px;position:relative;overflow:hidden">
                    {% if activite.images %}
                        <img src="{{ activite.imageUrl }}"
                             alt="{{ activite.nom }}"
                             style="width:100%;height:100%;object-fit:cover"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                        <div style="display:none;width:100%;height:100%;align-items:center;justify-content:center;font-size:5rem;background:linear-gradient(135deg,var(--primary-dark),var(--primary))">
                            {% if activite.type == 'Sport' %}🏃{% elseif activite.type == 'Culture' %}🎭{% elseif activite.type == 'Gastronomie' %}🍽️{% else %}🌟{% endif %}
                        </div>
                    {% else %}
                        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:5rem;background:linear-gradient(135deg,var(--primary-dark),var(--primary))">
                            {% if activite.type == 'Sport' %}🏃{% elseif activite.type == 'Culture' %}🎭{% elseif activite.type == 'Gastronomie' %}🍽️{% else %}🌟{% endif %}
                        </div>
                    {% endif %}
                    <span class="position-absolute top-0 start-0 m-2 badge"
                          style="background:rgba(255,255,255,0.9);color:var(--primary);font-size:0.72rem">
                        {{ activite.type }}
                    </span>
                    {% if activite.placesDisponibles == 0 %}
                    <span class="position-absolute top-0 end-0 m-2 badge bg-danger">Complet</span>
                    {% elseif activite.placesDisponibles <= 3 %}
                    <span class="position-absolute top-0 end-0 m-2 badge-new">Dernières places</span>
                    {% endif %}
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title mb-2">{{ activite.nom }}</h5>
                    <div class="d-flex flex-column gap-1 text-muted mb-3" style="font-size:0.85rem">
                        <span><i class="bi bi-geo-alt me-2" style="color:var(--primary-light)"></i>{{ activite.lieu }}</span>
                        <span><i class="bi bi-calendar me-2" style="color:var(--primary-light)"></i>
                            {% if activite.avecDate == 1 %}
                                {{ activite.dateActivite|date('d/m/Y') }}
                            {% else %}
                                <em>Date flexible</em>
                            {% endif %}
                        </span>
                        <span><i class="bi bi-people me-2" style="color:var(--primary-light)"></i>{{ activite.placesDisponibles }} place(s) dispo</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="price">{{ activite.prix }} TND</span>
                        <a href="{{ path('app_activite_show', {id: activite.id}) }}"
                           class="btn btn-sm rounded-pill px-3"
                           style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                            Détails <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12" data-aos="fade-up">
            <div class="text-center py-5 rounded-4" style="background:var(--white)">
                <div style="font-size:4rem">📅</div>
                <p class="mt-3 text-muted">Aucune activité disponible.</p>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<style>
@keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
.conseil-grid { grid-template-columns: 1fr 1fr; }
@media(max-width:576px){ .conseil-grid { grid-template-columns: 1fr; } }
</style>
<script>
const CONSEIL_URL = '{{ path('app_activites_conseil_meteo') }}';

function loadConseilMeteo() {
    const lieu     = document.getElementById('meteo-lieu').value;
    const datetime = document.getElementById('meteo-date').value;
    const loading  = document.getElementById('conseil-loading');
    const content  = document.getElementById('conseil-content');
    const errBox   = document.getElementById('conseil-error');
    const errMsg   = document.getElementById('conseil-error-msg');

    if (!datetime) { alert('Choisissez une date.'); return; }

    loading.style.display = 'block';
    content.style.display = 'none';
    errBox.style.display  = 'none';

    fetch(CONSEIL_URL + '?lieu=' + encodeURIComponent(lieu) + '&datetime=' + encodeURIComponent(datetime))
        .then(r => r.json())
        .then(data => {
            loading.style.display = 'none';

            if (data.error) {
                errMsg.textContent   = data.message || 'Erreur lors de l\'analyse.';
                errBox.style.display = 'block';
                return;
            }

            const m = data.meteo;
            const c = data.conseil;

            // Météo
            document.getElementById('conseil-meteo-emoji').textContent   = m.emoji;
            document.getElementById('conseil-meteo-temp').textContent    = m.temp + '°C — ' + m.description;
            document.getElementById('conseil-meteo-desc').textContent    = '📅 ' + m.slot_time + ' · 📍 ' + m.city;
            document.getElementById('conseil-meteo-details').textContent = '💧 ' + m.humidity + '% · 💨 ' + m.wind + ' km/h';

            // Couleur card météo
            document.getElementById('conseil-meteo-card').style.background = (m.color || '#7f8c8d') + '18';
            document.getElementById('conseil-meteo-card').style.borderColor = (m.color || '#7f8c8d') + '44';

            // Conseil IA
            document.getElementById('conseil-emoji').textContent  = c.emoji;
            document.getElementById('conseil-texte').textContent  = c.conseil;

            // Recommandées
            const recBox = document.getElementById('conseil-recommandees-box');
            const recEl  = document.getElementById('conseil-recommandees');
            if (c.recommandees && c.recommandees.length > 0) {
                recEl.innerHTML = c.recommandees.map(nom =>
                    `<span style="background:#e8f8e8;color:#28a745;border:1px solid #b7ebc8;border-radius:50px;padding:3px 12px;font-size:0.8rem;font-weight:600;">✅ ${nom}</span>`
                ).join('');
                recBox.style.display = 'block';
            } else {
                recBox.style.display = 'none';
            }

            // Déconseillées
            const decBox = document.getElementById('conseil-deconseillees-box');
            const decEl  = document.getElementById('conseil-deconseillees');
            if (c.deconseillees && c.deconseillees.length > 0) {
                decEl.innerHTML = c.deconseillees.map(nom =>
                    `<span style="background:#fff5f5;color:#dc3545;border:1px solid #ffc9c9;border-radius:50px;padding:3px 12px;font-size:0.8rem;font-weight:600;">⚠️ ${nom}</span>`
                ).join('');
                decBox.style.display = 'block';
            } else {
                decBox.style.display = 'none';
            }

            content.style.display = 'block';
        })
        .catch(() => {
            loading.style.display = 'none';
            errMsg.textContent    = 'Impossible de contacter le service météo.';
            errBox.style.display  = 'block';
        });
}
</script>
<script>
(function () {
    function updateBadge(id, count) {
        const el = document.getElementById(id);
        if (!el) return;
        if (count > 0) {
            el.textContent = count > 99 ? '99+' : count;
            el.style.display = 'block';
        } else {
            el.style.display = 'none';
        }
    }

    function loadBadges() {
        fetch('/api/badges')
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data) return;
                updateBadge('badge-historique', data.mesActivites ?? 0);
                updateBadge('badge-demandes',   data.demandes ?? 0);
            })
            .catch(() => {});
    }

    loadBadges();
    setInterval(loadBadges, 30000);
})();
</script>
{% endblock %}
