{% extends 'admin/base_admin.html.twig' %}
{% block title %}{{ titre }}{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block stylesheets %}
<style>
.option-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: #faf8ff;
    border: 1px solid #e0d5f5;
    border-radius: 10px;
    margin-bottom: 8px;
    transition: box-shadow 0.2s;
}
.option-row:hover { box-shadow: 0 2px 10px rgba(108,63,197,0.08); }
.color-preview {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #ddd;
    cursor: pointer;
    flex-shrink: 0;
    transition: transform 0.2s;
}
.color-preview:hover { transform: scale(1.15); }
.btn-remove-option {
    background: #fde8e8;
    color: #c0392b;
    border: none;
    border-radius: 7px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s;
}
.btn-remove-option:hover { background: #e74c3c; color: #fff; }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <h1>{{ titre }}</h1>
    <a href="{{ path('admin_attributs') }}" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row justify-content-center">
<div class="col-lg-7">

<form method="post">
    <div class="form-card mb-4">
        <h6 class="fw-bold mb-4" style="color:var(--primary-dark)">
            <i class="bi bi-info-circle-fill me-2" style="color:var(--primary)"></i>Informations de l'attribut
        </h6>
        <div class="row g-3">
            <div class="col-md-7">
                <label class="form-label">Nom de l'attribut <span class="text-danger">*</span></label>
                <input type="text" name="nom" class="form-control" required
                       placeholder="ex: Taille, Couleur, Matière..."
                       value="{{ attribut ? attribut.nom : '' }}">
            </div>
            <div class="col-md-5">
                <label class="form-label">Type d'affichage</label>
                <select name="typeAffichage" class="form-select">
                    <option value="select"  {{ attribut and attribut.typeAffichage == 'select'  ? 'selected' : '' }}>Liste déroulante</option>
                    <option value="boutons" {{ attribut and attribut.typeAffichage == 'boutons' ? 'selected' : '' }}>Boutons</option>
                    <option value="couleur" {{ attribut and attribut.typeAffichage == 'couleur' ? 'selected' : '' }}>Nuancier couleur</option>
                </select>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h6 class="fw-bold mb-0" style="color:var(--primary-dark)">
                    <i class="bi bi-list-ul me-2" style="color:var(--primary)"></i>Options
                </h6>
                <div class="text-muted small mt-1">Valeurs possibles pour cet attribut</div>
            </div>
            <button type="button" class="btn btn-primary-admin btn-sm" id="btn-add-option">
                <i class="bi bi-plus-lg me-1"></i>Ajouter une option
            </button>
        </div>

        <div id="options-container">
            {% if attribut and attribut.options|length > 0 %}
                {% for opt in attribut.options %}
                <div class="option-row">
                    <span class="text-muted small fw-semibold" style="min-width:20px">{{ loop.index }}</span>
                    <input type="text" name="option_valeur[]" class="form-control form-control-sm"
                           placeholder="ex: Rouge, XL, Coton..." required value="{{ opt.valeur }}">
                    <div style="position:relative;flex-shrink:0">
                        <input type="color" name="option_hex[]" class="color-input"
                               value="{{ opt.codeHexadecimal ?? '#6c3fc5' }}"
                               style="opacity:0;position:absolute;width:32px;height:32px;cursor:pointer">
                        <div class="color-preview" style="background:{{ opt.codeHexadecimal ?? '#e0d5f5' }}"
                             title="Choisir une couleur (optionnel)"></div>
                    </div>
                    <button type="button" class="btn-remove-option" title="Supprimer">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                {% endfor %}
            {% endif %}
        </div>

        <div id="no-option-msg"
             class="{{ attribut and attribut.options|length > 0 ? 'd-none' : '' }} text-center py-4 rounded-3"
             style="background:#f9f7ff;border:2px dashed #e0d5f5">
            <i class="bi bi-list-ul" style="font-size:2rem;color:#c5b3e8"></i>
            <p class="text-muted small mt-2 mb-0">Aucune option. Cliquez sur "Ajouter une option".</p>
        </div>

        <div class="mt-3 p-3 rounded-3" style="background:#f9f7ff;border:1px solid #ede5ff">
            <div class="small text-muted">
                <i class="bi bi-lightbulb me-1" style="color:var(--primary)"></i>
                La couleur est optionnelle — utile uniquement pour le type "Nuancier couleur".
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-3">
        <button type="submit" class="btn btn-primary-admin px-4">
            <i class="bi bi-check-lg me-1"></i>{{ attribut ? 'Enregistrer' : 'Créer l\'attribut' }}
        </button>
        <a href="{{ path('admin_attributs') }}" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
    </div>
</form>

</div>
</div>
{% endblock %}

{% block javascripts %}
<script>
let optionCount = document.querySelectorAll('.option-row').length;

function buildOptionRow(idx) {
    return `<div class="option-row">
        <span class="text-muted small fw-semibold" style="min-width:20px">${idx + 1}</span>
        <input type="text" name="option_valeur[]" class="form-control form-control-sm"
               placeholder="ex: Rouge, XL, Coton..." required>
        <div style="position:relative;flex-shrink:0">
            <input type="color" name="option_hex[]" class="color-input"
                   value="#6c3fc5"
                   style="opacity:0;position:absolute;width:32px;height:32px;cursor:pointer">
            <div class="color-preview" style="background:#e0d5f5" title="Choisir une couleur (optionnel)"></div>
        </div>
        <button type="button" class="btn-remove-option" title="Supprimer">
            <i class="bi bi-x"></i>
        </button>
    </div>`;
}

document.getElementById('btn-add-option').addEventListener('click', () => {
    const container = document.getElementById('options-container');
    container.insertAdjacentHTML('beforeend', buildOptionRow(optionCount++));
    document.getElementById('no-option-msg').classList.add('d-none');
    bindEvents();
    container.lastElementChild.querySelector('input[type=text]').focus();
});

function bindEvents() {
    // Supprimer option
    document.querySelectorAll('.btn-remove-option').forEach(btn => {
        btn.onclick = function() {
            this.closest('.option-row').remove();
            if (!document.querySelector('.option-row')) {
                document.getElementById('no-option-msg').classList.remove('d-none');
            }
            renumberOptions();
        };
    });

    // Sync color picker → preview
    document.querySelectorAll('.option-row').forEach(row => {
        const colorInput   = row.querySelector('.color-input');
        const colorPreview = row.querySelector('.color-preview');
        if (!colorInput || !colorPreview) return;

        // Clic sur le preview ouvre le picker
        colorPreview.addEventListener('click', () => colorInput.click());

        colorInput.addEventListener('input', () => {
            colorPreview.style.background = colorInput.value;
        });
    });
}

function renumberOptions() {
    document.querySelectorAll('.option-row').forEach((row, i) => {
        const num = row.querySelector('span');
        if (num) num.textContent = i + 1;
    });
}

bindEvents();
</script>
{% endblock %}
