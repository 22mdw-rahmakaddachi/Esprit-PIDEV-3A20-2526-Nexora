{% extends 'admin/base_admin.html.twig' %}
{% block title %}Attributs & Options{% endblock %}
{% block page_title %}Attributs & Options{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="bi bi-sliders me-2"></i>Attributs de variation</h1>
    <a href="{{ path('admin_attribut_new') }}" class="btn btn-primary-admin">
        <i class="bi bi-plus-lg me-1"></i>Nouvel attribut
    </a>
</div>

<div class="row g-4">
    {% for attribut in attributs %}
    <div class="col-md-6 col-xl-4" data-aos="fade-up">
        <div class="admin-table h-100">
            <div class="d-flex justify-content-between align-items-center p-3 border-bottom" style="border-color:#ede5ff!important">
                <div>
                    <h6 class="mb-0 fw-bold" style="color:var(--primary-dark)">
                        <i class="bi bi-tag-fill me-2" style="color:var(--primary)"></i>{{ attribut.nom }}
                    </h6>
                    <span class="badge mt-1" style="background:#f0ebff;color:var(--primary);font-size:0.72rem">
                        {{ attribut.typeAffichage ?? 'select' }}
                    </span>
                </div>
                <div class="d-flex gap-1">
                    <a href="{{ path('admin_attribut_edit', {id: attribut.id}) }}" class="btn-edit-admin btn btn-sm">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form method="post" action="{{ path('admin_attribut_delete', {id: attribut.id}) }}"
                          onsubmit="return confirm('Supprimer cet attribut et toutes ses options ?')">
                        <button type="submit" class="btn-danger-admin btn btn-sm">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>

            <div class="p-3">
                {% if attribut.options|length > 0 %}
                <div class="d-flex flex-wrap gap-2">
                    {% for opt in attribut.options %}
                    <span class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill"
                          style="background:#f9f7ff;border:1px solid #e0d5f5;font-size:0.82rem">
                        {% if opt.codeHexadecimal %}
                        <span style="width:14px;height:14px;border-radius:50%;background:{{ opt.codeHexadecimal }};border:1px solid #ddd;display:inline-block"></span>
                        {% endif %}
                        {{ opt.valeur }}
                    </span>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-muted small mb-0">Aucune option — <a href="{{ path('admin_attribut_edit', {id: attribut.id}) }}">Ajouter</a></p>
                {% endif %}
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12">
        <div class="text-center py-5 rounded-4" style="background:#fff;border:2px dashed #ede5ff">
            <i class="bi bi-sliders" style="font-size:3rem;color:#c5b3e8"></i>
            <p class="mt-3 text-muted">Aucun attribut. <a href="{{ path('admin_attribut_new') }}">Créer le premier</a></p>
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}
