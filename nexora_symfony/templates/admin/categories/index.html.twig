{% extends 'admin/base_admin.html.twig' %}
{% block title %}Catégories{% endblock %}
{% block page_title %}Catégories & Sous-catégories{% endblock %}

{% block body %}
<div class="row g-3 mb-4">
    <div class="col-auto">
        <a href="{{ path('admin_categorie_new') }}" class="btn btn-primary-admin">
            <i class="bi bi-plus-lg me-1"></i>Nouvelle catégorie
        </a>
    </div>
    <div class="col-auto">
        <a href="{{ path('admin_sous_categorie_new') }}" class="btn btn-edit-admin">
            <i class="bi bi-plus-lg me-1"></i>Nouvelle sous-catégorie
        </a>
    </div>
</div>

{% if categories is empty %}
<div class="text-center py-5 rounded-4" style="background:#fff;border:2px dashed #ede5ff">
    <i class="bi bi-grid" style="font-size:3rem;color:#c5b3e8"></i>
    <p class="mt-3 text-muted">Aucune catégorie. <a href="{{ path('admin_categorie_new') }}">Créer la première</a></p>
</div>
{% else %}
<div class="row g-4">
    {% for cat in categories %}
    <div class="col-md-6 col-xl-4">
        <div class="admin-table h-100">

            {# En-tête catégorie #}
            <div class="d-flex align-items-center gap-3 p-3 border-bottom" style="border-color:#ede5ff!important">
                {% if cat.image %}
                <img src="/uploads/categorie/{{ cat.image }}" alt="{{ cat.nom }}"
                     style="width:48px;height:48px;object-fit:cover;border-radius:10px;flex-shrink:0">
                {% else %}
                <div style="width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">
                    🗂️
                </div>
                {% endif %}
                <div class="flex-grow-1 min-width-0">
                    <div class="fw-bold" style="color:var(--primary-dark)">{{ cat.nom }}</div>
                    {% if cat.description %}
                    <div class="text-muted small text-truncate">{{ cat.description }}</div>
                    {% endif %}
                </div>
                <div class="d-flex gap-1 flex-shrink-0">
                    <a href="{{ path('admin_categorie_edit', {id: cat.id}) }}" class="btn-edit-admin btn btn-sm">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form method="post" action="{{ path('admin_categorie_delete', {id: cat.id}) }}"
                          onsubmit="return confirm('Supprimer cette catégorie ?')">
                        <button type="submit" class="btn-danger-admin btn btn-sm">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>

            {# Sous-catégories #}
            <div class="p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-semibold text-muted">Sous-catégories</span>
                    <a href="{{ path('admin_sous_categorie_new') }}?cat={{ cat.id }}"
                       class="btn btn-sm rounded-pill px-2 py-0"
                       style="background:#f0ebff;color:var(--primary);font-size:0.75rem">
                        <i class="bi bi-plus"></i> Ajouter
                    </a>
                </div>

                {% set sousCats = sousCatsMap[cat.id] ?? [] %}
                {% if sousCats|length > 0 %}
                <div class="d-flex flex-column gap-2">
                    {% for sc in sousCats %}
                    <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background:#f9f7ff;border:1px solid #ede5ff">
                        {% if sc.image %}
                        <img src="/uploads/sous_categorie/{{ sc.image }}" alt="{{ sc.nom }}"
                             style="width:32px;height:32px;object-fit:cover;border-radius:6px;flex-shrink:0">
                        {% else %}
                        <div style="width:32px;height:32px;border-radius:6px;background:#ede5ff;display:flex;align-items:center;justify-content:center;font-size:0.9rem;flex-shrink:0">📁</div>
                        {% endif %}
                        <span class="small fw-semibold flex-grow-1" style="color:var(--primary-dark)">{{ sc.nom }}</span>
                        <a href="{{ path('admin_sous_categorie_edit', {id: sc.id}) }}" class="btn-edit-admin btn btn-sm py-0 px-2">
                            <i class="bi bi-pencil" style="font-size:0.75rem"></i>
                        </a>
                        <form method="post" action="{{ path('admin_sous_categorie_delete', {id: sc.id}) }}"
                              onsubmit="return confirm('Supprimer cette sous-catégorie ?')">
                            <button type="submit" class="btn-danger-admin btn btn-sm py-0 px-2">
                                <i class="bi bi-trash" style="font-size:0.75rem"></i>
                            </button>
                        </form>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-muted small mb-0 fst-italic">Aucune sous-catégorie</p>
                {% endif %}
            </div>

        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
