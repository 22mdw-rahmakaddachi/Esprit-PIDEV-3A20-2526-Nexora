{% extends 'admin/base_admin.html.twig' %}
{% block title %}Publication #{{ pub.id }}{% endblock %}
{% block page_title %}Publication #{{ pub.id }}{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="bi bi-newspaper me-2"></i>Publication #{{ pub.id }}</h1>
    <div class="d-flex gap-2">
        <form method="POST" action="{{ path('admin_publication_delete', {id: pub.id}) }}"
              onsubmit="return confirm('Supprimer cette publication ?')">
            <button type="submit" class="btn btn-danger-admin px-3">
                <i class="bi bi-trash me-1"></i>Supprimer
            </button>
        </form>
        <a href="{{ path('admin_publications') }}" class="btn btn-sm rounded-pill px-3"
           style="border:1.5px solid var(--primary);color:var(--primary)">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="form-card">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.1rem">
                    {{ pub.auteur|slice(0,1)|upper }}
                </div>
                <div>
                    <div class="fw-bold" style="color:var(--primary-dark)">{{ pub.auteur }}</div>
                    <div class="text-muted small">{{ pub.created_at|date('d/m/Y à H:i') }}</div>
                </div>
            </div>
            <p style="font-size:0.95rem;line-height:1.8;color:#333">{{ pub.contenu }}</p>
            {% if pub.image %}
            <img src="/uploads/publications/{{ pub.image }}" alt="image"
                 style="width:100%;max-height:300px;object-fit:cover;border-radius:12px;margin-top:12px">
            {% endif %}
        </div>

        {# Réactions #}
        {% if pub.reactions %}
        <div class="form-card mt-4">
            <h6 class="fw-bold mb-3" style="color:var(--primary-dark)"><i class="bi bi-emoji-smile me-2"></i>Réactions</h6>
            <div class="d-flex gap-3 flex-wrap">
                {% set emojis = {'jaime':'👍','jadore':'❤️','haha':'😂','wow':'😮','triste':'😢','grrr':'😡'} %}
                {% for r in pub.reactions %}
                <div class="text-center">
                    <div style="font-size:1.6rem">{{ emojis[r.type_reaction] ?? '👍' }}</div>
                    <div class="fw-bold" style="color:var(--primary)">{{ r.total }}</div>
                    <div class="text-muted" style="font-size:0.72rem">{{ r.type_reaction }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>

    <div class="col-lg-5">
        <div class="form-card">
            <h6 class="fw-bold mb-3" style="color:var(--primary-dark)">
                <i class="bi bi-chat me-2"></i>Commentaires ({{ pub.commentaires|length }})
            </h6>
            {% for c in pub.commentaires %}
            <div class="d-flex gap-2 mb-3 pb-3" style="border-bottom:1px solid #f0ebff">
                <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#a78bda,var(--accent));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.78rem;flex-shrink:0">
                    {{ c.auteur|slice(0,1)|upper }}
                </div>
                <div>
                    <div class="fw-semibold small" style="color:var(--primary-dark)">{{ c.auteur }}</div>
                    <div style="font-size:0.85rem;color:#444;margin-top:2px">{{ c.contenu }}</div>
                    <div class="text-muted" style="font-size:0.72rem;margin-top:3px">{{ c.created_at|date('d/m/Y H:i') }}</div>
                </div>
            </div>
            {% else %}
            <p class="text-muted small text-center py-3">Aucun commentaire.</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
