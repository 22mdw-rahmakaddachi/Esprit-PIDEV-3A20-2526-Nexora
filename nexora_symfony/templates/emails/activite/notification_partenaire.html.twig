<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nouvelle demande de participation</title>
</head>
<body style="margin:0;padding:0;background-color:#f0f2f5;font-family:'Segoe UI',Arial,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background:#f0f2f5;padding:30px 0;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">

      <!-- HEADER -->
      <tr>
        <td style="background:linear-gradient(135deg,#6c3fc5 0%,#9b59b6 100%);border-radius:12px 12px 0 0;padding:35px 40px;text-align:center;">
          <div style="font-size:42px;margin-bottom:10px;">📩</div>
          <h1 style="color:#ffffff;margin:0;font-size:24px;font-weight:700;letter-spacing:-0.5px;">Nouvelle demande de participation</h1>
          <p style="color:rgba(255,255,255,0.85);margin:8px 0 0;font-size:14px;">Vous avez reçu une nouvelle demande sur votre activité</p>
        </td>
      </tr>

      <!-- BODY -->
      <tr>
        <td style="background:#ffffff;padding:35px 40px;">

          <p style="color:#444;font-size:16px;margin:0 0 25px;">Bonjour,</p>
          <p style="color:#444;font-size:15px;margin:0 0 25px;line-height:1.6;">
            Un client souhaite participer à votre activité. Voici les détails de la demande :
          </p>

          <!-- ACTIVITE CARD -->
          <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8f5ff;border:1px solid #e0d5f5;border-radius:10px;margin-bottom:20px;">
            <tr>
              <td style="padding:20px 25px;">
                <p style="margin:0 0 12px;font-size:13px;font-weight:700;color:#6c3fc5;text-transform:uppercase;letter-spacing:1px;">🎯 Activité concernée</p>
                <table width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;width:130px;">Nom</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;font-weight:600;">{{ activite.nom }}</td>
                  </tr>
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;">Type</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;">{{ activite.type }}</td>
                  </tr>
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;">📍 Lieu</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;">{{ activite.lieu }}</td>
                  </tr>
                  {% if activite.avecDate and activite.dateActivite %}
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;">📅 Date</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;font-weight:600;">{{ activite.dateActivite|date('d/m/Y à H:i') }}</td>
                  </tr>
                  {% endif %}
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;">💰 Prix</td>
                    <td style="padding:5px 0;color:#6c3fc5;font-size:15px;font-weight:700;">{{ activite.prix }} TND</td>
                  </tr>
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;">Places dispo</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;">{{ activite.placesDisponibles }} / {{ activite.nombrePlaces }}</td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>

          <!-- CLIENT CARD -->
          <table width="100%" cellpadding="0" cellspacing="0" style="background:#fff8e1;border:1px solid #ffe082;border-radius:10px;margin-bottom:25px;">
            <tr>
              <td style="padding:20px 25px;">
                <p style="margin:0 0 12px;font-size:13px;font-weight:700;color:#f59e0b;text-transform:uppercase;letter-spacing:1px;">👤 Informations client</p>
                <table width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;width:130px;">Nom complet</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;font-weight:600;">{{ demande.clientNom }}</td>
                  </tr>
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;">📧 Email</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;">{{ demande.clientEmail }}</td>
                  </tr>
                  {% if demande.clientTelephone %}
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;">📞 Téléphone</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;">{{ demande.clientTelephone }}</td>
                  </tr>
                  {% endif %}
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;">📆 Date demande</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;">{{ demande.dateDemande|date('d/m/Y à H:i') }}</td>
                  </tr>
                  <tr>
                    <td style="padding:5px 0;color:#555;font-size:14px;">Référence</td>
                    <td style="padding:5px 0;color:#222;font-size:14px;font-weight:600;">#{{ demande.id }}</td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>

          <!-- CTA -->
          <table width="100%" cellpadding="0" cellspacing="0" style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:10px;margin-bottom:10px;">
            <tr>
              <td style="padding:18px 25px;text-align:center;">
                <p style="margin:0;color:#2e7d32;font-size:14px;font-weight:600;">
                  ✅ Connectez-vous à votre espace partenaire pour <strong>accepter</strong> ou <strong>refuser</strong> cette demande.
                </p>
              </td>
            </tr>
          </table>

        </td>
      </tr>

      <!-- FOOTER -->
      <tr>
        <td style="background:#f8f5ff;border-radius:0 0 12px 12px;padding:20px 40px;text-align:center;border-top:1px solid #e0d5f5;">
          <p style="color:#9b59b6;font-size:13px;font-weight:700;margin:0 0 4px;">Nexora Activités</p>
          <p style="color:#aaa;font-size:12px;margin:0;">Ceci est un email automatique, merci de ne pas y répondre.</p>
        </td>
      </tr>

    </table>
  </td></tr>
</table>

</body>
</html>
