{% extends 'base.html.twig' %}
{% block title %}Paiement échoué — NEXORA{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
    <div class="col-lg-6" data-aos="fade-up">
        <div class="bg-white rounded-4 p-5 shadow-sm text-center" style="border:2px solid #e74c3c">
            <div style="font-size:4rem">❌</div>
            <h2 class="mt-3" style="color:#e74c3c">Paiement échoué</h2>
            <p class="text-muted">Le paiement n'a pas pu être complété. Votre demande reste acceptée.</p>

            {% if demande %}
            <div class="my-4 p-3 rounded-3" style="background:#fde8e8;border:1px solid #f5b7b1">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Activité</span>
                    <span class="fw-semibold">{{ demande.activite.nom }}</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Montant</span>
                    <span class="fw-bold" style="color:#c0392b">{{ demande.activite.prix|number_format(2) }} TND</span>
                </div>
            </div>

            <a href="{{ path('app_paiement_activite_initier', {demandeId: demande.id}) }}"
               class="btn w-100 rounded-pill py-3 mb-3"
               style="background:linear-gradient(135deg,#0066cc,#0099ff);color:#fff;font-weight:700">
                <i class="bi bi-arrow-repeat me-2"></i>Réessayer le paiement
            </a>
            {% endif %}

            <a href="{{ path('app_mes_activites') }}" class="btn btn-outline-secondary rounded-pill px-4">
                Retour à mes activités
            </a>
        </div>
    </div>
    </div>
</div>
{% endblock %}
