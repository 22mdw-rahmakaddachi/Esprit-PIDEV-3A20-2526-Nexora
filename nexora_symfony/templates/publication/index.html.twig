{% extends 'base.html.twig' %}
{% block title %}Publications — TripShop{% endblock %}

{% block stylesheets %}
<style>
.feed-wrap { max-width: 640px; margin: 0 auto; }
.pub-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 16px rgba(108,63,197,0.08); border: 1px solid #ede5ff; overflow: hidden; transition: box-shadow 0.2s; }
.pub-card:hover { box-shadow: 0 6px 28px rgba(108,63,197,0.13); }
.pub-avatar { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--accent)); color: #fff; font-weight: 700; font-size: 1rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.reaction-bar { display: flex; gap: 4px; padding: 8px 16px; border-top: 1px solid #f0ebff; border-bottom: 1px solid #f0ebff; }
.reaction-btn { position: relative; background: none; border: none; font-size: 1.3rem; cursor: pointer; padding: 4px 8px; border-radius: 50px; transition: transform 0.15s, background 0.15s; line-height: 1; }
.reaction-btn:hover { transform: scale(1.35); background: #f0ebff; }
.reaction-btn.active { background: #ede5ff; }
.reaction-btn .r-count { position: absolute; top: -4px; right: -2px; background: var(--primary); color: #fff; font-size: 0.6rem; font-weight: 700; min-width: 16px; height: 16px; border-radius: 50px; display: flex; align-items: center; justify-content: center; padding: 0 3px; }
.comment-item { display: flex; gap: 10px; align-items: flex-start; }
.comment-avatar { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #a78bda, var(--accent)); color: #fff; font-weight: 700; font-size: 0.78rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.comment-bubble { background: #f4f1fb; border-radius: 0 12px 12px 12px; padding: 8px 14px; font-size: 0.85rem; flex: 1; }
.comment-bubble .c-author { font-weight: 700; color: var(--primary-dark); font-size: 0.82rem; }
.comment-bubble .c-text   { color: #444; margin-top: 2px; line-height: 1.5; }
.comment-bubble .c-date   { color: #aaa; font-size: 0.72rem; margin-top: 3px; }
.comment-input-wrap { display: flex; gap: 10px; align-items: center; padding: 12px 16px; }
.comment-input { flex: 1; border: 1.5px solid #ede5ff; border-radius: 50px; padding: 8px 16px; font-size: 0.85rem; outline: none; transition: border-color 0.2s; }
.comment-input:focus { border-color: var(--primary-light); }
.comment-send-btn { background: linear-gradient(135deg, var(--primary), var(--accent)); color: #fff; border: none; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 0.9rem; transition: opacity 0.2s, transform 0.2s; flex-shrink: 0; }
.comment-send-btn:hover { opacity: 0.85; transform: scale(1.08); }
.new-pub-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 16px rgba(108,63,197,0.08); border: 1px solid #ede5ff; padding: 20px; }
.new-pub-textarea { width: 100%; border: 1.5px solid #ede5ff; border-radius: 12px; padding: 12px 16px; font-size: 0.9rem; resize: none; outline: none; transition: border-color 0.2s; font-family: inherit; }
.new-pub-textarea:focus { border-color: var(--primary-light); }
</style>
{% endblock %}

{% block body %}
<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Publications</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="feed-wrap" id="feed">

        <div class="new-pub-card mb-4" data-aos="fade-down">
            {% if app.user %}
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="pub-avatar">{{ app.user.prenom|first|upper }}</div>
                <div>
                    <div class="fw-bold" style="color:var(--primary-dark)">{{ app.user.prenom }} {{ app.user.nom }}</div>
                    <div class="text-muted small"><i class="bi bi-globe me-1"></i>Visible par tous</div>
                </div>
            </div>
            <form action="{{ path('app_publication_new') }}" method="POST" enctype="multipart/form-data" id="pub-form" novalidate>
                {% set pub_old = app.session.get('pub_old', {}) %}
                <div style="position:relative;">
                    <textarea name="contenu" id="pub-contenu" 
                              class="new-pub-textarea" 
                              rows="3"
                              placeholder="Quoi de neuf ? Partagez votre expérience..." 
                              spellcheck="true" lang="fr"
                              oninput="pubCheckSpelling(this.value)"
                              style="{% if app.session.flashBag.peek('error_contenu') is not empty %}border:1px solid #dc3545 !important;background:#fff;padding-right:40px;border-radius:12px;{% elseif pub_old.contenu is defined and pub_old.contenu|length >= 2 %}border:1px solid #28a745 !important;border-radius:12px;{% else %}border-radius:12px;{% endif %}">{{ pub_old.contenu ?? '' }}</textarea>
                    {% if app.session.flashBag.peek('error_contenu') is not empty %}
                    <i class="bi bi-exclamation-circle-fill" style="position:absolute;right:12px;top:12px;color:#dc3545;font-size:1.1rem;"></i>
                    {% endif %}
                </div>
                {% for error in app.flashes('error_contenu') %}
                <div style="display:flex;align-items:flex-start;gap:6px;margin-top:6px;font-size:0.8rem;color:#dc3545;">
                    <i class="bi bi-exclamation-triangle-fill" style="margin-top:2px;"></i>
                    <span>{{ error }}</span>
                </div>
                {% endfor %}

                {# Zone pills de correction #}
                <div id="pub-corrections" style="display:none;margin-top:8px;padding:10px 14px;background:#fff8f0;border:1px solid #fde8cc;border-radius:12px;font-size:0.82rem">
                    <div style="color:#c0392b;font-weight:600;margin-bottom:6px">
                        <i class="bi bi-magic me-1"></i>Corrections suggérées :
                    </div>
                    <div id="pub-pills" style="display:flex;flex-wrap:wrap;gap:6px"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 gap-2">
                    <label class="btn rounded-pill px-3" style="background:#f0ebff;color:var(--primary);border:none;cursor:pointer;font-size:0.85rem">
                        <i class="bi bi-image me-1"></i>Photo
                        <input type="file" name="image" accept="image/*" style="display:none"
                               onchange="document.getElementById('pub-fname').textContent = this.files[0]?.name ?? ''">
                    </label>
                    <span id="pub-fname" class="text-muted small flex-grow-1"></span>
                    <button type="submit" id="pub-submit-btn" class="btn rounded-pill px-4 fw-semibold"
                            style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;font-size:0.88rem">
                        <i class="bi bi-send me-2"></i>Publier
                    </button>
                </div>
            </form>
            {% else %}
            <div class="text-center py-3">
                <div style="font-size:2rem">✍️</div>
                <p class="text-muted mt-2 mb-3">Connectez-vous pour partager avec la communauté</p>
                <a href="{{ path('app_login') }}" class="btn rounded-pill px-4 fw-semibold"
                   style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                    <i class="bi bi-person-circle me-2"></i>Se connecter
                </a>
            </div>
            {% endif %}
        </div>

        {% for pub in publications %}
        <div class="pub-card mb-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 60 }}" id="pub-{{ pub.id }}">
            <div class="d-flex align-items-center gap-3 p-3">
                <div class="pub-avatar">{{ pub.auteur|slice(0,1)|upper }}</div>
                <div>
                    <div class="fw-bold" style="color:var(--primary-dark);font-size:0.95rem">{{ pub.auteur }}</div>
                    <div class="text-muted" style="font-size:0.75rem">
                        <i class="bi bi-clock me-1"></i>{{ pub.created_at|date('d/m/Y à H:i') }}
                    </div>
                </div>
            </div>

            <div class="px-3 pb-3" style="font-size:0.92rem;line-height:1.7;color:#333">
                {{ pub.contenu }}
            </div>

            {% if pub.total_reactions > 0 %}
            <div class="px-3 pb-2 d-flex gap-2 align-items-center" style="font-size:0.8rem;color:#888">
                <span id="summary-{{ pub.id }}">
                    {% for r in pub.reactions %}
                        {{ r.type_reaction == 'jaime'  ? '👍' :
                           r.type_reaction == 'jadore' ? '❤️' :
                           r.type_reaction == 'haha'   ? '😂' :
                           r.type_reaction == 'wow'    ? '😮' :
                           r.type_reaction == 'triste' ? '😢' : '😡' }}
                        {{ r.total }}
                    {% endfor %}
                </span>
            </div>
            {% else %}
            <div class="px-3 pb-2" id="summary-{{ pub.id }}" style="font-size:0.8rem;color:#bbb"></div>
            {% endif %}

            <div class="reaction-bar" id="reactions-{{ pub.id }}">
                {% set emojis = {'jaime':'👍','jadore':'❤️','haha':'😂','wow':'😮','triste':'😢','grrr':'😡'} %}
                {% for key, emoji in emojis %}
                {% set count = 0 %}
                {% for r in pub.reactions %}{% if r.type_reaction == key %}{% set count = r.total %}{% endif %}{% endfor %}
                <button class="reaction-btn" data-pub="{{ pub.id }}" data-type="{{ key }}"
                        title="{{ key|capitalize }}" onclick="reagir({{ pub.id }}, '{{ key }}', this)">
                    {{ emoji }}
                    {% if count > 0 %}<span class="r-count">{{ count }}</span>{% endif %}
                </button>
                {% endfor %}
                <button class="ms-auto btn btn-sm rounded-pill px-3"
                        style="font-size:0.8rem;color:var(--primary);border:1.5px solid #ede5ff"
                        onclick="toggleComments({{ pub.id }})">
                    <i class="bi bi-chat me-1"></i>
                    <span id="nb-comments-{{ pub.id }}">{{ pub.commentaires|length }}</span>
                </button>
            </div>

            <div id="comments-{{ pub.id }}" style="display:none">
                <div class="px-3 pt-3 d-flex flex-column gap-3" id="comments-list-{{ pub.id }}">
                    {% for c in pub.commentaires %}
                    <div class="comment-item">
                        <div class="comment-avatar">{{ c.auteur|slice(0,1)|upper }}</div>
                        <div class="comment-bubble">
                            <div class="c-author">{{ c.auteur }}</div>
                            <div class="c-text">{{ c.contenu }}</div>
                            <div class="c-date">{{ c.created_at|date('d/m/Y H:i') }}</div>
                        </div>
                    </div>
                    {% else %}
                    <div class="text-muted small text-center py-2" id="no-comment-{{ pub.id }}">Aucun commentaire.</div>
                    {% endfor %}
                </div>
                <div class="comment-input-wrap" style="flex-direction:column;align-items:stretch;gap:8px">
                    <div style="display:flex;gap:10px;align-items:center">
                        <div class="comment-avatar">{{ app.user ? app.user.prenom|first|upper : '?' }}</div>
                        {% if not app.user %}
                        <input type="text" class="comment-input" id="c-auteur-{{ pub.id }}" placeholder="Votre nom">
                        {% endif %}
                        <input type="text" class="comment-input" id="c-text-{{ pub.id }}"
                               placeholder="Écrire un commentaire..."
                               spellcheck="true" lang="fr"
                               oninput="commentCheckSpelling({{ pub.id }}, this.value)"
                               onkeydown="if(event.key==='Enter') envoyerCommentaire({{ pub.id }})">
                        <button class="comment-send-btn" onclick="envoyerCommentaire({{ pub.id }})">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                    {# Pills de correction commentaire #}
                    <div id="c-corrections-{{ pub.id }}" style="display:none;margin:4px 0 0 52px;padding:8px 12px;background:#fff8f0;border:1px solid #fde8cc;border-radius:10px;font-size:0.78rem">
                        <div style="color:#c0392b;font-weight:600;margin-bottom:5px"><i class="bi bi-magic me-1"></i>Corrections :</div>
                        <div id="c-pills-{{ pub.id }}" style="display:flex;flex-wrap:wrap;gap:5px"></div>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="text-center py-5 text-muted" data-aos="fade-up">
            <div style="font-size:4rem">📝</div>
            <p class="mt-3">Aucune publication. Soyez le premier à partager !</p>
        </div>
        {% endfor %}

    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const loggedUser = "{{ app.user ? app.user.prenom ~ ' ' ~ app.user.nom : '' }}";

// ── Correction orthographique PUBLICATION ──
let _pubTimer = null;
let _pubMatches = [];

function pubCheckSpelling(text) {
    const corrDiv  = document.getElementById('pub-corrections');
    const pillsDiv = document.getElementById('pub-pills');
    clearTimeout(_pubTimer);
    if (!text || text.length < 5) { corrDiv.style.display = 'none'; _pubMatches = []; return; }

    _pubTimer = setTimeout(() => {
        fetch('https://api.languagetool.org/v2/check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `text=${encodeURIComponent(text)}&language=fr`
        })
        .then(r => r.json())
        .then(data => {
            _pubMatches = data.matches || [];
            if (_pubMatches.length === 0) { corrDiv.style.display = 'none'; return; }

            pillsDiv.innerHTML = '';
            _pubMatches.forEach((m, idx) => {
                if (!m.replacements || m.replacements.length === 0) return;
                const wrongWord = text.slice(m.offset, m.offset + m.length);
                const pill = document.createElement('div');
                pill.style.cssText = 'display:flex;align-items:center;gap:6px;background:#fff;border:1px solid #fde8cc;border-radius:50px;padding:4px 10px';
                // Mot barré en rouge
                const wrong = document.createElement('span');
                wrong.style.cssText = 'text-decoration:line-through;color:#e74c3c;font-weight:600';
                wrong.textContent = wrongWord;
                pill.appendChild(wrong);
                const arrow = document.createElement('span');
                arrow.textContent = '→';
                arrow.style.color = '#aaa';
                pill.appendChild(arrow);
                // Boutons suggestions (max 3)
                m.replacements.slice(0, 3).forEach(rep => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.textContent = rep.value;
                    btn.style.cssText = 'background:#f0ebff;color:var(--primary);border:none;border-radius:50px;padding:2px 10px;font-size:0.78rem;font-weight:600;cursor:pointer';
                    btn.onmouseover = () => btn.style.background = 'var(--primary)', btn.style.color = '#fff';
                    btn.onmouseout  = () => { btn.style.background = '#f0ebff'; btn.style.color = 'var(--primary)'; };
                    btn.onclick = () => pubApplyFix(m.offset, m.length, rep.value);
                    pill.appendChild(btn);
                });
                pillsDiv.appendChild(pill);
            });
            corrDiv.style.display = pillsDiv.children.length > 0 ? 'block' : 'none';
        })
        .catch(() => { corrDiv.style.display = 'none'; });
    }, 800);
}

function pubApplyFix(offset, length, replacement) {
    const ta = document.getElementById('pub-contenu');
    ta.value = ta.value.slice(0, offset) + replacement + ta.value.slice(offset + length);
    pubCheckSpelling(ta.value);
    ta.focus();
}

// ── Correction orthographique COMMENTAIRES (pills) ──
let _cTimers = {};

function commentCheckSpelling(pubId, text) {
    const corrDiv  = document.getElementById(`c-corrections-${pubId}`);
    const pillsDiv = document.getElementById(`c-pills-${pubId}`);
    clearTimeout(_cTimers[pubId]);
    if (!text || text.length < 5) { corrDiv.style.display = 'none'; return; }

    _cTimers[pubId] = setTimeout(() => {
        fetch('https://api.languagetool.org/v2/check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `text=${encodeURIComponent(text)}&language=fr`
        })
        .then(r => r.json())
        .then(data => {
            const matches = (data.matches || []).filter(m => m.replacements && m.replacements.length > 0);
            if (matches.length === 0) { corrDiv.style.display = 'none'; return; }
            pillsDiv.innerHTML = '';
            matches.forEach(m => {
                const wrongWord = text.slice(m.offset, m.offset + m.length);
                const pill = document.createElement('div');
                pill.style.cssText = 'display:flex;align-items:center;gap:5px;background:#fff;border:1px solid #fde8cc;border-radius:50px;padding:3px 10px';
                const wrong = document.createElement('span');
                wrong.style.cssText = 'text-decoration:line-through;color:#e74c3c;font-weight:600';
                wrong.textContent = wrongWord;
                pill.appendChild(wrong);
                const arrow = document.createElement('span');
                arrow.textContent = '→'; arrow.style.color = '#aaa';
                pill.appendChild(arrow);
                m.replacements.slice(0, 3).forEach(rep => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.textContent = rep.value;
                    btn.style.cssText = 'background:#f0ebff;color:var(--primary);border:none;border-radius:50px;padding:2px 10px;font-size:0.75rem;font-weight:600;cursor:pointer';
                    btn.onclick = () => {
                        const input = document.getElementById(`c-text-${pubId}`);
                        input.value = input.value.slice(0, m.offset) + rep.value + input.value.slice(m.offset + m.length);
                        commentCheckSpelling(pubId, input.value);
                        input.focus();
                    };
                    pill.appendChild(btn);
                });
                pillsDiv.appendChild(pill);
            });
            corrDiv.style.display = pillsDiv.children.length > 0 ? 'block' : 'none';
        })
        .catch(() => { corrDiv.style.display = 'none'; });
    }, 800);
}

function reagir(pubId, type, btn) {
    const auteur = loggedUser || prompt('Votre prénom pour réagir ?', localStorage.getItem('tripshop_username') || '');
    if (!auteur || auteur.trim().length < 2) return;
    if (!loggedUser) localStorage.setItem('tripshop_username', auteur.trim());
    const fd = new FormData();
    fd.append('auteur', auteur.trim());
    fd.append('type', type);
    fetch(`/publications/${pubId}/reagir`, { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            if (data.error) return;
            const bar = document.getElementById(`reactions-${pubId}`);
            bar.querySelectorAll('.reaction-btn').forEach(b => {
                const t = b.dataset.type;
                const found = data.reactions.find(r => r.type_reaction === t);
                let badge = b.querySelector('.r-count');
                if (found && found.total > 0) {
                    if (!badge) { badge = document.createElement('span'); badge.className = 'r-count'; b.appendChild(badge); }
                    badge.textContent = found.total;
                } else if (badge) { badge.remove(); }
            });
            const emojis = {jaime:'👍',jadore:'❤️',haha:'😂',wow:'😮',triste:'😢',grrr:'😡'};
            const summary = document.getElementById(`summary-${pubId}`);
            summary.innerHTML = data.reactions.map(r => `${emojis[r.type_reaction]} ${r.total}`).join(' ');
        });
}

function toggleComments(pubId) {
    const el = document.getElementById(`comments-${pubId}`);
    el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

function envoyerCommentaire(pubId) {
    const auteurEl  = document.getElementById(`c-auteur-${pubId}`);
    const contenuEl = document.getElementById(`c-text-${pubId}`);
    const sendBtn   = contenuEl.closest('.comment-input-wrap').querySelector('.comment-send-btn');
    const auteur    = loggedUser || (auteurEl ? auteurEl.value.trim() : '');
    const contenu   = contenuEl.value.trim();

    if (auteur.length < 2 || contenu.length < 2) {
        if (auteurEl) auteurEl.style.borderColor = auteur.length < 2 ? '#e74c3c' : '#ede5ff';
        contenuEl.style.borderColor = contenu.length < 2 ? '#e74c3c' : '#ede5ff';
        return;
    }

    // Désactiver le bouton pendant la correction
    sendBtn.disabled = true;
    sendBtn.innerHTML = '<i class="bi bi-hourglass-split"></i>';

    // Corriger d'abord, puis envoyer
    fetch('https://api.languagetool.org/v2/check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `text=${encodeURIComponent(contenu)}&language=fr`
    })
    .then(r => r.json())
    .then(data => {
        let texteCorrige = contenu;
        if (data.matches && data.matches.length > 0) {
            let offset = 0;
            data.matches.forEach(m => {
                if (m.replacements && m.replacements.length > 0) {
                    const fix = m.replacements[0].value;
                    texteCorrige = texteCorrige.slice(0, m.offset + offset) + fix + texteCorrige.slice(m.offset + offset + m.length);
                    offset += fix.length - m.length;
                }
            });
        }
        _envoyerCommentaireAvecTexte(pubId, auteur, texteCorrige, contenuEl, sendBtn);
    })
    .catch(() => {
        // Si l'API échoue, envoyer le texte original
        _envoyerCommentaireAvecTexte(pubId, auteur, contenu, contenuEl, sendBtn);
    });
}

function _envoyerCommentaireAvecTexte(pubId, auteur, contenu, contenuEl, sendBtn) {
    const fd = new FormData();
    fd.append('auteur', auteur);
    fd.append('contenu', contenu);
    fetch(`/publications/${pubId}/commenter`, { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            sendBtn.disabled = false;
            sendBtn.innerHTML = '<i class="bi bi-send-fill"></i>';
            if (data.error) return;
            contenuEl.value = '';
            contenuEl.style.borderColor = '#ede5ff';
            // Cacher les pills si visibles
            const corrDiv = document.getElementById(`c-corrections-${pubId}`);
            if (corrDiv) corrDiv.style.display = 'none';
            const noComment = document.getElementById(`no-comment-${pubId}`);
            if (noComment) noComment.remove();
            const list = document.getElementById(`comments-list-${pubId}`);
            const div  = document.createElement('div');
            div.className = 'comment-item';
            div.innerHTML = `<div class="comment-avatar">${data.auteur[0].toUpperCase()}</div><div class="comment-bubble"><div class="c-author">${data.auteur}</div><div class="c-text">${data.contenu}</div><div class="c-date">${data.created_at}</div></div>`;
            list.appendChild(div);
            const nb = document.getElementById(`nb-comments-${pubId}`);
            if (nb) nb.textContent = parseInt(nb.textContent || 0) + 1;
        })
        .catch(() => {
            sendBtn.disabled = false;
            sendBtn.innerHTML = '<i class="bi bi-send-fill"></i>';
        });
}
</script>
{% endblock %}
