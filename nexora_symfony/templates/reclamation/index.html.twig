{% extends 'base.html.twig' %}
{% block title %}Mes réclamations{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container" style="max-width:860px">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2" style="color:#e67e22"></i>Mes réclamations
            </h2>
            <a href="{{ path('app_reclamation_new') }}" class="btn btn-hero" style="background:linear-gradient(135deg,#e67e22,#d35400);color:#fff;border:none;padding:10px 24px;border-radius:50px;font-weight:600">
                <i class="bi bi-plus-circle me-2"></i>Nouvelle réclamation
            </a>
        </div>

        {% if reclamations is empty %}
        <div class="text-center py-5" style="background:#fff;border-radius:16px;border:1px solid #ede5ff">
            <i class="bi bi-check-circle" style="font-size:3rem;color:#1a7a4a;opacity:0.4"></i>
            <p class="mt-3 text-muted">Aucune réclamation pour le moment.</p>
            <a href="{{ path('app_reclamation_new') }}" class="btn btn-sm rounded-pill px-4 mt-1"
               style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none">
                Soumettre une réclamation
            </a>
        </div>
        {% else %}
        <div class="d-flex flex-column gap-3">
            {% for r in reclamations %}
            <div class="p-4 rounded-3" style="background:#fff;border:1px solid #ede5ff;box-shadow:0 4px 16px rgba(108,63,197,0.07)">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        {% if r.activite %}
                        <span class="badge rounded-pill mb-1" style="background:#f0ebff;color:var(--primary);font-size:0.78rem">
                            <i class="bi bi-calendar-event me-1"></i>{{ r.activite.nom }}
                        </span>
                        {% endif %}
                        <p class="mb-0 fw-semibold" style="color:#333">{{ r.description }}</p>
                    </div>
                    <span class="ms-3 flex-shrink-0 badge rounded-pill px-3 py-2
                        {% if r.statut == 'RESOLUE' %}
                            " style="background:#d1f2eb;color:#1a7a4a">✅ Résolue
                        {% elseif r.statut == 'EN_COURS' %}
                            " style="background:#fff3cd;color:#856404">🔄 En cours
                        {% else %}
                            " style="background:#fde8e8;color:#c0392b">⏳ En attente
                        {% endif %}
                    </span>
                </div>
                <div class="text-muted small mt-2">
                    <i class="bi bi-clock me-1"></i>
                    {{ r.dateCreation ? r.dateCreation|date('d/m/Y à H:i') : '—' }}
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

    </div>
</section>
{% endblock %}
