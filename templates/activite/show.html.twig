{% extends 'base.html.twig' %}
{% block title %}{{ activite ? activite.nom : 'Activité' }} — NEXORA{% endblock %}

{% block body %}
{% if not activite %}
<div class="container py-5 text-center text-muted">
    <i class="bi bi-calendar-x" style="font-size:3rem;opacity:0.4"></i>
    <p class="mt-3">Activité introuvable.</p>
    <a href="{{ path('app_activites') }}" class="btn rounded-pill px-4 mt-2" style="background:var(--primary);color:#fff">Retour aux activités</a>
</div>
{% else %}
<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_activites') }}">Activités</a></li>
                <li class="breadcrumb-item active">{{ activite.nom }}</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5 align-items-start">
        <div class="col-md-5" data-aos="fade-right">
            <div class="rounded-4 overflow-hidden" style="height:400px">
                {% if activite.images %}
                    <img src="{{ activite.imageUrl }}"
                         alt="{{ activite.nom }}"
                         style="width:100%;height:100%;object-fit:cover"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                    <div style="display:none;width:100%;height:100%;align-items:center;justify-content:center;font-size:10rem;background:linear-gradient(135deg,var(--primary-dark),var(--primary))">
                        {% if activite.type == 'Sport' %}🏃{% elseif activite.type == 'Culture' %}🎭{% elseif activite.type == 'Gastronomie' %}🍽️{% else %}🌟{% endif %}
                    </div>
                {% else %}
                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:10rem;background:linear-gradient(135deg,var(--primary-dark),var(--primary))">
                        {% if activite.type == 'Sport' %}🏃{% elseif activite.type == 'Culture' %}🎭{% elseif activite.type == 'Gastronomie' %}🍽️{% else %}🌟{% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="col-md-7" data-aos="fade-left">
            <span class="badge mb-3" style="background:linear-gradient(135deg,var(--primary),var(--accent));font-size:0.85rem;padding:6px 14px;border-radius:50px">
                {{ activite.type }}
            </span>
            <h1 class="mb-3" style="font-family:'Playfair Display',serif">{{ activite.nom }}</h1>

            <div class="row g-3 my-3">
                {% for info in [
                    ['bi-geo-alt','Lieu', activite.lieu ?? 'Non précisé'],
                    ['bi-calendar','Date', activite.avecDate == 1 ? activite.dateActivite|date('d/m/Y') : '📅 Vous choisissez votre date'],
                    ['bi-people','Places dispo', activite.placesDisponibles ~ ' / ' ~ activite.nombrePlaces],
                    ['bi-gender-ambiguous','Genre cible', activite.genreCible]
                ] %}
                <div class="col-6" data-aos="zoom-in" data-aos-delay="{{ loop.index * 80 }}">
                    <div class="p-3 rounded-3" style="background:#f9f7ff;border:1px solid #ede5ff">
                        <i class="bi {{ info[0] }} me-2" style="color:var(--primary-light)"></i>
                        <strong style="font-size:0.82rem;color:var(--primary)">{{ info[1] }}</strong>
                        <div class="text-muted small mt-1">{{ info[2] }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <p class="text-muted mt-3">{{ activite.description }}</p>

            <div class="d-flex align-items-center gap-4 mt-4 flex-wrap">
                <span class="price" style="font-size:2.2rem">{{ activite.prix }} TND</span>

                {% if demandeExistante %}
                    {% if demandeExistante.statut == 'EN_ATTENTE' %}
                    <span class="btn btn-lg rounded-pill px-4 btn-warning disabled">
                        <i class="bi bi-hourglass-split me-2"></i>En attente de réponse...
                    </span>
                    {% elseif demandeExistante.statut == 'ACCEPTEE' %}
                    {% if demandeExistante.paiementEffectue == 0 %}
                        <a href="{{ path('app_paiement_activite_initier', {demandeId: demandeExistante.id}) }}"
                           class="btn btn-lg rounded-pill px-4 btn-pulse"
                           style="background:linear-gradient(135deg,#27ae60,#2ecc71);color:#fff">
                            <i class="bi bi-credit-card me-2"></i>Payer {{ activite.prix }} TND
                        </a>
                        {% else %}
                        <span class="btn btn-lg rounded-pill px-4 btn-success disabled">
                            <i class="bi bi-check-circle-fill me-2"></i>Payé ✓
                        </span>
                        {% endif %}
                    {% elseif demandeExistante.statut == 'REFUSEE' %}
                    <span class="btn btn-lg rounded-pill px-4 btn-danger disabled">
                        <i class="bi bi-x-circle me-2"></i>Demande refusée
                    </span>
                    {% endif %}
                {% elseif activite.placesDisponibles > 0 %}

                {# Activité sans date : le client choisit sa date #}
                {% if activite.avecDate == 0 %}
                <form method="POST" action="{{ path('app_activite_inscrire', {id: activite.id}) }}">
                    <div class="mb-3">
                        <label class="fw-semibold d-block mb-1" style="color:var(--primary-dark)">
                            <i class="bi bi-calendar-plus me-1"></i>Choisissez votre date
                        </label>
                        <input type="datetime-local" name="date_souhaitee" id="date_souhaitee" required
                               class="form-control rounded-3"
                               min="{{ 'now'|date('Y-m-d') }}T00:00"
                               style="border-color:#ede5ff;max-width:260px"
                               oninput="fetchMeteo(this.value)">
                        <div class="text-muted small mt-1">La date ne peut pas être dans le passé.</div>

                        {# ── Widget Météo ── #}
                        <div id="meteo-box" style="display:none;margin-top:12px;max-width:340px;border-radius:14px;overflow:hidden;border:1.5px solid #ede5ff;">

                            {# Chargement #}
                            <div id="meteo-loading" style="padding:14px 16px;background:#f9f7ff;text-align:center;color:#aaa;font-size:0.85rem;">
                                <i class="bi bi-arrow-repeat" style="animation:spin 1s linear infinite;margin-right:6px;"></i>Chargement météo…
                            </div>

                            {# Résultat #}
                            <div id="meteo-content" style="display:none;">
                                {# Header coloré #}
                                <div id="meteo-header" style="padding:14px 16px;display:flex;align-items:center;gap:12px;">
                                    <span id="meteo-emoji" style="font-size:2.2rem;line-height:1;"></span>
                                    <div>
                                        <div style="font-weight:700;font-size:1rem;color:#fff;" id="meteo-temp"></div>
                                        <div style="font-size:0.8rem;color:rgba(255,255,255,0.85);" id="meteo-desc"></div>
                                        <div style="font-size:0.75rem;color:rgba(255,255,255,0.7);" id="meteo-city"></div>
                                    </div>
                                </div>
                                {# Détails #}
                                <div style="padding:10px 16px;background:#fff;display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;border-top:1px solid #f0ebff;">
                                    <div style="text-align:center;">
                                        <div style="font-size:0.7rem;color:#aaa;">💧 Humidité</div>
                                        <div id="meteo-humidity" style="font-weight:700;font-size:0.9rem;color:#3498db;"></div>
                                    </div>
                                    <div style="text-align:center;">
                                        <div style="font-size:0.7rem;color:#aaa;">💨 Vent</div>
                                        <div id="meteo-wind" style="font-weight:700;font-size:0.9rem;color:#7f8c8d;"></div>
                                    </div>
                                    <div style="text-align:center;">
                                        <div style="font-size:0.7rem;color:#aaa;">🌡️ Min/Max</div>
                                        <div id="meteo-minmax" style="font-weight:700;font-size:0.9rem;color:#e67e22;"></div>
                                    </div>
                                </div>
                                {# Conseil #}
                                <div id="meteo-conseil" style="padding:10px 16px;background:#f9f7ff;font-size:0.8rem;color:#555;border-top:1px solid #f0ebff;line-height:1.5;"></div>
                            </div>

                            {# Erreur #}
                            <div id="meteo-error" style="display:none;padding:12px 16px;background:#fff5f5;color:#dc3545;font-size:0.82rem;">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                <span id="meteo-error-msg"></span>
                            </div>

                        </div>
                        {# ── Fin Widget Météo ── #}
                    </div>
                    <button type="submit" class="btn btn-lg rounded-pill px-4 btn-pulse"
                            style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                        <i class="bi bi-calendar-check me-2"></i>S'inscrire à cette activité
                    </button>
                </form>
                {% else %}
                <form method="POST" action="{{ path('app_activite_inscrire', {id: activite.id}) }}" class="d-inline">
                    <button type="submit" class="btn btn-lg rounded-pill px-4 btn-pulse"
                            style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                        <i class="bi bi-calendar-check me-2"></i>S'inscrire — {{ activite.dateActivite|date('d/m/Y') }}
                    </button>
                </form>
                {% endif %}

                {% else %}
                <button class="btn btn-lg rounded-pill px-4 btn-secondary" disabled>
                    <i class="bi bi-x-circle me-2"></i>Complet
                </button>
                {% endif %}

                <a href="{{ path('app_mes_activites') }}"
                   class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                    <i class="bi bi-clock-history me-2"></i>Mes activités
                </a>
                <a href="{{ path('app_activites') }}"
                   class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>

                {# Bouton réclamation — visible pour tout utilisateur connecté #}
                {% if app.user %}
                <a href="{{ path('app_reclamation_new') }}?activite_id={{ activite.id }}"
                   class="btn btn-lg rounded-pill px-4"
                   style="background:linear-gradient(135deg,#fff3e0,#ffe0b2);color:#e65100;border:1.5px solid #ffb74d;font-weight:600;transition:all .2s"
                   onmouseover="this.style.background='linear-gradient(135deg,#e65100,#ef6c00)';this.style.color='#fff';this.style.borderColor='transparent'"
                   onmouseout="this.style.background='linear-gradient(135deg,#fff3e0,#ffe0b2)';this.style.color='#e65100';this.style.borderColor='#ffb74d'">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Réclamation
                </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% block javascripts %}
<script>
const WEATHER_URL = '{{ path('app_activite_weather', {id: activite.id}) }}';
let _meteoTimer = null;

function fetchMeteo(datetime) {
    const box     = document.getElementById('meteo-box');
    const loading = document.getElementById('meteo-loading');
    const content = document.getElementById('meteo-content');
    const errBox  = document.getElementById('meteo-error');
    const errMsg  = document.getElementById('meteo-error-msg');

    clearTimeout(_meteoTimer);

    if (!datetime) { box.style.display = 'none'; return; }

    // Afficher le box avec le loader
    box.style.display    = 'block';
    loading.style.display= 'block';
    content.style.display= 'none';
    errBox.style.display = 'none';

    _meteoTimer = setTimeout(() => {
        fetch(WEATHER_URL + '?datetime=' + encodeURIComponent(datetime))
            .then(r => r.json())
            .then(data => {
                loading.style.display = 'none';

                if (data.error) {
                    errMsg.textContent   = data.message || 'Météo indisponible.';
                    errBox.style.display = 'block';
                    return;
                }

                // Header
                const header = document.getElementById('meteo-header');
                header.style.background = data.color || '#7f8c8d';

                document.getElementById('meteo-emoji').textContent = data.emoji;
                document.getElementById('meteo-temp').textContent  = data.temp + '°C — ' + data.description;
                document.getElementById('meteo-desc').textContent  = '📅 ' + data.slot_time;
                document.getElementById('meteo-city').textContent  = '📍 ' + data.city;

                // Détails
                document.getElementById('meteo-humidity').textContent = data.humidity + '%';
                document.getElementById('meteo-wind').textContent     = data.wind + ' km/h';
                document.getElementById('meteo-minmax').textContent   = data.temp_min + '° / ' + data.temp_max + '°';

                // Conseil
                document.getElementById('meteo-conseil').textContent = data.conseil;

                content.style.display = 'block';
            })
            .catch(() => {
                loading.style.display = 'none';
                errMsg.textContent    = 'Impossible de récupérer la météo.';
                errBox.style.display  = 'block';
            });
    }, 600);
}
</script>
{% endblock %}
{% endif %}
{% endblock %}
