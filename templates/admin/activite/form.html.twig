{% extends 'admin/base_admin.html.twig' %}
{% block title %}{{ titre }}{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block stylesheets %}
<style>
    .field-err { color:#dc3545; font-size:0.82rem; margin-top:4px; }
    .field-err::before { content:'⚠ '; }
    .is-invalid { border-color:#dc3545!important; box-shadow:0 0 0 3px rgba(220,53,69,.12)!important; }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="bi bi-{{ activite ? 'pencil' : 'plus-circle' }} me-2"></i>{{ titre }}</h1>
    <a href="{{ path('admin_activites') }}" class="btn btn-sm rounded-pill px-3" style="border:1.5px solid var(--primary);color:var(--primary)">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row justify-content-center">
<div class="col-lg-9">
<div class="form-card">

<form method="POST" enctype="multipart/form-data" id="activiteForm"
      action="{{ activite ? path('admin_activite_edit', {id: activite.id}) : path('admin_activite_new') }}">

    <div class="row g-4">

        {# NOM #}
        <div class="col-12">
            <label class="form-label fw-semibold" style="color:var(--primary-dark)">Nom de l'activité</label>
            <input type="text" name="nom" class="form-control {{ errors.nom is defined ? 'is-invalid' : '' }}"
                   value="{{ old.nom ?? activite.nom ?? '' }}"
                   placeholder="Ex: Randonnée au Djebel Zaghouan">
            {% if errors.nom is defined %}<div class="field-err">{{ errors.nom }}</div>{% endif %}
        </div>

        {# TYPE #}
        <div class="col-md-6">
            <label class="form-label fw-semibold" style="color:var(--primary-dark)">Type d'activité</label>
            <select name="type" id="sel_type" class="form-select {{ errors.type is defined ? 'is-invalid' : '' }}">
                <option value="">-- Choisir un type --</option>
                {% for t in ['Sport','Culture','Gastronomie','Aventure','Bien-être','Autre'] %}
                <option value="{{ t }}" {{ (old.type ?? activite.type ?? '') == t ? 'selected' : '' }}>{{ t }}</option>
                {% endfor %}
            </select>
            {% if errors.type is defined %}<div class="field-err">{{ errors.type }}</div>{% endif %}
            <div id="autre-box" style="display:none;margin-top:8px">
                <input type="text" name="typeAutre" id="autre-input" class="form-control"
                       placeholder="Précisez le type (ex: Yoga, Peinture...)"
                       value="{{ old.typeAutre ?? '' }}">
                <div id="autre-err" style="display:none;color:#dc3545;font-size:0.82rem;margin-top:4px">⚠ Veuillez préciser le type.</div>
            </div>
        </div>

        {# GENRE #}
        <div class="col-md-6">
            <label class="form-label fw-semibold" style="color:var(--primary-dark)">Genre cible</label>
            <select name="genreCible" class="form-select {{ errors.genreCible is defined ? 'is-invalid' : '' }}">
                <option value="">-- Choisir --</option>
                {% for label,val in {'Mixte':'MIXTE','Masculin':'MASCULIN','Féminin':'FEMININ'} %}
                <option value="{{ val }}" {{ (old.genreCible ?? activite.genreCible ?? '') == val ? 'selected' : '' }}>{{ label }}</option>
                {% endfor %}
            </select>
            {% if errors.genreCible is defined %}<div class="field-err">{{ errors.genreCible }}</div>{% endif %}
        </div>

        {# LIEU #}
        <div class="col-md-6">
            <label class="form-label fw-semibold" style="color:var(--primary-dark)">Gouvernorat</label>
            <select name="lieu" class="form-select {{ errors.lieu is defined ? 'is-invalid' : '' }}">
                <option value="">-- Choisir un gouvernorat --</option>
                {% for g in ['Ariana','Béja','Ben Arous','Bizerte','Gabès','Gafsa','Jendouba','Kairouan','Kasserine','Kébili','Le Kef','Mahdia','La Manouba','Médenine','Monastir','Nabeul','Sfax','Sidi Bouzid','Siliana','Sousse','Tataouine','Tozeur','Tunis','Zaghouan'] %}
                <option value="{{ g }}" {{ (old.lieu ?? activite.lieu ?? '') == g ? 'selected' : '' }}>{{ g }}</option>
                {% endfor %}
            </select>
            {% if errors.lieu is defined %}<div class="field-err">{{ errors.lieu }}</div>{% endif %}
        </div>

        {# PRIX #}
        <div class="col-md-3">
            <label class="form-label fw-semibold" style="color:var(--primary-dark)">Prix (TND)</label>
            <div class="input-group">
                <input type="number" name="prix" step="0.01" min="0.01"
                       class="form-control {{ errors.prix is defined ? 'is-invalid' : '' }}"
                       value="{{ old.prix ?? activite.prix ?? '' }}" placeholder="0.00">
                <span class="input-group-text" style="border-color:#ddd;background:#f9f7ff;color:var(--primary)">TND</span>
            </div>
            {% if errors.prix is defined %}<div class="field-err">{{ errors.prix }}</div>{% endif %}
        </div>

        {# PLACES #}
        <div class="col-md-3">
            <label class="form-label fw-semibold" style="color:var(--primary-dark)">Nombre de places</label>
            <input type="number" name="nombrePlaces" min="1"
                   class="form-control {{ errors.nombrePlaces is defined ? 'is-invalid' : '' }}"
                   value="{{ old.nombrePlaces ?? activite.nombrePlaces ?? '' }}" placeholder="Ex: 20">
            {% if errors.nombrePlaces is defined %}<div class="field-err">{{ errors.nombrePlaces }}</div>{% endif %}
        </div>

        {# DATE SELECT #}
        <div class="col-md-6">
            <label class="form-label fw-semibold" style="color:var(--primary-dark)">
                <i class="bi bi-calendar3 me-1"></i>Date de l'activité
            </label>
            <select id="date-select" class="form-select" style="border-color:#ddd;border-radius:10px">
                <option value="0">📅 Le client choisit sa date lors de la réservation</option>
                <option value="1" {{ (activite and activite.avecDate) ? 'selected' : '' }}>📌 Fixer une date maintenant</option>
            </select>
            <input type="hidden" name="avecDate" id="avecDateHidden" value="{{ (activite and activite.avecDate) ? '1' : '0' }}">
        </div>

        {# CALENDRIER #}
        <div class="col-md-6" id="date-field" style="{{ (activite and activite.avecDate) ? '' : 'display:none' }}">
            <label class="form-label fw-semibold" style="color:var(--primary-dark)">
                <i class="bi bi-calendar-event me-1"></i>Choisir la date
            </label>
            <input type="datetime-local" name="dateActivite" id="f_date_picker"
                   class="form-control {{ errors.dateActivite is defined ? 'is-invalid' : '' }}"
                   min="{{ 'now'|date('Y-m-d') }}T00:00"
                   value="{{ (activite and activite.dateActivite and activite.avecDate) ? activite.dateActivite|date('Y-m-d\\TH:i') : '' }}">
            <div class="text-muted small mt-1"><i class="bi bi-info-circle me-1"></i>La date doit être dans le futur.</div>
            {% if errors.dateActivite is defined %}<div class="field-err">{{ errors.dateActivite }}</div>{% endif %}
        </div>

        {# IMAGE #}
        <div class="col-12">
            <div class="p-3 rounded-3" style="background:#f9f7ff;border:1px solid #ede5ff">
                <div class="fw-semibold mb-3" style="color:var(--primary-dark)">
                    <i class="bi bi-image me-2"></i>Image de l'activité
                </div>
                {% if activite and activite.images %}
                <div class="mb-3 d-flex align-items-center gap-3">
                    <img src="{{ activite.imageUrl }}" alt="image actuelle"
                         style="height:80px;border-radius:8px;object-fit:cover;border:2px solid #ede5ff"
                         onerror="this.style.display='none'">
                    <span class="text-muted small">Image actuelle</span>
                </div>
                {% endif %}

                {# Input file caché — déclenché par le label #}
                <input type="file" name="imageFile" id="imageFileInput" accept="image/*"
                       style="visibility:hidden;position:absolute;width:1px;height:1px">

                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <label for="imageFileInput"
                           class="btn rounded-pill px-4 mb-0"
                           style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;font-size:0.88rem;cursor:pointer">
                        <i class="bi bi-folder2-open me-2"></i>Choisir une image
                    </label>
                    <span id="file-name" class="text-muted small">Aucun fichier sélectionné</span>
                    <button type="button" id="btn-clear-img"
                            class="btn btn-sm rounded-pill px-3"
                            style="background:#fde8e8;color:#c0392b;font-size:0.8rem;display:none"
                            onclick="clearImage()">
                        <i class="bi bi-x me-1"></i>Supprimer
                    </button>
                </div>
                <div id="preview-container" class="mt-3" style="display:none">
                    <img id="preview-img" src="" alt="aperçu"
                         style="max-height:160px;border-radius:10px;object-fit:cover;border:2px solid #ede5ff">
                </div>
                <div class="text-muted small mt-2">Formats acceptés : JPG, PNG, WEBP, GIF, BMP — max 10 Mo</div>
            </div>
        </div>

        {# DESCRIPTION #}
        <div class="col-12">
            <label class="form-label fw-semibold" style="color:var(--primary-dark)">Description</label>
            <textarea name="description" rows="4"
                      class="form-control {{ errors.description is defined ? 'is-invalid' : '' }}"
                      placeholder="Décrivez l'activité...">{{ old.description ?? activite.description ?? '' }}</textarea>
            {% if errors.description is defined %}<div class="field-err">{{ errors.description }}</div>{% endif %}
        </div>

    </div>{# end row #}

    <div class="d-flex gap-3 mt-4">
        <button type="submit" class="btn btn-primary-admin px-4">
            <i class="bi bi-check-lg me-2"></i>{{ activite ? 'Enregistrer' : 'Créer l\'activité' }}
        </button>
        <a href="{{ path('admin_activites') }}" class="btn btn-sm rounded-pill px-4" style="border:1.5px solid #ddd;color:#666">Annuler</a>
    </div>

</form>
</div></div></div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// ── Type Autre ──
const selType  = document.getElementById('sel_type');
const autreBox = document.getElementById('autre-box');
const autreInp = document.getElementById('autre-input');
const autreErr = document.getElementById('autre-err');

function toggleAutre() {
    autreBox.style.display = selType.value === 'Autre' ? 'block' : 'none';
}
if (selType) { selType.addEventListener('change', toggleAutre); toggleAutre(); }

document.getElementById('activiteForm').addEventListener('submit', function(e) {
    if (selType && selType.value === 'Autre') {
        const val = autreInp ? autreInp.value.trim() : '';
        if (!val) {
            e.preventDefault();
            autreErr.style.display = 'block';
            autreInp.focus();
            return;
        }
        // Remplacer la valeur du select par le texte saisi
        selType.innerHTML += '<option value="'+val+'" selected>'+val+'</option>';
        selType.value = val;
    }
});

// ── Date select ──
const dateSelect     = document.getElementById('date-select');
const dateField      = document.getElementById('date-field');
const avecDateHidden = document.getElementById('avecDateHidden');

function toggleDate() {
    const fixe = dateSelect.value === '1';
    dateField.style.display = fixe ? 'block' : 'none';
    avecDateHidden.value = fixe ? '1' : '0';
}
if (dateSelect) { dateSelect.addEventListener('change', toggleDate); toggleDate(); }

// ── Image ──
const fileInput = document.getElementById('imageFileInput');
if (fileInput) {
    fileInput.addEventListener('change', function() {
        const file = this.files[0];
        if (!file) return;
        document.getElementById('file-name').textContent = file.name + ' (' + (file.size/1024).toFixed(0) + ' Ko)';
        document.getElementById('btn-clear-img').style.display = 'inline-block';
        const reader = new FileReader();
        reader.onload = e => {
            document.getElementById('preview-img').src = e.target.result;
            document.getElementById('preview-container').style.display = 'block';
        };
        reader.readAsDataURL(file);
    });
}
function clearImage() {
    fileInput.value = '';
    document.getElementById('file-name').textContent = 'Aucun fichier sélectionné';
    document.getElementById('btn-clear-img').style.display = 'none';
    document.getElementById('preview-container').style.display = 'none';
}
</script>
{% endblock %}
