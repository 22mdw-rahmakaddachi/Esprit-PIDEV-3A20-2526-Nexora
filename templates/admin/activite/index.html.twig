{% extends 'admin/base_admin.html.twig' %}
{% block title %}Mes activités{% endblock %}
{% block page_title %}Mes activités{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="bi bi-calendar-event me-2"></i>Mes activités</h1>
    <a href="{{ path('admin_activite_new') }}" class="btn btn-primary-admin">
        <i class="bi bi-plus-lg me-2"></i>Nouvelle activité
    </a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Type</th>
                <th>Lieu</th>
                <th>Date</th>
                <th>Prix</th>
                <th>Places</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for a in activites %}
            <tr>
                <td class="text-muted small">{{ a.id }}</td>
                <td class="fw-semibold">{{ a.nom }}</td>
                <td><span class="badge" style="background:#f0ebff;color:var(--primary)">{{ a.type }}</span></td>
                <td><i class="bi bi-geo-alt me-1 text-muted"></i>{{ a.lieu }}</td>
                <td class="small">{{ a.date_activite|date('d/m/Y') }}</td>
                <td class="fw-semibold" style="color:var(--primary)">{{ a.prix }} TND</td>
                <td>
                    <div class="d-flex align-items-center gap-1">
                        <span class="fw-semibold">{{ a.places_disponibles }}</span>
                        <span class="text-muted small">/{{ a.nombre_places }}</span>
                        {% if a.places_disponibles == 0 %}
                        <span class="ms-1 status-badge badge-complet" style="font-size:0.68rem">Complet</span>
                        {% endif %}
                    </div>
                </td>
                <td>
                    {% if a.places_disponibles == 0 %}
                    <span class="status-badge badge-complet">Complet</span>
                    {% elseif a.date_activite < date() %}
                    <span class="status-badge badge-passe">Passée</span>
                    {% else %}
                    <span class="status-badge badge-actif">Active</span>
                    {% endif %}
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <a href="{{ path('admin_activite_show', {id: a.id}) }}" class="btn btn-edit-admin" title="Voir demandes">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('admin_activite_edit', {id: a.id}) }}" class="btn btn-edit-admin" title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="POST" action="{{ path('admin_activite_delete', {id: a.id}) }}" class="d-inline"
                              onsubmit="return confirm('Supprimer cette activité ?')">
                            <button type="submit" class="btn btn-danger-admin" title="Supprimer">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="9" class="text-center py-5 text-muted">
                    <div style="font-size:3rem">📅</div>
                    <p class="mt-2">Aucune activité. <a href="{{ path('admin_activite_new') }}">Créer la première</a></p>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
