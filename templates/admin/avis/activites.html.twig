{% extends 'admin/base_admin.html.twig' %}
{% block title %}Avis & Commentaires{% endblock %}
{% block page_title %}Avis & Commentaires{% endblock %}

{% block body %}

{# ── HEADER ── #}
<div class="page-header mb-4">
    <h1><i class="bi bi-chat-square-text-fill me-2"></i>Avis & Commentaires</h1>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <span class="badge rounded-pill px-3 py-2" style="background:#f0ebff;color:var(--primary);font-size:0.85rem">
            <i class="bi bi-chat-dots me-1"></i>{{ total }} avis au total
        </span>
        {% if moyenne > 0 %}
        <span class="badge rounded-pill px-3 py-2" style="background:#fff3cd;color:#856404;font-size:0.85rem">
            ⭐ Moyenne globale : {{ moyenne }}/5
        </span>
        {% endif %}
    </div>
</div>

{# ── BARRE RECHERCHE + FILTRES ── #}
<div class="admin-table p-3 mb-4">
    <form method="GET" action="{{ path('admin_avis_activites') }}" id="filter-form">
        <div class="row g-2 align-items-end">

            {# Recherche texte #}
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1" style="color:var(--primary-dark)">
                    <i class="bi bi-search me-1"></i>Recherche
                </label>
                <div class="position-relative">
                    <input type="text" name="search" id="search-input" value="{{ search }}"
                           class="form-control form-control-sm ps-4"
                           placeholder="Titre ou commentaire…"
                           autocomplete="off">
                    <i class="bi bi-search position-absolute" style="left:10px;top:50%;transform:translateY(-50%);color:#aaa;font-size:0.8rem;pointer-events:none"></i>
                    {% if search %}
                    <button type="button" onclick="clearSearch()" class="position-absolute btn btn-sm p-0"
                            style="right:8px;top:50%;transform:translateY(-50%);color:#aaa;background:none;border:none">
                        <i class="bi bi-x-circle"></i>
                    </button>
                    {% endif %}
                </div>
            </div>

            {# Filtre par note #}
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1" style="color:var(--primary-dark)">
                    <i class="bi bi-star me-1"></i>Filtrer par note
                </label>
                <select name="note" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Toutes les notes</option>
                    {% for i in 5..1 %}
                    <option value="{{ i }}" {{ note == i ? 'selected' : '' }}>
                        {% for s in 1..i %}⭐{% endfor %} {{ i }}/5
                        {% if i == 5 %} — Excellent
                        {% elseif i == 4 %} — Bien
                        {% elseif i == 3 %} — Moyen
                        {% elseif i == 2 %} — Mauvais
                        {% else %} — Très mauvais{% endif %}
                    </option>
                    {% endfor %}
                </select>
            </div>

            {# Tri #}
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1" style="color:var(--primary-dark)">
                    <i class="bi bi-sort-down me-1"></i>Trier par
                </label>
                <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="date_desc" {{ sort == 'date_desc' ? 'selected' : '' }}>Date (récent → ancien)</option>
                    <option value="date_asc"  {{ sort == 'date_asc'  ? 'selected' : '' }}>Date (ancien → récent)</option>
                    <option value="note_desc" {{ sort == 'note_desc' ? 'selected' : '' }}>Note (meilleure → pire)</option>
                    <option value="note_asc"  {{ sort == 'note_asc'  ? 'selected' : '' }}>Note (pire → meilleure)</option>
                </select>
            </div>

            {# Boutons #}
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary-admin btn-sm flex-fill">
                    <i class="bi bi-funnel me-1"></i>Filtrer
                </button>
                <a href="{{ path('admin_avis_activites') }}" class="btn btn-sm flex-fill"
                   style="background:#f0ebff;color:var(--primary);border:none" title="Réinitialiser">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>

        </div>
    </form>
</div>

{# ── RÉSULTATS ── #}
{% if avisList is empty %}
<div class="text-center py-5 text-muted">
    <i class="bi bi-chat-square-text" style="font-size:3rem;opacity:0.3"></i>
    <p class="mt-3 mb-1">Aucun avis trouvé.</p>
    {% if search or note %}
    <a href="{{ path('admin_avis_activites') }}" class="btn btn-sm rounded-pill px-3 mt-2"
       style="border:1.5px solid var(--primary);color:var(--primary)">
        <i class="bi bi-arrow-counterclockwise me-1"></i>Voir tous les avis
    </a>
    {% endif %}
</div>
{% else %}

{# Compteur résultats #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">
        <strong style="color:var(--primary)">{{ avisList|length }}</strong> avis affichés
        {% if search %} pour "<strong>{{ search }}</strong>"{% endif %}
        {% if note %} — note {{ note }}/5{% endif %}
    </span>
</div>

{# ── CARDS GRID ── #}
<div class="row g-3" id="avis-grid">
    {% for avis in avisList %}
    <div class="col-md-6 col-xl-4 avis-item" data-titre="{{ avis.titre|lower }}" data-contenu="{{ avis.contenu|lower }}">
        <div class="h-100 rounded-4 p-4 d-flex flex-column"
             style="background:var(--card-bg,#fff);border:1px solid var(--border,#ede5ff);box-shadow:0 2px 16px rgba(108,63,197,0.07);transition:transform .2s,box-shadow .2s"
             onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 28px rgba(108,63,197,0.14)'"
             onmouseleave="this.style.transform='';this.style.boxShadow='0 2px 16px rgba(108,63,197,0.07)'">

            {# Header : note + date #}
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    {% for i in 1..5 %}
                        <i class="bi bi-star{{ i <= avis.rating ? '-fill' : '' }}"
                           style="color:{{ i <= avis.rating ? '#f39c12' : '#ddd' }};font-size:1rem"></i>
                    {% endfor %}
                    <span class="ms-1 small fw-bold" style="color:var(--primary)">{{ avis.rating }}/5</span>
                </div>
                <span class="badge rounded-pill px-2 py-1"
                      style="font-size:0.72rem;
                      {% if avis.rating >= 4 %}background:#d1f2eb;color:#1a7a4a
                      {% elseif avis.rating == 3 %}background:#fff3cd;color:#856404
                      {% else %}background:#fde8e8;color:#c0392b{% endif %}">
                    {% if avis.rating >= 4 %}Positif
                    {% elseif avis.rating == 3 %}Neutre
                    {% else %}Négatif{% endif %}
                </span>
            </div>

            {# Titre #}
            <div class="fw-bold mb-2" style="color:var(--primary-dark);font-size:0.95rem">
                {{ avis.titre }}
            </div>

            {# Activité concernée #}
            {% if avis.activiteId and activitesMap[avis.activiteId] is defined %}
            <div class="mb-2">
                <span style="background:#f0ebff;color:var(--primary);border-radius:50px;padding:2px 10px;font-size:0.75rem;font-weight:600;">
                    <i class="bi bi-calendar-event me-1"></i>{{ activitesMap[avis.activiteId] }}
                </span>
            </div>
            {% endif %}

            {# Contenu #}
            <p class="text-muted mb-3 flex-grow-1" style="font-size:0.88rem;line-height:1.7;font-style:italic">
                "{{ avis.contenu|length > 120 ? avis.contenu|slice(0,120) ~ '…' : avis.contenu }}"
            </p>

            {# Footer #}
            <div class="d-flex justify-content-between align-items-center pt-3"
                 style="border-top:1px solid var(--border,#ede5ff)">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;font-weight:700;font-size:0.78rem;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        U
                    </div>
                    <div>
                        <div class="small fw-semibold" style="color:var(--primary-dark)">
                            Utilisateur #{{ avis.userId }}
                        </div>
                        <div class="text-muted" style="font-size:0.72rem">
                            <i class="bi bi-clock me-1"></i>{{ avis.createdAt ? avis.createdAt|date('d/m/Y à H:i') : '—' }}
                        </div>
                    </div>
                </div>
                <form method="POST" action="{{ path('admin_avis_delete', {id: avis.id}) }}"
                      onsubmit="return confirm('Supprimer cet avis ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ avis.id) }}">
                    <button type="submit" class="btn btn-sm"
                            style="background:#fde8e8;color:#c0392b;border:none;border-radius:8px;padding:5px 10px"
                            title="Supprimer">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </div>

            {# ── Réponse existante ── #}
            {% if reponses[avis.id] is defined %}
            {% set rep = reponses[avis.id] %}
            <div id="reponse-affichee-{{ avis.id }}"
                 style="margin-top:10px;padding:10px 14px;background:linear-gradient(135deg,#f3eeff,#faf8ff);border-left:3px solid var(--primary);border-radius:10px;">
                <div style="font-size:0.72rem;font-weight:700;color:var(--primary);margin-bottom:4px;">
                    🏢 Réponse publiée
                    <span style="font-weight:400;color:#aaa;margin-left:6px;">{{ rep.created_at|date('d/m/Y') }}</span>
                </div>
                <p style="font-size:0.82rem;color:#444;margin:0;line-height:1.5;" id="reponse-texte-{{ avis.id }}">{{ rep.contenu }}</p>
                <div class="d-flex gap-2 mt-2">
                    <button onclick="modifierReponse({{ avis.id }})" class="btn btn-sm rounded-pill"
                            style="background:#f0ebff;color:var(--primary);border:1px solid #d4c5f9;font-size:0.72rem;">
                        <i class="bi bi-pencil me-1"></i>Modifier
                    </button>
                    <button onclick="supprimerReponse({{ avis.id }})" class="btn btn-sm rounded-pill"
                            style="background:#fde8e8;color:#c0392b;border:none;font-size:0.72rem;">
                        <i class="bi bi-trash me-1"></i>Supprimer
                    </button>
                </div>
            </div>
            {% else %}
            <div id="reponse-affichee-{{ avis.id }}" style="display:none;"></div>
            {% endif %}

            {# ── Boutons action ── #}
            <div class="d-flex gap-2 flex-wrap mt-2" id="actions-{{ avis.id }}">
                {% if reponses[avis.id] is not defined %}
                <button onclick="ouvrirFormulaire({{ avis.id }})" id="btn-repondre-{{ avis.id }}"
                        class="btn btn-sm rounded-pill"
                        style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;font-size:0.75rem;font-weight:600;">
                    <i class="bi bi-reply me-1"></i>Répondre
                </button>
                {% endif %}
                <button onclick="suggererReponseIA({{ avis.id }}, this)" id="btn-ia-{{ avis.id }}"
                        class="btn btn-sm rounded-pill"
                        style="background:linear-gradient(135deg,#f3eeff,#ede5ff);color:var(--primary);border:1px solid #d4c5f9;font-size:0.75rem;font-weight:600;">
                    <i class="bi bi-magic me-1"></i>💡 Suggestion IA
                </button>
            </div>

            {# ── Suggestion IA ── #}
            <div id="ia-box-{{ avis.id }}" style="display:none;margin-top:10px;">
                <div id="ia-loading-{{ avis.id }}" style="padding:8px;color:#aaa;font-size:0.78rem;display:none;">
                    <i class="bi bi-arrow-repeat" style="animation:spin 1s linear infinite;margin-right:4px;"></i>Génération en cours…
                </div>
                <div id="ia-result-{{ avis.id }}" style="display:none;background:#f9f7ff;border:1.5px solid #ede5ff;border-radius:10px;padding:12px;">
                    <div style="font-size:0.72rem;font-weight:700;color:var(--primary);margin-bottom:6px;">💡 Réponse suggérée :</div>
                    <p id="ia-text-{{ avis.id }}" style="font-size:0.82rem;color:#444;line-height:1.5;margin:0;font-style:italic;"></p>
                    <div class="d-flex gap-2 mt-2">
                        <button onclick="utiliserSuggestion({{ avis.id }})" class="btn btn-sm rounded-pill"
                                style="background:linear-gradient(135deg,#28a745,#2ecc71);color:#fff;border:none;font-size:0.72rem;font-weight:600;">
                            <i class="bi bi-check-circle me-1"></i>Utiliser
                        </button>
                        <button onclick="ignorerSuggestion({{ avis.id }})" class="btn btn-sm rounded-pill"
                                style="background:#f8f9fa;color:#888;border:1px solid #ddd;font-size:0.72rem;">
                            <i class="bi bi-x me-1"></i>Ignorer
                        </button>
                    </div>
                </div>
            </div>

            {# ── Formulaire de réponse ── #}
            <div id="form-{{ avis.id }}" style="display:none;margin-top:10px;">
                <textarea id="textarea-{{ avis.id }}" class="form-control" rows="3" maxlength="1000"
                          placeholder="Rédigez votre réponse…"
                          style="font-size:0.82rem;border-color:#ede5ff;border-radius:10px;resize:vertical;"
                          oninput="updateCount({{ avis.id }}, this.value.length)"></textarea>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <span id="count-{{ avis.id }}" style="font-size:0.7rem;color:#aaa;">0 / 1000</span>
                    <span id="err-{{ avis.id }}" style="font-size:0.72rem;color:#dc3545;display:none;"></span>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button onclick="envoyerReponse({{ avis.id }})" class="btn btn-sm rounded-pill"
                            style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;font-size:0.75rem;font-weight:600;">
                        <i class="bi bi-send me-1"></i>Publier
                    </button>
                    <button onclick="annulerFormulaire({{ avis.id }})" class="btn btn-sm rounded-pill"
                            style="background:#f8f9fa;color:#888;border:1px solid #ddd;font-size:0.75rem;">
                        Annuler
                    </button>
                </div>
            </div>

        </div>
    </div>
    {% endfor %}
</div>

{% endif %}

{% endblock %}

{% block javascripts %}
{{ parent() }}
<style>
@keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
</style>
<script>
// ── Formulaire de réponse ────────────────────────────────────────────────────
function ouvrirFormulaire(id) {
    document.getElementById('form-' + id).style.display = 'block';
    const btn = document.getElementById('btn-repondre-' + id);
    if (btn) btn.style.display = 'none';
    document.getElementById('textarea-' + id).focus();
}

function annulerFormulaire(id) {
    document.getElementById('form-' + id).style.display = 'none';
    const btn = document.getElementById('btn-repondre-' + id);
    if (btn) btn.style.display = 'inline-flex';
}

function updateCount(id, len) {
    document.getElementById('count-' + id).textContent = len + ' / 1000';
}

function modifierReponse(id) {
    const texteEl = document.getElementById('reponse-texte-' + id);
    const texte   = texteEl ? texteEl.textContent.trim() : '';
    document.getElementById('textarea-' + id).value = texte;
    updateCount(id, texte.length);
    document.getElementById('reponse-affichee-' + id).style.display = 'none';
    document.getElementById('form-' + id).style.display = 'block';
}

function envoyerReponse(id) {
    const contenu = document.getElementById('textarea-' + id).value.trim();
    const errEl   = document.getElementById('err-' + id);
    if (contenu.length < 5) {
        errEl.textContent = 'Minimum 5 caractères.';
        errEl.style.display = 'inline';
        return;
    }
    errEl.style.display = 'none';

    const fd = new FormData();
    fd.append('contenu', contenu);

    fetch('/avis/' + id + '/repondre', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            if (data.error) {
                errEl.textContent = data.error;
                errEl.style.display = 'inline';
                return;
            }
            const repBox = document.getElementById('reponse-affichee-' + id);
            repBox.innerHTML = `
                <div style="margin-top:10px;padding:10px 14px;background:linear-gradient(135deg,#f3eeff,#faf8ff);border-left:3px solid var(--primary);border-radius:10px;">
                    <div style="font-size:0.72rem;font-weight:700;color:var(--primary);margin-bottom:4px;">
                        🏢 Réponse publiée <span style="font-weight:400;color:#aaa;margin-left:6px;">${data.created_at}</span>
                    </div>
                    <p style="font-size:0.82rem;color:#444;margin:0;line-height:1.5;" id="reponse-texte-${id}">${data.contenu}</p>
                    <div class="d-flex gap-2 mt-2">
                        <button onclick="modifierReponse(${id})" class="btn btn-sm rounded-pill" style="background:#f0ebff;color:var(--primary);border:1px solid #d4c5f9;font-size:0.72rem;"><i class="bi bi-pencil me-1"></i>Modifier</button>
                        <button onclick="supprimerReponse(${id})" class="btn btn-sm rounded-pill" style="background:#fde8e8;color:#c0392b;border:none;font-size:0.72rem;"><i class="bi bi-trash me-1"></i>Supprimer</button>
                    </div>
                </div>`;
            repBox.style.display = 'block';
            document.getElementById('form-' + id).style.display = 'none';
            const btn = document.getElementById('btn-repondre-' + id);
            if (btn) btn.style.display = 'none';
        })
        .catch(() => { errEl.textContent = 'Erreur.'; errEl.style.display = 'inline'; });
}

function supprimerReponse(id) {
    if (!confirm('Supprimer cette réponse ?')) return;
    fetch('/avis/' + id + '/reponse/supprimer', { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById('reponse-affichee-' + id).innerHTML = '';
                document.getElementById('reponse-affichee-' + id).style.display = 'none';
                const actions = document.getElementById('actions-' + id);
                if (!document.getElementById('btn-repondre-' + id)) {
                    const btn = document.createElement('button');
                    btn.id = 'btn-repondre-' + id;
                    btn.innerHTML = '<i class="bi bi-reply me-1"></i>Répondre';
                    btn.className = 'btn btn-sm rounded-pill';
                    btn.style.cssText = 'background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;font-size:0.75rem;font-weight:600;';
                    btn.onclick = () => ouvrirFormulaire(id);
                    actions.prepend(btn);
                } else {
                    document.getElementById('btn-repondre-' + id).style.display = 'inline-flex';
                }
            }
        });
}

// ── Suggestion IA ────────────────────────────────────────────────────────────
function suggererReponseIA(id, btn) {
    const box     = document.getElementById('ia-box-' + id);
    const loading = document.getElementById('ia-loading-' + id);
    const result  = document.getElementById('ia-result-' + id);
    box.style.display     = 'block';
    loading.style.display = 'block';
    result.style.display  = 'none';
    btn.disabled          = true;

    const fd = new FormData();
    fetch('/avis/' + id + '/suggerer-reponse', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            loading.style.display = 'none';
            if (data.error) { box.innerHTML = '<div style="color:#dc3545;font-size:0.78rem;padding:6px;">❌ ' + data.error + '</div>'; return; }
            document.getElementById('ia-text-' + id).textContent = data.reponse;
            result.style.display = 'block';
            btn.disabled = false;
        })
        .catch(() => { loading.style.display = 'none'; btn.disabled = false; });
}

function utiliserSuggestion(id) {
    const texte = document.getElementById('ia-text-' + id).textContent;
    document.getElementById('textarea-' + id).value = texte;
    updateCount(id, texte.length);
    document.getElementById('ia-box-' + id).style.display = 'none';
    ouvrirFormulaire(id);
}

function ignorerSuggestion(id) {
    document.getElementById('ia-box-' + id).style.display = 'none';
}

// Recherche dynamique côté client
const searchInput = document.getElementById('search-input');
if (searchInput) {
    searchInput.addEventListener('input', function() {
        const q = this.value.toLowerCase().trim();
        document.querySelectorAll('.avis-item').forEach(card => {
            const titre   = card.dataset.titre   || '';
            const contenu = card.dataset.contenu || '';
            card.style.display = (!q || titre.includes(q) || contenu.includes(q)) ? '' : 'none';
        });
        const visible = document.querySelectorAll('.avis-item:not([style*="none"])').length;
        const counter = document.querySelector('#avis-grid')?.previousElementSibling?.querySelector('strong');
        if (counter) counter.textContent = visible;
    });
}

function clearSearch() {
    if (searchInput) { searchInput.value = ''; searchInput.dispatchEvent(new Event('input')); }
}
</script>
{% endblock %}
