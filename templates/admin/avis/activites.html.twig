{% extends 'admin/base_admin.html.twig' %}
{% block title %}Avis & Commentaires{% endblock %}
{% block page_title %}Avis & Commentaires{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="bi bi-chat-square-text-fill me-2"></i>Avis & Commentaires</h1>
</div>

<p class="text-muted mb-4" style="font-size:0.9rem">
    Sélectionnez une activité pour gérer ses avis et commentaires.
</p>

<div class="row g-4">
    {% for a in activites %}
    <div class="col-md-4">
        <div class="stat-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stat-icon" style="background:#f0ebff;color:var(--primary)">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold" style="color:var(--primary-dark)">{{ a.nom }}</div>
                        <div class="d-flex gap-2 mt-1">
                            <span class="badge" style="background:#f0ebff;color:var(--primary);font-size:0.72rem">{{ a.type }}</span>
                            {% if a.lieu is defined and a.lieu %}
                            <span class="badge" style="background:#e8f5e9;color:#2e7d32;font-size:0.72rem">
                                <i class="bi bi-geo-alt me-1"></i>{{ a.lieu }}
                            </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            <a href="{{ path('admin_avis_list', {activiteId: a.id}) }}"
               class="btn btn-primary-admin w-100 mt-3">
                <i class="bi bi-chat-dots me-2"></i>Gérer les avis
            </a>
        </div>
    </div>
    {% else %}
    <div class="col-12 text-center py-5 text-muted">
        <i class="bi bi-calendar-x" style="font-size:3rem;opacity:0.4"></i>
        <p class="mt-3">Aucune activité disponible.</p>
        <a href="{{ path('admin_activite_new') }}" class="btn btn-primary-admin mt-2">
            <i class="bi bi-plus-lg me-2"></i>Créer une activité
        </a>
    </div>
    {% endfor %}
</div>
{% endblock %}
