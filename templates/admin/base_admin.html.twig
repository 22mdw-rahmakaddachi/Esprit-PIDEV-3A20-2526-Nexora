<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Dashboard{% endblock %} — TripShop Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script>
        (function(){
            var t = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
            document.documentElement.style.colorScheme = t;
        })();
    </script>
    <style>
        :root {
            --primary:      #6c3fc5;
            --primary-dark: #4e2d9a;
            --primary-light:#a78bda;
            --accent:       #9b59b6;
            --sidebar-w:    260px;
            --topbar-h:     64px;
            --bg:           #f4f1fb;
            /* tokens */
            --text:         #333333;
            --text-muted:   #888888;
            --border:       #ede5ff;
            --card-bg:      #ffffff;
            --nav-bg:       #ffffff;
            --input-bg:     #ffffff;
            --sidebar-bg:   linear-gradient(180deg, var(--primary-dark) 0%, var(--primary) 100%);
        }

        [data-theme="dark"] {
            --bg:           #0f0e17;
            --card-bg:      #1a1825;
            --nav-bg:       #13111e;
            --input-bg:     #221f33;
            --text:         #e8e0ff;
            --text-muted:   #9b8ec4;
            --border:       #2e2850;
            --sidebar-bg:   linear-gradient(180deg, #0d0b18 0%, #1a1530 100%);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); transition: background 0.3s, color 0.3s; }

        /* ── SIDEBAR ── */
        .sidebar {
            position: fixed; top: 0; left: 0;
            width: var(--sidebar-w); height: 100vh;
            background: var(--sidebar-bg);
            display: flex; flex-direction: column;
            z-index: 1000; overflow-y: auto;
            transition: transform 0.3s;
        }
        .sidebar-brand {
            padding: 22px 24px 18px;
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem; font-weight: 700;
            color: #fff; border-bottom: 1px solid rgba(255,255,255,0.12);
            text-decoration: none; display: block;
        }
        .sidebar-brand span { color: #c39bd3; }
        .sidebar-section {
            font-size: 0.68rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 1.5px;
            color: rgba(255,255,255,0.4);
            padding: 20px 24px 8px;
        }
        .sidebar-link {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 24px;
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            font-size: 0.9rem; font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }
        .sidebar-link i { font-size: 1.05rem; width: 20px; text-align: center; }
        .sidebar-link:hover {
            color: #fff;
            background: rgba(255,255,255,0.08);
            border-left-color: rgba(255,255,255,0.4);
        }
        .sidebar-link.active {
            color: #fff;
            background: rgba(255,255,255,0.15);
            border-left-color: #fff;
            font-weight: 600;
        }
        .sidebar-badge {
            margin-left: auto;
            background: #e74c3c;
            color: #fff;
            font-size: 0.68rem;
            padding: 2px 7px;
            border-radius: 50px;
            font-weight: 700;
        }
        .sidebar-footer {
            margin-top: auto;
            padding: 16px 24px;
            border-top: 1px solid rgba(255,255,255,0.12);
            font-size: 0.82rem;
            color: rgba(255,255,255,0.5);
        }

        /* ── TOPBAR ── */
        .topbar {
            position: fixed; top: 0; left: var(--sidebar-w); right: 0;
            height: var(--topbar-h);
            background: var(--nav-bg);
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center;
            padding: 0 28px; gap: 16px;
            z-index: 999;
            box-shadow: 0 2px 12px rgba(108,63,197,0.07);
            transition: background 0.3s;
        }
        .topbar-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem; font-weight: 700;
            color: var(--primary-dark);
        }
        .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 12px; }
        .topbar-icon {
            width: 38px; height: 38px; border-radius: 50%;
            background: #f0ebff; color: var(--primary);
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; cursor: pointer; text-decoration: none;
            transition: background 0.2s;
        }
        .topbar-icon:hover { background: var(--primary); color: #fff; }
        .topbar-avatar {
            width: 38px; height: 38px; border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff; display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.9rem;
        }

        /* ── MAIN CONTENT ── */
        .main-content {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            padding: 28px;
            min-height: calc(100vh - var(--topbar-h));
        }

        /* ── STAT CARDS ── */
        .stat-card {
            background: #fff;
            border-radius: 16px;
            padding: 22px 24px;
            box-shadow: 0 4px 20px rgba(108,63,197,0.08);
            border: 1px solid #ede5ff;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(108,63,197,0.14); }
        .stat-icon {
            width: 52px; height: 52px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem;
        }
        .stat-num { font-size: 1.9rem; font-weight: 700; color: var(--primary-dark); line-height: 1; }
        .stat-label { font-size: 0.82rem; color: #888; margin-top: 4px; }

        /* ── TABLE ── */
        .admin-table {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(108,63,197,0.07);
            border: 1px solid #ede5ff;
        }
        .admin-table .table { margin: 0; }
        .admin-table .table thead th {
            background: #f9f7ff;
            color: var(--primary-dark);
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            border-bottom: 2px solid #ede5ff;
            padding: 14px 16px;
        }
        .admin-table .table tbody td {
            padding: 13px 16px;
            vertical-align: middle;
            border-color: #f5f0ff;
            font-size: 0.88rem;
        }
        .admin-table .table tbody tr:hover { background: #faf8ff; }

        /* ── FORM CARD ── */
        .form-card {
            background: #fff;
            border-radius: 16px;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(108,63,197,0.08);
            border: 1px solid #ede5ff;
        }
        .form-label { font-weight: 600; font-size: 0.85rem; color: var(--primary-dark); }
        .form-control, .form-select {
            border-color: #ddd;
            border-radius: 10px;
            font-size: 0.88rem;
            padding: 10px 14px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary-light);
            box-shadow: 0 0 0 3px rgba(108,63,197,0.12);
        }

        /* ── BUTTONS ── */
        .btn-primary-admin {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff; border: none;
            border-radius: 10px; padding: 10px 22px;
            font-weight: 600; font-size: 0.88rem;
            transition: opacity 0.2s, transform 0.2s;
        }
        .btn-primary-admin:hover { opacity: 0.9; transform: translateY(-1px); color: #fff; }
        .btn-danger-admin {
            background: #fde8e8; color: #c0392b;
            border: none; border-radius: 8px;
            padding: 6px 14px; font-size: 0.82rem;
            transition: background 0.2s;
        }
        .btn-danger-admin:hover { background: #e74c3c; color: #fff; }
        .btn-edit-admin {
            background: #f0ebff; color: var(--primary);
            border: none; border-radius: 8px;
            padding: 6px 14px; font-size: 0.82rem;
            transition: background 0.2s;
        }
        .btn-edit-admin:hover { background: var(--primary); color: #fff; }

        /* ── BADGE STATUT ── */
        .badge-complet  { background: #fde8e8; color: #c0392b; }
        .badge-actif    { background: #d1f2eb; color: #1a7a4a; }
        .badge-attente  { background: #fff3cd; color: #856404; }
        .badge-passe    { background: #e9ecef; color: #666; }
        .status-badge {
            padding: 4px 12px; border-radius: 50px;
            font-size: 0.75rem; font-weight: 600;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 24px;
        }
        .page-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem; color: var(--primary-dark);
        }

        /* ── FLASH ── */
        .flash-admin {
            position: fixed; top: 80px; right: 20px;
            z-index: 9999; min-width: 300px;
        }

        /* ── DARK MODE ── */
        .theme-toggle {
            width: 38px; height: 38px; border-radius: 50%;
            background: rgba(255,255,255,0.15); color: #fff;
            border: none; display: flex; align-items: center; justify-content: center;
            font-size: 1rem; cursor: pointer;
            transition: background 0.2s, transform 0.2s;
        }
        .theme-toggle:hover { background: rgba(255,255,255,0.3); transform: rotate(20deg); }

        [data-theme="dark"] body { background: #0f0e17; color: #e8e0ff; }
        [data-theme="dark"] .topbar { background: #13111e; border-color: #2e2850; }
        [data-theme="dark"] .topbar-title { color: #c9b8f0; }
        [data-theme="dark"] .topbar-icon { background: #221f33; color: #a78bda; }
        [data-theme="dark"] .main-content { background: #0f0e17; }
        [data-theme="dark"] .stat-card { background: #1a1825; border-color: #2e2850; }
        [data-theme="dark"] .stat-num { color: #c9b8f0; }
        [data-theme="dark"] .stat-label { color: #9b8ec4; }
        [data-theme="dark"] .admin-table { background: #1a1825; border-color: #2e2850; }
        [data-theme="dark"] .admin-table .table thead th { background: #221f33; color: #c9b8f0; border-color: #2e2850; }
        [data-theme="dark"] .admin-table .table tbody td { border-color: #2e2850; color: #e8e0ff; }
        [data-theme="dark"] .admin-table .table tbody tr:hover { background: #221f33; }
        [data-theme="dark"] .admin-table .table { color: #e8e0ff; }
        [data-theme="dark"] .form-card { background: #1a1825; border-color: #2e2850; }
        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select { background: #221f33; color: #e8e0ff; border-color: #2e2850; }
        [data-theme="dark"] .form-control:focus,
        [data-theme="dark"] .form-select:focus { background: #221f33; color: #e8e0ff; }
        [data-theme="dark"] .text-muted { color: #9b8ec4 !important; }
        [data-theme="dark"] .page-header h1 { color: #c9b8f0; }
        [data-theme="dark"] .fw-semibold { color: #e8e0ff; }
        [data-theme="dark"] .border-bottom { border-color: #2e2850 !important; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

{# ── SIDEBAR ── #}
<aside class="sidebar">
    <a href="{{ path('admin_dashboard') }}" class="sidebar-brand">Trip<span>Shop</span> <small style="font-size:0.65rem;opacity:0.6">Admin</small></a>

    <div class="sidebar-section">Principal</div>
    <a href="{{ path('admin_dashboard') }}" class="sidebar-link {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
        <i class="bi bi-grid-fill"></i> Dashboard
    </a>

    <div class="sidebar-section">Activités</div>
    <a href="{{ path('admin_activites') }}" class="sidebar-link {{ 'admin_activite' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-calendar-event-fill"></i> Mes activités
    </a>
    <a href="{{ path('admin_activite_new') }}" class="sidebar-link {{ app.request.get('_route') == 'admin_activite_new' ? 'active' : '' }}">
        <i class="bi bi-plus-circle-fill"></i> Ajouter activité
    </a>
    <a href="{{ path('admin_demandes') }}" class="sidebar-link {{ app.request.get('_route') == 'admin_demandes' ? 'active' : '' }}">
        <i class="bi bi-people-fill"></i> Demandes reçues
        <span class="sidebar-badge" id="sb-demandes" style="display:none">0</span>
    </a>

    <div class="sidebar-section">Avis</div>
    <a href="{{ path('admin_avis_activites') }}" class="sidebar-link {{ 'admin_avis' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-chat-square-text-fill"></i> Avis & Commentaires
    </a>

    <div class="sidebar-section">Publications</div>
    <a href="{{ path('admin_publications') }}" class="sidebar-link {{ 'admin_publication' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-newspaper"></i> Publications
    </a>

    <div class="sidebar-section">Aperçu</div>
    <a href="{{ path('app_home') }}" class="sidebar-link" target="_blank">
        <i class="bi bi-box-arrow-up-right"></i> Voir le site
    </a>

    <div class="sidebar-footer">
        {% if app.user %}
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="topbar-avatar" style="width:34px;height:34px;font-size:0.8rem">
                    {{ app.user.initials }}
                </div>
                <div style="overflow:hidden">
                    <div style="color:#fff;font-size:0.82rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                        {{ app.user.fullName }}
                    </div>
                    <div style="font-size:0.72rem;opacity:0.6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                        {{ app.user.email }}
                    </div>
                </div>
            </div>
            <a href="{{ path('app_logout') }}" class="sidebar-link" style="padding:8px 0;color:rgba(255,255,255,0.6)">
                <i class="bi bi-box-arrow-right"></i> Déconnexion
            </a>
        {% else %}
            <i class="bi bi-person-circle me-2"></i>Admin
        {% endif %}
    </div>
</aside>

{# ── TOPBAR ── #}
<header class="topbar">
    <div class="topbar-title">{% block page_title %}Dashboard{% endblock %}</div>
    <div class="topbar-right">
        <button class="theme-toggle" id="theme-toggle" title="Mode sombre / clair">
            <i class="bi bi-moon-fill" id="theme-icon"></i>
        </button>
        <a href="{{ path('admin_demandes') }}" class="topbar-icon" title="Demandes">
            <i class="bi bi-bell-fill"></i>
        </a>
        <a href="{{ path('app_home') }}" class="topbar-icon" title="Voir le site" target="_blank">
            <i class="bi bi-eye-fill"></i>
        </a>
        {% if app.user %}
            <div class="topbar-avatar" title="{{ app.user.fullName }}">
                {{ app.user.initials }}
            </div>
        {% else %}
            <div class="topbar-avatar">A</div>
        {% endif %}
    </div>
</header>

{# FLASH #}
<div class="flash-admin">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show shadow-sm rounded-3">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {% endfor %}
    {% endfor %}
</div>

{# ── CONTENT ── #}
<main class="main-content">
    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ── DARK MODE ──
    (function() {
        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.style.colorScheme = theme;
            localStorage.setItem('theme', theme);
            const icon = document.getElementById('theme-icon');
            if (icon) icon.className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
        }
        applyTheme(localStorage.getItem('theme') || 'light');
        document.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('theme-toggle');
            if (btn) btn.addEventListener('click', () => {
                applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
            });
        });
    })();

    // Badge sidebar demandes
    fetch('/api/badges').then(r => r.ok ? r.json() : null).then(d => {
        if (!d) return;
        const el = document.getElementById('sb-demandes');
        if (el && d.demandes > 0) { el.textContent = d.demandes; el.style.display = 'inline'; }
    }).catch(() => {});

    // Auto-dismiss flash
    setTimeout(() => {
        document.querySelectorAll('.flash-admin .alert').forEach(el => {
            el.classList.remove('show'); setTimeout(() => el.remove(), 300);
        });
    }, 4000);
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
