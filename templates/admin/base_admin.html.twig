<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Dashboard{% endblock %} — TripShop Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary:      #6c3fc5;
            --primary-dark: #4e2d9a;
            --primary-light:#a78bda;
            --accent:       #9b59b6;
            --sidebar-w:    260px;
            --topbar-h:     64px;
            --bg:           #f4f1fb;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: #333; }

        /* ── SIDEBAR ── */
        .sidebar {
            position: fixed; top: 0; left: 0;
            width: var(--sidebar-w); height: 100vh;
            background: linear-gradient(180deg, var(--primary-dark) 0%, var(--primary) 100%);
            display: flex; flex-direction: column;
            z-index: 1000; overflow-y: auto;
            transition: transform 0.3s;
        }
        .sidebar-brand {
            padding: 22px 24px 18px;
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem; font-weight: 700;
            color: #fff; border-bottom: 1px solid rgba(255,255,255,0.12);
            text-decoration: none; display: block;
        }
        .sidebar-brand span { color: #c39bd3; }
        .sidebar-section {
            font-size: 0.68rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 1.5px;
            color: rgba(255,255,255,0.4);
            padding: 20px 24px 8px;
        }
        .sidebar-link {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 24px;
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            font-size: 0.9rem; font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }
        .sidebar-link i { font-size: 1.05rem; width: 20px; text-align: center; }
        .sidebar-link:hover {
            color: #fff;
            background: rgba(255,255,255,0.08);
            border-left-color: rgba(255,255,255,0.4);
        }
        .sidebar-link.active {
            color: #fff;
            background: rgba(255,255,255,0.15);
            border-left-color: #fff;
            font-weight: 600;
        }
        .sidebar-badge {
            margin-left: auto;
            background: #e74c3c;
            color: #fff;
            font-size: 0.68rem;
            padding: 2px 7px;
            border-radius: 50px;
            font-weight: 700;
        }
        .sidebar-footer {
            margin-top: auto;
            padding: 16px 24px;
            border-top: 1px solid rgba(255,255,255,0.12);
            font-size: 0.82rem;
            color: rgba(255,255,255,0.5);
        }

        /* ── TOPBAR ── */
        .topbar {
            position: fixed; top: 0; left: var(--sidebar-w); right: 0;
            height: var(--topbar-h);
            background: #fff;
            border-bottom: 1px solid #ede5ff;
            display: flex; align-items: center;
            padding: 0 28px; gap: 16px;
            z-index: 999;
            box-shadow: 0 2px 12px rgba(108,63,197,0.07);
        }
        .topbar-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem; font-weight: 700;
            color: var(--primary-dark);
        }
        .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 12px; }
        .topbar-icon {
            width: 38px; height: 38px; border-radius: 50%;
            background: #f0ebff; color: var(--primary);
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; cursor: pointer; text-decoration: none;
            transition: background 0.2s;
        }
        .topbar-icon:hover { background: var(--primary); color: #fff; }
        .topbar-avatar {
            width: 38px; height: 38px; border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff; display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.9rem;
        }

        /* ── MAIN CONTENT ── */
        .main-content {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            padding: 28px;
            min-height: calc(100vh - var(--topbar-h));
        }

        /* ── STAT CARDS ── */
        .stat-card {
            background: #fff;
            border-radius: 16px;
            padding: 22px 24px;
            box-shadow: 0 4px 20px rgba(108,63,197,0.08);
            border: 1px solid #ede5ff;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(108,63,197,0.14); }
        .stat-icon {
            width: 52px; height: 52px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem;
        }
        .stat-num { font-size: 1.9rem; font-weight: 700; color: var(--primary-dark); line-height: 1; }
        .stat-label { font-size: 0.82rem; color: #888; margin-top: 4px; }

        /* ── TABLE ── */
        .admin-table {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(108,63,197,0.07);
            border: 1px solid #ede5ff;
        }
        .admin-table .table { margin: 0; }
        .admin-table .table thead th {
            background: #f9f7ff;
            color: var(--primary-dark);
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            border-bottom: 2px solid #ede5ff;
            padding: 14px 16px;
        }
        .admin-table .table tbody td {
            padding: 13px 16px;
            vertical-align: middle;
            border-color: #f5f0ff;
            font-size: 0.88rem;
        }
        .admin-table .table tbody tr:hover { background: #faf8ff; }

        /* ── FORM CARD ── */
        .form-card {
            background: #fff;
            border-radius: 16px;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(108,63,197,0.08);
            border: 1px solid #ede5ff;
        }
        .form-label { font-weight: 600; font-size: 0.85rem; color: var(--primary-dark); }
        .form-control, .form-select {
            border-color: #ddd;
            border-radius: 10px;
            font-size: 0.88rem;
            padding: 10px 14px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary-light);
            box-shadow: 0 0 0 3px rgba(108,63,197,0.12);
        }

        /* ── BUTTONS ── */
        .btn-primary-admin {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff; border: none;
            border-radius: 10px; padding: 10px 22px;
            font-weight: 600; font-size: 0.88rem;
            transition: opacity 0.2s, transform 0.2s;
        }
        .btn-primary-admin:hover { opacity: 0.9; transform: translateY(-1px); color: #fff; }
        .btn-danger-admin {
            background: #fde8e8; color: #c0392b;
            border: none; border-radius: 8px;
            padding: 6px 14px; font-size: 0.82rem;
            transition: background 0.2s;
        }
        .btn-danger-admin:hover { background: #e74c3c; color: #fff; }
        .btn-edit-admin {
            background: #f0ebff; color: var(--primary);
            border: none; border-radius: 8px;
            padding: 6px 14px; font-size: 0.82rem;
            transition: background 0.2s;
        }
        .btn-edit-admin:hover { background: var(--primary); color: #fff; }
        .btn-warning-admin {
            background: #fff3cd; color: #856404;
            border: none; border-radius: 8px;
            padding: 6px 14px; font-size: 0.82rem;
            transition: background 0.2s;
        }
        .btn-warning-admin:hover { background: #e67e22; color: #fff; }
        .btn-success-admin {
            background: #d1f2eb; color: #1a7a4a;
            border: none; border-radius: 8px;
            padding: 6px 14px; font-size: 0.82rem;
            transition: background 0.2s;
        }
        .btn-success-admin:hover { background: #1a7a4a; color: #fff; }

        /* ── BADGE STATUT ── */
        .badge-complet  { background: #fde8e8; color: #c0392b; }
        .badge-actif    { background: #d1f2eb; color: #1a7a4a; }
        .badge-attente  { background: #fff3cd; color: #856404; }
        .badge-passe    { background: #e9ecef; color: #666; }
        .status-badge {
            padding: 4px 12px; border-radius: 50px;
            font-size: 0.75rem; font-weight: 600;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 24px;
        }
        .page-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem; color: var(--primary-dark);
        }

        /* ── FLASH ── */
        .flash-admin {
            position: fixed; top: 80px; right: 20px;
            z-index: 9999; min-width: 300px;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

{# ── SIDEBAR ── #}
<aside class="sidebar">
    <a href="{{ path('admin_dashboard') }}" class="sidebar-brand">Trip<span>Shop</span> <small style="font-size:0.65rem;opacity:0.6">Admin</small></a>

    <div class="sidebar-section">Principal</div>
    <a href="{{ path('admin_dashboard') }}" class="sidebar-link {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
        <i class="bi bi-grid-fill"></i> Dashboard
    </a>

    <div class="sidebar-section">Activités</div>
    <a href="{{ path('admin_activites') }}" class="sidebar-link {{ 'admin_activite' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-calendar-event-fill"></i> Mes activités
    </a>
    <a href="{{ path('admin_activite_new') }}" class="sidebar-link {{ app.request.get('_route') == 'admin_activite_new' ? 'active' : '' }}">
        <i class="bi bi-plus-circle-fill"></i> Ajouter activité
    </a>
    <a href="{{ path('admin_demandes') }}" class="sidebar-link {{ app.request.get('_route') == 'admin_demandes' ? 'active' : '' }}">
        <i class="bi bi-people-fill"></i> Demandes reçues
        <span class="sidebar-badge" id="sb-demandes" style="display:none">0</span>
    </a>

    <div class="sidebar-section">Excursions</div>
    <a href="{{ path('admin_destination_index') }}" class="sidebar-link {{ 'admin_destination' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-geo-alt-fill"></i> Mes excursions
    </a>
    <a href="{{ path('admin_destination_new') }}" class="sidebar-link {{ app.request.get('_route') == 'admin_destination_new' ? 'active' : '' }}">
        <i class="bi bi-plus-circle-fill"></i> Ajouter excursion
    </a>

    <div class="sidebar-section">Boutique</div>
    <a href="{{ path('admin_categories') }}" class="sidebar-link {{ 'admin_categorie' in app.request.get('_route') or 'admin_sous_categorie' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-grid-fill"></i> Catégories
    </a>
    <a href="{{ path('admin_produits') }}" class="sidebar-link {{ 'admin_produit' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-bag-fill"></i> Mes produits
    </a>
    <a href="{{ path('admin_produit_new') }}" class="sidebar-link {{ app.request.get('_route') == 'admin_produit_new' ? 'active' : '' }}">
        <i class="bi bi-plus-circle-fill"></i> Ajouter un produit
    </a>
    <a href="{{ path('admin_attributs') }}" class="sidebar-link {{ 'admin_attribut' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-sliders"></i> Attributs & Options
    </a>
    <a href="{{ path('admin_promos') }}" class="sidebar-link {{ 'admin_promo' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-tag-fill"></i> Codes promo
    </a>
    <a href="{{ path('admin_promo_new') }}" class="sidebar-link {{ app.request.get('_route') == 'admin_promo_new' ? 'active' : '' }}">
        <i class="bi bi-plus-circle"></i> Nouveau code promo
    </a>
    <a href="{{ path('admin_reclamations') }}" class="sidebar-link {{ 'admin_reclamation' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-exclamation-triangle-fill"></i> Réclamations
        {# badge réclamations en attente #}
    </a>

    <div class="sidebar-section">Avis</div>
    <a href="{{ path('admin_avis_activites') }}" class="sidebar-link {{ 'admin_avis' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-chat-square-text-fill"></i> Avis & Commentaires
    </a>

    <div class="sidebar-section">Aperçu</div>
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_users_index') }}" class="sidebar-link {{ 'app_users' in app.request.get('_route') ? 'active' : '' }}">
        <i class="bi bi-people-fill"></i> Utilisateurs
    </a>
    {% endif %}
    <a href="{{ path('app_home') }}" class="sidebar-link" target="_blank">
        <i class="bi bi-box-arrow-up-right"></i> Voir le site
    </a>

    <div class="sidebar-footer">
        <i class="bi bi-person-circle me-2"></i>Partenaire connecté
    </div>
</aside>

{# ── TOPBAR ── #}
<header class="topbar">
    <div class="topbar-title">{% block page_title %}Dashboard{% endblock %}</div>
    <div class="topbar-right">
        <a href="{{ path('admin_demandes') }}" class="topbar-icon" title="Demandes">
            <i class="bi bi-bell-fill"></i>
        </a>
        <a href="{{ path('app_home') }}" class="topbar-icon" title="Voir le site" target="_blank">
            <i class="bi bi-eye-fill"></i>
        </a>
        <div class="dropdown">
            <a href="#" class="topbar-avatar text-decoration-none" data-bs-toggle="dropdown" title="Mon profil">
                {{ app.user ? app.user.prenom|first|upper : 'A' }}
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2" style="min-width:200px">
                <li class="px-3 py-2 border-bottom">
                    <div class="fw-semibold" style="color:var(--primary-dark)">
                        {{ app.user ? app.user.prenom ~ ' ' ~ app.user.nom : 'Admin' }}
                    </div>
                    <div class="text-muted small">{{ app.user ? app.user.email : '' }}</div>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="{{ path('app_profile') }}">
                        <i class="bi bi-person-circle me-2" style="color:var(--primary)"></i>Mon profil
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="{{ path('app_profile_edit') }}">
                        <i class="bi bi-pencil-square me-2" style="color:var(--primary)"></i>Modifier le profil
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item py-2 text-danger" href="{{ path('app_logout') }}">
                        <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>

{# FLASH #}
<div class="flash-admin">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show shadow-sm rounded-3">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {% endfor %}
    {% endfor %}
</div>

{# ── CONTENT ── #}
<main class="main-content">
    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Badge sidebar demandes
    fetch('/api/badges').then(r => r.ok ? r.json() : null).then(d => {
        if (!d) return;
        const el = document.getElementById('sb-demandes');
        if (el && d.demandes > 0) { el.textContent = d.demandes; el.style.display = 'inline'; }
    }).catch(() => {});

    // Auto-dismiss flash
    setTimeout(() => {
        document.querySelectorAll('.flash-admin .alert').forEach(el => {
            el.classList.remove('show'); setTimeout(() => el.remove(), 300);
        });
    }, 4000);

    // Badge notifications commandes — polling toutes les 15 secondes
    if (document.querySelector('.sidebar')) {
        function refreshNotifBadge() {
            fetch('/admin/notifications/api/count')
                .then(r => r.ok ? r.json() : null)
                .then(d => {
                    if (!d) return;
                    const badge = document.getElementById('notif-badge-sidebar');
                    if (!badge) return;
                    badge.textContent = d.count;
                    badge.style.display = d.count > 0 ? 'inline' : 'none';
                    if (d.count > 0 && !window._lastNotifCount) {
                        window._lastNotifCount = d.count;
                    } else if (d.count > (window._lastNotifCount || 0)) {
                        window._lastNotifCount = d.count;
                        showNewOrderToast();
                    } else {
                        window._lastNotifCount = d.count;
                    }
                })
                .catch(() => {});
        }

        function showNewOrderToast() {
            const t = document.createElement('div');
            t.style.cssText = 'position:fixed;top:80px;right:20px;z-index:99999;min-width:300px;animation:fadeIn 0.3s ease';
            t.innerHTML = `<div class="alert shadow-lg rounded-4 p-3 border-0" style="background:#fff;border-left:4px solid var(--primary)!important">
                <div class="d-flex align-items-center gap-2">
                    <span style="font-size:1.5rem">🛍️</span>
                    <div>
                        <div class="fw-bold small" style="color:var(--primary-dark)">Nouvelle commande reçue !</div>
                        <a href="/admin/notifications" class="small" style="color:var(--primary)">Voir les détails →</a>
                    </div>
                    <button onclick="this.closest('div[style]').remove()" class="btn-close ms-auto" style="font-size:0.7rem"></button>
                </div>
            </div>`;
            document.body.appendChild(t);
            setTimeout(() => { t.style.opacity='0'; t.style.transition='opacity 0.3s'; setTimeout(()=>t.remove(),300); }, 7000);
        }

        refreshNotifBadge();
        setInterval(refreshNotifBadge, 15000);
    }
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
