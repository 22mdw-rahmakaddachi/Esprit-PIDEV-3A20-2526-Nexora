{% extends 'admin/base_admin.html.twig' %}
{% block title %}Modération{% endblock %}
{% block page_title %}Modération des publications{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <h1><i class="bi bi-shield-exclamation me-2"></i>Modération</h1>
    <div class="d-flex gap-2">
        <span class="badge rounded-pill px-3 py-2" style="background:#fde8e8;color:#c0392b;font-size:0.85rem">
            <i class="bi bi-person-x me-1"></i>{{ users|filter(u => u.is_blocked)|length }} bloqué(s)
        </span>
        <span class="badge rounded-pill px-3 py-2" style="background:#fff3cd;color:#856404;font-size:0.85rem">
            <i class="bi bi-exclamation-triangle me-1"></i>{{ users|filter(u => not u.is_blocked and u.warning_count > 0)|length }} averti(s)
        </span>
    </div>
</div>

{% if users is empty %}
<div class="text-center py-5 text-muted">
    <i class="bi bi-shield-check" style="font-size:3rem;opacity:0.3"></i>
    <p class="mt-3">Aucun avertissement enregistré.</p>
</div>
{% else %}
<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>Utilisateur</th>
                <th>Email</th>
                <th>Avertissements</th>
                <th>Statut</th>
                <th>Dernier contenu bloqué</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for u in users %}
            <tr>
                <td class="fw-semibold">{{ u.user_nom }}</td>
                <td class="text-muted small">{{ u.user_email }}</td>
                <td>
                    <div class="d-flex gap-1">
                        {% for i in 1..3 %}
                        <div style="width:14px;height:14px;border-radius:50%;
                             background:{{ i <= u.warning_count ? '#e74c3c' : '#ddd' }}"></div>
                        {% endfor %}
                    </div>
                    <span class="small text-muted">{{ u.warning_count }}/3</span>
                </td>
                <td>
                    {% if u.is_blocked %}
                    <span class="status-badge badge-complet">🚫 Bloqué</span>
                    {% elseif u.warning_count >= 2 %}
                    <span class="status-badge" style="background:#fde8e8;color:#c0392b">⚠️ Danger</span>
                    {% elseif u.warning_count == 1 %}
                    <span class="status-badge badge-attente">⚠️ Averti</span>
                    {% else %}
                    <span class="status-badge badge-actif">✅ OK</span>
                    {% endif %}
                </td>
                <td style="max-width:250px">
                    <span class="text-muted small" style="font-style:italic">
                        "{{ u.contenu_bloque|length > 80 ? u.contenu_bloque|slice(0,80) ~ '…' : u.contenu_bloque }}"
                    </span>
                </td>
                <td class="text-muted small">{{ u.created_at|date('d/m/Y H:i') }}</td>
                <td>
                    {% if u.is_blocked %}
                    <form method="POST" action="{{ path('admin_moderation_debloquer', {userId: u.user_id}) }}"
                          onsubmit="return confirm('Débloquer {{ u.user_nom }} ?')">
                        <button type="submit" class="btn btn-sm"
                                style="background:#d1f2eb;color:#1a7a4a;border:none;border-radius:8px;padding:5px 12px;font-size:0.8rem">
                            <i class="bi bi-unlock me-1"></i>Débloquer
                        </button>
                    </form>
                    {% else %}
                    <span class="text-muted small">—</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# Historique complet #}
<div class="mt-4">
    <h6 class="fw-bold mb-3" style="color:var(--primary-dark)">
        <i class="bi bi-clock-history me-2"></i>Historique complet
    </h6>
    <div class="admin-table">
        <table class="table">
            <thead>
                <tr><th>#</th><th>Utilisateur</th><th>Contenu bloqué</th><th>Avert.</th><th>Date</th><th></th></tr>
            </thead>
            <tbody>
                {% for w in warnings %}
                <tr>
                    <td class="text-muted small">{{ w.id }}</td>
                    <td class="fw-semibold small">{{ w.user_nom }}</td>
                    <td style="max-width:300px">
                        <span class="text-muted small" style="font-style:italic">
                            "{{ w.contenu_bloque|length > 100 ? w.contenu_bloque|slice(0,100) ~ '…' : w.contenu_bloque }}"
                        </span>
                    </td>
                    <td>
                        <span class="badge" style="background:{{ w.is_blocked ? '#fde8e8' : '#fff3cd' }};color:{{ w.is_blocked ? '#c0392b' : '#856404' }}">
                            {{ w.warning_count }}/3 {{ w.is_blocked ? '🚫' : '⚠️' }}
                        </span>
                    </td>
                    <td class="text-muted small">{{ w.created_at|date('d/m/Y H:i') }}</td>
                    <td>
                        <form method="POST" action="{{ path('admin_moderation_supprimer', {id: w.id}) }}"
                              onsubmit="return confirm('Supprimer cet avertissement ?')">
                            <button type="submit" class="btn btn-danger-admin btn-sm">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
