{% extends 'admin/base_admin.html.twig' %}
{% block title %}Commandes reçues{% endblock %}
{% block page_title %}Commandes reçues{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="bi bi-bag-check-fill me-2"></i>Commandes reçues</h1>
    {% if notifications|length > 0 %}
    <button class="btn btn-edit-admin" id="btn-tout-lire">
        <i class="bi bi-check-all me-1"></i>Tout marquer comme lu
    </button>
    {% endif %}
</div>

{% if notifications is empty %}
<div class="text-center py-5 rounded-4" style="background:#fff;border:2px dashed #ede5ff">
    <i class="bi bi-inbox" style="font-size:3rem;color:#c5b3e8"></i>
    <p class="mt-3 text-muted">Aucune commande reçue pour le moment.</p>
</div>
{% else %}
<div class="d-flex flex-column gap-3">
    {% for notif in notifications %}
    <div class="rounded-4 p-4 shadow-sm notif-item" data-id="{{ notif.id }}"
         style="{{ not notif.lue ? 'background:#fff;border:2px solid var(--primary)' : 'background:#f9f7ff;opacity:0.8' }}">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 mb-3">
                    {% if not notif.lue %}
                    <span class="badge rounded-pill px-2 py-1" style="background:var(--primary);color:#fff;font-size:0.7rem">
                        <i class="bi bi-circle-fill me-1" style="font-size:0.45rem"></i>Nouveau
                    </span>
                    {% endif %}
                    <span class="fw-bold fs-6" style="color:var(--primary-dark)">
                        Commande #{{ notif.commandeId }}
                    </span>
                    <span class="text-muted small ms-auto">
                        <i class="bi bi-clock me-1"></i>{{ notif.createdAt|date('d/m/Y à H:i') }}
                    </span>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="small fw-semibold text-muted mb-1">Client</div>
                        <div class="fw-semibold">{{ notif.clientNom }}</div>
                        {% if notif.clientEmail %}
                        <div class="text-muted small">
                            <i class="bi bi-envelope me-1"></i>{{ notif.clientEmail }}
                        </div>
                        {% endif %}
                    </div>

                    <div class="col-md-6">
                        <div class="small fw-semibold text-muted mb-1">Articles commandés</div>
                        {% for line in notif.details|split('\n') %}
                        {% if line %}
                        <div class="small py-1 px-2 rounded mb-1" style="background:#f0ebff">
                            <i class="bi bi-box me-1" style="color:var(--primary)"></i>{{ line }}
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>

                    <div class="col-md-3 text-md-end">
                        <div class="small fw-semibold text-muted mb-1">Montant total</div>
                        <div class="fw-bold" style="font-size:1.4rem;color:var(--primary)">
                            {{ notif.montant|number_format(2) }} TND
                        </div>
                        <div class="small text-muted mt-1">
                            <span class="badge rounded-pill" style="background:#fff3cd;color:#856404">En attente</span>
                        </div>
                    </div>
                </div>
            </div>

            {% if not notif.lue %}
            <button class="btn-edit-admin btn btn-sm btn-lire flex-shrink-0" data-id="{{ notif.id }}">
                <i class="bi bi-check me-1"></i>Marquer lu
            </button>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
document.querySelectorAll('.btn-lire').forEach(btn => {
    btn.addEventListener('click', async function() {
        const id = this.dataset.id;
        await fetch(`/admin/notifications/${id}/lire`, { method: 'POST' });
        const item = document.querySelector(`.notif-item[data-id="${id}"]`);
        if (item) {
            item.style.border = 'none';
            item.style.opacity = '0.8';
            item.style.background = '#f9f7ff';
            item.querySelector('.badge')?.remove();
            this.remove();
        }
        refreshBadge();
    });
});

document.getElementById('btn-tout-lire')?.addEventListener('click', async function() {
    await fetch('/admin/notifications/tout-lire', { method: 'POST' });
    document.querySelectorAll('.notif-item').forEach(item => {
        item.style.border = 'none';
        item.style.opacity = '0.8';
        item.style.background = '#f9f7ff';
        item.querySelector('.badge')?.remove();
        item.querySelector('.btn-lire')?.remove();
    });
    this.remove();
    refreshBadge();
});

async function refreshBadge() {
    const res = await fetch('/admin/notifications/api/count');
    const data = await res.json();
    const badge = document.getElementById('notif-badge-sidebar');
    if (badge) {
        badge.textContent = data.count;
        badge.style.display = data.count > 0 ? 'inline' : 'none';
    }
}
</script>
{% endblock %}
