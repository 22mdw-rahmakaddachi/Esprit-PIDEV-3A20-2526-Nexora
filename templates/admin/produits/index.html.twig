{% extends 'admin/base_admin.html.twig' %}
{% block title %}Mes produits{% endblock %}
{% block page_title %}Mes produits{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="bi bi-bag me-2"></i>Mes produits</h1>
    <a href="{{ path('admin_produit_new') }}" class="btn btn-primary-admin">
        <i class="bi bi-plus-lg me-1"></i>Nouveau produit
    </a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Produit</th>
                <th>Catégorie</th>
                <th>Variantes</th>
                <th>Prix min</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for p in produits %}
            <tr>
                <td>
                    {% if p.imagePrincipale %}
                    <img src="/uploads/produits/{{ p.imagePrincipale }}" alt="{{ p.nom }}"
                         style="width:48px;height:48px;object-fit:cover;border-radius:8px">
                    {% else %}
                    <div style="width:48px;height:48px;border-radius:8px;background:#f0ebff;display:flex;align-items:center;justify-content:center;font-size:1.4rem">🛍️</div>
                    {% endif %}
                </td>
                <td>
                    <div class="fw-semibold">{{ p.nom }}</div>
                    {% if p.marque %}<div class="text-muted small">{{ p.marque }}</div>{% endif %}
                </td>
                <td>{{ p.sousCategorie ? p.sousCategorie.nom : '—' }}</td>
                <td>
                    <span class="badge rounded-pill" style="background:#f0ebff;color:var(--primary)">
                        {{ p.variants|length }} variante(s)
                    </span>
                </td>
                <td class="fw-bold" style="color:var(--primary)">
                    {{ p.prixMin ? p.prixMin ~ ' TND' : '—' }}
                </td>
                <td>
                    <span class="status-badge {{ p.statut == 'actif' ? 'badge-actif' : 'badge-complet' }}">
                        {{ p.statut }}
                    </span>
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <a href="{{ path('admin_produit_edit', {id: p.id}) }}" class="btn-edit-admin btn">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('admin_produit_delete', {id: p.id}) }}"
                              onsubmit="return confirm('Supprimer ce produit ?')">
                            <button type="submit" class="btn-danger-admin btn"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-5">
                    <div style="font-size:3rem">🛍️</div>
                    <p class="mt-2">Aucun produit. <a href="{{ path('admin_produit_new') }}">Ajouter le premier</a></p>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
