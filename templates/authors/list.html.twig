

{% if auth is not empty %}
<table border="1">
    <tr>
        <th>id</th>
        <th>username</th>
        <th>email</th>
        <th>nb_books</th>
        <th>picture</th>
    </tr>
    {% set totalBooks = 0 %}
    {% for au in auth %}   {# exécuter une action : boucle for  #}
    <tr>
        <td>{{au.id}}</td>    {# afficher une variable  #}
        <td>{{au.username | upper}}</td>
        <td>{{au.email}}</td>
        <td>{{au.nb_books}}</td>
        <td><img src="{{au.picture}}" alt="{{au.username}}" width="100"></td>
    </tr>
    {% set totalBooks = totalBooks + au.nb_books %}
    {% endfor %}
</table>
<p>  le nombre d'auteurs est de : {{ auth | length }} </p>
<p>  le nombre total de livres est de : {{ totalBooks }} </p>
{% else %}
<p>Aucun auteur trouvé</p>
{% endif %}

