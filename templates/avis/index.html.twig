{% extends 'base.html.twig' %}
{% block title %}Avis & Commentaires — Nexora{% endblock %}

{% block stylesheets %}
<style>
.avis-card {
    background: var(--card-bg, #fff);
    border-radius: 20px;
    box-shadow: 0 4px 24px rgba(108,63,197,0.10);
    border: 1px solid var(--border, #ede5ff);
    overflow: hidden;
    transition: transform .3s, box-shadow .3s;
}
.avis-card:hover { transform: translateY(-6px); box-shadow: 0 12px 36px rgba(108,63,197,0.18); }
.avis-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #fff; font-weight: 700; font-size: 1rem;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.star-rating-input { display:inline-flex;gap:3px;background:#f0ebff;border-radius:50px;padding:6px 10px; }
.star { font-size:1.4rem;cursor:pointer;color:#ddd;transition:color .15s,transform .15s;line-height:1;user-select:none; }
.star.active { color:#f39c12; }
.star:hover { transform:scale(1.2); }
</style>
{% endblock %}

{% block body %}
<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Avis & Commentaires</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">

    <div class="text-center mb-5" data-aos="fade-down">
        <h1 class="section-title d-inline-block">
            <i class="bi bi-chat-square-quote me-2" style="color:var(--primary)"></i>Avis & Commentaires
        </h1>
        <p class="text-muted mt-3">Découvrez ce que nos clients pensent de nos activités.</p>
    </div>

    {# ── FORMULAIRE ── #}
    <div class="mb-5" data-aos="fade-up">
        <div class="card border-0 rounded-4 p-4" style="background:var(--card-bg,#fff);box-shadow:0 4px 20px rgba(108,63,197,0.09);border:1px solid var(--border,#ede5ff)!important">
            <h5 class="fw-bold mb-4" style="color:var(--primary-dark)">
                <i class="bi bi-plus-circle-fill me-2" style="color:var(--primary)"></i>Laisser un avis
            </h5>
            <form method="POST" action="{{ path('app_avis_new_public') }}">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" style="color:var(--primary-dark)">Titre <span class="text-danger">*</span></label>
                        <input type="text" name="titre" id="avis-titre" class="form-control" placeholder="Résumé de votre avis" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold" style="color:var(--primary-dark)">Note <span class="text-danger">*</span></label>
                        <div class="star-rating-input" id="star-rating">
                            {% for i in 1..5 %}<span class="star active" data-value="{{ i }}">★</span>{% endfor %}
                        </div>
                        <input type="hidden" name="note" id="avis-note" value="5">
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn w-100 fw-semibold"
                                style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border-radius:10px">
                            <i class="bi bi-send me-1"></i>Publier
                        </button>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold" style="color:var(--primary-dark)">
                            Commentaire <span class="text-danger">*</span>
                            <span id="sc-status" class="ms-2" style="font-weight:400;font-size:0.75rem"></span>
                        </label>
                        <div style="position:relative">
                            <textarea name="commentaire" id="avis-commentaire" class="form-control" rows="4"
                                      placeholder="Partagez votre expérience (min. 5 caractères)…"
                                      required minlength="5"
                                      style="padding-bottom:36px"></textarea>
                            {# Suggestions de correction #}
                            <div id="sc-suggestions" style="display:none;position:absolute;bottom:6px;left:10px;right:10px;
                                 background:var(--card-bg,#fff);border:1px solid var(--border,#ede5ff);
                                 border-radius:10px;padding:8px 12px;font-size:0.8rem;
                                 box-shadow:0 4px 16px rgba(108,63,197,0.12);z-index:10;max-height:120px;overflow-y:auto">
                            </div>
                        </div>
                        <div id="sc-errors" style="margin-top:6px;display:flex;flex-wrap:wrap;gap:6px"></div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# ── LISTE DES AVIS ── #}
    {% if avisList is empty %}
    <div class="text-center py-5 text-muted" data-aos="fade-up">
        <div style="font-size:4rem">💬</div>
        <p class="mt-3">Aucun avis pour le moment. Soyez le premier !</p>
    </div>
    {% else %}
    <div class="row g-4">
        {% for avis in avisList %}
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 60 }}">
            <div class="avis-card p-4 h-100 d-flex flex-column">
                {# Étoiles #}
                <div style="color:#f39c12;font-size:1rem;margin-bottom:10px">
                    {% for i in 1..5 %}
                        <i class="bi bi-star{{ i <= avis.rating ? '-fill' : '' }}"></i>
                    {% endfor %}
                    <span class="ms-1 text-muted small">({{ avis.rating }}/5)</span>
                </div>
                {# Titre #}
                <div class="fw-bold mb-2" style="color:var(--primary-dark)">{{ avis.titre }}</div>
                {# Commentaire #}
                <p class="text-muted mb-3 flex-grow-1" style="font-size:0.9rem;line-height:1.7;font-style:italic">
                    "{{ avis.contenu|length > 150 ? avis.contenu|slice(0,150) ~ '…' : avis.contenu }}"
                </p>
                {# Footer #}
                <div class="d-flex align-items-center gap-2 pt-3" style="border-top:1px solid var(--border,#ede5ff)">
                    <div class="avis-avatar">U</div>
                    <div>
                        <div class="fw-semibold small" style="color:var(--primary-dark)">Utilisateur #{{ avis.userId }}</div>
                        <div class="text-muted" style="font-size:0.72rem">
                            {{ avis.createdAt ? avis.createdAt|date('d/m/Y') : '' }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>

<script>
(function() {
    const labels = {1:'Très mauvais',2:'Mauvais',3:'Moyen',4:'Bien',5:'Excellent'};
    const stars = document.querySelectorAll('#star-rating .star');
    const input = document.getElementById('avis-note');
    let current = 5;
    function paint(v) { stars.forEach(s => s.classList.toggle('active', parseInt(s.dataset.value) <= v)); }
    stars.forEach(s => {
        s.addEventListener('click', () => { current = parseInt(s.dataset.value); input.value = current; paint(current); });
        s.addEventListener('mouseenter', () => paint(parseInt(s.dataset.value)));
        s.addEventListener('mouseleave', () => paint(current));
    });
    paint(current);
})();

// ── CORRECTION AUTOMATIQUE via LanguageTool API ──
(function() {
    const textarea  = document.getElementById('avis-commentaire');
    const statusEl  = document.getElementById('sc-status');
    const errorsEl  = document.getElementById('sc-errors');
    const suggestEl = document.getElementById('sc-suggestions');
    if (!textarea) return;

    let debounceTimer = null;
    let lastErrors    = [];

    function setStatus(msg, color) {
        if (!statusEl) return;
        statusEl.innerHTML = msg;
        statusEl.style.color = color || 'var(--text-muted)';
    }

    function applyCorrection(original, replacement) {
        const text = textarea.value;
        // Replace first occurrence of the wrong word
        textarea.value = text.replace(original, replacement);
        errorsEl.innerHTML = '';
        suggestEl.style.display = 'none';
        setStatus('<i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"></i>Corrigé !', '#1a7a4a');
        setTimeout(() => setStatus(''), 2000);
        // Re-check after correction
        checkText(textarea.value);
    }

    function renderErrors(matches) {
        errorsEl.innerHTML = '';
        suggestEl.style.display = 'none';
        lastErrors = matches;

        if (matches.length === 0) {
            setStatus('<i class="bi bi-check-circle-fill me-1"></i>Aucune erreur détectée', '#1a7a4a');
            return;
        }

        setStatus(`<i class="bi bi-exclamation-triangle-fill me-1"></i>${matches.length} erreur(s) détectée(s)`, '#e67e22');

        matches.slice(0, 5).forEach(m => {
            if (!m.replacements || m.replacements.length === 0) return;

            const wrong   = textarea.value.substring(m.offset, m.offset + m.length);
            const fixes   = m.replacements.slice(0, 3).map(r => r.value);
            const pill    = document.createElement('span');
            pill.style.cssText = 'display:inline-flex;align-items:center;gap:4px;background:#fff3cd;border:1px solid #f39c12;border-radius:50px;padding:3px 10px;font-size:0.78rem;cursor:default';
            pill.innerHTML = `<span style="color:#c0392b;text-decoration:line-through">${wrong}</span>
                <i class="bi bi-arrow-right" style="color:#888;font-size:0.7rem"></i>`;

            fixes.forEach(fix => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = fix;
                btn.style.cssText = 'background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;border-radius:50px;padding:2px 8px;font-size:0.75rem;cursor:pointer';
                btn.title = 'Cliquer pour corriger';
                btn.addEventListener('click', () => applyCorrection(wrong, fix));
                pill.appendChild(btn);
            });

            errorsEl.appendChild(pill);
        });
    }

    function checkText(text) {
        if (text.trim().length < 5) {
            errorsEl.innerHTML = '';
            setStatus('');
            return;
        }

        setStatus('<i class="bi bi-hourglass-split me-1"></i>Vérification…', '#888');

        const body = new URLSearchParams();
        body.append('text', text);
        body.append('language', 'fr');
        body.append('enabledOnly', 'false');

        fetch('https://api.languagetool.org/v2/check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        })
        .then(r => r.json())
        .then(data => renderErrors(data.matches || []))
        .catch(() => setStatus(''));
    }

    textarea.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => checkText(this.value), 800);
    });
})();
</script>
{% endblock %}
