{% extends 'base.html.twig' %}
{% block title %}Avis & Commentaires — TripShop{% endblock %}

{% block body %}

<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Avis & Commentaires</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">

    <div class="text-center mb-5" data-aos="fade-down">
        <h1 class="section-title d-inline-block">
            <i class="bi bi-chat-square-quote me-2" style="color:var(--primary)"></i>Avis & Commentaires
        </h1>
        <p class="text-muted mt-3">Découvrez ce que nos clients pensent de nos activités.</p>
    </div>

    {% for activite in activites %}
    {% if activite.avis|length > 0 %}
    <div class="mb-5" data-aos="fade-up">

        {# En-tête activité #}
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <div style="width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;font-size:1.4rem">
                    {% if activite.type == 'Sport' %}🏃
                    {% elseif activite.type == 'Culture' %}🎭
                    {% elseif activite.type == 'Gastronomie' %}🍽️
                    {% elseif activite.type == 'Aventure' %}🧗
                    {% else %}🌟{% endif %}
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="color:var(--primary-dark)">{{ activite.nom }}</h5>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="badge" style="background:#f0ebff;color:var(--primary);font-size:0.72rem">{{ activite.type }}</span>
                        <span style="color:#f39c12;font-size:0.85rem">
                            {% for i in 1..5 %}
                                <i class="bi bi-star{{ i <= activite.moyenne|round ? '-fill' : '' }}"></i>
                            {% endfor %}
                        </span>
                        <span class="text-muted small">{{ activite.moyenne }}/5 ({{ activite.avis|length }} avis)</span>
                    </div>
                </div>
            </div>
            <a href="{{ path('app_activite_show', {id: activite.id}) }}"
               class="btn btn-sm rounded-pill px-3"
               style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                <i class="bi bi-calendar-check me-1"></i>Voir l'activité
            </a>
        </div>

        {# Avis #}
        <div class="row g-3">
            {% for avis in activite.avis %}
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 60 }}">
                <div class="card border-0 rounded-4 h-100 p-4"
                     style="background:#fff;box-shadow:0 4px 16px rgba(108,63,197,0.07);border:1px solid #ede5ff!important">
                    <div style="color:#f39c12;font-size:0.9rem;margin-bottom:10px">
                        {% for i in 1..5 %}
                            <i class="bi bi-star{{ i <= avis.note ? '-fill' : '' }}"></i>
                        {% endfor %}
                    </div>
                    <p class="text-muted mb-3" style="font-size:0.88rem;line-height:1.7">
                        "{{ avis.commentaire|length > 130 ? avis.commentaire|slice(0,130) ~ '…' : avis.commentaire }}"
                    </p>
                    <div class="d-flex align-items-center gap-2 mt-auto pt-3"
                         style="border-top:1px solid #f0ebff">
                        <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem;flex-shrink:0">
                            {{ avis.auteur|slice(0,1)|upper }}
                        </div>
                        <span class="fw-semibold small" style="color:var(--primary-dark)">{{ avis.auteur }}</span>
                        <span class="ms-auto text-muted" style="font-size:0.72rem">{{ avis.createdAt|date('d/m/Y') }}</span>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

    </div>
    <hr style="border-color:#ede5ff;margin:40px 0">
    {% endif %}
    {% else %}
    <div class="text-center py-5 text-muted" data-aos="fade-up">
        <div style="font-size:4rem">💬</div>
        <p class="mt-3">Aucun avis pour le moment.</p>
        <a href="{{ path('app_activites') }}" class="btn rounded-pill px-4 mt-2"
           style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
            <i class="bi bi-calendar-event me-2"></i>Voir les activités
        </a>
    </div>
    {% endfor %}

</div>
{% endblock %}
