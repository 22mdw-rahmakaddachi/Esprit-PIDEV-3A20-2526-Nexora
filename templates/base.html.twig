    <!-- Particules -->
    <div class="ls-particle" style="width:80px;height:80px;left:10%;animation-duration:8s;animation-delay:0s"></div>
    <div class="ls-particle" style="width:40px;height:40px;left:25%;animation-duration:6s;animation-delay:1s"></div>
