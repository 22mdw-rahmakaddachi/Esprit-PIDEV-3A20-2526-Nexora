</div>

<script>
    // Compteur de pourcentage
    let pct = 0;
    const pctEl = document.getElementById('ls-percent');
    const pctInterval = setInterval(function() {
        pct = Math.min(pct + Math.floor(Math.random() * 8) + 2, 99);
        if (pctEl) pctEl.textContent = pct + '%';
    }, 80);

    document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (link && link.href && !link.target && !link.href.startsWith('#') &&
            link.href.startsWith(window.location.origin)) {
            document.getElementById('loading-screen').classList.remove('hide');
            document.body.classList.remove('loaded');
        }
    });

    document.addEventListener('submit', function() {
        document.getElementById('loading-screen').classList.remove('hide');
        document.body.classList.remove('loaded');
    });

    const start = Date.now();
    window.addEventListener('load', function() {
        clearInterval(pctInterval);
        if (pctEl) pctEl.textContent = '100%';
        const elapsed = Date.now() - start;
        const delay = Math.max(0, 800 - elapsed);
        setTimeout(function() {
            const loader = document.getElementById('loading-screen');
            loader.classList.add('hide');
            document.body.classList.add('loaded');
        }, delay);
    });
</script>

