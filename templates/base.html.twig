    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        // Init AOS animations
        AOS.init({ duration: 700, once: true, offset: 60 });

        // Navbar shadow on scroll
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNav');
            if (nav) nav.classList.toggle('scrolled', window.scrollY > 30);
        });

        // ── LANGUAGE SWITCHER ──
        (function() {
            const LANGS = { fr: 'Français', en: 'English', ar: 'العربية' };
            let currentLang = localStorage.getItem('nexora_lang') || 'fr';
            let originalTexts = new Map();

            function toggleLangMenu() {
                const menu = document.getElementById('lang-menu');
                if (!menu) return;
                menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
            }
            window.toggleLangMenu = toggleLangMenu;

            document.addEventListener('click', e => {
                const wrapper = document.getElementById('lang-wrapper');
                if (wrapper && !wrapper.contains(e.target)) {
                    const menu = document.getElementById('lang-menu');
                    if (menu) menu.style.display = 'none';
                }
            });

            function markActive(lang) {
                document.querySelectorAll('.lang-opt').forEach(b => {
                    b.classList.toggle('active', b.dataset.lang === lang);
                });
                document.documentElement.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
            }

            function showOverlay(msg) {
                const el = document.getElementById('translate-overlay');
                const msgEl = document.getElementById('translate-msg');
                if (el) { el.style.display = 'block'; }
                if (msgEl) msgEl.textContent = msg;
            }
            function hideOverlay() {
                const el = document.getElementById('translate-overlay');
                if (el) el.style.display = 'none';
            }

            // Get only meaningful text nodes (skip tiny/icon text)
            function getTextNodes() {
                const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
                    acceptNode(node) {
                        const p = node.parentElement;
                        if (!p) return NodeFilter.FILTER_REJECT;
                        const tag = p.tagName;
                        if (['SCRIPT','STYLE','NOSCRIPT','INPUT','TEXTAREA','SELECT'].includes(tag)) return NodeFilter.FILTER_REJECT;
                        if (p.closest('#translate-overlay,#lang-menu,[data-notranslate]')) return NodeFilter.FILTER_REJECT;
                        const text = node.textContent.trim();
                        // Only translate meaningful text (letters, min 3 chars)
                        if (text.length < 3 || !/[a-zA-ZÀ-ÿ\u0600-\u06FF]/.test(text)) return NodeFilter.FILTER_REJECT;
                        return NodeFilter.FILTER_ACCEPT;
                    }
                });
                const nodes = [];
                let n;
                while ((n = walker.nextNode())) nodes.push(n);
                return nodes;
            }

            // Translate single text using Google Translate unofficial endpoint
            async function translateOne(text, targetLang) {
                try {
                    const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=fr&tl=${targetLang}&dt=t&q=${encodeURIComponent(text)}`;
                    const res = await fetch(url);
                    const data = await res.json();
                    if (data && data[0]) {
                        return data[0].map(item => item[0]).join('');
                    }
                } catch {}
                return text;
            }

            // Translate all nodes in parallel batches
            async function translateAll(nodes, targetLang) {
                const BATCH = 5; // parallel requests
                for (let i = 0; i < nodes.length; i += BATCH) {
                    const batch = nodes.slice(i, i + BATCH);
                    await Promise.all(batch.map(async node => {
                        const orig = originalTexts.get(node) || node.textContent;
                        if (!originalTexts.has(node)) originalTexts.set(node, orig);
                        const translated = await translateOne(orig, targetLang);
                        node.textContent = translated;
                    }));
                    const pct = Math.round(((i + BATCH) / nodes.length) * 100);
                    showOverlay(`Traduction ${Math.min(pct,100)}%…`);
                }
            }

            async function applyTranslation(lang) {
                const nodes = getTextNodes();
                if (lang === 'fr') {
                    nodes.forEach(node => {
                        const orig = originalTexts.get(node);
                        if (orig) node.textContent = orig;
                    });
                    document.documentElement.setAttribute('dir', 'ltr');
                    return;
                }
                nodes.forEach(node => {
                    if (!originalTexts.has(node)) originalTexts.set(node, node.textContent);
                });
                await translateAll(nodes, lang);
            }

            async function setLang(lang) {
                const menu = document.getElementById('lang-menu');
                if (menu) menu.style.display = 'none';
                if (lang === currentLang) return;
                currentLang = lang;
                localStorage.setItem('nexora_lang', lang);
                markActive(lang);
                if (lang === 'fr') {
                    showOverlay('Restauration…');
                    await applyTranslation('fr');
                    hideOverlay();
                } else {
                    showOverlay(`Traduction 0%…`);
                    await applyTranslation(lang);
                    hideOverlay();
                }
            }
            window.setLang = setLang;

            // Init
            document.addEventListener('DOMContentLoaded', () => {
                markActive(currentLang);
                if (currentLang !== 'fr') {
                    showOverlay(`Traduction 0%…`);
                    applyTranslation(currentLang).then(hideOverlay);
                }
            });
        })();

        // ── DARK MODE TOGGLE ──
        (function() {
            function applyTheme(theme) {
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.style.colorScheme = theme;
                localStorage.setItem('nexora_theme', theme);
                const icon = document.getElementById('theme-icon');
                if (icon) icon.className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
            }
            applyTheme(localStorage.getItem('nexora_theme') || 'light');
            document.addEventListener('DOMContentLoaded', () => {
                const btn = document.getElementById('theme-toggle');
                if (btn) btn.addEventListener('click', () => {
                    const current = document.documentElement.getAttribute('data-theme');
                    applyTheme(current === 'dark' ? 'light' : 'dark');
                });
            });
        })();

        // Auto-dismiss flash messages
        setTimeout(() => {
            document.querySelectorAll('.flash-container .alert').forEach(el => {
                el.classList.remove('show');
                setTimeout(() => el.remove(), 300);
            });
        }, 4000);

        // ── Charger les badges de notification ──
        function updateBadge(elId, count) {
            const el = document.getElementById(elId);
            if (!el) return;
            if (count > 0) {
                el.textContent = count > 99 ? '99+' : count;
                el.style.display = 'block';
            } else {
                el.style.display = 'none';
            }
        }

        // Appel API pour récupérer les compteurs
        fetch('/api/badges')
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data) return;
                updateBadge('badge-historique', data.mesActivites ?? 0);
                updateBadge('badge-demandes',   data.demandes ?? 0);
            })
            .catch(() => {});

        // Rafraîchir toutes les 30 secondes
        setInterval(() => {
            fetch('/api/badges')
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (!data) return;
                    updateBadge('badge-historique', data.mesActivites ?? 0);
                    updateBadge('badge-demandes',   data.demandes ?? 0);
                })
                .catch(() => {});
        }, 30000);

        // ── Notifications temps réel (polling SSE) ──
        {% if app.user %}
        (function() {
            let lastId = 0;

            // Conteneur toast
            const toastContainer = document.createElement('div');
            toastContainer.style.cssText = 'position:fixed;top:80px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:10px;min-width:320px;max-width:380px';
            document.body.appendChild(toastContainer);

            function showToast(titre, message, type) {
                const colors = {
                    'NOUVELLE_DEMANDE': { bg: '#6c3fc5', icon: '📩' },
                    'ACCEPTATION':      { bg: '#16a34a', icon: '✅' },
                    'REFUS':            { bg: '#dc2626', icon: '❌' },
                    'PAIEMENT':         { bg: '#0284c7', icon: '💳' },
                };
                const c = colors[type] || { bg: '#6c3fc5', icon: '🔔' };

                const toast = document.createElement('div');
                toast.style.cssText = `background:#fff;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.15);overflow:hidden;animation:slideIn 0.3s ease;border-left:4px solid ${c.bg}`;
                toast.innerHTML = `
                    <div style="padding:14px 16px;display:flex;align-items:flex-start;gap:12px">
                        <div style="font-size:22px;flex-shrink:0">${c.icon}</div>
                        <div style="flex:1">
                            <div style="font-weight:700;font-size:14px;color:#222;margin-bottom:3px">${titre}</div>
                            <div style="font-size:13px;color:#666;line-height:1.4">${message}</div>
                        </div>
                        <button onclick="this.closest('div[style]').remove()" style="background:none;border:none;color:#aaa;font-size:18px;cursor:pointer;padding:0;line-height:1">×</button>
                    </div>
                    <div style="height:3px;background:${c.bg};animation:toastProgress 5s linear forwards"></div>
                `;

                const style = document.createElement('style');
                style.textContent = `
                    @keyframes slideIn { from { transform:translateX(120%);opacity:0 } to { transform:translateX(0);opacity:1 } }
                    @keyframes toastProgress { from { width:100% } to { width:0% } }
                `;
                document.head.appendChild(style);

                toastContainer.appendChild(toast);
                setTimeout(() => toast.remove(), 5500);

                // Mettre à jour les badges
                fetch('/api/badges').then(r => r.ok ? r.json() : null).then(data => {
                    if (!data) return;
                    updateBadge('badge-historique', data.mesActivites ?? 0);
                    updateBadge('badge-demandes',   data.demandes ?? 0);
                }).catch(() => {});
            }

            function pollNotifications() {
                fetch('/api/notifications/stream?lastId=' + lastId)
                    .then(r => r.ok ? r.json() : [])
                    .then(notifications => {
                        if (!Array.isArray(notifications)) return;
                        notifications.forEach(n => {
                            showToast(n.titre, n.message, n.type);
                            if (n.id > lastId) lastId = n.id;
                        });
                    })
                    .catch(() => {});
            }

            // Initialiser lastId avec la dernière notification connue
            fetch('/api/notifications/stream?lastId=0')
                .then(r => r.ok ? r.json() : [])
                .then(notifications => {
                    if (Array.isArray(notifications) && notifications.length > 0) {
                        lastId = Math.max(...notifications.map(n => n.id));
                    }
                })
                .catch(() => {})
                .finally(() => {
                    // Démarrer le polling toutes les 5 secondes
                    setInterval(pollNotifications, 5000);
                });
        })();

        // ── CLOCHE NOTIFICATIONS (commentaires/réactions publications) ──
        let notifOpen = false;

        function toggleNotifDropdown() {
            notifOpen = !notifOpen;
            const dd = document.getElementById('notif-dropdown');
            if (!dd) return;
            dd.style.display = notifOpen ? 'block' : 'none';
            if (notifOpen) loadNotifList();
        }

        // Fermer si clic dehors
        document.addEventListener('click', e => {
            const wrap = document.getElementById('notif-wrap');
            if (notifOpen && wrap && !wrap.contains(e.target)) {
                notifOpen = false;
                const dd = document.getElementById('notif-dropdown');
                if (dd) dd.style.display = 'none';
            }
        });

        function loadNotifList() {
            fetch('/notifications/api/unread')
                .then(r => r.json())
                .then(data => {
                    const list  = document.getElementById('notif-list');
                    const empty = document.getElementById('notif-empty');
                    const badge = document.getElementById('notif-badge');
                    if (!list) return;

                    if (data.count > 0) {
                        badge.style.display = 'block';
                        badge.textContent   = data.count > 99 ? '99+' : data.count;
                        empty.style.display = 'none';
                        list.innerHTML = data.notifications.map(n => `
                            <div onclick="readNotif(${n.id}, '${n.related_type}', ${n.related_id ?? 0})"
                                 style="padding:12px 16px;border-bottom:1px solid #f0ebff;cursor:pointer;
                                        background:${n.is_read ? 'transparent' : '#f5f0ff'};
                                        display:flex;gap:12px;align-items:flex-start;transition:background 0.2s"
                                 onmouseover="this.style.background='#f0ebff'"
                                 onmouseout="this.style.background='${n.is_read ? 'transparent' : '#f5f0ff'}'">
                                <div style="width:38px;height:38px;border-radius:50%;flex-shrink:0;
                                            background:linear-gradient(135deg,#6c3fc5,#9b59b6);
                                            display:flex;align-items:center;justify-content:center;
                                            font-size:1.1rem">
                                    ${n.type === 'reaction' ? '❤️' : '💬'}
                                </div>
                                <div style="flex:1;min-width:0">
                                    <div style="font-size:0.85rem;color:#333;line-height:1.5">${n.message}</div>
                                    <div style="font-size:0.72rem;color:#aaa;margin-top:3px">${timeAgo(n.created_at)}</div>
                                </div>
                                ${!n.is_read ? '<div style="width:8px;height:8px;border-radius:50%;background:#e74c3c;flex-shrink:0;margin-top:6px"></div>' : ''}
                            </div>
                        `).join('');
                    } else {
                        badge.style.display = 'none';
                        list.innerHTML      = '';
                        empty.style.display = 'block';
                    }
                }).catch(() => {});
        }

        function readNotif(id, type, relatedId) {
            fetch(`/notifications/mark-read/${id}`, { method: 'POST' });
            notifOpen = false;
            document.getElementById('notif-dropdown').style.display = 'none';
            if (type === 'publication' && relatedId) {
                window.location.href = `/publications#pub-${relatedId}`;
            }
        }

        function markAllRead() {
            fetch('/notifications/mark-all-read', { method: 'POST' })
                .then(() => loadNotifList());
        }

        function timeAgo(dateStr) {
            const diff = Math.floor((Date.now() - new Date(dateStr)) / 1000);
            if (diff < 60)   return 'À l\'instant';
            if (diff < 3600) return `Il y a ${Math.floor(diff/60)} min`;
            if (diff < 86400) return `Il y a ${Math.floor(diff/3600)} h`;
            return `Il y a ${Math.floor(diff/86400)} j`;
        }

        // Polling badge cloche toutes les 10 secondes
        function pollNotifBadge() {
            fetch('/notifications/api/unread')
                .then(r => r.json())
                .then(data => {
                    const badge = document.getElementById('notif-badge');
                    if (!badge) return;
                    if (data.count > 0) {
                        badge.style.display = 'block';
                        badge.textContent   = data.count > 99 ? '99+' : data.count;
                    } else {
                        badge.style.display = 'none';
                    }
                }).catch(() => {});
        }

        // Charger au démarrage + toutes les 10s
        pollNotifBadge();
        setInterval(pollNotifBadge, 10000);

        {% endif %}
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
