<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}TripShop{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <style>
        :root {
            --primary:       #6c3fc5;
            --primary-dark:  #4e2d9a;
            --primary-light: #a78bda;
            --accent:        #9b59b6;
            --accent-light:  #c39bd3;
            --bg:            #f9f7ff;
            --white:         #ffffff;
            --card-shadow:   0 6px 24px rgba(108,63,197,0.10);
            --card-shadow-hover: 0 16px 40px rgba(108,63,197,0.18);
        }

        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: #333; overflow-x: hidden; }
        h1,h2,h3,.brand { font-family: 'Playfair Display', serif; }

        /* ── SCROLLBAR ── */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f0ebff; }
        ::-webkit-scrollbar-thumb { background: var(--primary-light); border-radius: 10px; }

        /* ── NAV ICON BUTTONS (style Facebook) ── */
        .nav-icon-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #f0ebff;
            color: var(--primary);
            font-size: 1.15rem;
            text-decoration: none;
            transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }
        .nav-icon-btn:hover {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(108,63,197,0.3);
        }
        .nav-icon-btn.active {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            box-shadow: 0 4px 14px rgba(108,63,197,0.25);
        }
        .nav-icon-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 50px;
            background: #e74c3c;
            color: #fff;
            font-size: 0.68rem;
            font-weight: 700;
            line-height: 18px;
            text-align: center;
            border: 2px solid #fff;
            animation: badgePop 0.3s cubic-bezier(.36,.07,.19,.97);
        }
        @keyframes badgePop {
            0%   { transform: scale(0); }
            70%  { transform: scale(1.3); }
            100% { transform: scale(1); }
        }
        /* Tooltip au hover */
        .nav-icon-btn .nav-icon-tooltip {
            position: absolute;
            bottom: -32px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--primary-dark);
            color: #fff;
            font-size: 0.72rem;
            padding: 3px 10px;
            border-radius: 50px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
            z-index: 100;
        }
        .nav-icon-btn:hover .nav-icon-tooltip { opacity: 1; }

        /* Séparateur vertical navbar */
        .nav-divider {
            width: 1px;
            height: 28px;
            background: #ede5ff;
            margin: 0 4px;
        }

        /* ── TOPBAR ── */
        .topbar {
            background: linear-gradient(90deg, var(--primary-dark), var(--primary));
            color: #e8d5ff;
            font-size: 0.8rem;
            padding: 7px 0;
        }
        .topbar a { color: #e8d5ff; text-decoration: none; transition: color 0.2s; }
        .topbar a:hover { color: #fff; }

        /* ── NAVBAR ── */
        .navbar {
            background: var(--white);
            border-bottom: 2px solid #ede5ff;
            padding: 14px 0;
            transition: box-shadow 0.3s;
        }
        .navbar.scrolled { box-shadow: 0 4px 20px rgba(108,63,197,0.12); }
        .navbar-brand {
            font-family: 'Playfair Display', serif;
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--primary) !important;
        }
        .navbar-brand span { color: var(--accent-light); }
        .nav-link {
            color: #444 !important;
            font-weight: 500;
            font-size: 0.92rem;
            padding: 6px 16px !important;
            border-radius: 50px;
            transition: all 0.25s;
        }
        .nav-link:hover { color: var(--primary) !important; background: #f0ebff; }
        .nav-link.active { color: var(--primary) !important; background: #ede5ff; font-weight: 600; }
        .btn-cart {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            border-radius: 50px;
            padding: 8px 20px;
            font-size: 0.88rem;
            border: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-cart:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(108,63,197,0.35);
        }

        /* ── HERO ── */
        .hero {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 50%, var(--accent) 100%);
            color: #fff;
            padding: 90px 0 80px;
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: -80px; right: -80px;
            width: 400px; height: 400px;
            background: rgba(255,255,255,0.06);
            border-radius: 50%;
            animation: float 6s ease-in-out infinite;
        }
        .hero::after {
            content: '';
            position: absolute;
            bottom: -100px; left: -60px;
            width: 300px; height: 300px;
            background: rgba(255,255,255,0.04);
            border-radius: 50%;
            animation: float 8s ease-in-out infinite reverse;
        }
        .hero h1 { font-size: 3rem; font-weight: 700; line-height: 1.2; }
        .hero p { font-size: 1.1rem; opacity: 0.88; }
        .btn-hero {
            background: #fff;
            color: var(--primary);
            border: none;
            padding: 13px 34px;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-hero:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(0,0,0,0.2);
            color: var(--primary-dark);
        }
        .btn-hero-outline {
            background: transparent;
            color: #fff;
            border: 2px solid rgba(255,255,255,0.6);
            padding: 13px 34px;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-hero-outline:hover { background: rgba(255,255,255,0.15); color: #fff; border-color: #fff; }

        /* ── SECTION TITLE ── */
        .section-title {
            font-size: 1.9rem;
            font-weight: 700;
            color: var(--primary-dark);
            position: relative;
            padding-bottom: 12px;
        }
        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0;
            width: 50px; height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--accent-light));
            border-radius: 2px;
        }

        /* ── PRODUCT CARD ── */
        .product-card {
            background: var(--white);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s cubic-bezier(.25,.8,.25,1), box-shadow 0.3s;
            border: none;
        }
        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--card-shadow-hover);
        }
        .product-card .img-wrap {
            height: 220px;
            background: linear-gradient(135deg, #f0ebff, #e8d5ff);
            display: flex; align-items: center; justify-content: center;
            font-size: 4rem;
            position: relative;
            overflow: hidden;
        }
        .product-card .img-wrap::after {
            content: '';
            position: absolute; inset: 0;
            background: linear-gradient(to bottom, transparent 60%, rgba(108,63,197,0.08));
        }
        .badge-cat {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            font-size: 0.72rem;
            border-radius: 50px;
            padding: 3px 12px;
        }
        .price { font-size: 1.2rem; font-weight: 700; color: var(--primary); }
        .price-old { font-size: 0.9rem; color: #aaa; text-decoration: line-through; }
        .btn-add {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            border: none;
            border-radius: 50px;
            padding: 9px 20px;
            font-size: 0.85rem;
            width: 100%;
            transition: opacity 0.2s, transform 0.2s;
        }
        .btn-add:hover { opacity: 0.9; transform: scale(1.02); color: #fff; }

        /* ── ACTIVITY CARD ── */
        .activity-card {
            background: var(--white);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s cubic-bezier(.25,.8,.25,1), box-shadow 0.3s;
            border: none;
        }
        .activity-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--card-shadow-hover);
        }
        .activity-card .img-wrap {
            height: 200px;
            background: linear-gradient(135deg, var(--primary-dark), var(--primary));
            display: flex; align-items: center; justify-content: center;
            font-size: 4rem;
            position: relative;
        }
        .btn-activity {
            background: linear-gradient(135deg, var(--accent), var(--primary));
            color: #fff;
            border: none;
            border-radius: 50px;
            padding: 9px 20px;
            font-size: 0.85rem;
            width: 100%;
            transition: opacity 0.2s, transform 0.2s;
        }
        .btn-activity:hover { opacity: 0.9; transform: scale(1.02); color: #fff; }

        /* ── FILTER SIDEBAR ── */
        .filter-sidebar {
            background: var(--white);
            border-radius: 16px;
            padding: 24px;
            box-shadow: var(--card-shadow);
            border: 1px solid #ede5ff;
        }
        .filter-sidebar h6 {
            font-weight: 700;
            color: var(--primary);
            text-transform: uppercase;
            font-size: 0.78rem;
            letter-spacing: 1.2px;
            margin-bottom: 14px;
        }
        .filter-sidebar .form-check-input:checked { background-color: var(--primary); border-color: var(--primary); }

        /* ── CATEGORY PILLS ── */
        .cat-pill {
            display: inline-block;
            padding: 7px 18px;
            border-radius: 50px;
            background: var(--white);
            border: 1.5px solid #ddd;
            font-size: 0.85rem;
            color: #555;
            cursor: pointer;
            transition: all 0.25s;
            text-decoration: none;
        }
        .cat-pill:hover, .cat-pill.active {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-color: transparent;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(108,63,197,0.3);
        }

        /* ── STATS BAR ── */
        .stats-bar { background: var(--white); border-bottom: 1px solid #ede5ff; }
        .stat-item { transition: transform 0.2s; }
        .stat-item:hover { transform: translateY(-3px); }
        .stat-num { font-size: 1.6rem; font-weight: 700; color: var(--primary); }

        /* ── BREADCRUMB ── */
        .breadcrumb-section { background: var(--white); padding: 12px 0; border-bottom: 1px solid #ede5ff; }
        .breadcrumb-item a { color: var(--primary); text-decoration: none; }
        .breadcrumb-item.active { color: #888; }

        /* ── FLASH ── */
        .flash-container { position: fixed; top: 80px; right: 20px; z-index: 9999; min-width: 300px; }

        /* ── FOOTER ── */
        footer {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary));
            color: #d8c5f5;
            padding: 55px 0 20px;
            margin-top: 70px;
        }
        footer h5 { color: #fff; font-family: 'Playfair Display', serif; margin-bottom: 16px; }
        footer a { color: #d8c5f5; text-decoration: none; font-size: 0.9rem; display: block; margin-bottom: 7px; transition: color 0.2s, padding-left 0.2s; }
        footer a:hover { color: #fff; padding-left: 6px; }
        footer .footer-bottom { border-top: 1px solid rgba(255,255,255,0.15); margin-top: 30px; padding-top: 20px; font-size: 0.82rem; }

        /* ── ANIMATIONS ── */
        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50%       { transform: translateY(-20px) rotate(5deg); }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes pulse-ring {
            0%   { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(108,63,197,0.4); }
            70%  { transform: scale(1);    box-shadow: 0 0 0 12px rgba(108,63,197,0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(108,63,197,0); }
        }
        @keyframes shimmer {
            0%   { background-position: -200% center; }
            100% { background-position: 200% center; }
        }

        .animate-fadeup { animation: fadeInUp 0.6s ease both; }

        /* bouton pulsant */
        .btn-pulse { animation: pulse-ring 2s infinite; }

        /* texte dégradé animé */
        .text-gradient {
            background: linear-gradient(90deg, var(--primary), var(--accent-light), var(--primary));
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shimmer 3s linear infinite;
        }

        /* hover image zoom */
        .img-zoom { overflow: hidden; }
        .img-zoom img, .img-zoom .emoji-img {
            transition: transform 0.4s ease;
        }
        .img-zoom:hover .emoji-img { transform: scale(1.15); }

        /* badge animé */
        .badge-new {
            background: linear-gradient(135deg, #ff6b6b, #ee5a24);
            color: #fff;
            font-size: 0.68rem;
            border-radius: 50px;
            padding: 2px 8px;
            animation: pulse-ring 2s infinite;
        }

        /* ligne de séparation stylée */
        .divider {
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--primary-light), transparent);
            border: none;
            margin: 40px 0;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

    {# TOPBAR #}
    <div class="topbar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-telephone-fill me-1"></i> +216 00 000 000
                <span class="mx-3 opacity-50">|</span>
                <i class="bi bi-envelope-fill me-1"></i> contact@tripshop.tn
            </div>
            <div class="d-flex gap-3">
                <a href="#"><i class="bi bi-facebook"></i></a>
                <a href="#"><i class="bi bi-instagram"></i></a>
                <a href="#"><i class="bi bi-twitter-x"></i></a>
            </div>
        </div>
    </div>

    {# NAVBAR #}
    <nav class="navbar navbar-expand-lg sticky-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">Trip<span>Shop</span></a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav mx-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') == 'app_home' %}active{% endif %}"
                           href="{{ path('app_home') }}">
                            <i class="bi bi-house-fill me-1"></i>Accueil
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if 'produit' in app.request.get('_route') %}active{% endif %}"
                           href="{{ path('app_produits') }}">
                            <i class="bi bi-bag-fill me-1"></i>Boutique
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if 'activite' in app.request.get('_route') %}active{% endif %}"
                           href="{{ path('app_activites') }}">
                            <i class="bi bi-calendar-event-fill me-1"></i>Activités
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <a href="{{ path('app_panier') }}" class="btn btn-cart btn-pulse position-relative">
                        <i class="bi bi-cart3 me-1"></i>Panier
                        <span id="badge-panier" class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                              style="background:#e74c3c;font-size:0.65rem;display:none">0</span>
                    </a>
                    <a href="{{ path('admin_dashboard') }}" class="btn btn-sm rounded-pill px-3"
                       style="border:1.5px solid var(--primary);color:var(--primary)">
                        <i class="bi bi-shop me-1"></i>Espace Partenaire
                    </a>
                </div>
            </div>
        </div>
    </nav>

    {# FLASH MESSAGES #}
    <div class="flash-container">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show shadow-sm" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    {# CONTENT #}
    {% block body %}{% endblock %}

    {# FOOTER #}
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4" data-aos="fade-up">
                    <h5>Trip<span style="color:var(--accent-light)">Shop</span></h5>
                    <p style="font-size:0.9rem;opacity:0.8">Votre plateforme de produits outdoor et d'activités en Tunisie.</p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-white fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white fs-5"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white fs-5"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                <div class="col-md-2" data-aos="fade-up" data-aos-delay="100">
                    <h5>Boutique</h5>
                    <a href="{{ path('app_produits') }}">Tous les produits</a>
                    <a href="#">Nouveautés</a>
                    <a href="#">Promotions</a>
                </div>
                <div class="col-md-2" data-aos="fade-up" data-aos-delay="200">
                    <h5>Activités</h5>
                    <a href="{{ path('app_activites') }}">Toutes les activités</a>
                    <a href="#">Sport</a>
                    <a href="#">Culture</a>
                </div>
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                    <h5>Newsletter</h5>
                    <p style="font-size:0.88rem;opacity:0.8">Recevez nos offres et nouveautés.</p>
                    <div class="input-group">
                        <input type="email" class="form-control form-control-sm rounded-start-pill"
                               placeholder="Votre email">
                        <button class="btn btn-sm rounded-end-pill px-3"
                                style="background:#fff;color:var(--primary);font-weight:600">OK</button>
                    </div>
                </div>
            </div>
            <div class="footer-bottom text-center opacity-75">
                © {{ "now"|date("Y") }} TripShop — Tous droits réservés
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        // Init AOS animations
        AOS.init({ duration: 700, once: true, offset: 60 });

        // Navbar shadow on scroll
        window.addEventListener('scroll', () => {
            document.getElementById('mainNav').classList.toggle('scrolled', window.scrollY > 30);
        });

        // Auto-dismiss flash messages
        setTimeout(() => {
            document.querySelectorAll('.flash-container .alert').forEach(el => {
                el.classList.remove('show');
                setTimeout(() => el.remove(), 300);
            });
        }, 4000);

        // ── Charger les badges de notification ──
        function updateBadge(elId, count) {
            const el = document.getElementById(elId);
            if (!el) return;
            if (count > 0) {
                el.textContent = count > 99 ? '99+' : count;
                el.style.display = 'block';
            } else {
                el.style.display = 'none';
            }
        }

        // Appel API pour récupérer les compteurs
        fetch('/api/badges')
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data) return;
                updateBadge('badge-historique', data.mesActivites ?? 0);
                updateBadge('badge-demandes',   data.demandes ?? 0);
            })
            .catch(() => {});

        // Rafraîchir toutes les 30 secondes
        setInterval(() => {
            fetch('/api/badges')
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (!data) return;
                    updateBadge('badge-historique', data.mesActivites ?? 0);
                    updateBadge('badge-demandes',   data.demandes ?? 0);
                })
                .catch(() => {});
        }, 30000);

        // Badge panier
        fetch('/panier/api/count')
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data) return;
                const badge = document.getElementById('badge-panier');
                if (badge && data.count > 0) {
                    badge.textContent = data.count;
                    badge.style.display = 'inline';
                }
            })
            .catch(() => {});
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
