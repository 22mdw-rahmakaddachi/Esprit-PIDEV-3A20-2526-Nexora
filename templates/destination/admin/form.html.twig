{# templates/destination/admin/form.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Ajouter' }} une Destination{% endblock %}
{% block page_title %}{{ isEdit ? 'Modifier' : 'Nouvelle' }} Destination{% endblock %}

{% block stylesheets %}
<style>
    /* ─── Autocomplete ─── */
    .localisation-wrapper { position: relative; }
    #autocomplete-list {
        display: none; position: absolute; z-index: 999; top: calc(100% + 4px);
        left: 0; right: 0; background: white; border: 1.5px solid var(--primary);
        border-radius: 10px; box-shadow: 0 12px 32px rgba(108,63,197,0.15);
        max-height: 250px; overflow-y: auto; animation: acDrop .15s ease;
    }
    #autocomplete-list.open { display: block; }
    @keyframes acDrop { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
    .autocomplete-item { display: flex; align-items: center; gap: 10px; padding: 11px 16px; cursor: pointer; font-size: .85rem; color: #333; border-bottom: 1px solid #f0ebff; transition: background .1s; }
    .autocomplete-item:hover, .autocomplete-item.ac-active { background: #f0ebff; }
    .autocomplete-item .ac-text mark {
        background: transparent;
        color: var(--primary);
        font-weight: 700;
        text-decoration: underline;
    }
    .ac-loading, .ac-empty { padding: 14px 16px; font-size: .85rem; color: #666; display: flex; align-items: center; gap: 10px; }
    .ac-spinner { width: 16px; height: 16px; border: 2px solid #ddd; border-top-color: var(--primary); border-radius: 50%; animation: spin .6s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .localisation-wrapper .loc-input-wrap { position: relative; }
    .localisation-wrapper .loc-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); z-index: 1; }
    .localisation-wrapper input { padding-left: 38px !important; }

    /* ─── Zone upload ─── */
    .image-upload-zone { border: 2px dashed #ede5ff; border-radius: 12px; padding: 30px; text-align: center; transition: all .2s; cursor: pointer; position: relative; min-height: 120px; }
    .image-upload-zone:hover { border-color: var(--primary); background: #f9f7ff; }
    .image-upload-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; z-index: 5; }
    .upload-hint .icon { font-size: 2.5rem; margin-bottom: 8px; }
    .upload-hint p { font-weight: 600; color: var(--primary-dark); }

    .preview-inner { display: none; flex-direction: column; align-items: center; gap: 14px; }
    .preview-inner.active { display: flex; }
    .preview-grid-inner { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
    .preview-thumb { position: relative; width: 100px; height: 74px; border-radius: 8px; overflow: hidden; border: 2px solid var(--primary); box-shadow: 0 4px 12px rgba(108,63,197,0.15); animation: thumbIn .2s ease; }
    @keyframes thumbIn { from { scale: .8; opacity: 0; } to { scale: 1; opacity: 1; } }
    .preview-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .preview-thumb .rm-btn { position: absolute; top: 3px; right: 3px; background: rgba(220,38,38,.8); color: white; border: none; border-radius: 50%; width: 22px; height: 22px; font-size: .75rem; cursor: pointer; z-index: 10; }
    
    .add-more-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #f0ebff; color: var(--primary); border: 1.5px solid var(--primary); border-radius: 10px; font-weight: 600; font-size: .82rem; cursor: pointer; z-index: 10; }

    .img-thumb { position: relative; width: 110px; height: 80px; border-radius: 10px; overflow: hidden; border: 2px solid #ede5ff; }
    .img-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .img-thumb .delete-btn { position: absolute; top: 4px; right: 4px; background: rgba(220,38,38,.9); color: white; border: none; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .2s; cursor: pointer; }
    .img-thumb:hover .delete-btn { opacity: 1; }
    .img-thumb .badge-main { position: absolute; bottom: 4px; left: 4px; background: var(--primary); color: white; font-size: .6rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; }
</style>
{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <a href="{{ path('admin_destination_index') }}" class="btn-edit-admin btn-sm text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
    </a>
    <h1>{{ isEdit ? '✏️ Modifier Destination' : '➕ Nouvelle Destination' }}</h1>
</div>

<div class="form-card mx-auto" style="max-width: 800px;">
    {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate', id: 'destForm'}}) }}

    <div class="row g-3">
        <div class="col-12">
            <label class="form-label">{{ form_label(form.nom) }}</label>
            {{ form_widget(form.nom, {attr: {class: 'form-control', placeholder: 'Ex: Paris, France'}}) }}
            {{ form_errors(form.nom) }}
        </div>

        <div class="col-12">
            <label class="form-label">{{ form_label(form.description) }}</label>
            {{ form_widget(form.description, {attr: {class: 'form-control', rows: 4, placeholder: 'Une belle description...'}}) }}
        </div>

        <div class="col-12">
            <label class="form-label">{{ form_label(form.localisation) }}</label>
            <div class="localisation-wrapper">
                <div class="loc-input-wrap">
                    <span class="loc-icon">📍</span>
                    {{ form_widget(form.localisation, {attr: {class: 'form-control', autocomplete: 'off', placeholder: 'Rechercher un lieu...'}}) }}
                </div>
                <div id="autocomplete-list"></div>
            </div>
            {{ form_errors(form.localisation) }}
        </div>

        <div class="col-md-6">
            <label class="form-label">{{ form_label(form.capaciteMax) }}</label>
            {{ form_widget(form.capaciteMax, {attr: {class: 'form-control', min: 1}}) }}
            {{ form_errors(form.capaciteMax) }}
        </div>

        <div class="col-md-6">
            <label class="form-label">{{ form_label(form.dateLancement) }}</label>
            {{ form_widget(form.dateLancement, {attr: {class: 'form-control'}}) }}
            {{ form_errors(form.dateLancement) }}
        </div>

        <div class="col-12 mt-4">
            <label class="form-label d-block mb-2">🖼️ Galerie d'images</label>
            
            {% if isEdit and destination.destinationImages|length > 0 %}
            <div class="mb-3">
                <small class="text-muted text-uppercase fw-bold mb-2 d-block" style="font-size:0.7rem">Images actuelles</small>
                <div class="d-flex flex-wrap gap-2">
                    {% for img in destination.destinationImages %}
                    <div class="img-thumb" id="thumb-{{ img.id }}">
                        <img src="{{ img.displayChemin }}" alt="Thumbnail">
                        {% if loop.first %}<span class="badge-main">Principale</span>{% endif %}
                        <button type="button" class="delete-btn" onclick="deleteExistingImage({{ img.id }}, '{{ csrf_token('delete-image-' ~ img.id) }}')">✕</button>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <div class="image-upload-zone" id="uploadZone">
                {{ form_widget(form.imageFiles, {attr: {accept: 'image/*', multiple: 'multiple'}}) }}
                <div class="upload-hint" id="uploadHint">
                    <div class="icon">📷</div>
                    <p>Déposez vos nouvelles images ici</p>
                    <small class="text-muted">Plusieurs fichiers autorisés</small>
                </div>
                <div class="preview-inner" id="previewInner">
                    <div class="preview-grid-inner" id="previewGrid"></div>
                    <span class="small text-muted my-2 d-block" id="fileCountLabel"></span>
                    <button type="button" class="add-more-btn" onclick="document.getElementById('imageFilesInput').click()">
                        <i class="bi bi-plus-lg"></i> Ajouter d'autres
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4 pt-3 border-top">
        <button type="submit" class="btn-primary-admin">
            <i class="bi bi-check-lg me-1"></i> {{ isEdit ? 'Sauvegarder' : 'Créer destination' }}
        </button>
        <a href="{{ path('admin_destination_index') }}" class="btn-edit-admin py-2 px-3">Annuler</a>
    </div>

    {{ form_end(form) }}
</div>
<script>const _locFieldId = "{{ form.localisation.vars.id }}";</script>
{% endblock %}

{% block javascripts %}
<script>
// ============ UPLOAD LOGIC ============
(function() {
    const zone = document.getElementById('uploadZone');
    const input = zone ? zone.querySelector('input[type="file"]') : null;
    const hint = document.getElementById('uploadHint');
    const previewInner = document.getElementById('previewInner');
    const grid = document.getElementById('previewGrid');
    const countLabel = document.getElementById('fileCountLabel');
    
    if (!zone || !input) return;

    let allFiles = new DataTransfer();

    function sync() { try { input.files = allFiles.files; } catch(e) {} }
    function render() {
        grid.innerHTML = '';
        const files = Array.from(allFiles.files);
        if (!files.length) { hint.style.display = 'block'; previewInner.classList.remove('active'); return; }
        hint.style.display = 'none'; previewInner.classList.add('active');
        countLabel.textContent = files.length + ' image' + (files.length > 1 ? 's' : '') + ' sélectionnée(s)';
        files.forEach((file, idx) => {
            const reader = new FileReader();
            reader.onload = e => {
                const thumb = document.createElement('div');
                thumb.className = 'preview-thumb';
                thumb.innerHTML = `<img src="${e.target.result}"><button type="button" class="rm-btn" onclick="removeFile(${idx})">✕</button>`;
                grid.appendChild(thumb);
            };
            reader.readAsDataURL(file);
        });
    }
    window.removeFile = idx => {
        const up = new DataTransfer();
        Array.from(allFiles.files).forEach((f, i) => { if (i !== idx) up.items.add(f); });
        allFiles = up; sync(); render();
    };
    input.addEventListener('change', function() { Array.from(this.files).forEach(f => allFiles.items.add(f)); sync(); render(); });
    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('opacity-75'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('opacity-75'));
    zone.addEventListener('drop', e => { e.preventDefault(); zone.classList.remove('opacity-75'); Array.from(e.dataTransfer.files).forEach(f => { if(f.type.startsWith('image/')) allFiles.items.add(f); }); sync(); render(); });
})();

// ============ DELETE IMAGE ============
function deleteExistingImage(id, token) {
    if (!confirm('Supprimer cette image ?')) return;
    const fd = new FormData(); fd.append('_token', token);
    fetch('/admin/destinations/image/' + id + '/delete', { method: 'POST', body: fd })
    .then(r => r.json()).then(d => { if(d.success) { const el = document.getElementById('thumb-'+id); el.style.scale = '0'; setTimeout(()=>el.remove(), 300); } });
}

// ============ AUTOCOMPLETE ============
(function() {
    // Plusieurs sélecteurs pour pallier les défauts de vars.id vs manual id
    const input = document.getElementById(_locFieldId) 
               || document.getElementById('localisation-field')
               || document.querySelector('input[name*="[localisation]"]');
               
    if (!input) {
        console.warn("Autocomplete: input not found with id", _locFieldId);
        return;
    }

    const dropdown = document.getElementById('autocomplete-list');
    let timer, activeIdx = -1, results = [];

    const close = () => { dropdown.classList.remove('open'); dropdown.innerHTML = ''; activeIdx = -1; };
    const setActive = i => {
        const items = dropdown.querySelectorAll('.autocomplete-item');
        items.forEach(el => el.classList.remove('ac-active'));
        if (i >= 0 && i < items.length) { items[i].classList.add('ac-active'); items[i].scrollIntoView({block:'nearest'}); }
        activeIdx = i;
    };

    function highlight(text, query) {
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return text.replace(new RegExp('(' + escaped + ')', 'gi'), '<mark>$1</mark>');
    }

    const handleInput = () => {
        clearTimeout(timer);
        const q = input.value.trim();
        if (q.length < 3) { close(); return; }
        
        dropdown.innerHTML = '<div class="ac-loading"><div class="ac-spinner"></div>Recherche...</div>';
        dropdown.classList.add('open');
        
        timer = setTimeout(() => {
            fetch("{{ path('destination_autocomplete_location') }}?q=" + encodeURIComponent(q))
            .then(r => r.json()).then(data => {
                results = data;
                if (!data.length) { dropdown.innerHTML = '<div class="ac-empty">Aucun résultat</div>'; return; }
                dropdown.innerHTML = '';
                data.forEach((res, i) => {
                    const item = document.createElement('div');
                    item.className = 'autocomplete-item';
                    item.innerHTML = `<span class="ac-icon">📍</span><span class="ac-text">${highlight(res, q)}</span>`;
                    item.addEventListener('mousedown', e => { e.preventDefault(); input.value = res; close(); input.focus(); });
                    dropdown.appendChild(item);
                });
            });
        }, 350);
    };

    input.addEventListener('input', handleInput);
    input.addEventListener('keydown', e => {
        const items = dropdown.querySelectorAll('.autocomplete-item');
        if (!items.length) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(activeIdx + 1, items.length - 1)); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(activeIdx - 1, 0)); }
        else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); input.value = results[activeIdx]; close(); }
        else if (e.key === 'Escape') close();
    });
    document.addEventListener('click', e => { if (!input.contains(e.target) && !dropdown.contains(e.target)) close(); });
})();
</script>
{% endblock %}
