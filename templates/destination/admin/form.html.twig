{# templates/destination/admin/form.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Ajouter' }} une Destination{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --primary: #2563EB;
        --gray-50: #F9FAFB;
        --gray-100: #F3F4F6;
        --gray-200: #E5E7EB;
        --gray-600: #4B5563;
        --gray-800: #1F2937;
    }

    body { font-family: 'Segoe UI', system-ui, sans-serif; background: var(--gray-50); }

    .page-header {
        background: white;
        border-bottom: 1px solid var(--gray-200);
        padding: 20px 32px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--gray-600);
        text-decoration: none;
        font-size: .9rem;
        padding: 8px 14px;
        border-radius: 6px;
        transition: background .2s;
    }

    .back-btn:hover { background: var(--gray-100); }

    .page-header h1 { font-size: 1.5rem; font-weight: 700; color: var(--gray-800); }

    .container { max-width: 800px; margin: 40px auto; padding: 0 24px; }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(0,0,0,.08);
        padding: 36px;
    }

    .form-group { margin-bottom: 24px; }

    .form-group label {
        display: block;
        font-size: .85rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 8px;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid var(--gray-200);
        border-radius: 8px;
        font-size: .9rem;
        font-family: inherit;
        color: var(--gray-800);
        background: white;
        outline: none;
        transition: border .2s;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }

    .form-group textarea { resize: vertical; min-height: 100px; }

    /* Autocomplete */
    #autocomplete-list {
        position: absolute;
        z-index: 999;
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
        max-height: 220px;
        overflow-y: auto;
        width: 100%;
    }

    .autocomplete-item {
        padding: 10px 16px;
        cursor: pointer;
        font-size: .85rem;
        color: var(--gray-800);
        border-bottom: 1px solid var(--gray-100);
        transition: background .1s;
    }

    .autocomplete-item:last-child { border-bottom: none; }
    .autocomplete-item:hover { background: var(--gray-50); }

    .localisation-wrapper { position: relative; }

    /* Image preview */
    .image-upload-area {
        border: 2px dashed var(--gray-200);
        border-radius: 10px;
        padding: 28px;
        text-align: center;
        transition: border .2s, background .2s;
        cursor: pointer;
        position: relative;
    }

    .image-upload-area:hover {
        border-color: var(--primary);
        background: #EFF6FF;
    }

    .image-upload-area input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
        border: none;
    }

    .image-preview {
        max-width: 300px;
        max-height: 200px;
        border-radius: 8px;
        margin-top: 16px;
        object-fit: cover;
        display: none;
    }

    .current-image {
        max-width: 200px;
        max-height: 130px;
        border-radius: 8px;
        margin-bottom: 12px;
        object-fit: cover;
        border: 2px solid var(--gray-200);
    }

    .form-errors {
        background: #FEF2F2;
        border-left: 4px solid #DC2626;
        border-radius: 6px;
        padding: 12px 16px;
        margin-bottom: 24px;
        font-size: .85rem;
        color: #DC2626;
    }

    .form-errors ul { list-style: disc; padding-left: 16px; }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: .95rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s;
    }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: #1d4ed8; transform: translateY(-1px); }

    .btn-secondary {
        background: var(--gray-100);
        color: var(--gray-800);
    }

    .btn-secondary:hover { background: var(--gray-200); }

    .form-actions {
        display: flex;
        gap: 12px;
        padding-top: 8px;
        border-top: 1px solid var(--gray-100);
        margin-top: 32px;
    }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <a href="{{ path('admin_destination_index') }}" class="back-btn">← Retour</a>
    <h1>{{ isEdit ? '✏️ Modifier la destination' : '➕ Nouvelle destination' }}</h1>
</div>

<div class="container">
    <div class="form-card">

        {# Erreurs globales #}
        {% if not form.vars.valid and form.vars.submitted %}
            <div class="form-errors">
                <strong>Veuillez corriger les erreurs suivantes :</strong>
                <ul>
                    {% for field in form %}
                        {% for error in field.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}

        {# NOM #}
        <div class="form-group">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom, {attr: {placeholder: 'Ex: Paris, Marrakech...'}}) }}
            {{ form_errors(form.nom) }}
        </div>

        {# DESCRIPTION #}
        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {attr: {placeholder: 'Décrivez la destination...', rows: 4}}) }}
        </div>

        {# LOCALISATION avec autocomplete #}
        <div class="form-group">
            {{ form_label(form.localisation) }}
            <div class="localisation-wrapper">
                {{ form_widget(form.localisation, {attr: {id: 'localisation-field', autocomplete: 'off', placeholder: 'Tapez une ville ou un pays...'}}) }}
                <div id="autocomplete-list"></div>
            </div>
            {{ form_errors(form.localisation) }}
        </div>

        {# STATUT #}
        <div class="form-group">
            {{ form_label(form.statut) }}
            {{ form_widget(form.statut) }}
            {{ form_errors(form.statut) }}
        </div>

        {# IMAGE #}
        <div class="form-group">
            <label>Image de la destination</label>

            {% if isEdit and destination.firstImage %}
                <div style="margin-bottom:12px;">
                    <p style="font-size:.8rem;color:var(--gray-600);margin-bottom:8px;">Image actuelle :</p>
                    <img src="{{ destination.firstImage }}" class="current-image" alt="{{ destination.nom }}">
                </div>
            {% endif %}

            <div class="image-upload-area" id="uploadArea">
                {{ form_widget(form.imageFile, {attr: {id: 'imageInput', accept: 'image/*'}}) }}
                <div id="uploadPlaceholder">
                    <div style="font-size:2rem;margin-bottom:8px;">📷</div>
                    <p style="font-weight:600;color:var(--gray-800);">Cliquez pour choisir une image</p>
                    <p style="font-size:.8rem;color:var(--gray-600);">PNG, JPG, WEBP — max 5 Mo</p>
                </div>
                <img id="imagePreview" class="image-preview" src="" alt="Aperçu">
            </div>
            {{ form_errors(form.imageFile) }}
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                {{ isEdit ? '💾 Enregistrer les modifications' : '✅ Créer la destination' }}
            </button>
            <a href="{{ path('admin_destination_index') }}" class="btn btn-secondary">Annuler</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
// ============ IMAGE PREVIEW ============
document.getElementById('imageInput').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(ev) {
        const preview = document.getElementById('imagePreview');
        preview.src = ev.target.result;
        preview.style.display = 'block';
        document.getElementById('uploadPlaceholder').style.display = 'none';
    };
    reader.readAsDataURL(file);
});

// ============ AUTOCOMPLETE LOCALISATION ============
let debounceTimer;
const input = document.getElementById('localisation-field');
const list  = document.getElementById('autocomplete-list');

input.addEventListener('input', function() {
    clearTimeout(debounceTimer);
    const query = this.value.trim();

    if (query.length < 3) {
        list.innerHTML = '';
        return;
    }

    debounceTimer = setTimeout(() => {
        fetch('/admin/destinations/api/autocomplete-location?q=' + encodeURIComponent(query))
            .then(r => r.json())
            .then(results => {
                list.innerHTML = '';
                results.forEach(result => {
                    const item = document.createElement('div');
                    item.className = 'autocomplete-item';
                    item.textContent = result;
                    item.addEventListener('click', () => {
                        input.value = result;
                        list.innerHTML = '';
                    });
                    list.appendChild(item);
                });
            })
            .catch(() => list.innerHTML = '');
    }, 300);
});

document.addEventListener('click', function(e) {
    if (!input.contains(e.target) && !list.contains(e.target)) {
        list.innerHTML = '';
    }
});
</script>
{% endblock %}
