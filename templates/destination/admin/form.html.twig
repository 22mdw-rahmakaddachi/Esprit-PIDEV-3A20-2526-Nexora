{# templates/destination/admin/form.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Ajouter' }} une Destination{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --primary: #2563EB;
        --primary-light: #DBEAFE;
        --gray-50: #F9FAFB;
        --gray-100: #F3F4F6;
        --gray-200: #E5E7EB;
        --gray-600: #4B5563;
        --gray-800: #1F2937;
        --danger: #DC2626;
    }

    body { font-family: 'Segoe UI', system-ui, sans-serif; background: var(--gray-50); }

    .page-header {
        background: white;
        border-bottom: 1px solid var(--gray-200);
        padding: 20px 32px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--gray-600);
        text-decoration: none;
        font-size: .9rem;
        padding: 8px 14px;
        border-radius: 6px;
        transition: background .2s;
    }
    .back-btn:hover { background: var(--gray-100); }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; color: var(--gray-800); }

    .container { max-width: 800px; margin: 40px auto; padding: 0 24px; }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(0,0,0,.08);
        padding: 36px;
    }

    .form-group { margin-bottom: 24px; }
    .form-group label {
        display: block;
        font-size: .85rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 8px;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid var(--gray-200);
        border-radius: 8px;
        font-size: .9rem;
        font-family: inherit;
        color: var(--gray-800);
        background: white;
        outline: none;
        transition: border .2s;
    }
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }
    .form-group textarea { resize: vertical; min-height: 100px; }

    /* ─── Autocomplete ─── */
    .localisation-wrapper { position: relative; }

    #autocomplete-list {
        display: none;
        position: absolute;
        z-index: 999;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: white;
        border: 1.5px solid var(--primary);
        border-radius: 10px;
        box-shadow: 0 12px 32px rgba(37,99,235,.15);
        max-height: 250px;
        overflow-y: auto;
        animation: acDrop .15s ease;
    }
    #autocomplete-list.open { display: block; }
    @keyframes acDrop {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .autocomplete-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        cursor: pointer;
        font-size: .85rem;
        color: var(--gray-800);
        border-bottom: 1px solid var(--gray-100);
        transition: background .1s;
    }
    .autocomplete-item:last-child { border-bottom: none; }
    .autocomplete-item:hover,
    .autocomplete-item.ac-active { background: var(--primary-light); }
    .autocomplete-item .ac-icon { font-size: 1rem; flex-shrink: 0; }
    .autocomplete-item .ac-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .autocomplete-item .ac-text mark {
        background: transparent;
        color: var(--primary);
        font-weight: 700;
    }
    .ac-loading, .ac-empty {
        padding: 14px 16px;
        font-size: .85rem;
        color: var(--gray-600);
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .ac-spinner {
        width: 16px; height: 16px;
        border: 2px solid var(--gray-200);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin .6s linear infinite;
        flex-shrink: 0;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    /* Input avec icône de localisation */
    .localisation-wrapper .loc-input-wrap { position: relative; }
    .localisation-wrapper .loc-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1rem;
        pointer-events: none;
        z-index: 1;
    }
    .localisation-wrapper .loc-input-wrap input {
        padding-left: 38px !important;
    }

    /* ─── Zone upload ─── */
    .image-upload-zone {
        border: 2px dashed var(--gray-200);
        border-radius: 10px;
        padding: 28px;
        text-align: center;
        transition: border .2s, background .2s;
        cursor: pointer;
        position: relative;
        min-height: 120px;
    }
    .image-upload-zone:hover,
    .image-upload-zone.drag-over {
        border-color: var(--primary);
        background: #EFF6FF;
    }
    /* Input transparent par-dessus toute la zone — ouvre le sélecteur au clic */
    .image-upload-zone input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
        border: none;
        z-index: 5;      /* sous les boutons rm-btn et add-more-btn */
    }
    .upload-hint { pointer-events: none; }
    .upload-hint .icon { font-size: 2.2rem; margin-bottom: 8px; }
    .upload-hint p { font-weight: 600; color: var(--gray-800); margin-bottom: 4px; }
    .upload-hint small { color: var(--gray-600); font-size: .8rem; }

    /* ─── Grille de prévisualisations DANS la zone ─── */
    .preview-inner {
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 14px;
    }
    .preview-inner.active {
        display: flex;
    }
    .preview-grid-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
    }
    .preview-thumb {
        position: relative;
        width: 100px;
        height: 74px;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid var(--primary);
        box-shadow: 0 2px 8px rgba(37,99,235,.15);
        flex-shrink: 0;
        animation: thumbIn .25s ease;
    }
    @keyframes thumbIn {
        from { transform: scale(.8); opacity: 0; }
        to   { transform: scale(1);  opacity: 1; }
    }
    .preview-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .preview-thumb .rm-btn {
        position: absolute;
        top: 3px;
        right: 3px;
        background: rgba(220,38,38,.85);
        color: white;
        border: none;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: .7rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        pointer-events: auto;
        z-index: 10;    /* au-dessus de l'input transparent */
    }
    .preview-thumb:first-child::after {
        content: '⭐ Principale';
        position: absolute;
        bottom: 3px;
        left: 3px;
        background: rgba(37,99,235,.85);
        color: white;
        font-size: .58rem;
        font-weight: 700;
        padding: 2px 5px;
        border-radius: 4px;
    }
    .add-more-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        background: var(--primary-light, #DBEAFE);
        color: var(--primary);
        border: 1.5px solid var(--primary);
        border-radius: 8px;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s;
        position: relative;
        z-index: 10;    /* au-dessus de l'input transparent */
    }
    .add-more-btn:hover { background: #BFDBFE; }
    .file-count-label {
        font-size: .8rem;
        color: var(--gray-600);
    }

    /* ─── Grille d'images (existantes + nouvelles) ─── */
    .images-section { margin-top: 8px; }
    .images-section-title {
        font-size: .8rem;
        font-weight: 600;
        color: var(--gray-600);
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 10px;
    }
    .images-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }
    .img-thumb {
        position: relative;
        width: 110px;
        height: 80px;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid var(--gray-200);
        flex-shrink: 0;
    }
    .img-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .img-thumb .delete-btn {
        position: absolute;
        top: 4px;
        right: 4px;
        background: rgba(220,38,38,.9);
        color: white;
        border: none;
        border-radius: 50%;
        width: 22px;
        height: 22px;
        font-size: .75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        opacity: 0;
        transition: opacity .2s;
    }
    .img-thumb:hover .delete-btn { opacity: 1; }
    .img-thumb .badge-main {
        position: absolute;
        bottom: 4px;
        left: 4px;
        background: rgba(37,99,235,.85);
        color: white;
        font-size: .6rem;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
    }
    /* Vignette "nouvelle preview" */
    .img-thumb.new-preview {
        border-color: var(--primary);
        border-style: solid;
    }
    .img-thumb.new-preview .new-badge {
        position: absolute;
        bottom: 4px;
        right: 4px;
        background: var(--primary);
        color: white;
        font-size: .6rem;
        padding: 2px 5px;
        border-radius: 4px;
    }

    /* ─── Erreurs ─── */
    .form-errors {
        background: #FEF2F2;
        border-left: 4px solid #DC2626;
        border-radius: 6px;
        padding: 12px 16px;
        margin-bottom: 24px;
        font-size: .85rem;
        color: #DC2626;
    }
    .form-errors ul { list-style: disc; padding-left: 16px; }

    /* ─── Boutons ─── */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: .95rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s;
    }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: #1d4ed8; transform: translateY(-1px); }
    .btn-secondary { background: var(--gray-100); color: var(--gray-800); }
    .btn-secondary:hover { background: var(--gray-200); }
    .form-actions {
        display: flex;
        gap: 12px;
        padding-top: 8px;
        border-top: 1px solid var(--gray-100);
        margin-top: 32px;
    }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <a href="{{ path('admin_destination_index') }}" class="back-btn">← Retour</a>
    <h1>{{ isEdit ? '✏️ Modifier la destination' : '➕ Nouvelle destination' }}</h1>
</div>

<div class="container">
    <div class="form-card">

        {# Erreurs globales #}
        {% if not form.vars.valid and form.vars.submitted %}
            <div class="form-errors">
                <strong>Veuillez corriger les erreurs suivantes :</strong>
                <ul>
                    {% for field in form %}
                        {% for error in field.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {{ form_start(form, {attr: {enctype: 'multipart/form-data', novalidate: 'novalidate', id: 'destForm'}}) }}

        {# NOM #}
        <div class="form-group">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom, {attr: {placeholder: 'Ex: Paris, Marrakech...'}}) }}
            {{ form_errors(form.nom) }}
        </div>

        {# DESCRIPTION #}
        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {attr: {placeholder: 'Décrivez la destination...', rows: 4}}) }}
        </div>

        {# LOCALISATION avec autocomplete #}
        <div class="form-group">
            {{ form_label(form.localisation) }}
            <div class="localisation-wrapper">
                <div class="loc-input-wrap">
                    <span class="loc-icon">📍</span>
                    {{ form_widget(form.localisation, {attr: {autocomplete: 'off', placeholder: 'Tapez une ville ou un pays...'}}) }}
                </div>
                <div id="autocomplete-list"></div>
            </div>
            {{ form_errors(form.localisation) }}
        </div>
        {# Injecter le vrai ID Symfony du champ dans le JS #}
        <script>const _locFieldId = "{{ form.localisation.vars.id }}";</script>

        {# STATUT (uniquement pour l'édition) #}
        {% if form.statut is defined %}
        <div class="form-group">
            {{ form_label(form.statut) }}
            {{ form_widget(form.statut) }}
            {{ form_errors(form.statut) }}
        </div>
        {% endif %}

        {# ─── IMAGES ─── #}
        <div class="form-group">
            <label>🖼️ Images de la destination</label>

            {# Images existantes (édition) #}
            {% if isEdit and destination.destinationImages|length > 0 %}
            <div class="images-section" id="existingImagesSection">
                <div class="images-section-title">Images actuelles</div>
                <div class="images-grid" id="existingImagesGrid">
                    {% for img in destination.destinationImages %}
                    <div class="img-thumb" id="thumb-{{ img.id }}">
                        <img src="{{ img.displayChemin }}" alt="Image {{ loop.index }}" loading="lazy">
                        {% if loop.first %}
                            <span class="badge-main">⭐ Principale</span>
                        {% endif %}
                        <button type="button" class="delete-btn" title="Supprimer"
                                onclick="deleteExistingImage({{ img.id }}, '{{ csrf_token('delete-image-' ~ img.id) }}')">
                            ✕
                        </button>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Zone upload multi-fichiers #}
            <div class="image-upload-zone" id="uploadZone"
                 style="margin-top:{% if isEdit and destination.destinationImages|length > 0 %}14px{% else %}0{% endif %}">

                {# Input transparent par-dessus la zone — le clic n'importe où l'ouvre #}
                {{ form_widget(form.imageFiles, {attr: {id: 'imageFilesInput', accept: 'image/*', multiple: 'multiple'}}) }}

                {# Placeholder (visible quand aucune image sélectionnée) #}
                <div class="upload-hint" id="uploadHint">
                    <div class="icon">📷</div>
                    <p>Cliquez ou glissez des images ici</p>
                    <small>PNG, JPG, WEBP — max 30 Mo par fichier — plusieurs fichiers acceptés</small>
                </div>

                {# Prévisualisations DANS la zone (remplacement du placeholder) #}
                <div class="preview-inner" id="previewInner">
                    <div class="preview-grid-inner" id="previewGrid"></div>
                    <span class="file-count-label" id="fileCountLabel"></span>
                    <button type="button" class="add-more-btn"
                            onclick="document.activeElement && document.activeElement.blur(); document.querySelector('#uploadZone input[type=\'file\']').click()">
                        ➕ Ajouter d'autres images
                    </button>
                </div>
            </div>

            {{ form_errors(form.imageFiles) }}
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                {{ isEdit ? '💾 Enregistrer les modifications' : '✅ Créer la destination' }}
            </button>
            <a href="{{ path('admin_destination_index') }}" class="btn btn-secondary">Annuler</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
// ============ UPLOAD ZONE : PREVIEW DANS LA ZONE ============
(function() {
    const zone        = document.getElementById('uploadZone');
    const input       = zone ? zone.querySelector('input[type="file"]') : null;
    const hint        = document.getElementById('uploadHint');
    const previewInner = document.getElementById('previewInner');
    const grid        = document.getElementById('previewGrid');
    const countLabel  = document.getElementById('fileCountLabel');

    if (!input || !zone) {
        return; // Évite de faire planter le reste du JS si l'input n'est pas rendu
    }

    // DataTransfer accumulé pour garder tous les fichiers même après ajout
    let allFiles = new DataTransfer();

    // ── Mettre à jour l'input avec allFiles ──
    function syncInput() {
        try { input.files = allFiles.files; } catch(e) {}
    }

    // ── Afficher les thumbnails ──
    function renderPreviews() {
        grid.innerHTML = '';
        const files = Array.from(allFiles.files);

        if (!files.length) {
            hint.style.display = 'block';
            previewInner.classList.remove('active');
            return;
        }

        hint.style.display = 'none';
        previewInner.classList.add('active');
        countLabel.textContent = files.length + ' image' + (files.length > 1 ? 's sélectionnées' : ' sélectionnée');

        files.forEach((file, idx) => {
            const reader = new FileReader();
            reader.onload = function(ev) {
                const thumb = document.createElement('div');
                thumb.className = 'preview-thumb';
                thumb.innerHTML = `
                    <img src="${ev.target.result}" alt="${file.name}">
                    <button type="button" class="rm-btn" title="Retirer" onclick="removeFile(${idx})">&#x2715;</button>
                `;
                grid.appendChild(thumb);
            };
            reader.readAsDataURL(file);
        });
    }

    // ── Retirer un fichier par index ──
    window.removeFile = function(idx) {
        const updated = new DataTransfer();
        Array.from(allFiles.files).forEach((f, i) => {
            if (i !== idx) updated.items.add(f);
        });
        allFiles = updated;
        syncInput();
        renderPreviews();
    };

    // ── Écouter les changements de l'input ──
    input.addEventListener('change', function() {
        // Ajouter tous les nouveaux fichiers sélectionnés, sauf s'ils y sont déjà (simplification)
        Array.from(this.files).forEach(f => allFiles.items.add(f));
        syncInput();
        renderPreviews();
        // ATTENTION: Il ne faut SURTOUT PAS faire "this.value = '';" ici
        // car cela vide l'input du fichier natif juste avant l'envoi du formulaire au backend !
    });

    // ── Drag & Drop ──
    zone.addEventListener('dragover', e => {
        e.preventDefault();
        zone.classList.add('drag-over');
    });
    zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
    zone.addEventListener('drop', e => {
        e.preventDefault();
        zone.classList.remove('drag-over');
        Array.from(e.dataTransfer.files).forEach(f => {
            if (f.type.startsWith('image/')) allFiles.items.add(f);
        });
        syncInput();
        renderPreviews();
    });
})();

// ============ SUPPRIMER IMAGE EXISTANTE (AJAX) ============
function deleteExistingImage(imageId, token) {
    if (!confirm('Supprimer cette image ?')) return;

    const formData = new FormData();
    formData.append('_token', token);

    fetch('/admin/destinations/image/' + imageId + '/delete', {
        method: 'POST',
        body: formData,
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            const el = document.getElementById('thumb-' + imageId);
            if (el) {
                el.style.transform = 'scale(0)';
                el.style.opacity   = '0';
                el.style.transition = 'all .3s';
                setTimeout(() => el.remove(), 300);
            }
        } else {
            alert('Erreur : ' + (data.error || 'Suppression impossible'));
        }
    })
    .catch(() => alert('Erreur réseau'));
}

// ============ AUTOCOMPLETE LOCALISATION (OpenStreetMap Nominatim) ============
(function() {
    // Essayer plusieurs sélecteurs pour garantir qu'on trouve l'input, 
    // car l'identifiant peut être surchargé dans la classe du formulaire (ex: 'localisation-field')
    const locInput = document.getElementById(_locFieldId) 
                  || document.getElementById('localisation-field') 
                  || document.querySelector('input[name*="[localisation]"]');
                  
    if (!locInput) {
        console.error("Erreur: Impossible de trouver le champ de localisation pour l'autocomplete.");
        return;
    }

    const dropdown   = document.getElementById('autocomplete-list');
    const apiUrl     = "{{ path('destination_autocomplete_location') }}";
    let debounceTimer;
    let activeIdx = -1;
    let currentResults = [];

    function highlight(text, query) {
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return text.replace(new RegExp('(' + escaped + ')', 'gi'), '<mark>$1</mark>');
    }

    function getItems() {
        return dropdown.querySelectorAll('.autocomplete-item');
    }

    function setActive(idx) {
        const items = getItems();
        items.forEach(el => el.classList.remove('ac-active'));
        if (idx >= 0 && idx < items.length) {
            items[idx].classList.add('ac-active');
            items[idx].scrollIntoView({ block: 'nearest' });
        }
        activeIdx = idx;
    }

    function showLoading() {
        dropdown.innerHTML = '<div class="ac-loading"><div class="ac-spinner"></div>Recherche en cours…</div>';
        dropdown.classList.add('open');
    }

    function showEmpty() {
        dropdown.innerHTML = '<div class="ac-empty">🔍 Aucun résultat trouvé</div>';
        dropdown.classList.add('open');
    }

    function closeDropdown() {
        dropdown.classList.remove('open');
        dropdown.innerHTML = '';
        activeIdx = -1;
        currentResults = [];
    }

    function renderResults(results, rawQuery) {
        if (!results.length) { showEmpty(); return; }
        currentResults = results;
        dropdown.innerHTML = '';
        results.forEach((result, i) => {
            const item = document.createElement('div');
            item.className = 'autocomplete-item';
            item.innerHTML = `
                <span class="ac-icon">📍</span>
                <span class="ac-text">${highlight(result, rawQuery)}</span>
            `;
            item.addEventListener('mousedown', (e) => {
                e.preventDefault(); // empêche le blur de l'input
                locInput.value = result;
                closeDropdown();
                locInput.focus();
            });
            dropdown.appendChild(item);
        });
        dropdown.classList.add('open');
        activeIdx = -1;
    }

    function handleInput() {
        clearTimeout(debounceTimer);
        const query = locInput.value.trim();

        if (query.length < 3) { closeDropdown(); return; }

        showLoading();

        debounceTimer = setTimeout(() => {
            fetch(apiUrl + '?q=' + encodeURIComponent(query))
                .then(r => r.json())
                .then(results => renderResults(results, query))
                .catch(() => closeDropdown());
        }, 350);
    }

    locInput.addEventListener('input', handleInput);
    locInput.addEventListener('keyup', handleInput);

    // Navigation clavier ↑ ↓ Entrée Échap
    locInput.addEventListener('keydown', function(e) {
        const items = getItems();
        if (!items.length) return;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            setActive(Math.min(activeIdx + 1, items.length - 1));
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            setActive(Math.max(activeIdx - 1, 0));
        } else if (e.key === 'Enter' && activeIdx >= 0) {
            e.preventDefault();
            locInput.value = currentResults[activeIdx];
            closeDropdown();
        } else if (e.key === 'Escape') {
            closeDropdown();
        }
    });

    /* locInput.addEventListener('blur', function() {
        // Petit délai pour laisser le mousedown se déclencher sur l'item
        setTimeout(closeDropdown, 150);
    }); */

    document.addEventListener('click', function(e) {
        if (!locInput.contains(e.target) && !dropdown.contains(e.target)) {
            closeDropdown();
        }
    });
})();
</script>
