{# templates/destination/admin/index.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Excursions{% endblock %}
{% block page_title %}Gestion des Excursions{% endblock %}

{% block stylesheets %}
<style>
    /* Custom styles for specific elements not in admin base */
    .dest-image { width: 80px; height: 55px; object-fit: cover; border-radius: 6px; border: 1px solid #ede5ff; }
    .dest-image-placeholder { width: 80px; height: 55px; background: #f0ebff; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    
    .search-bar-admin { display: flex; gap: 12px; margin-bottom: 20px; align-items: center; }
    .search-bar-admin input { flex: 1; max-width: 400px; padding: 10px 16px; border: 2px solid #ede5ff; border-radius: 10px; outline: none; transition: border .2s; }
    .search-bar-admin input:focus { border-color: var(--primary); }

    .maps-link { color: var(--primary); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: .85rem; }
    .maps-link:hover { text-decoration: underline; }

    /* Modal confirmation suppression */
    .confirm-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 99999; align-items: center; justify-content: center; }
    .confirm-overlay.active { display: flex !important; }
    .confirm-modal { background: white; border-radius: 14px; padding: 32px; max-width: 420px; width: 90%; box-shadow: 0 24px 64px rgba(0,0,0,.2); animation: modalIn .2s ease; }
    @keyframes modalIn { from { transform: scale(.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .confirm-modal h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: 12px; color: var(--primary-dark); }
    .confirm-modal p { color: #666; margin-bottom: 24px; }
    .confirm-actions { display: flex; gap: 12px; justify-content: flex-end; }

    tr.dest-row.hidden { display: none; }
    .no-results-row { text-align: center; color: #888; padding: 40px; }
</style>
{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <h1>🗺️ Liste des Excursions</h1>
    <a href="{{ path('admin_destination_new') }}" class="btn-primary-admin">
        <i class="bi bi-plus-circle me-1"></i> Ajouter une excursion
    </a>
</div>

{# SEARCH LIVE #}
<div class="search-bar-admin">
    <input type="text" id="liveSearch" value="{{ search }}" placeholder="🔍 Rechercher par nom ou localisation..." autocomplete="off">
    <span id="resultCount" class="small text-muted ms-auto">
        {{ destinations|length }} excursion{{ destinations|length != 1 ? 's' : '' }} trouvée{{ destinations|length != 1 ? 's' : '' }}
    </span>
</div>

{# TABLE #}
<div class="admin-table">
    {% if destinations is empty %}
        <div class="text-center py-5">
            <div class="fs-1 mb-2">🌍</div>
            <p class="text-muted">Aucune excursion trouvée.</p>
            <a href="{{ path('admin_destination_new') }}" class="btn-primary-admin btn-sm">Créer la première</a>
        </div>
    {% else %}
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Nom</th>
                <th>Localisation</th>
                <th>Capacité</th>
                <th>Statut</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody id="destTableBody">
            {% for dest in destinations %}
            <tr class="dest-row" data-nom="{{ dest.nom|lower|e('html_attr') }}" data-loc="{{ (dest.localisation ?? '')|lower|e('html_attr') }}">
                <td>
                    <div style="position:relative;display:inline-block;">
                        {% if dest.firstImage %}
                            <img src="{{ dest.firstImage }}" alt="{{ dest.nom }}" class="dest-image">
                        {% else %}
                            <div class="dest-image-placeholder">🏔️</div>
                        {% endif %}
                        {% if dest.imagesCount > 1 %}
                            <span style="position:absolute;bottom:4px;right:4px;background:var(--primary);color:white;font-size:.6rem;font-weight:700;padding:1px 4px;border-radius:4px;">
                                +{{ dest.imagesCount - 1 }}
                            </span>
                        {% endif %}
                    </div>
                </td>
                <td><strong>{{ dest.nom }}</strong></td>
                <td>
                    {% if dest.localisation %}
                        <a href="https://www.google.com/maps/search/?api=1&query={{ dest.localisation|url_encode }}" target="_blank" class="maps-link">
                            📍 {{ dest.localisation|slice(0, 30) }}...
                        </a>
                    {% else %}
                        —
                    {% endif %}
                </td>
                <td>{{ dest.nbParticipants }}/{{ dest.capaciteMax }}</td>
                <td>
                    {% if dest.statut == 'Disponible' %}
                        <span class="status-badge badge-actif">Disponible</span>
                    {% elseif dest.statut == 'Complet' %}
                        <span class="status-badge badge-complet">Complet</span>
                    {% else %}
                        <span class="status-badge badge-passe">{{ dest.statut ?? '—' }}</span>
                    {% endif %}
                </td>
                <td class="text-end">
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('admin_destination_edit', {id: dest.id}) }}" class="btn-edit-admin btn-sm">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <button type="button" class="btn-danger-admin btn-sm"
                                onclick="openDeleteModal({{ dest.id }}, '{{ dest.nom|e('html_attr') }}', '{{ csrf_token('delete' ~ dest.id) }}')">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}
</div>

{# MODAL SUPPRESSION #}
<div class="confirm-overlay" id="deleteModal">
    <div class="confirm-modal">
        <h3>⚠️ Supprimer ?</h3>
        <p>Voulez-vous vraiment supprimer <strong id="modalDestName"></strong> ? Cette action est irréversible.</p>
        <div class="confirm-actions">
            <button class="btn btn-edit-admin" onclick="closeDeleteModal()">Annuler</button>
            <form id="deleteForm" method="POST">
                <input type="hidden" name="_token" id="deleteToken">
                <button type="submit" class="btn-danger-admin py-2 px-3">🗑️ Supprimer définitivement</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
// ── SUPPRESSION MODAL ──
function openDeleteModal(id, name, token) {
    document.getElementById('modalDestName').textContent = name;
    document.getElementById('deleteForm').action = '/admin/destinations/' + id + '/delete';
    document.getElementById('deleteToken').value = token;
    document.getElementById('deleteModal').classList.add('active');
}
function closeDeleteModal() { document.getElementById('deleteModal').classList.remove('active'); }
document.getElementById('deleteModal').addEventListener('click', e => { if (e.target === document.getElementById('deleteModal')) closeDeleteModal(); });

// ── LIVE SEARCH ──
(function() {
    const input   = document.getElementById('liveSearch');
    const rows    = document.querySelectorAll('.dest-row');
    const counter = document.getElementById('resultCount');
    const tbody   = document.getElementById('destTableBody');
    let noResRow  = null;

    function updateCounter(n) {
        counter.textContent = n + ' excursion' + (n !== 1 ? 's' : '') + ' trouvée' + (n !== 1 ? 's' : '');
    }

    input.addEventListener('input', function() {
        const q = this.value.trim().toLowerCase();
        let visible = 0;
        rows.forEach(row => {
            const nom = row.dataset.nom || '';
            const loc = row.dataset.loc || '';
            const match = !q || nom.includes(q) || loc.includes(q);
            row.classList.toggle('hidden', !match);
            if (match) visible++;
        });
        if (noResRow) { noResRow.remove(); noResRow = null; }
        if (visible === 0) {
            noResRow = document.createElement('tr');
            noResRow.innerHTML = '<td colspan="6" class="no-results-row">🔍 Aucun résultat pour "' + this.value + '"</td>';
            tbody.appendChild(noResRow);
        }
        updateCounter(visible);
    });
})();
</script>
{% endblock %}
