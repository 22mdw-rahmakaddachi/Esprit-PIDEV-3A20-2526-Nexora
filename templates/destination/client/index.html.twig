{# templates/destination/client/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Excursions{% endblock %}

{% block stylesheets %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    :root {
        --primary: #2563EB;
        --primary-light: #DBEAFE;
        --gray-50: #F9FAFB;
        --gray-100: #F3F4F6;
        --gray-200: #E5E7EB;
        --gray-600: #4B5563;
        --gray-800: #1F2937;
        --radius: 14px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; background: var(--gray-50); color: var(--gray-800); }

    /* ─── HEADER ─── */
    .page-header {
        background: white;
        border-bottom: 1px solid var(--gray-200);
        padding: 22px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }
    .page-header h1 { font-size: 1.7rem; font-weight: 800; }
    .header-sub { font-size: .9rem; color: var(--gray-600); margin-top: 2px; }

    /* ─── SEARCH ─── */
    .search-wrap { max-width: 1200px; margin: 32px auto 0; padding: 0 32px; }
    .search-bar {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }
    .search-bar input {
        flex: 1;
        min-width: 220px;
        max-width: 420px;
        padding: 11px 18px;
        border: 2px solid var(--gray-200);
        border-radius: 10px;
        font-size: .9rem;
        font-family: inherit;
        outline: none;
        transition: border .2s;
    }
    .search-bar input:focus { border-color: var(--primary); }
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 20px;
        border-radius: 10px;
        font-size: .9rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all .2s;
        font-family: inherit;
    }
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: #1d4ed8; transform: translateY(-1px); }
    .btn-ghost { background: var(--gray-100); color: var(--gray-800); }
    .btn-ghost:hover { background: var(--gray-200); }
    .count-label { color: var(--gray-600); font-size: .88rem; margin-left: auto; }

    /* ─── GRILLE DE CARTES ─── */
    .destinations-grid {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 32px 60px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
    }

    /* ─── CARTE ─── */
    .dest-card {
        background: white;
        border-radius: var(--radius);
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        overflow: hidden;
        cursor: pointer;
        transition: transform .25s, box-shadow .25s;
        position: relative;
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .dest-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(37,99,235,.15);
    }

    /* Highlight quand la popup est visible */
    .dest-card.popup-active {
        outline: 2.5px solid var(--primary);
        outline-offset: 2px;
    }

    .card-img-wrap {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: var(--gray-100);
    }
    .card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .4s;
    }
    .dest-card:hover .card-img-wrap img { transform: scale(1.05); }
    .card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #DBEAFE, #EDE9FE);
        font-size: 3.5rem;
    }

    /* Badge statut sur l'image */
    .card-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        backdrop-filter: blur(4px);
    }
    .badge-disponible { background: rgba(22,163,74,.85); color: white; }
    .badge-complet    { background: rgba(220,38,38,.85);  color: white; }

    /* Badge nb images */
    .card-imgs-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(0,0,0,.55);
        color: white;
        font-size: .72rem;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Loader hover ring */
    .hover-ring {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity .2s;
    }
    .dest-card:hover .hover-ring { opacity: 1; }
    .ring-svg { animation: spin 3s linear forwards; width: 32px; height: 32px; }
    @keyframes spin { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }

    .card-body { padding: 18px 20px; }
    .card-title { font-size: 1.05rem; font-weight: 700; margin-bottom: 6px; }
    .card-loc { font-size: .82rem; color: var(--gray-600); display: flex; align-items: center; gap: 4px; }

    /* Live search — cartes cachées */
    .dest-card.hidden { display: none !important; }
    .no-results-msg {
        grid-column: 1 / -1;
        text-align: center;
        padding: 60px 20px;
        color: var(--gray-600);
        font-size: 1rem;
    }
    .no-results-msg .icon { font-size: 2.5rem; margin-bottom: 12px; }

    /* ─── ÉTAT VIDE ─── */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: var(--gray-600);
        grid-column: 1 / -1;
    }
    .empty-state .icon { font-size: 3.5rem; margin-bottom: 14px; }
    .empty-state p { font-size: 1rem; }

    /* ═══════════════════════════════════════════
       POPUP PREVIEW (hover 3s)
    ═══════════════════════════════════════════ */
    #hoverPopup {
        position: fixed;
        z-index: 9999;
        width: 340px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,.22);
        overflow: hidden;
        pointer-events: none;         /* ne bloque pas la souris */
        opacity: 0;
        transform: scale(.94) translateY(6px);
        transition: opacity .25s, transform .25s;
    }
    #hoverPopup.visible {
        opacity: 1;
        transform: scale(1) translateY(0);
        pointer-events: auto;
    }

    /* Galerie popup */
    .popup-gallery {
        position: relative;
        height: 200px;
        background: var(--gray-100);
        overflow: hidden;
    }
    .popup-gallery img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity .45s;
    }
    .popup-gallery img.active { opacity: 1; }
    .popup-gallery .ph { width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:4rem; background: linear-gradient(135deg,#DBEAFE,#EDE9FE); }

    /* Indicateurs dots */
    .popup-dots {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 6px;
    }
    .popup-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: rgba(255,255,255,.55);
        transition: background .3s, transform .3s;
    }
    .popup-dot.active { background: white; transform: scale(1.3); }

    /* Infos popup */
    .popup-info {
        padding: 18px 20px 20px;
    }
    .popup-name {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--gray-800);
        margin-bottom: 8px;
    }
    .popup-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
    }
    .popup-hint {
        margin-top: 12px;
        font-size: .78rem;
        color: var(--gray-600);
        text-align: center;
        border-top: 1px solid var(--gray-100);
        padding-top: 10px;
    }

    /* ─── FILTERS ─── */
    .filter-group { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 32px; }
    .filter-btn {
        padding: 8px 16px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
        border: 1.5px solid var(--gray-200);
        background: white;
        color: var(--gray-600);
        cursor: pointer;
        transition: all .2s;
    }
    .filter-btn:hover { border-color: var(--primary); color: var(--primary); }
    .filter-btn.active { background: var(--primary); color: white; border-color: var(--primary); }

    /* ─── SORTING ─── */
    .sort-control { display: flex; align-items: center; gap: 8px; font-size: .85rem; color: var(--gray-600); }
    .sort-select {
        padding: 8px 12px;
        border-radius: 8px;
        border: 1.5px solid var(--gray-200);
        outline: none;
        font-family: inherit;
        font-weight: 500;
        cursor: pointer;
        background: white;
    }
    .sort-select:focus { border-color: var(--primary); }
    
    .filters-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 32px; }
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <div>
        <h1>🌍 Nos Excursions</h1>
        <div class="header-sub">Découvrez nos excursions de voyage</div>
    </div>
</div>

<div class="search-wrap">
    <div class="search-bar">
        <input type="text"
               id="liveSearch"
               value="{{ search }}"
               placeholder="🔍 Rechercher une excursion..."
               autocomplete="off">
        <span class="count-label" id="resultCount">
            {{ destinations|length }} excursion{{ destinations|length != 1 ? 's' : '' }} trouvée{{ destinations|length != 1 ? 's' : '' }}
        </span>
    </div>

    <div class="filters-row">
        <div class="filter-group" style="margin-bottom:0;">
            <button class="filter-btn active" data-filter-type="all">✨ Tous</button>
            <button class="filter-btn" data-filter-type="statut" data-filter-val="Disponible">✅ Disponibles</button>
            <button class="filter-btn" data-filter-type="statut" data-filter-val="Complet">🔴 Complets</button>
            <button class="filter-btn" data-filter-type="date" data-filter-val="future">🛫 À venir (Non vécu)</button>
            <button class="filter-btn" data-filter-type="date" data-filter-val="past">⌛ Passés (Vécu)</button>
        </div>

        <div class="sort-control">
            <label for="sortSelect">🔘 Trier par :</label>
            <select id="sortSelect" class="sort-select">
                <option value="id-desc">Ajouté récemment</option>
                <option value="name-asc">Nom (A-Z)</option>
                <option value="name-desc">Nom (Z-A)</option>
                <option value="part-asc">Participants (Moins → Plus)</option>
                <option value="part-desc">Participants (Plus → Moins)</option>
                <option value="date-asc">Date (Le plus proche)</option>
                <option value="date-desc">Date (Le plus loin)</option>
            </select>
        </div>
    </div>
</div>

{# ─── GRILLE ─── #}
<div class="destinations-grid">
    {% if destinations is empty %}
        <div class="empty-state">
            <div class="icon">🌍</div>
            <p>Aucune excursion trouvée{% if search %} pour "{{ search }}"{% endif %}.</p>
        </div>
    {% else %}
        {% for dest in destinations %}
        {# ─── DATA images (max 5) encodées en JSON ─── #}
        {% set imgs = dest.imagesList|slice(0, 5) %}
        <a href="{{ path('client_destination_show', {id: dest.id}) }}"
           class="dest-card"
           data-id="{{ dest.id }}"
           data-name="{{ dest.nom|e('html_attr') }}"
           data-statut="{{ dest.statut|e('html_attr') }}"
           data-is-expired="{{ dest.isExpired ? '1' : '0' }}"
           data-date-ts="{{ dest.dateLancement ? dest.dateLancement.timestamp : 0 }}"
           data-nb-part="{{ dest.nbParticipants }}"
           data-images="{{ imgs|json_encode|e('html_attr') }}"
           data-count="{{ dest.imagesCount }}">

            <div class="card-img-wrap">
                {% if dest.firstImage %}
                    <img src="{{ dest.firstImage }}" alt="{{ dest.nom }}" loading="lazy">
                {% else %}
                    <div class="card-placeholder">🏔️</div>
                {% endif %}

                {% if dest.statut %}
                    <span class="card-badge {{ dest.statut == 'Disponible' ? 'badge-disponible' : 'badge-complet' }}">
                        {{ dest.statut == 'Disponible' ? '✅ Disponible' : '🔴 Complet' }}
                    </span>
                {% endif %}

                {% if dest.isExpired %}
                    <span class="card-badge" style="top:42px; background:rgba(75,85,99,0.85); color:white;">⌛ Vécu</span>
                {% endif %}

                {% if dest.imagesCount > 1 %}
                    <span class="card-imgs-badge">🖼️ {{ dest.imagesCount }}</span>
                {% endif %}

                {# Anneau de chargement visuel 3s #}
                <div class="hover-ring">
                    <svg class="ring-svg" viewBox="0 0 32 32" fill="none">
                        <circle cx="16" cy="16" r="13" stroke="rgba(255,255,255,0.3)" stroke-width="3"/>
                        <circle cx="16" cy="16" r="13" stroke="white" stroke-width="3"
                                stroke-dasharray="82" stroke-dashoffset="82"
                                stroke-linecap="round"
                                style="transform-origin:center;transform:rotate(-90deg);
                                       transition:stroke-dashoffset 3s linear;" id="ring-{{ dest.id }}"/>
                    </svg>
                </div>
            </div>

            <div class="card-body">
                <div class="card-title">{{ dest.nom }}</div>
                {% if dest.localisation %}
                    <div class="card-loc">📍 {{ dest.localisation }}</div>
                {% endif %}
            </div>
        </a>
        {% endfor %}
    {% endif %}
</div>

{# ═══════════ POPUP UNIQUE (déplacée par JS) ═══════════ #}
<div id="hoverPopup">
    <div class="popup-gallery" id="popupGallery">
        <div class="ph" id="popupPlaceholder">🏔️</div>
        <div class="popup-dots" id="popupDots"></div>
    </div>
    <div class="popup-info">
        <div class="popup-name" id="popupName">—</div>
        <span class="popup-status" id="popupStatus"></span>
        <div class="popup-hint">👆 Cliquez pour voir les détails</div>
    </div>
</div>

<script>
(function() {
    const popup       = document.getElementById('hoverPopup');
    const gallery     = document.getElementById('popupGallery');
    const placeholder = document.getElementById('popupPlaceholder');
    const dotsWrap    = document.getElementById('popupDots');
    const popupName   = document.getElementById('popupName');
    const popupStatus = document.getElementById('popupStatus');

    let hoverTimer   = null;
    let slideTimer   = null;
    let currentCard  = null;
    let currentSlide = 0;
    let popupImages  = [];

    // ── Créer les <img> dans la galerie popup ──
    function buildGallery(images) {
        // Supprimer anciens
        gallery.querySelectorAll('img').forEach(el => el.remove());
        dotsWrap.innerHTML = '';
        currentSlide = 0;
        popupImages = images;

        if (!images.length) {
            placeholder.style.display = 'flex';
            return;
        }
        placeholder.style.display = 'none';

        images.forEach((src, i) => {
            const img = document.createElement('img');
            img.src = src;
            img.alt = 'Photo ' + (i + 1);
            if (i === 0) img.classList.add('active');
            gallery.insertBefore(img, dotsWrap);

            const dot = document.createElement('div');
            dot.className = 'popup-dot' + (i === 0 ? ' active' : '');
            dotsWrap.appendChild(dot);
        });
    }

    function goSlide(idx) {
        const imgs = gallery.querySelectorAll('img');
        const dots = dotsWrap.querySelectorAll('.popup-dot');
        if (!imgs.length) return;
        imgs.forEach((el, i) => el.classList.toggle('active', i === idx));
        dots.forEach((el, i) => el.classList.toggle('active', i === idx));
        currentSlide = idx;
    }

    function startSlideshow() {
        clearInterval(slideTimer);
        if (popupImages.length <= 1) return;
        slideTimer = setInterval(() => {
            const next = (currentSlide + 1) % popupImages.length;
            goSlide(next);
        }, 1800);
    }

    function stopSlideshow() {
        clearInterval(slideTimer);
    }

    // ── Positionner la popup près du curseur ──
    function positionPopup(e) {
        const W = window.innerWidth;
        const H = window.innerHeight;
        const PW = 340;
        const PH = popup.offsetHeight || 330;
        const margin = 18;

        let x = e.clientX + margin;
        let y = e.clientY + margin;

        if (x + PW > W - margin) x = e.clientX - PW - margin;
        if (y + PH > H - margin) y = e.clientY - PH - margin;

        popup.style.left = Math.max(8, x) + 'px';
        popup.style.top  = Math.max(8, y) + 'px';
    }

    // ── Afficher popup ──
    function showPopup(card, e) {
        // images (max 5) depuis data attribute
        let images = [];
        try { images = JSON.parse(card.dataset.images || '[]'); } catch(ex) {}

        const nom    = card.dataset.name   || '';
        const statut = card.dataset.statut || '';

        buildGallery(images);
        popupName.textContent = nom;

        // Statut badge
        if (statut === 'Disponible') {
            popupStatus.textContent    = '✅ Disponible';
            popupStatus.style.cssText  = 'background:#DCFCE7;color:#15803D;';
        } else if (statut === 'Complet') {
            popupStatus.textContent    = '🔴 Complet';
            popupStatus.style.cssText  = 'background:#FEE2E2;color:#DC2626;';
        } else {
            popupStatus.textContent    = statut || '—';
            popupStatus.style.cssText  = 'background:#F3F4F6;color:#4B5563;';
        }

        positionPopup(e);
        popup.classList.add('visible');
        card.classList.add('popup-active');
        startSlideshow();
    }

    function hidePopup() {
        popup.classList.remove('visible');
        stopSlideshow();
        if (currentCard) {
            currentCard.classList.remove('popup-active');
            currentCard = null;
        }
        clearTimeout(hoverTimer);
        hoverTimer = null;
    }

    // ── Attacher les événements à chaque carte ──
    document.querySelectorAll('.dest-card').forEach(card => {

        card.addEventListener('mouseenter', function(e) {
            if (currentCard && currentCard !== card) hidePopup();
            currentCard = card;

            // Animer l'anneau SVG
            const ring = document.getElementById('ring-' + card.dataset.id);
            if (ring) {
                ring.style.transition = 'none';
                ring.style.strokeDashoffset = '82';
                // Force reflow
                ring.getBoundingClientRect();
                ring.style.transition = 'stroke-dashoffset 3s linear';
                ring.style.strokeDashoffset = '0';
            }

            hoverTimer = setTimeout(() => {
                showPopup(card, e);
            }, 3000);
        });

        card.addEventListener('mousemove', function(e) {
            if (popup.classList.contains('visible')) {
                positionPopup(e);
            }
        });

        card.addEventListener('mouseleave', function() {
            clearTimeout(hoverTimer);
            hoverTimer = null;
            // Réinitialiser l'anneau
            const ring = document.getElementById('ring-' + card.dataset.id);
            if (ring) {
                ring.style.transition = 'none';
                ring.style.strokeDashoffset = '82';
            }
            // Cacher popup avec un petit délai pour éviter le flicker
            setTimeout(() => {
                if (currentCard === card) hidePopup();
            }, 120);
        });
    });

    // Cacher popup si on clique en dehors
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.dest-card') && !e.target.closest('#hoverPopup')) {
            hidePopup();
        }
    });
})();

// ── LIVE SEARCH & FILTERS & SORT CLIENT ──
(function() {
    const input   = document.getElementById('liveSearch');
    const grid    = document.querySelector('.destinations-grid');
    const filters = document.querySelectorAll('.filter-btn');
    const sortSel = document.getElementById('sortSelect');
    
    let cardsArray = Array.from(document.querySelectorAll('.dest-card'));
    let activeFilter = { type: 'all', val: null };
    let noResEl   = null;

    if (!input || !grid) return;

    function updateCounter(n) {
        const counter = document.getElementById('resultCount');
        if (!counter) return;
        counter.textContent = n + ' excursion' + (n !== 1 ? 's' : '') + ' trouvée' + (n !== 1 ? 's' : '');
    }

    function sortCards() {
        const [crit, order] = sortSel.value.split('-');
        
        cardsArray.sort((a, b) => {
            let valA, valB;
            
            if (crit === 'name') {
                valA = a.dataset.name.toLowerCase();
                valB = b.dataset.name.toLowerCase();
            } else if (crit === 'part') {
                valA = parseInt(a.dataset.nbPart) || 0;
                valB = parseInt(b.dataset.nbPart) || 0;
            } else if (crit === 'date') {
                valA = parseInt(a.dataset.dateTs) || 0;
                valB = parseInt(b.dataset.dateTs) || 0;
                // Si date 0 (non définie), on la met à la fin
                if (valA === 0) valA = order === 'asc' ? Infinity : -Infinity;
                if (valB === 0) valB = order === 'asc' ? Infinity : -Infinity;
            } else if (crit === 'id') {
                valA = parseInt(a.dataset.id) || 0;
                valB = parseInt(b.dataset.id) || 0;
            }

            if (valA < valB) return order === 'asc' ? -1 : 1;
            if (valA > valB) return order === 'asc' ? 1 : -1;
            return 0;
        });

        // Ré-injecter les cartes dans le nouvel ordre
        cardsArray.forEach(card => grid.appendChild(card));
    }

    function applyAllFilters() {
        const q = input.value.trim().toLowerCase();
        let visible = 0;

        cardsArray.forEach(card => {
            const nom = (card.dataset.name || '').toLowerCase();
            const statut = card.dataset.statut || '';
            const isExpired = card.dataset.isExpired === '1';
            
            const matchText = !q || nom.startsWith(q);
            
            let matchFilter = true;
            if (activeFilter.type === 'statut') {
                matchFilter = (statut === activeFilter.val);
            } else if (activeFilter.type === 'date') {
                matchFilter = (activeFilter.val === 'past') ? isExpired : !isExpired;
            }

            const isShown = matchText && matchFilter;
            card.classList.toggle('hidden', !isShown);
            if (isShown) visible++;
        });

        if (noResEl) { noResEl.remove(); noResEl = null; }
        if (visible === 0) {
            noResEl = document.createElement('div');
            noResEl.className = 'no-results-msg';
            noResEl.innerHTML = '<div class="icon">🔍</div><p>Aucun résultat correspondant à vos critères.</p>';
            grid.appendChild(noResEl);
        }
        updateCounter(visible);
    }

    // Sort event
    sortSel.addEventListener('change', () => {
        sortCards();
        applyAllFilters();
    });

    // Input events
    input.addEventListener('input', applyAllFilters);

    // Filter button events
    filters.forEach(btn => {
        btn.addEventListener('click', function() {
            filters.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            activeFilter.type = this.dataset.filterType;
            activeFilter.val = this.dataset.filterVal;
            applyAllFilters();
        });
    });

    // Initial Sort
    sortCards();
    updateCounter(cardsArray.length);
})();
</script>
{% endblock %}

