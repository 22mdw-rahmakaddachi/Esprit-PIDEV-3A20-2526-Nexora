{# templates/destination/client/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ destination.nom }} — Destination{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --primary: #2563EB;
        --gray-50: #F9FAFB;
        --gray-100: #F3F4F6;
        --gray-200: #E5E7EB;
        --gray-600: #4B5563;
        --gray-800: #1F2937;
    }

    body { font-family: 'Segoe UI', system-ui, sans-serif; background: var(--gray-50); }

    .back-bar {
        background: white;
        border-bottom: 1px solid var(--gray-200);
        padding: 14px 32px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--gray-600);
        text-decoration: none;
        font-size: .9rem;
        padding: 8px 14px;
        border-radius: 6px;
        transition: background .2s;
        font-weight: 500;
    }

    .back-btn:hover { background: var(--gray-100); color: var(--gray-800); }

    .container { max-width: 1100px; margin: 40px auto; padding: 0 24px; }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,.08);
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .detail-grid { grid-template-columns: 1fr; }
    }

    .detail-image-side { position: relative; }

    .main-image {
        width: 100%;
        height: 400px;
        object-fit: cover;
        display: block;
    }

    .image-placeholder {
        width: 100%;
        height: 400px;
        background: linear-gradient(135deg, #DBEAFE, #EDE9FE);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 5rem;
    }

    .badge-overlay {
        position: absolute;
        top: 20px;
        left: 20px;
        padding: 6px 16px;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 700;
    }

    .badge-disponible { background: #16A34A; color: white; }
    .badge-complet { background: #DC2626; color: white; }

    .detail-info-side { padding: 40px; }

    .detail-info-side h1 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--gray-800);
        margin-bottom: 16px;
    }

    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px 0;
        border-bottom: 1px solid var(--gray-100);
    }

    .info-row:last-child { border-bottom: none; }

    .info-icon { font-size: 1.2rem; flex-shrink: 0; margin-top: 2px; }

    .info-label {
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--gray-600);
        margin-bottom: 4px;
    }

    .info-value {
        font-size: 1rem;
        color: var(--gray-800);
        line-height: 1.6;
    }

    .maps-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        padding: 10px 20px;
        background: var(--primary);
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-size: .85rem;
        font-weight: 600;
        transition: background .2s, transform .2s;
    }

    .maps-btn:hover { background: #1d4ed8; transform: translateY(-1px); }

    /* Extra images */
    .extra-images {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .extra-image {
        width: 90px;
        height: 60px;
        object-fit: cover;
        border-radius: 6px;
        border: 2px solid var(--gray-200);
        cursor: pointer;
        transition: border .2s;
    }

    .extra-image:hover { border-color: var(--primary); }
</style>
{% endblock %}

{% block body %}
<div class="back-bar">
    <a href="{{ path('client_destination_index') }}" class="back-btn">← Retour aux destinations</a>
</div>

<div class="container">
    <div class="detail-grid">

        {# IMAGE SIDE #}
        <div class="detail-image-side">
            {% if destination.firstImage %}
                <img src="{{ destination.firstImage }}" alt="{{ destination.nom }}" class="main-image" id="mainImage">
            {% else %}
                <div class="image-placeholder">🏔️</div>
            {% endif %}

            {% if destination.statut %}
                <span class="badge-overlay {{ destination.statut == 'Disponible' ? 'badge-disponible' : 'badge-complet' }}">
                    {{ destination.statut == 'Disponible' ? '✅ Disponible' : '🔴 Complet' }}
                </span>
            {% endif %}
        </div>

        {# INFO SIDE #}
        <div class="detail-info-side">
            <h1>{{ destination.nom }}</h1>

            {# LOCALISATION #}
            {% if destination.localisation %}
            <div class="info-row">
                <span class="info-icon">📍</span>
                <div>
                    <div class="info-label">Localisation</div>
                    <div class="info-value">{{ destination.localisation }}</div>
                    <a href="https://www.google.com/maps/search/?api=1&query={{ destination.localisation|url_encode }}"
                       target="_blank" class="maps-btn">
                        🗺️ Voir sur Google Maps
                    </a>
                </div>
            </div>
            {% endif %}

            {# DESCRIPTION #}
            {% if destination.description %}
            <div class="info-row">
                <span class="info-icon">📝</span>
                <div>
                    <div class="info-label">Description</div>
                    <div class="info-value">{{ destination.description }}</div>
                </div>
            </div>
            {% endif %}

            {# IMAGES SUPPLÉMENTAIRES #}
            {% if destination.imagesList|length > 1 %}
            <div class="info-row">
                <span class="info-icon">🖼️</span>
                <div>
                    <div class="info-label">Galerie</div>
                    <div class="extra-images">
                        {% for img in destination.imagesList %}
                            <img src="{{ img }}" alt="Image" class="extra-image"
                                 onclick="document.getElementById('mainImage').src='{{ img }}'">
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% endif %}

        </div>
    </div>
</div>
{% endblock %}
