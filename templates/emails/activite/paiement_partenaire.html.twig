<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><title>Paiement reçu</title></head>
<body style="margin:0;padding:0;background:#f0f2f5;font-family:'Segoe UI',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f0f2f5;padding:30px 0;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">

      <tr>
        <td style="background:linear-gradient(135deg,#6c3fc5,#9b59b6);border-radius:12px 12px 0 0;padding:35px 40px;text-align:center;">
          <div style="font-size:48px;margin-bottom:10px;">💰</div>
          <h1 style="color:#fff;margin:0;font-size:24px;font-weight:700;">Paiement reçu !</h1>
          <p style="color:rgba(255,255,255,0.9);margin:8px 0 0;font-size:14px;">Un client a payé sa participation</p>
        </td>
      </tr>

      <tr>
        <td style="background:#fff;padding:35px 40px;">
          <p style="color:#444;font-size:16px;margin:0 0 20px;">Bonjour,</p>
          <p style="color:#666;font-size:15px;margin:0 0 25px;line-height:1.6;">
            Le client <strong style="color:#6c3fc5;">{{ demande.clientNom }}</strong> a effectué le paiement pour votre activité.
          </p>

          <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8f5ff;border:1px solid #e0d5f5;border-radius:10px;margin-bottom:20px;">
            <tr><td style="padding:20px 25px;">
              <p style="margin:0 0 12px;font-size:13px;font-weight:700;color:#6c3fc5;text-transform:uppercase;letter-spacing:1px;">🎯 Détails</p>
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding:6px 0;color:#555;font-size:14px;width:150px;">Activité</td>
                  <td style="padding:6px 0;color:#222;font-size:14px;font-weight:700;">{{ activite.nom }}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0;color:#555;font-size:14px;">Client</td>
                  <td style="padding:6px 0;color:#222;font-size:14px;font-weight:600;">{{ demande.clientNom }}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0;color:#555;font-size:14px;">📧 Email client</td>
                  <td style="padding:6px 0;color:#222;font-size:14px;">{{ demande.clientEmail }}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0;color:#555;font-size:14px;">💵 Montant</td>
                  <td style="padding:6px 0;color:#16a34a;font-size:16px;font-weight:700;">{{ activite.prix }} TND</td>
                </tr>
                <tr>
                  <td style="padding:6px 0;color:#555;font-size:14px;">Référence</td>
                  <td style="padding:6px 0;color:#6c3fc5;font-size:14px;font-weight:700;">#{{ demande.id }}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0;color:#555;font-size:14px;">Statut</td>
                  <td style="padding:6px 0;">
                    <span style="background:#dcfce7;color:#16a34a;font-size:13px;font-weight:700;padding:4px 12px;border-radius:20px;">✅ Payé</span>
                  </td>
                </tr>
              </table>
            </td></tr>
          </table>
        </td>
      </tr>

      <tr>
        <td style="background:#f8f5ff;border-radius:0 0 12px 12px;padding:15px 40px;text-align:center;border-top:1px solid #e0d5f5;">
          <p style="color:#9b59b6;font-size:13px;font-weight:700;margin:0 0 4px;">Nexora Activités</p>
          <p style="color:#aaa;font-size:12px;margin:0;">Ceci est un email automatique, merci de ne pas y répondre.</p>
        </td>
      </tr>

    </table>
  </td></tr>
</table>
</body>
</html>
