{% extends 'base.html.twig' %}
{% block title %}TripShop — Accueil{% endblock %}

{% block body %}

{# ══════════════════════════════════════════
   HERO + AVION ANIMÉ
══════════════════════════════════════════ #}
<section class="hero" style="overflow:hidden;position:relative">

    {# Scène avion (canvas + SVG) #}
    <div id="plane-scene" style="position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden">
        <canvas id="trail-canvas" style="position:absolute;inset:0;width:100%;height:100%"></canvas>

        {# Avion SVG #}
        <div id="plane" style="position:absolute;top:30%;left:-120px;transform:translateY(-50%)">
            <svg width="110" height="40" viewBox="0 0 110 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="55" cy="20" rx="50" ry="9" fill="white" opacity="0.95"/>
                <path d="M105 20 Q115 20 108 16 L95 20 Z" fill="#d8c5f5"/>
                <path d="M50 20 L70 4 L80 4 L65 20 Z" fill="white" opacity="0.85"/>
                <path d="M50 20 L70 36 L80 36 L65 20 Z" fill="white" opacity="0.75"/>
                <path d="M15 20 L22 10 L28 10 L22 20 Z" fill="white" opacity="0.8"/>
                <path d="M15 20 L22 30 L28 30 L22 20 Z" fill="white" opacity="0.7"/>
                <circle cx="75" cy="18" r="3" fill="#a78bda" opacity="0.7"/>
                <circle cx="63" cy="17" r="3" fill="#a78bda" opacity="0.7"/>
                <circle cx="51" cy="17" r="3" fill="#a78bda" opacity="0.7"/>
                <ellipse cx="60" cy="28" rx="8" ry="4" fill="#c39bd3" opacity="0.8"/>
                <ellipse cx="60" cy="28" rx="5" ry="2.5" fill="#6c3fc5" opacity="0.6"/>
            </svg>
        </div>

        {# Nuages #}
        <div style="position:absolute;top:12%;left:-80px;opacity:0.15;font-size:3rem;animation:cloudDrift 18s linear infinite">☁️</div>
        <div style="position:absolute;top:58%;left:-80px;opacity:0.10;font-size:2rem;animation:cloudDrift 26s linear infinite 5s">☁️</div>
        <div style="position:absolute;top:75%;left:-80px;opacity:0.08;font-size:1.5rem;animation:cloudDrift 22s linear infinite 10s">☁️</div>
    </div>

    {# Contenu hero #}
    <div class="container position-relative" style="z-index:1">
        <div class="row align-items-center">
            <div class="col-lg-6 animate-fadeup">
                <span class="badge rounded-pill mb-3 px-3 py-2"
                      style="background:rgba(255,255,255,0.2);color:#fff;font-size:0.85rem">
                    <i class="bi bi-star-fill me-1 text-warning"></i>Plateforme N°1 en Tunisie
                </span>
                <h1 class="mb-3">Découvrez nos produits<br>& <span style="color:#d8c5f5">activités</span> outdoor</h1>
                <p class="mb-4 opacity-75">Équipements de qualité et expériences uniques pour tous les aventuriers.</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="{{ path('app_produits') }}" class="btn btn-hero">
                        <i class="bi bi-bag me-2"></i>Voir la boutique
                    </a>
                    <a href="{{ path('app_activites') }}" class="btn btn-hero-outline">
                        <i class="bi bi-calendar-event me-2"></i>Nos activités
                    </a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-flex justify-content-end gap-3 mt-4 mt-lg-0">
                {% for item in [['🏕️','Camping'],['🏃','Sport'],['🎭','Culture'],['🍽️','Gastro']] %}
                <div class="text-center p-4 rounded-3 animate-fadeup"
                     style="background:rgba(255,255,255,0.12);backdrop-filter:blur(8px);animation-delay:{{ loop.index * 0.15 }}s">
                    <div style="font-size:2.4rem">{{ item[0] }}</div>
                    <div class="mt-2 fw-semibold small">{{ item[1] }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{# ── FEED PUBLICATIONS ── #}
<section class="py-5" id="publications" style="background:var(--bg)">
    <div class="container">
        <div class="text-center mb-4" data-aos="fade-down">
            <h2 class="section-title d-inline-block">
                <i class="bi bi-newspaper me-2" style="color:var(--primary)"></i>Publications
            </h2>
            <p class="text-muted mt-2 small">Partagez vos expériences avec la communauté TripShop</p>
        </div>
        <div style="max-width:600px;margin:0 auto">
            <div class="card border-0 rounded-4 p-4 mb-4" style="box-shadow:0 4px 20px rgba(108,63,197,0.09);border:1px solid var(--border)!important;background:var(--card-bg)" data-aos="fade-up">
                <form method="POST" action="{{ path('app_publication_new') }}" enctype="multipart/form-data" id="pub-form">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div id="pub-avatar-new" style="width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;font-weight:700;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0">?</div>
                        <input type="text" name="auteur" id="pub-auteur" placeholder="Votre nom..." class="form-control rounded-pill" style="border-color:#ede5ff;font-size:0.88rem" required minlength="2">
                    </div>
                    <textarea name="contenu" id="pub-contenu" rows="3" required minlength="2" class="form-control rounded-3 mb-3" style="border-color:#ede5ff;font-size:0.9rem;resize:none" placeholder="Quoi de neuf ? Partagez votre expérience..."></textarea>
                    <div id="img-preview-pub" class="mb-3" style="display:none">
                        <img id="img-preview-src" src="" alt="aperçu" style="max-height:200px;border-radius:12px;object-fit:cover;width:100%;border:2px solid #ede5ff">
                        <button type="button" onclick="clearImage()" class="btn btn-sm mt-1" style="color:#e74c3c;font-size:0.78rem"><i class="bi bi-x-circle me-1"></i>Supprimer l'image</button>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <label for="pub-image" class="btn btn-sm rounded-pill px-3" style="border:1.5px solid #ede5ff;color:var(--primary);cursor:pointer;font-size:0.82rem">
                            <i class="bi bi-image me-1"></i>Photo
                            <input type="file" name="image" id="pub-image" accept="image/*" style="display:none" onchange="previewImage(this)">
                        </label>
                        <button type="submit" class="btn rounded-pill px-4 fw-semibold" style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;font-size:0.88rem"><i class="bi bi-send me-2"></i>Publier</button>
                    </div>
                </form>
            </div>
            <div id="pub-feed">
                {% for pub in dernieresPubs %}
                <div class="card border-0 rounded-4 mb-4" style="box-shadow:0 2px 16px rgba(108,63,197,0.08);border:1px solid var(--border)!important;background:var(--card-bg);overflow:hidden" id="pub-{{ pub.id }}">
                    <div class="d-flex align-items-center gap-3 p-3">
                        <div style="width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;font-weight:700;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0">{{ pub.auteur|slice(0,1)|upper }}</div>
                        <div>
                            <div class="fw-bold" style="color:var(--primary-dark);font-size:0.95rem">{{ pub.auteur }}</div>
                            <div class="text-muted" style="font-size:0.72rem"><i class="bi bi-globe me-1"></i>{{ pub.created_at|date('d/m/Y à H:i') }}</div>
                        </div>
                    </div>
                    <div class="px-3 pb-3" style="font-size:0.92rem;line-height:1.7;color:var(--text)">{{ pub.contenu }}</div>
                    {% if pub.image %}<img src="/uploads/publications/{{ pub.image }}" alt="publication" style="width:100%;max-height:400px;object-fit:cover">{% endif %}
                    <div class="px-3 pt-2 pb-1" id="summary-{{ pub.id }}" style="font-size:0.8rem;color:#888;min-height:20px">
                        {% for r in pub.reactions %}{{ r.type_reaction == 'jaime' ? '👍' : r.type_reaction == 'jadore' ? '❤️' : r.type_reaction == 'haha' ? '😂' : r.type_reaction == 'wow' ? '😮' : r.type_reaction == 'triste' ? '😢' : '😡' }} {{ r.total }} {% endfor %}
                    </div>
                    <div class="d-flex align-items-center gap-1 px-3 py-2" style="border-top:1px solid var(--border);border-bottom:1px solid var(--border)" id="reactions-{{ pub.id }}">
                        {% set emojis = {'jaime':'👍','jadore':'❤️','haha':'😂','wow':'😮','triste':'😢','grrr':'😡'} %}
                        {% for key, emoji in emojis %}{% set count = 0 %}{% for r in pub.reactions %}{% if r.type_reaction == key %}{% set count = r.total %}{% endif %}{% endfor %}
                        <button onclick="reagir({{ pub.id }},'{{ key }}',this)" data-type="{{ key }}" class="btn btn-sm px-2 py-1 reaction-btn-home" style="font-size:1.2rem;border:none;background:none;transition:transform 0.15s" title="{{ key }}">{{ emoji }}{% if count > 0 %}<sup style="font-size:0.65rem;color:var(--primary);font-weight:700">{{ count }}</sup>{% endif %}</button>
                        {% endfor %}
                        <button class="ms-auto btn btn-sm rounded-pill px-3" style="font-size:0.8rem;color:var(--primary);border:1.5px solid #ede5ff" onclick="toggleComments({{ pub.id }})"><i class="bi bi-chat me-1"></i><span id="nb-comments-{{ pub.id }}">{{ pub.commentaires|length }}</span></button>
                    </div>
                    <div id="comments-{{ pub.id }}" style="display:none">
                        <div class="px-3 pt-3 d-flex flex-column gap-3" id="comments-list-{{ pub.id }}">
                            {% for c in pub.commentaires %}
                            <div class="d-flex gap-2 align-items-start">
                                <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#a78bda,var(--accent));color:#fff;font-weight:700;font-size:0.78rem;display:flex;align-items:center;justify-content:center;flex-shrink:0">{{ c.auteur|slice(0,1)|upper }}</div>
                                <div style="background:#f4f1fb;border-radius:0 12px 12px 12px;padding:8px 14px;font-size:0.85rem;flex:1">
                                    <div style="font-weight:700;color:var(--primary-dark);font-size:0.82rem">{{ c.auteur }}</div>
                                    <div style="color:#444;margin-top:2px">{{ c.contenu }}</div>
                                    <div style="color:#aaa;font-size:0.72rem;margin-top:3px">{{ c.created_at|date('d/m/Y H:i') }}</div>
                                </div>
                            </div>
                            {% else %}<div class="text-muted small text-center py-2" id="no-comment-{{ pub.id }}">Aucun commentaire.</div>{% endfor %}
                        </div>
                        <div class="d-flex gap-2 align-items-center p-3">
                            <input type="text" id="c-auteur-{{ pub.id }}" placeholder="Votre nom" class="form-control form-control-sm rounded-pill" style="border-color:#ede5ff;max-width:120px">
                            <input type="text" id="c-text-{{ pub.id }}" placeholder="Commenter..." class="form-control form-control-sm rounded-pill" style="border-color:#ede5ff;flex:1" onkeydown="if(event.key==='Enter') envoyerCommentaire({{ pub.id }})">
                            <button onclick="envoyerCommentaire({{ pub.id }})" class="btn btn-sm rounded-pill" style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;width:34px;height:34px;padding:0;flex-shrink:0"><i class="bi bi-send-fill" style="font-size:0.8rem"></i></button>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="text-center py-4 text-muted"><div style="font-size:3rem">📝</div><p class="mt-2 small">Aucune publication. Soyez le premier !</p></div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{# STATS #}
<section class="stats-bar py-4">
    <div class="container">
        <div class="row text-center g-3">
            {% for stat in [['500+','Produits','bi-bag'],['50+','Activités','bi-calendar-event'],['1000+','Clients','bi-people'],['20+','Partenaires','bi-handshake']] %}
            <div class="col-6 col-md-3 stat-item" data-aos="zoom-in" data-aos-delay="{{ loop.index * 80 }}">
                <i class="bi {{ stat[2] }} fs-4 mb-1" style="color:var(--primary-light)"></i>
                <div class="stat-num">{{ stat[0] }}</div>
                <div class="text-muted small">{{ stat[1] }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# PRODUITS VEDETTES #}
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-right">
            <h2 class="section-title mb-0">Produits vedettes</h2>
            <a href="{{ path('app_produits') }}" class="text-decoration-none fw-semibold" style="color:var(--primary)">
                Voir tout <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-4">
            {% for produit in produits %}
            <div class="col-6 col-md-4 col-lg-2" data-aos="fade-up" data-aos-delay="{{ loop.index * 80 }}">
                <div class="product-card card h-100">
                    <div class="img-wrap img-zoom">
                        <span class="emoji-img" style="font-size:3.5rem">🛍️</span>
                    </div>
                    <div class="card-body p-3">
                        <span class="badge-cat mb-2 d-inline-block">
                            {{ produit.sousCategorie ? produit.sousCategorie.nom : 'Produit' }}
                        </span>
                        <h6 class="card-title mb-1" style="font-size:0.88rem">{{ produit.nom }}</h6>
                        <div class="price">{{ produit.prixMin ? produit.prixMin ~ ' TND' : 'N/A' }}</div>
                    </div>
                    <div class="card-footer bg-transparent border-0 p-3 pt-0">
                        <a href="{{ path('app_produit_show', {id: produit.id}) }}" class="btn-add btn">
                            <i class="bi bi-eye me-1"></i>Voir
                        </a>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center text-muted py-4">Aucun produit disponible.</div>
            {% endfor %}
        </div>
    </div>
</section>

<hr class="divider">

{# ACTIVITES #}
<section class="py-5" style="background:var(--white)">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-right">
            <h2 class="section-title mb-0">Activités à venir</h2>
            <a href="{{ path('app_activites') }}" class="text-decoration-none fw-semibold" style="color:var(--primary)">
                Voir tout <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-4">
            {% for activite in activites %}
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
                <div class="activity-card card h-100">
                    <div class="img-wrap">
                        <span style="font-size:4rem">
                            {% if activite.type == 'Sport' %}🏃
                            {% elseif activite.type == 'Culture' %}🎭
                            {% elseif activite.type == 'Gastronomie' %}🍽️
                            {% else %}🌟{% endif %}
                        </span>
                        <span class="position-absolute top-0 start-0 m-2 badge bg-white"
                              style="color:var(--primary);font-size:0.72rem">{{ activite.type }}</span>
                    </div>
                    <div class="card-body p-3">
                        <h6 class="card-title">{{ activite.nom }}</h6>
                        <div class="text-muted small mb-1"><i class="bi bi-geo-alt me-1"></i>{{ activite.lieu }}</div>
                        <div class="text-muted small mb-2"><i class="bi bi-calendar me-1"></i>{{ activite.date_activite|date('d/m/Y') }}</div>
                        <div class="price">{{ activite.prix }} TND</div>
                    </div>
                    <div class="card-footer bg-transparent border-0 p-3 pt-0">
                        <a href="{{ path('app_activite_show', {id: activite.id}) }}" class="btn-activity btn">
                            <i class="bi bi-arrow-right me-1"></i>Détails
                        </a>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center text-muted py-4">Aucune activité disponible.</div>
            {% endfor %}
        </div>
    </div>
</section>

{% if dernierAvis|length > 0 %}
<section class="py-5" style="background:var(--bg)">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-right">
            <h2 class="section-title mb-0">
                <i class="bi bi-chat-square-quote me-2" style="color:var(--primary)"></i>Avis de nos clients
            </h2>
            <a href="{{ path('app_activites') }}" class="text-decoration-none fw-semibold" style="color:var(--primary)">
                Voir les activités <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-4">
            {% for avis in dernierAvis %}
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 80 }}">
                <div class="card h-100 border-0 rounded-4 p-4"
                     style="background:var(--card-bg);box-shadow:0 4px 20px rgba(108,63,197,0.08);border:1px solid var(--border)!important">
                    {# Étoiles #}
                    <div style="color:#f39c12;font-size:1rem;margin-bottom:10px">
                        {% for i in 1..5 %}
                            <i class="bi bi-star{{ i <= avis.note ? '-fill' : '' }}"></i>
                        {% endfor %}
                        <span class="ms-1 text-muted small">({{ avis.note }}/5)</span>
                    </div>
                    {# Commentaire #}
                    <p class="text-muted mb-3" style="font-size:0.9rem;line-height:1.7;flex-grow:1">
                        "{{ avis.commentaire|length > 120 ? avis.commentaire|slice(0,120) ~ '…' : avis.commentaire }}"
                    </p>
                    {# Auteur #}
                    <div class="d-flex align-items-center gap-2 mt-auto pt-3"
                         style="border-top:1px solid var(--border)">
                        <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.85rem;flex-shrink:0">
                            {{ avis.auteur|slice(0,1)|upper }}
                        </div>
                        <div>
                            <div class="fw-semibold small" style="color:var(--primary-dark)">{{ avis.auteur }}</div>
                            {% if avis.activiteNom %}
                            <div class="text-muted" style="font-size:0.72rem">
                                <i class="bi bi-calendar-event me-1"></i>{{ avis.activiteNom }}
                            </div>
                            {% endif %}
                        </div>
                        <div class="ms-auto text-muted" style="font-size:0.72rem">
                            {{ avis.createdAt|date('d/m/Y') }}
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# CTA BANNER #}
<section class="py-5" data-aos="zoom-in">
    <div class="container">
        <div class="rounded-4 p-5 text-center text-white"
             style="background:linear-gradient(135deg,var(--primary-dark),var(--accent))">
            <h2 class="mb-3">Prêt à vivre l'aventure ?</h2>
            <p class="mb-4 opacity-75">Rejoignez des milliers d'aventuriers qui nous font confiance.</p>
            <a href="{{ path('app_activites') }}" class="btn btn-hero me-3">
                <i class="bi bi-calendar-check me-2"></i>Réserver une activité
            </a>
            <a href="{{ path('app_produits') }}" class="btn btn-hero-outline">
                <i class="bi bi-bag me-2"></i>Explorer la boutique
            </a>
        </div>
    </div>
</section>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<style>
    .reaction-btn-home:hover { transform: scale(1.35) !important; }
    [data-theme="dark"] .form-control { background: var(--input-bg); color: var(--text); border-color: var(--border); }
    [data-theme="dark"] .card { background: var(--card-bg) !important; border-color: var(--border) !important; }
    [data-theme="dark"] .pub-avatar-comment { background: linear-gradient(135deg,#3d2a6e,#5a3a8a) !important; }
    [data-theme="dark"] .comment-bg { background: #221f33 !important; }
    [data-theme="dark"] .comment-text { color: var(--text) !important; }
    [data-theme="dark"] .activity-card, [data-theme="dark"] .product-card { background: var(--card-bg) !important; }
    [data-theme="dark"] section[style*="background:var(--white)"] { background: var(--card-bg) !important; }
</style>
<script>
// Pré-remplir le nom depuis localStorage
document.addEventListener('DOMContentLoaded', () => {
    const name = localStorage.getItem('tripshop_username') || '';
    if (name) {
        const el = document.getElementById('pub-auteur');
        if (el) { el.value = name; updateAvatar(name); }
    }
    document.getElementById('pub-auteur')?.addEventListener('input', function() {
        updateAvatar(this.value);
    });
});

function updateAvatar(name) {
    const av = document.getElementById('pub-avatar-new');
    if (av) av.textContent = name.trim() ? name.trim()[0].toUpperCase() : '?';
}

// Preview image
function previewImage(input) {
    if (!input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
        document.getElementById('img-preview-src').src = e.target.result;
        document.getElementById('img-preview-pub').style.display = 'block';
    };
    reader.readAsDataURL(input.files[0]);
}
function clearImage() {
    document.getElementById('pub-image').value = '';
    document.getElementById('img-preview-pub').style.display = 'none';
}

// Sauvegarder le nom à la soumission
document.getElementById('pub-form')?.addEventListener('submit', function() {
    const auteur = document.getElementById('pub-auteur').value.trim();
    if (auteur) localStorage.setItem('tripshop_username', auteur);
});

// ── RÉAGIR ──
function reagir(pubId, type, btn) {
    let auteur = localStorage.getItem('tripshop_username') || '';
    if (!auteur) {
        auteur = prompt('Votre prénom pour réagir ?', '');
        if (!auteur || auteur.trim().length < 2) return;
        localStorage.setItem('tripshop_username', auteur.trim());
    }
    const fd = new FormData();
    fd.append('auteur', auteur.trim());
    fd.append('type', type);

    fetch(`/publications/${pubId}/reagir`, { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            if (data.error) return;
            const emojis = {jaime:'👍',jadore:'❤️',haha:'😂',wow:'😮',triste:'😢',grrr:'😡'};
            // Mise à jour boutons
            document.querySelectorAll(`#reactions-${pubId} .reaction-btn-home`).forEach(b => {
                const t = b.dataset.type;
                const found = data.reactions.find(r => r.type_reaction === t);
                const sup = b.querySelector('sup');
                if (found && found.total > 0) {
                    if (sup) sup.textContent = found.total;
                    else b.innerHTML = emojis[t] + `<sup style="font-size:0.65rem;color:var(--primary);font-weight:700">${found.total}</sup>`;
                } else {
                    if (sup) sup.remove();
                }
            });
            // Résumé
            const summary = document.getElementById(`summary-${pubId}`);
            summary.innerHTML = data.reactions.map(r => `${emojis[r.type_reaction]} ${r.total}`).join(' ');
        });
}

// ── TOGGLE COMMENTAIRES ──
function toggleComments(pubId) {
    const el = document.getElementById(`comments-${pubId}`);
    el.style.display = el.style.display === 'none' ? 'block' : 'none';
    if (el.style.display === 'block') {
        const name = localStorage.getItem('tripshop_username') || '';
        const auteurEl = document.getElementById(`c-auteur-${pubId}`);
        if (auteurEl && name) auteurEl.value = name;
    }
}

// ── COMMENTER ──
function envoyerCommentaire(pubId) {
    const auteurEl  = document.getElementById(`c-auteur-${pubId}`);
    const contenuEl = document.getElementById(`c-text-${pubId}`);
    const auteur    = auteurEl.value.trim();
    const contenu   = contenuEl.value.trim();

    auteurEl.style.borderColor  = auteur.length  < 2 ? '#e74c3c' : '#ede5ff';
    contenuEl.style.borderColor = contenu.length < 2 ? '#e74c3c' : '#ede5ff';
    if (auteur.length < 2 || contenu.length < 2) return;

    localStorage.setItem('tripshop_username', auteur);

    const fd = new FormData();
    fd.append('auteur', auteur);
    fd.append('contenu', contenu);

    fetch(`/publications/${pubId}/commenter`, { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            if (data.error) return;
            contenuEl.value = '';
            contenuEl.style.borderColor = '#ede5ff';
            document.getElementById(`no-comment-${pubId}`)?.remove();

            const list = document.getElementById(`comments-list-${pubId}`);
            const div  = document.createElement('div');
            div.className = 'd-flex gap-2 align-items-start';
            div.innerHTML = `
                <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#a78bda,var(--accent));color:#fff;font-weight:700;font-size:0.78rem;display:flex;align-items:center;justify-content:center;flex-shrink:0">${data.auteur[0].toUpperCase()}</div>
                <div style="background:#f4f1fb;border-radius:0 12px 12px 12px;padding:8px 14px;font-size:0.85rem;flex:1">
                    <div style="font-weight:700;color:var(--primary-dark);font-size:0.82rem">${data.auteur}</div>
                    <div style="color:#444;margin-top:2px">${data.contenu}</div>
                    <div style="color:#aaa;font-size:0.72rem;margin-top:3px">${data.created_at}</div>
                </div>`;
            list.appendChild(div);

            const nb = document.getElementById(`nb-comments-${pubId}`);
            if (nb) nb.textContent = parseInt(nb.textContent || 0) + 1;
        });
}
</script>
<style>
    @keyframes cloudDrift {
        from { transform: translateX(0); }
        to   { transform: translateX(120vw); }
    }
</style>
<script>
(function () {
    const plane  = document.getElementById('plane');
    const canvas = document.getElementById('trail-canvas');
    const scene  = document.getElementById('plane-scene');
    if (!plane || !canvas || !scene) return;

    const ctx = canvas.getContext('2d');
    let W, H, x, y, trail = [], tick = 0;
    const SPEED = 1.8, TRAIL_LEN = 130, AMPLITUDE = 30, FREQUENCY = 0.011;

    function resize() { W = canvas.width = scene.offsetWidth; H = canvas.height = scene.offsetHeight; reset(); }
    function reset()  { x = -130; y = H * 0.35; trail = []; tick = 0; }

    function drawTrail() {
        ctx.clearRect(0, 0, W, H);
        if (trail.length < 2) return;
        [-7, 7].forEach(offset => {
            ctx.beginPath();
            ctx.moveTo(trail[0].x, trail[0].y + offset);
            for (let i = 1; i < trail.length; i++) ctx.lineTo(trail[i].x, trail[i].y + offset);
            const g = ctx.createLinearGradient(trail[0].x, 0, trail[trail.length-1].x, 0);
            g.addColorStop(0, 'rgba(255,255,255,0)');
            g.addColorStop(0.3, 'rgba(195,155,211,0.2)');
            g.addColorStop(1, 'rgba(255,255,255,0.6)');
            ctx.strokeStyle = g; ctx.lineWidth = 3.5; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
            ctx.stroke();
        });
    }

    function animate() {
        tick++; x += SPEED;
        const targetY = H * 0.35 + Math.sin(tick * FREQUENCY) * AMPLITUDE;
        y += (targetY - y) * 0.05;
        const dy = trail.length > 1 ? y - trail[trail.length-1].y : 0;
        const angle = Math.atan2(dy, SPEED) * (180 / Math.PI);
        plane.style.left = x + 'px'; plane.style.top = y + 'px';
        plane.style.transform = `translateY(-50%) rotate(${angle * 0.55}deg)`;
        trail.push({ x: x + 8, y });
        if (trail.length > TRAIL_LEN) trail.shift();
        drawTrail();
        if (x > W + 160) reset();
        requestAnimationFrame(animate);
    }

    window.addEventListener('resize', resize);
    resize(); animate();
})();
</script>
