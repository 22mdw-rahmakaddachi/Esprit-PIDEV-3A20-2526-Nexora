{% extends 'base.html.twig' %}
{% block title %}NEXORA — Accueil{% endblock %}

{% block body %}

{# ══════════════════════════════════════════
   HERO + AVION ANIMÉ
══════════════════════════════════════════ #}
<section class="hero" style="overflow:hidden;position:relative">

    {# Scène avion (canvas + SVG) #}
    <div id="plane-scene" style="position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden">
        <canvas id="trail-canvas" style="position:absolute;inset:0;width:100%;height:100%"></canvas>

        {# Avion SVG #}
        <div id="plane" style="position:absolute;top:30%;left:-120px;transform:translateY(-50%)">
            <svg width="110" height="40" viewBox="0 0 110 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="55" cy="20" rx="50" ry="9" fill="white" opacity="0.95"/>
                <path d="M105 20 Q115 20 108 16 L95 20 Z" fill="#d8c5f5"/>
                <path d="M50 20 L70 4 L80 4 L65 20 Z" fill="white" opacity="0.85"/>
                <path d="M50 20 L70 36 L80 36 L65 20 Z" fill="white" opacity="0.75"/>
                <path d="M15 20 L22 10 L28 10 L22 20 Z" fill="white" opacity="0.8"/>
                <path d="M15 20 L22 30 L28 30 L22 20 Z" fill="white" opacity="0.7"/>
                <circle cx="75" cy="18" r="3" fill="#a78bda" opacity="0.7"/>
                <circle cx="63" cy="17" r="3" fill="#a78bda" opacity="0.7"/>
                <circle cx="51" cy="17" r="3" fill="#a78bda" opacity="0.7"/>
                <ellipse cx="60" cy="28" rx="8" ry="4" fill="#c39bd3" opacity="0.8"/>
                <ellipse cx="60" cy="28" rx="5" ry="2.5" fill="#6c3fc5" opacity="0.6"/>
            </svg>
        </div>

        {# Nuages #}
        <div style="position:absolute;top:12%;left:-80px;opacity:0.15;font-size:3rem;animation:cloudDrift 18s linear infinite">☁️</div>
        <div style="position:absolute;top:58%;left:-80px;opacity:0.10;font-size:2rem;animation:cloudDrift 26s linear infinite 5s">☁️</div>
        <div style="position:absolute;top:75%;left:-80px;opacity:0.08;font-size:1.5rem;animation:cloudDrift 22s linear infinite 10s">☁️</div>
    </div>

    {# Contenu hero #}
    <div class="container position-relative" style="z-index:1">
        <div class="row align-items-center">
            <div class="col-lg-6 animate-fadeup">
                <span class="badge rounded-pill mb-3 px-3 py-2"
                      style="background:rgba(255,255,255,0.2);color:#fff;font-size:0.85rem">
                    <i class="bi bi-star-fill me-1 text-warning"></i>Plateforme N°1 en Tunisie
                </span>
                <h1 class="mb-3">Découvrez nos produits<br>& <span style="color:#d8c5f5">activités</span> outdoor</h1>
                <p class="mb-4 opacity-75">Équipements de qualité et expériences uniques pour tous les aventuriers.</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="{{ path('app_produits') }}" class="btn btn-hero">
                        <i class="bi bi-bag me-2"></i>Voir la boutique
                    </a>
                    <a href="{{ path('app_activites') }}" class="btn btn-hero-outline">
                        <i class="bi bi-calendar-event me-2"></i>Nos activités
                    </a>
                </div>

                {# ── BARRE AI ── #}
                <div class="mt-4" data-aos="fade-up" data-aos-delay="300">
                    <div style="background:rgba(255,255,255,0.12);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.25);border-radius:50px;padding:6px 6px 6px 20px;display:flex;align-items:center;gap:10px;max-width:480px">
                        <span style="font-size:1rem;opacity:0.8">🤖</span>
                        <input id="ai-bar-input" type="text"
                               placeholder="Que cherchez-vous ? activités, produits, offres..."
                               autocomplete="off"
                               style="flex:1;background:none;border:none;outline:none;color:#fff;font-size:0.88rem;min-width:0"
                               onkeydown="if(event.key==='Enter') askAIBar()"
                               onfocus="document.getElementById('ai-bar-result').style.display='block'">
                        {# Bouton microphone #}
                        <button id="ai-mic-btn" onclick="toggleMic()" title="Parler"
                                style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.15);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1rem;transition:all .2s;flex-shrink:0">
                            🎤
                        </button>
                        <button onclick="askAIBar()" id="ai-bar-btn"
                                style="background:#fff;color:var(--primary);border:none;border-radius:50px;padding:8px 20px;font-weight:700;font-size:0.82rem;cursor:pointer;white-space:nowrap;transition:opacity .2s">
                            Demander
                        </button>
                    </div>
                    <div id="ai-bar-result"
                         style="display:none;margin-top:10px;background:rgba(255,255,255,0.95);border-radius:16px;padding:14px 18px;max-width:480px;color:#333;font-size:0.88rem;line-height:1.6;box-shadow:0 8px 24px rgba(0,0,0,0.15)">
                    </div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-flex justify-content-end gap-3 mt-4 mt-lg-0">
                {% for item in [['🏕️','Camping'],['🏃','Sport'],['🎭','Culture'],['🍽️','Gastro']] %}
                <div class="text-center p-4 rounded-3 animate-fadeup"
                     style="background:rgba(255,255,255,0.12);backdrop-filter:blur(8px);animation-delay:{{ loop.index * 0.15 }}s">
                    <div style="font-size:2.4rem">{{ item[0] }}</div>
                    <div class="mt-2 fw-semibold small">{{ item[1] }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{# STATS #}
<section class="stats-bar py-4">
    <div class="container">
        <div class="row text-center g-3">
            {% for stat in [['500+','Produits','bi-bag'],['50+','Activités','bi-calendar-event'],['1000+','Clients','bi-people'],['20+','Partenaires','bi-handshake']] %}
            <div class="col-6 col-md-3 stat-item" data-aos="zoom-in" data-aos-delay="{{ loop.index * 80 }}">
                <i class="bi {{ stat[2] }} fs-4 mb-1" style="color:var(--primary-light)"></i>
                <div class="stat-num">{{ stat[0] }}</div>
                <div class="text-muted small">{{ stat[1] }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ══════════════════════════════════════════
   FORMULAIRE PUBLICATION RAPIDE
══════════════════════════════════════════ #}
<section class="py-4" style="background:#f9f7ff;border-top:1px solid var(--border)">
    <div class="container">
        <div class="rounded-4 p-4" style="background:#fff;box-shadow:var(--card-shadow);border:1px solid var(--border)" data-aos="fade-up">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.2rem;flex-shrink:0">
                    {{ app.user ? app.user.prenom|first|upper : '👤' }}
                </div>
                <div>
                    <div class="fw-bold" style="color:var(--primary-dark)">Partagez avec la communauté</div>
                    <div class="text-muted small">Racontez votre aventure, partagez une photo...</div>
                </div>
                <a href="{{ path('app_publications') }}" class="ms-auto btn btn-sm rounded-pill fw-semibold"
                   style="background:#f0ebff;color:var(--primary);border:none;font-size:0.8rem">
                    <i class="bi bi-grid me-1"></i>Voir tout
                </a>
            </div>
            <form action="{{ path('app_publication_new') }}" method="POST" enctype="multipart/form-data">
                <div class="row g-2">
                    {% if not app.user %}
                    <div class="col-12 text-center py-2">
                        <a href="{{ path('app_login') }}" class="btn rounded-pill fw-semibold px-4"
                           style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                            <i class="bi bi-person-circle me-2"></i>Connectez-vous pour publier
                        </a>
                    </div>
                    {% else %}
                    <div class="col">
                        <input type="text" name="contenu" class="form-control rounded-3"
                               placeholder="Quoi de neuf ? Partagez votre expérience..." required
                               style="border-color:var(--border);font-size:0.88rem">
                    </div>
                    <div class="col-auto">
                        <label class="btn rounded-3" style="background:#f0ebff;color:var(--primary);border:none;cursor:pointer;padding:9px 14px" title="Ajouter une photo">
                            <i class="bi bi-image fs-5"></i>
                            <input type="file" name="image" accept="image/*" style="display:none"
                                   onchange="document.getElementById('pub-filename').textContent = this.files[0]?.name ?? ''">
                        </label>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn rounded-3 fw-semibold"
                                style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;padding:9px 20px">
                            <i class="bi bi-send me-1"></i>Publier
                        </button>
                    </div>
                    <div class="col-12">
                        <span id="pub-filename" class="text-muted small"></span>
                    </div>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>
</section>

{# PRODUITS VEDETTES #}
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-right">
            <h2 class="section-title mb-0">Produits vedettes</h2>
            <a href="{{ path('app_produits') }}" class="text-decoration-none fw-semibold" style="color:var(--primary)">
                Voir tout <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-4">
            {% for produit in produits %}
            <div class="col-6 col-md-4 col-lg-2" data-aos="fade-up" data-aos-delay="{{ loop.index * 80 }}">
                <div class="product-card card h-100">
                    <div class="img-wrap img-zoom">
                        <span class="emoji-img" style="font-size:3.5rem">🛍️</span>
                    </div>
                    <div class="card-body p-3">
                        <span class="badge-cat mb-2 d-inline-block">Produit</span>
                        <h6 class="card-title mb-1" style="font-size:0.88rem">{{ produit.nom }}</h6>
                        <div class="price">Voir prix</div>
                    </div>
                    <div class="card-footer bg-transparent border-0 p-3 pt-0">
                        <a href="{{ path('app_produit_show', {id: produit.id}) }}" class="btn-add btn">
                            <i class="bi bi-eye me-1"></i>Voir
                        </a>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center text-muted py-4">Aucun produit disponible.</div>
            {% endfor %}
        </div>
    </div>
</section>

<hr class="divider">

{# ACTIVITES #}
<section class="py-5" style="background:var(--white)">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-right">
            <h2 class="section-title mb-0">Activités à venir</h2>
            <a href="{{ path('app_activites') }}" class="text-decoration-none fw-semibold" style="color:var(--primary)">
                Voir tout <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-4">
            {% for activite in activites %}
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
                <div class="activity-card card h-100">
                    <div class="img-wrap">
                        <span style="font-size:4rem">
                            {% if activite.type == 'Sport' %}🏃
                            {% elseif activite.type == 'Culture' %}🎭
                            {% elseif activite.type == 'Gastronomie' %}🍽️
                            {% else %}🌟{% endif %}
                        </span>
                        <span class="position-absolute top-0 start-0 m-2 badge bg-white"
                              style="color:var(--primary);font-size:0.72rem">{{ activite.type }}</span>
                    </div>
                    <div class="card-body p-3">
                        <h6 class="card-title">{{ activite.nom }}</h6>
                        <div class="text-muted small mb-1"><i class="bi bi-geo-alt me-1"></i>{{ activite.lieu }}</div>
                        <div class="text-muted small mb-2"><i class="bi bi-calendar me-1"></i>{{ activite.dateActivite|date('d/m/Y') }}</div>
                        <div class="price">{{ activite.prix }} TND</div>
                    </div>
                    <div class="card-footer bg-transparent border-0 p-3 pt-0">
                        <a href="{{ path('app_activite_show', {id: activite.id}) }}" class="btn-activity btn">
                            <i class="bi bi-arrow-right me-1"></i>Détails
                        </a>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center text-muted py-4">Aucune activité disponible.</div>
            {% endfor %}
        </div>
    </div>
</section>

{# EXCURSIONS #}
{% if destinations is not empty %}
<hr class="divider">
<section class="py-5" style="background:linear-gradient(135deg,#f0f9ff 0%,#f5f0ff 100%)">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-right">
            <div>
                <h2 class="section-title mb-1">🌍 Nos Excursions</h2>
                <p class="text-muted small mb-0">Rejoignez une aventure et explorez le monde</p>
            </div>
            <a href="{{ path('client_destination_index') }}" class="text-decoration-none fw-semibold" style="color:var(--primary)">
                Voir toutes <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-4">
            {% for dest in destinations %}
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="{{ loop.index * 80 }}">
                <a href="{{ path('client_destination_show', {id: dest.id}) }}" class="text-decoration-none">
                    <div class="activity-card card h-100" style="border:none;box-shadow:0 4px 20px rgba(37,99,235,0.10);overflow:hidden">
                        <div class="img-wrap" style="height:180px;padding:0;overflow:hidden;position:relative">
                            {% if dest.firstImage %}
                                <img src="{{ dest.firstImage }}" alt="{{ dest.nom }}"
                                     style="width:100%;height:100%;object-fit:cover">
                            {% else %}
                                <div style="width:100%;height:100%;background:linear-gradient(135deg,#DBEAFE,#EDE9FE);display:flex;align-items:center;justify-content:center;font-size:4rem">🏔️</div>
                            {% endif %}
                            {% if dest.statut %}
                            <span class="position-absolute top-0 start-0 m-2 badge"
                                  style="font-size:0.7rem;{% if dest.statut == 'Disponible' %}background:rgba(22,163,74,.85);color:#fff{% else %}background:rgba(220,38,38,.85);color:#fff{% endif %}">
                                {{ dest.statut == 'Disponible' ? '✅ Disponible' : '🔴 Complet' }}
                            </span>
                            {% endif %}
                            {% if dest.imagesCount > 1 %}
                            <span class="position-absolute bottom-0 end-0 m-2 badge"
                                  style="background:rgba(0,0,0,.5);color:#fff;font-size:0.68rem">
                                🖼️ {{ dest.imagesCount }}
                            </span>
                            {% endif %}
                        </div>
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold mb-1" style="color:#1F2937">{{ dest.nom }}</h6>
                            {% if dest.localisation %}
                            <div class="text-muted small mb-2">
                                <i class="bi bi-geo-alt me-1" style="color:#2563EB"></i>{{ dest.localisation }}
                            </div>
                            {% endif %}
                            <div class="d-flex align-items-center justify-content-between mt-2">
                                <span class="small text-muted">
                                    <i class="bi bi-people me-1"></i>{{ dest.nbParticipants }}/{{ dest.capaciteMax }}
                                </span>
                                {% if dest.dateLancement %}
                                <span class="small text-muted">
                                    <i class="bi bi-calendar me-1"></i>{{ dest.dateLancement|date('d/m/Y') }}
                                </span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-3 pt-0">
                            <span class="btn-activity btn w-100" style="background:linear-gradient(135deg,#2563EB,#7C3AED);color:#fff;border:none">
                                <i class="bi bi-arrow-right me-1"></i>Voir l'excursion
                            </span>
                        </div>
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# OFFRES DESTINATIONS #}
<hr class="divider">
<section class="py-5" style="background:var(--white)">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-right">
            <div>
                <h2 class="section-title mb-1">🌍 Offres de destinations</h2>
                <p class="text-muted small mb-0">{{ offresTotal }} offres disponibles</p>
            </div>
            <a href="{{ path('app_offres') }}" class="text-decoration-none fw-semibold" style="color:var(--primary)">
                Voir toutes les offres <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-4">
            {% for offre in offres %}
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="{{ loop.index * 80 }}">
                <div class="activity-card card h-100" style="cursor:pointer"
                     onclick="window.open('{{ offre.lien }}', '_blank')">
                    <div class="img-wrap" style="height:160px;{% if offre.imageUrl %}padding:0;overflow:hidden{% else %}background:linear-gradient(135deg,var(--primary-dark),var(--accent)){% endif %}">
                        {% if offre.imageUrl %}
                            <img src="{{ offre.imageUrl }}" alt="{{ offre.titre }}"
                                 style="width:100%;height:100%;object-fit:cover"
                                 onerror="this.style.display='none';this.closest('.img-wrap').style.background='linear-gradient(135deg,var(--primary-dark),var(--accent))'">
                        {% else %}
                            <span style="font-size:3rem">
                                {% if 'Istanbul' in offre.titre or 'Turquie' in offre.pays %}🕌
                                {% elseif 'Egypte' in offre.titre or 'Égypte' in offre.pays %}🏛️
                                {% elseif 'Bali' in offre.titre or 'Malaisie' in offre.pays %}🌴
                                {% elseif 'Thaïlande' in offre.titre %}🐘
                                {% elseif 'Bresil' in offre.titre or 'Brésil' in offre.pays %}🌎
                                {% elseif 'croisière' in offre.description|lower or 'MSC' in offre.titre %}🚢
                                {% elseif 'Algerie' in offre.titre or 'Algérie' in offre.pays %}🇩🇿
                                {% elseif 'Antalya' in offre.titre %}🏖️
                                {% else %}✈️{% endif %}
                            </span>
                        {% endif %}
                        {% if offre.pays %}
                        <span class="position-absolute top-0 start-0 m-2 badge bg-white"
                              style="color:var(--primary);font-size:0.72rem">{{ offre.pays }}</span>
                        {% endif %}
                    </div>
                    <div class="card-body p-3">
                        <h6 class="card-title fw-bold mb-2">{{ offre.titre }}</h6>
                        {% if offre.duree %}
                        <div class="text-muted small mb-1">
                            <i class="bi bi-clock me-1"></i>{{ offre.duree }}
                        </div>
                        {% endif %}
                        {% if offre.date %}
                        <div class="text-muted small mb-1">
                            <i class="bi bi-calendar me-1"></i>{{ offre.date }}
                        </div>
                        {% endif %}
                        {% if offre.description %}
                        <div class="small mt-2 px-2 py-1 rounded-2" style="background:#f0ebff;color:var(--primary)">
                            <i class="bi bi-check-circle me-1"></i>{{ offre.description }}
                        </div>
                        {% endif %}
                    </div>
                    <div class="card-footer bg-transparent border-0 p-3 pt-0">
                        <a href="{{ offre.lien }}" target="_blank" class="btn-activity btn w-100"
                           onclick="event.stopPropagation()">
                            <i class="bi bi-globe me-1"></i>Voir l'offre
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# MES ACTIVITÉS (si connecté) #}
{% if app.user and mesActivites is not empty %}
<hr class="divider">
<section class="py-5" style="background:var(--bg)">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-right">
            <h2 class="section-title mb-0">
                <i class="bi bi-person-check-fill me-2" style="color:var(--primary)"></i>Mes activités
            </h2>
            <a href="{{ path('app_mes_activites') }}" class="text-decoration-none fw-semibold" style="color:var(--primary)">
                Voir tout <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-4">
            {% for item in mesActivites %}
            {% set a = item.activite %}
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="{{ loop.index * 80 }}">
                <div class="activity-card card h-100 position-relative">
                    {# Badge statut #}
                    <span class="position-absolute top-0 end-0 m-2 badge rounded-pill"
                          style="z-index:2;font-size:0.72rem;
                          {% if item.statut == 'ACCEPTEE' %}background:#d1f2eb;color:#1a7a4a
                          {% elseif item.statut == 'REFUSEE' %}background:#fde8e8;color:#c0392b
                          {% else %}background:#fff3cd;color:#856404{% endif %}">
                        {% if item.statut == 'ACCEPTEE' %}✅ Acceptée
                        {% elseif item.statut == 'REFUSEE' %}❌ Refusée
                        {% else %}⏳ En attente{% endif %}
                    </span>
                    <div class="img-wrap">
                        {% if a.images %}
                            <img src="{{ a.getImageUrl() }}" alt="{{ a.nom }}"
                                 style="width:100%;height:100%;object-fit:cover">
                        {% else %}
                            <span style="font-size:4rem">
                                {% if a.type == 'Sport' %}🏃
                                {% elseif a.type == 'Culture' %}🎭
                                {% elseif a.type == 'Gastronomie' %}🍽️
                                {% else %}🌟{% endif %}
                            </span>
                        {% endif %}
                        <span class="position-absolute top-0 start-0 m-2 badge bg-white"
                              style="color:var(--primary);font-size:0.72rem">{{ a.type }}</span>
                    </div>
                    <div class="card-body p-3">
                        <h6 class="card-title">{{ a.nom }}</h6>
                        <div class="text-muted small mb-1">
                            <i class="bi bi-geo-alt me-1"></i>{{ a.lieu }}
                        </div>
                        <div class="text-muted small mb-1">
                            <i class="bi bi-calendar me-1"></i>
                            {% if a.avecDate %}
                                {{ a.dateActivite|date('d/m/Y') }}
                            {% else %}
                                Date flexible
                            {% endif %}
                        </div>
                        <div class="price mt-1">{{ a.prix }} TND</div>
                    </div>
                    <div class="card-footer bg-transparent border-0 p-3 pt-0">
