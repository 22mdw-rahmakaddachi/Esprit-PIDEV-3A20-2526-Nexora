{% block javascripts %}
{{ parent() }}
<style>
    @keyframes cloudDrift {
        from { transform: translateX(0); }
        to   { transform: translateX(120vw); }
    }
    @keyframes mic-pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(231,76,60,0.5); }
        50%       { box-shadow: 0 0 0 8px rgba(231,76,60,0); }
    }
    @keyframes qrPop {
        from { transform: scale(0.85); opacity: 0; }
        to   { transform: scale(1);    opacity: 1; }
    }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
function setQrUrl(url) {
    var container = document.getElementById('qrcode');
    container.innerHTML = '';
    new QRCode(container, {
        text: url,
        width: 180,
        height: 180,
        colorDark: '#3d1a8e',
        colorLight: '#f8f5ff',
        correctLevel: QRCode.CorrectLevel.H
    });
    var isLocal = url.indexOf('localhost') !== -1;
    var btnLocal  = document.getElementById('btn-local');
    var btnMobile = document.getElementById('btn-mobile');
    if (btnLocal && btnMobile) {
        btnLocal.style.background  = isLocal ? '#6c3fc5' : '#fff';
        btnLocal.style.color       = isLocal ? '#fff'    : '#6c3fc5';
        btnMobile.style.background = isLocal ? '#fff'    : '#6c3fc5';
        btnMobile.style.color      = isLocal ? '#6c3fc5' : '#fff';
    }
}
// Par défaut : mobile
setQrUrl('http://192.168.137.231:9000');
</script>
<script>
// -- Reconnaissance vocale --
let recognition = null;
let isListening  = false;

function toggleMic() {
    const SpeechAPI = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechAPI) {
        alert('Reconnaissance vocale non support�e. Utilisez Chrome ou Edge.');
        return;
    }
    if (isListening) { recognition.stop(); return; }

    recognition = new SpeechAPI();
    recognition.lang           = 'fr-FR';
    recognition.continuous     = false;
    recognition.interimResults = true;

    const micBtn = document.getElementById('ai-mic-btn');
    const input  = document.getElementById('ai-bar-input');

    recognition.onstart = () => {
        isListening = true;
        micBtn.textContent       = '??';
        micBtn.style.background  = 'rgba(231,76,60,0.5)';
        micBtn.style.animation   = 'mic-pulse 1s infinite';
        input.placeholder        = '?? Parlez maintenant...';
        input.value              = '';
    };

    recognition.onresult = (e) => {
        let t = '';
        for (let i = e.resultIndex; i < e.results.length; i++) t += e.results[i][0].transcript;
        input.value = t;
    };

    recognition.onend = () => {
        isListening              = false;
        micBtn.textContent       = '??';
        micBtn.style.background  = 'rgba(255,255,255,0.15)';
        micBtn.style.animation   = '';
        input.placeholder        = 'Que cherchez-vous ? activit�s, produits, offres...';
        if (input.value.trim()) askAIBar();
    };

    recognition.onerror = (e) => {
        isListening              = false;
        micBtn.textContent       = '??';
        micBtn.style.background  = 'rgba(255,255,255,0.15)';
        micBtn.style.animation   = '';
        if (e.error !== 'no-speech') {
            input.placeholder = '? ' + e.error;
            setTimeout(() => { input.placeholder = 'Que cherchez-vous ?'; }, 3000);
        }
    };

    recognition.start();
}

// -- Barre AI --
function askAIBar() {
    const input  = document.getElementById('ai-bar-input');
    const result = document.getElementById('ai-bar-result');
    const btn    = document.getElementById('ai-bar-btn');
    const q      = input.value.trim();
    if (!q) return;

    result.style.display = 'block';
    result.innerHTML     = '<span style="color:#888;font-style:italic">? Recherche en cours...</span>';
    btn.textContent      = '...';
    btn.disabled         = true;

    fetch('/ai/search', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ question: q })
    })
    .then(r => r.json())
    .then(data => {
        if (data.redirect) {
            result.innerHTML = '<span style="color:#6c3fc5;font-weight:600">Redirection...</span>';
            const loader = document.getElementById('loading-screen');
            if (loader) { loader.classList.remove('hide'); document.body.classList.remove('loaded'); }
            window.location.href = data.redirect;
        } else if (data.type === 'hors_sujet') {
            result.innerHTML = '<div style="padding:4px 0"><div style="font-weight:700;color:#c0392b;margin-bottom:6px;font-size:0.92rem">🚫 Besoin non disponible</div><div style="color:#555;font-size:0.84rem;margin-bottom:10px">Nexora propose des activites, produits outdoor et offres de voyages.</div><div style="display:flex;gap:8px;flex-wrap:wrap"><a href="/activites" style="padding:5px 14px;background:#f0ebff;color:#6c3fc5;border-radius:50px;font-size:0.78rem;font-weight:600;text-decoration:none">Activites</a><a href="/boutique" style="padding:5px 14px;background:#f0ebff;color:#6c3fc5;border-radius:50px;font-size:0.78rem;font-weight:600;text-decoration:none">Boutique</a><a href="/offres" style="padding:5px 14px;background:#f0ebff;color:#6c3fc5;border-radius:50px;font-size:0.78rem;font-weight:600;text-decoration:none">Offres</a></div></div>';
            btn.textContent = 'Demander';
            btn.disabled    = false;
        } else {
            result.innerHTML = 'Nexora AI : ' + data.message;
            btn.textContent  = 'Demander';
            btn.disabled     = false;
        }
    })
    .catch(() => {
        result.innerHTML = 'Erreur de connexion.';
        btn.textContent  = 'Demander';
        btn.disabled     = false;
    });
}

// Fermer r�sultat en cliquant ailleurs
document.addEventListener('click', function(e) {
    const bar    = document.getElementById('ai-bar-input');
    const result = document.getElementById('ai-bar-result');
    const mic    = document.getElementById('ai-mic-btn');
    const btn    = document.getElementById('ai-bar-btn');
    if (bar && result && !bar.contains(e.target) && !result.contains(e.target)
        && e.target !== mic && e.target !== btn) {
        result.style.display = 'none';
    }
});
</script>
<script>
(function () {
    const plane  = document.getElementById('plane');
    const canvas = document.getElementById('trail-canvas');
    const scene  = document.getElementById('plane-scene');
    if (!plane || !canvas || !scene) return;

    const ctx = canvas.getContext('2d');
    let W, H, x, y, trail = [], tick = 0;

    const SPEED     = 1.8;
    const TRAIL_LEN = 130;
    const AMPLITUDE = 30;
    const FREQUENCY = 0.011;

    function resize() {
        W = canvas.width  = scene.offsetWidth;
        H = canvas.height = scene.offsetHeight;
        reset();
    }

    function reset() {
        x = -130; y = H * 0.35; trail = []; tick = 0;
    }

    function drawTrail() {
        ctx.clearRect(0, 0, W, H);
        if (trail.length < 2) return;

        [-7, 7].forEach(offset => {
            ctx.beginPath();
            ctx.moveTo(trail[0].x, trail[0].y + offset);
            for (let i = 1; i < trail.length; i++) {
                ctx.lineTo(trail[i].x, trail[i].y + offset);
            }
            const g = ctx.createLinearGradient(trail[0].x, 0, trail[trail.length - 1].x, 0);
            g.addColorStop(0,   'rgba(255,255,255,0)');
            g.addColorStop(0.3, 'rgba(195,155,211,0.2)');
            g.addColorStop(1,   'rgba(255,255,255,0.6)');
            ctx.strokeStyle = g;
            ctx.lineWidth   = 3.5;
            ctx.lineCap     = 'round';
            ctx.lineJoin    = 'round';
            ctx.stroke();
        });
    }

    function animate() {
        tick++;
        x += SPEED;

        const targetY = H * 0.35 + Math.sin(tick * FREQUENCY) * AMPLITUDE;
        y += (targetY - y) * 0.05;

        const dy    = trail.length > 1 ? y - trail[trail.length - 1].y : 0;
        const angle = Math.atan2(dy, SPEED) * (180 / Math.PI);

        plane.style.left      = x + 'px';
        plane.style.top       = y + 'px';
        plane.style.transform = `translateY(-50%) rotate(${angle * 0.55}deg)`;

        trail.push({ x: x + 8, y });
        if (trail.length > TRAIL_LEN) trail.shift();

        drawTrail();

        if (x > W + 160) reset();
        requestAnimationFrame(animate);
    }

    window.addEventListener('resize', resize);
    resize();
    animate();
})();
</script>
{% endblock %}
