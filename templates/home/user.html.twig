{% extends 'base.html.twig' %}

{% block title %}Liste des Utilisateurs{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2 class="text-center text-primary mb-4">Liste des Utilisateurs</h2>

    <div class="d-flex justify-content-end mb-3">
        <a href="{{ path('add') }}" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Ajouter un utilisateur
        </a>
    </div>

    <table border="1" class="table table-bordered table-striped align-middle text-center shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Âge</th>
                <th>Moyenne</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in userBD %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.name }}</td>
                <td>{{ user.age }}</td>
                <td>{{ user.moyenne ?? '-' }}</td>
                <td>
                    <a href="{{ path('update_User', {'id': user.id}) }}" class="btn btn-warning btn-sm me-2">
                        <i class="bi bi-pencil"></i> Modifier
                    </a>
                    <a href="{{ path('remove_User', {'id': user.id}) }}" class="btn btn-danger btn-sm"
                       onclick="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?');">
                        <i class="bi bi-trash"></i> Supprimer
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-muted">Aucun utilisateur trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
