{% extends 'base.html.twig' %}
{% block title %}Finaliser la commande — NEXORA{% endblock %}

{% block body %}
<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_panier') }}">Panier</a></li>
                <li class="breadcrumb-item active">Commande</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 justify-content-center">

        <div class="col-lg-7" data-aos="fade-right">
            <h2 class="section-title mb-4">Vos informations</h2>
            <div class="bg-white rounded-4 p-4 shadow-sm" style="border:1px solid #ede5ff">
                <form method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nom complet *</label>
                            <input type="text" name="nom" class="form-control rounded-3" required placeholder="Votre nom">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email *</label>
                            <input type="email" name="email" class="form-control rounded-3" required placeholder="votre@email.com">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Adresse de livraison</label>
                            <textarea name="adresse" class="form-control rounded-3" rows="2" placeholder="Rue, ville, code postal"></textarea>
                        </div>
                    </div>

                    <hr style="border-color:#ede5ff;margin:24px 0">

                    <h6 class="fw-bold mb-3" style="color:var(--primary-dark)">Récapitulatif de la commande</h6>
                    {% for item in panier %}
                    <div class="d-flex justify-content-between mb-2 small">
                        <span>{{ item.nom }} <span class="text-muted">({{ item.variantLabel is defined ? item.variantLabel : (item.sku is defined ? item.sku : '') }}) × {{ item.quantite }}</span></span>
                        <span class="fw-semibold">{{ (item.prix * item.quantite)|number_format(2) }} TND</span>
                    </div>
                    {% endfor %}

                    <hr style="border-color:#ede5ff">

                    {% if codePromo %}
                    <div class="d-flex justify-content-between mb-2 text-success small">
                        <span><i class="bi bi-tag-fill me-1"></i>Code {{ codePromo.code }}</span>
                        <span>−{{ reduction|number_format(2) }} TND</span>
                    </div>
                    {% endif %}

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold">Total à payer</span>
                        <span class="fw-bold fs-5" style="color:var(--primary)">{{ totalFinal|number_format(2) }} TND</span>
                    </div>

                    <button type="submit" class="btn w-100 rounded-pill btn-pulse"
                            style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;padding:13px;font-weight:600;font-size:1rem">
                        <i class="bi bi-check-circle me-2"></i>Confirmer la commande
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>
{% endblock %}
