{% extends 'base.html.twig' %}
{% block title %}Commande confirmée — TripShop{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="text-center py-5" data-aos="fade-up">
        <div style="font-size:5rem">✅</div>
        <h2 class="mt-3" style="color:var(--primary)">Commande confirmée !</h2>
        {% if commande %}
        <p class="text-muted">Numéro de commande : <strong>#{{ commande.id }}</strong></p>
        <p class="text-muted">Total : <strong style="color:var(--primary)">{{ commande.total|number_format(2) }} TND</strong></p>
        {% endif %}
        <p class="text-muted mt-2">Vous recevrez une confirmation par email.</p>
        <div class="d-flex gap-3 justify-content-center mt-4">
            <a href="{{ path('app_produits') }}" class="btn rounded-pill px-4"
               style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                <i class="bi bi-bag me-2"></i>Continuer les achats
            </a>
            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-house me-2"></i>Accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}
