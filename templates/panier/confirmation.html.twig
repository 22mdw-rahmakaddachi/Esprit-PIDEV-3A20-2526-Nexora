{% extends 'base.html.twig' %}
{% block title %}Commande confirmée — NEXORA{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
    <div class="col-lg-6" data-aos="fade-up">

        <div class="bg-white rounded-4 p-5 shadow-sm text-center" style="border:1px solid #ede5ff">
            <div style="font-size:4rem">🎉</div>
            <h2 class="mt-3" style="color:var(--primary)">Commande confirmée !</h2>

            {% if commande %}
            <p class="text-muted">Numéro de commande : <strong>#{{ commande.id }}</strong></p>
            <div class="my-4 p-3 rounded-3" style="background:#f9f7ff;border:1px solid #ede5ff">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Montant total</span>
                    <span class="fw-bold fs-5" style="color:var(--primary)">{{ commande.total|number_format(2) }} TND</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Statut</span>
                    <span class="badge rounded-pill px-3" style="background:#fff3cd;color:#856404">En attente de paiement</span>
                </div>
            </div>

            {# Bouton paiement Flouci #}
            <div class="mb-3">
                <a href="{{ path('app_paiement_initier', {commandeId: commande.id}) }}"
                   class="btn w-100 rounded-pill btn-pulse py-3"
                   style="background:linear-gradient(135deg,#0066cc,#0099ff);color:#fff;font-weight:700;font-size:1rem">
                    <img src="https://flouci.com/favicon.ico" alt="Flouci" style="width:20px;height:20px;margin-right:8px;border-radius:4px">
                    Payer avec Flouci / Konnect
                    <span class="ms-2 badge rounded-pill" style="background:rgba(255,255,255,0.2);font-size:0.75rem">{{ commande.total|number_format(2) }} TND</span>
                </a>
                <div class="text-muted small mt-2">
                    <i class="bi bi-shield-lock me-1"></i>Paiement sécurisé via Konnect (Flouci)
                </div>
            </div>

            <div class="divider my-3" style="height:1px;background:#ede5ff"></div>

            <div class="text-muted small mb-3">ou</div>

            <a href="{{ path('app_produits') }}" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-bag me-2"></i>Continuer les achats
            </a>
            {% else %}
            <p class="text-muted">Votre commande a été enregistrée.</p>
            <a href="{{ path('app_produits') }}" class="btn rounded-pill px-4 mt-3"
               style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                Retour à la boutique
            </a>
            {% endif %}
        </div>

    </div>
    </div>
</div>
{% endblock %}
