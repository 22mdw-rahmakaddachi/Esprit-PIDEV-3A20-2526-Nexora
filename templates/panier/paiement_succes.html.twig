{% extends 'base.html.twig' %}
{% block title %}Paiement réussi — NEXORA{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
    <div class="col-lg-6" data-aos="fade-up">
        <div class="bg-white rounded-4 p-5 shadow-sm text-center" style="border:2px solid #27ae60">
            <div style="font-size:4rem">✅</div>
            <h2 class="mt-3" style="color:#27ae60">Paiement réussi !</h2>

            {% if commande %}
            <p class="text-muted">Commande <strong>#{{ commande.id }}</strong> payée avec succès.</p>
            <div class="my-4 p-3 rounded-3" style="background:#d1f2eb;border:1px solid #a9dfbf">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Montant payé</span>
                    <span class="fw-bold fs-5" style="color:#1a7a4a">{{ commande.total|number_format(2) }} TND</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Référence Flouci</span>
                    <span class="fw-semibold small">{{ paymentId }}</span>
                </div>
            </div>
            {% endif %}

            <p class="text-muted small">Vous recevrez une confirmation par email. Merci pour votre achat !</p>

            <a href="{{ path('app_produits') }}" class="btn rounded-pill px-4 mt-3"
               style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                <i class="bi bi-bag me-2"></i>Continuer les achats
            </a>
        </div>
    </div>
    </div>
</div>
{% endblock %}
