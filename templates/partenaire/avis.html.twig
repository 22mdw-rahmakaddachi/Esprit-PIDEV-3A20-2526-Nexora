{% extends 'partenaire/base_partenaire.html.twig' %}
{% block title %}Avis Clients{% endblock %}

{% block stylesheets %}
<style>
@keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
.avis-row { background:#fff; border-radius:14px; border:1px solid #ede5ff; padding:20px; transition:box-shadow .2s; }
.avis-row:hover { box-shadow:0 4px 18px rgba(108,63,197,0.1); }
.star-filled { color:#f39c12; }
.star-empty  { color:#ddd; }
.reponse-box { background:linear-gradient(135deg,#f3eeff,#faf8ff); border-left:3px solid var(--primary); border-radius:10px; padding:12px 16px; margin-top:12px; }
.ia-suggestion { background:#f9f7ff; border:1.5px solid #ede5ff; border-radius:12px; padding:14px 16px; margin-top:10px; }
</style>
{% endblock %}

{% block body %}
<div class="main-content">

    {# ── HEADER ── #}
    <div class="page-header mb-4">
        <h1><i class="bi bi-chat-square-quote-fill me-2"></i>Avis Clients</h1>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <span class="badge rounded-pill px-3 py-2" style="background:#f0ebff;color:var(--primary);font-size:0.85rem">
                <i class="bi bi-chat-dots me-1"></i>{{ total }} avis
            </span>
            {% if moyenne > 0 %}
            <span class="badge rounded-pill px-3 py-2" style="background:#fff3cd;color:#856404;font-size:0.85rem">
                ⭐ Moyenne : {{ moyenne }}/5
            </span>
            {% endif %}
            <span class="badge rounded-pill px-3 py-2" style="background:#e8f8e8;color:#28a745;font-size:0.85rem">
                🤖 Suggestions IA disponibles
            </span>
        </div>
    </div>

    {# ── LISTE DES AVIS ── #}
    {% if avisList is empty %}
    <div class="text-center py-5 text-muted">
        <div style="font-size:3rem">💬</div>
        <p class="mt-3">Aucun avis pour le moment.</p>
    </div>
    {% else %}
    <div class="d-flex flex-column gap-4">
        {% for avis in avisList %}
        <div class="avis-row" id="avis-row-{{ avis.id }}">

            {# ── En-tête avis ── #}
            <div class="d-flex align-items-start gap-3 flex-wrap">
                <div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;font-weight:700;font-size:1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    {{ avis.userId }}
                </div>
                <div style="flex:1;min-width:0;">
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <strong style="font-size:0.95rem;color:var(--primary-dark);">{{ avis.titre }}</strong>
                        <span>
                            {% for i in 1..5 %}
                                <i class="bi bi-star{{ i <= avis.rating ? '-fill star-filled' : ' star-empty' }}" style="font-size:0.85rem;"></i>
                            {% endfor %}
                            <span style="font-size:0.75rem;color:#888;">({{ avis.rating }}/5)</span>
                        </span>
                        <span style="font-size:0.75rem;color:#aaa;">
                            <i class="bi bi-clock me-1"></i>{{ avis.createdAt ? avis.createdAt|date('d/m/Y') : '' }}
                        </span>
                    </div>
                    <p style="font-size:0.88rem;color:#555;margin-bottom:0;line-height:1.6;font-style:italic;">
                        "{{ avis.contenu }}"
                    </p>
                </div>
            </div>

            {# ── Réponse existante ── #}
            {% if reponses[avis.id] is defined %}
            {% set rep = reponses[avis.id] %}
            <div class="reponse-box" id="reponse-affichee-{{ avis.id }}">
                <div style="font-size:0.75rem;font-weight:700;color:var(--primary);margin-bottom:6px;">
                    🏢 Votre réponse
                    <span style="font-weight:400;color:#aaa;margin-left:6px;">{{ rep.created_at|date('d/m/Y H:i') }}</span>
                </div>
                <p style="font-size:0.85rem;color:#444;margin:0;line-height:1.5;" id="reponse-texte-{{ avis.id }}">{{ rep.contenu }}</p>
                <div class="d-flex gap-2 mt-2">
                    <button onclick="modifierReponse({{ avis.id }})"
                            class="btn btn-sm rounded-pill"
                            style="background:#f0ebff;color:var(--primary);border:1px solid #d4c5f9;font-size:0.75rem;">
                        <i class="bi bi-pencil me-1"></i>Modifier
                    </button>
                    <button onclick="supprimerReponse({{ avis.id }})"
                            class="btn btn-sm rounded-pill"
                            style="background:#fde8e8;color:#c0392b;border:none;font-size:0.75rem;">
                        <i class="bi bi-trash me-1"></i>Supprimer
                    </button>
                </div>
            </div>
            {% else %}
            <div id="reponse-affichee-{{ avis.id }}" style="display:none;"></div>
            {% endif %}

            {# ── Boutons action ── #}
            <div class="d-flex gap-2 flex-wrap mt-3" id="actions-{{ avis.id }}">
                {% if reponses[avis.id] is not defined %}
                <button onclick="ouvrirFormulaire({{ avis.id }})"
                        id="btn-repondre-{{ avis.id }}"
                        class="btn btn-sm rounded-pill"
                        style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;font-size:0.8rem;font-weight:600;">
                    <i class="bi bi-reply me-1"></i>Répondre à cet avis
                </button>
                {% endif %}
                <button onclick="suggererReponseIA({{ avis.id }}, this)"
                        id="btn-ia-{{ avis.id }}"
                        class="btn btn-sm rounded-pill"
                        style="background:linear-gradient(135deg,#f3eeff,#ede5ff);color:var(--primary);border:1px solid #d4c5f9;font-size:0.8rem;font-weight:600;">
                    <i class="bi bi-magic me-1"></i>💡 Suggestion IA
                </button>
            </div>

            {# ── Suggestion IA ── #}
            <div id="ia-box-{{ avis.id }}" style="display:none;">
                <div id="ia-loading-{{ avis.id }}" style="padding:10px;color:#aaa;font-size:0.82rem;display:none;">
                    <i class="bi bi-arrow-repeat" style="animation:spin 1s linear infinite;margin-right:6px;"></i>
                    L'IA rédige une réponse adaptée…
                </div>
                <div id="ia-result-{{ avis.id }}" style="display:none;" class="ia-suggestion">
                    <div style="font-size:0.75rem;font-weight:700;color:var(--primary);margin-bottom:8px;">
                        💡 Réponse suggérée par l'IA :
                    </div>
                    <p id="ia-text-{{ avis.id }}" style="font-size:0.88rem;color:#444;line-height:1.6;margin:0;font-style:italic;"></p>
                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button onclick="utiliserSuggestion({{ avis.id }})"
                                class="btn btn-sm rounded-pill"
                                style="background:linear-gradient(135deg,#28a745,#2ecc71);color:#fff;border:none;font-size:0.8rem;font-weight:600;">
                            <i class="bi bi-check-circle me-1"></i>Utiliser cette réponse
                        </button>
                        <button onclick="ignorerSuggestion({{ avis.id }})"
                                class="btn btn-sm rounded-pill"
                                style="background:#f8f9fa;color:#888;border:1px solid #ddd;font-size:0.8rem;">
                            <i class="bi bi-x me-1"></i>Ignorer
                        </button>
                    </div>
                </div>
            </div>

            {# ── Formulaire de réponse ── #}
            <div id="form-{{ avis.id }}" style="display:none;margin-top:14px;">
                <div style="font-size:0.8rem;font-weight:600;color:var(--primary-dark);margin-bottom:8px;">
                    <i class="bi bi-reply me-1"></i>Votre réponse :
                </div>
                <textarea id="textarea-{{ avis.id }}"
                          class="form-control"
                          rows="3"
                          maxlength="1000"
                          placeholder="Rédigez votre réponse professionnelle…"
                          style="font-size:0.88rem;border-color:#ede5ff;border-radius:10px;resize:vertical;"
                          oninput="updateCount({{ avis.id }}, this.value.length)"></textarea>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <span id="count-{{ avis.id }}" style="font-size:0.72rem;color:#aaa;">0 / 1000</span>
                    <span id="err-{{ avis.id }}" style="font-size:0.75rem;color:#dc3545;display:none;"></span>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button onclick="envoyerReponse({{ avis.id }})"
                            class="btn btn-sm rounded-pill"
                            style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;font-size:0.8rem;font-weight:600;">
                        <i class="bi bi-send me-1"></i>Publier la réponse
                    </button>
                    <button onclick="annulerFormulaire({{ avis.id }})"
                            class="btn btn-sm rounded-pill"
                            style="background:#f8f9fa;color:#888;border:1px solid #ddd;font-size:0.8rem;">
                        Annuler
                    </button>
                </div>
            </div>

        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// ── Formulaire de réponse ────────────────────────────────────────────────────

function ouvrirFormulaire(id) {
    document.getElementById('form-' + id).style.display = 'block';
    document.getElementById('btn-repondre-' + id).style.display = 'none';
    document.getElementById('textarea-' + id).focus();
}

function annulerFormulaire(id) {
    document.getElementById('form-' + id).style.display = 'none';
    const btn = document.getElementById('btn-repondre-' + id);
    if (btn) btn.style.display = 'inline-flex';
}

function updateCount(id, len) {
    document.getElementById('count-' + id).textContent = len + ' / 1000';
}

function modifierReponse(id) {
    const texteEl = document.getElementById('reponse-texte-' + id);
    const texte   = texteEl ? texteEl.textContent.trim() : '';
    document.getElementById('textarea-' + id).value = texte;
    updateCount(id, texte.length);
    document.getElementById('reponse-affichee-' + id).style.display = 'none';
    document.getElementById('form-' + id).style.display = 'block';
}

function envoyerReponse(id) {
    const contenu = document.getElementById('textarea-' + id).value.trim();
    const errEl   = document.getElementById('err-' + id);

    if (contenu.length < 5) {
        errEl.textContent = 'Minimum 5 caractères.';
        errEl.style.display = 'inline';
        return;
    }
    errEl.style.display = 'none';

    const fd = new FormData();
    fd.append('contenu', contenu);

    fetch('/avis/' + id + '/repondre', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            if (data.error) {
                errEl.textContent   = data.error;
                errEl.style.display = 'inline';
                return;
            }

            // Afficher la réponse publiée
            const repBox = document.getElementById('reponse-affichee-' + id);
            repBox.innerHTML = `
                <div class="reponse-box">
                    <div style="font-size:0.75rem;font-weight:700;color:var(--primary);margin-bottom:6px;">
                        🏢 Votre réponse
                        <span style="font-weight:400;color:#aaa;margin-left:6px;">${data.created_at}</span>
                    </div>
                    <p style="font-size:0.85rem;color:#444;margin:0;line-height:1.5;" id="reponse-texte-${id}">${data.contenu}</p>
                    <div class="d-flex gap-2 mt-2">
                        <button onclick="modifierReponse(${id})" class="btn btn-sm rounded-pill" style="background:#f0ebff;color:var(--primary);border:1px solid #d4c5f9;font-size:0.75rem;">
                            <i class="bi bi-pencil me-1"></i>Modifier
                        </button>
                        <button onclick="supprimerReponse(${id})" class="btn btn-sm rounded-pill" style="background:#fde8e8;color:#c0392b;border:none;font-size:0.75rem;">
                            <i class="bi bi-trash me-1"></i>Supprimer
                        </button>
                    </div>
                </div>`;
            repBox.style.display = 'block';

            // Masquer le formulaire et le bouton "Répondre"
            document.getElementById('form-' + id).style.display = 'none';
            const btn = document.getElementById('btn-repondre-' + id);
            if (btn) btn.style.display = 'none';
        })
        .catch(() => {
            errEl.textContent   = 'Erreur de connexion.';
            errEl.style.display = 'inline';
        });
}

function supprimerReponse(id) {
    if (!confirm('Supprimer cette réponse ?')) return;

    fetch('/avis/' + id + '/reponse/supprimer', { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById('reponse-affichee-' + id).innerHTML = '';
                document.getElementById('reponse-affichee-' + id).style.display = 'none';
                // Réafficher le bouton "Répondre"
                const actions = document.getElementById('actions-' + id);
                if (!document.getElementById('btn-repondre-' + id)) {
                    const btn = document.createElement('button');
                    btn.id        = 'btn-repondre-' + id;
                    btn.innerHTML = '<i class="bi bi-reply me-1"></i>Répondre à cet avis';
                    btn.className = 'btn btn-sm rounded-pill';
                    btn.style.cssText = 'background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;font-size:0.8rem;font-weight:600;';
                    btn.onclick   = () => ouvrirFormulaire(id);
                    actions.prepend(btn);
                } else {
                    document.getElementById('btn-repondre-' + id).style.display = 'inline-flex';
                }
            }
        });
}

// ── Suggestion IA ────────────────────────────────────────────────────────────

function suggererReponseIA(id, btn) {
    const box     = document.getElementById('ia-box-' + id);
    const loading = document.getElementById('ia-loading-' + id);
    const result  = document.getElementById('ia-result-' + id);

    box.style.display     = 'block';
    loading.style.display = 'block';
    result.style.display  = 'none';
    btn.disabled          = true;

    const fd = new FormData();
    fetch('/avis/' + id + '/suggerer-reponse', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            loading.style.display = 'none';
            if (data.error) {
                box.innerHTML = '<div style="color:#dc3545;font-size:0.82rem;padding:8px;">❌ ' + data.error + '</div>';
                return;
            }
            document.getElementById('ia-text-' + id).textContent = data.reponse;
            result.style.display = 'block';
            btn.disabled = false;
        })
        .catch(() => {
            loading.style.display = 'none';
            box.innerHTML = '<div style="color:#dc3545;font-size:0.82rem;padding:8px;">❌ Erreur de connexion.</div>';
            btn.disabled = false;
        });
}

function utiliserSuggestion(id) {
    const texte = document.getElementById('ia-text-' + id).textContent;
    document.getElementById('textarea-' + id).value = texte;
    updateCount(id, texte.length);
    document.getElementById('ia-box-' + id).style.display = 'none';
    ouvrirFormulaire(id);
}

function ignorerSuggestion(id) {
    document.getElementById('ia-box-' + id).style.display = 'none';
}
</script>
{% endblock %}
