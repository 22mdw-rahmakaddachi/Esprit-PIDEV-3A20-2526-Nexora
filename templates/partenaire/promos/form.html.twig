{% extends 'partenaire/base_partenaire.html.twig' %}
{% block title %}{{ titre }}{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block body %}
<div class="page-header">
    <h1>{{ titre }}</h1>
    <a href="{{ path('partenaire_promos') }}" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <form method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Code promo *</label>
                        <input type="text" name="code" class="form-control" required
                               style="font-family:monospace;text-transform:uppercase"
                               value="{{ promo ? promo.code : '' }}"
                               placeholder="ex: SUMMER20">
                        <div class="text-muted small mt-1">Le code sera automatiquement mis en majuscules.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Type de réduction *</label>
                        <select name="typeReduction" class="form-select" id="typeReduction">
                            <option value="pourcentage" {{ promo and promo.typeReduction == 'pourcentage' ? 'selected' : '' }}>Pourcentage (%)</option>
                            <option value="montant_fixe" {{ promo and promo.typeReduction == 'montant_fixe' ? 'selected' : '' }}>Montant fixe (TND)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Valeur de la réduction *</label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="0" name="valeurReduction" class="form-control" required
                                   value="{{ promo ? promo.valeurReduction : '' }}">
                            <span class="input-group-text" id="unit-label">%</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Montant minimum de commande (TND)</label>
                        <input type="number" step="0.01" min="0" name="montantMinimum" class="form-control"
                               value="{{ promo ? promo.montantMinimum : '' }}" placeholder="Optionnel">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Date de début *</label>
                        <input type="date" name="dateDebut" class="form-control" required
                               value="{{ promo ? promo.dateDebut|date('Y-m-d') : '' }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Date de fin *</label>
                        <input type="date" name="dateFin" class="form-control" required
                               value="{{ promo ? promo.dateFin|date('Y-m-d') : '' }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Limite d'utilisation</label>
                        <input type="number" min="1" name="limiteUtilisation" class="form-control"
                               value="{{ promo ? promo.limiteUtilisation : '' }}" placeholder="Illimité">
                    </div>
                    {% if promo %}
                    <div class="col-md-6">
                        <label class="form-label">Statut</label>
                        <select name="actif" class="form-select">
                            <option value="1" {{ promo.actif ? 'selected' : '' }}>Actif</option>
                            <option value="0" {{ not promo.actif ? 'selected' : '' }}>Inactif</option>
                        </select>
                    </div>
                    {% endif %}
                    <div class="col-12">
                        <label class="form-label">Description (optionnel)</label>
                        <textarea name="description" class="form-control" rows="2">{{ promo ? promo.description : '' }}</textarea>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-3">
                    <button type="submit" class="btn btn-primary-p px-4">
                        <i class="bi bi-check-lg me-1"></i>{{ promo ? 'Enregistrer' : 'Créer le code promo' }}
                    </button>
                    <a href="{{ path('partenaire_promos') }}" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.getElementById('typeReduction').addEventListener('change', function() {
    document.getElementById('unit-label').textContent = this.value === 'pourcentage' ? '%' : 'TND';
});
// Init
document.getElementById('unit-label').textContent = document.getElementById('typeReduction').value === 'pourcentage' ? '%' : 'TND';
</script>
{% endblock %}
