{% extends 'base.html.twig' %}
{% block title %}Paiement réussi — NEXORA{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
    <div class="col-lg-6" data-aos="fade-up">
        <div class="bg-white rounded-4 p-5 shadow-sm text-center" style="border:2px solid #27ae60">
            <div style="font-size:4rem">✅</div>
            <h2 class="mt-3" style="color:#27ae60">Paiement réussi !</h2>

            {% if demande %}
            <p class="text-muted">Votre participation à <strong>{{ demande.activite.nom }}</strong> est confirmée.</p>
            <div class="my-4 p-3 rounded-3" style="background:#d1f2eb;border:1px solid #a9dfbf">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Activité</span>
                    <span class="fw-semibold">{{ demande.activite.nom }}</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Lieu</span>
                    <span>{{ demande.activite.lieu }}</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Montant payé</span>
                    <span class="fw-bold" style="color:#1a7a4a">{{ demande.activite.prix|number_format(2) }} TND</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Référence</span>
                    <span class="small">{{ paymentId }}</span>
                </div>
            </div>
            {% endif %}

            <a href="{{ path('app_mes_activites') }}" class="btn rounded-pill px-4"
               style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                <i class="bi bi-calendar-check me-2"></i>Mes activités
            </a>
        </div>
    </div>
    </div>
</div>
{% endblock %}
