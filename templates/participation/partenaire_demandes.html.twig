{% extends 'base.html.twig' %}
{% block title %}Gestion des demandes — TripShop{% endblock %}

{% block body %}
<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Gestion des demandes</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-right">
        <h2 class="section-title mb-0">Demandes de participation</h2>
        <div class="d-flex gap-2">
            <span class="badge rounded-pill px-3 py-2" style="background:#fff3cd;color:#856404">
                {{ demandes|filter(d => d.statut == 'EN_ATTENTE')|length }} en attente
            </span>
            <span class="badge rounded-pill px-3 py-2" style="background:#d1f2eb;color:#1a7a4a">
                {{ demandes|filter(d => d.statut == 'ACCEPTEE')|length }} acceptées
            </span>
            <span class="badge rounded-pill px-3 py-2" style="background:#fde8e8;color:#c0392b">
                {{ demandes|filter(d => d.statut == 'REFUSEE')|length }} refusées
            </span>
        </div>
    </div>

    {% if demandes is empty %}
    <div class="text-center py-5 rounded-4" style="background:#fff;border:2px dashed #ede5ff">
        <div style="font-size:4rem">📭</div>
        <h5 class="mt-3" style="color:var(--primary)">Aucune demande reçue</h5>
        <p class="text-muted">Vos activités n'ont pas encore reçu de demandes de participation.</p>
    </div>
    {% else %}
    <div class="d-flex flex-column gap-3">
        {% for demande in demandes %}
        <div class="p-4 rounded-4 bg-white shadow-sm" data-aos="fade-up" data-aos-delay="{{ loop.index * 60 }}"
             style="border-left:4px solid
                {% if demande.statut == 'ACCEPTEE' %}#27ae60
                {% elseif demande.statut == 'REFUSEE' %}#e74c3c
                {% else %}var(--primary-light){% endif %}">

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    {# Infos activité #}
                    <div class="fw-bold mb-1" style="color:var(--primary-dark);font-size:1rem">
                        {{ demande.activite.nom }}
                        <span class="badge ms-2" style="background:#f0ebff;color:var(--primary);font-size:0.72rem">
                            {{ demande.activite.type }}
                        </span>
                    </div>
                    {# Infos client #}
                    <div class="text-muted small d-flex flex-wrap gap-3 mt-1">
                        <span><i class="bi bi-person me-1"></i>{{ demande.clientNom }}</span>
                        <span><i class="bi bi-envelope me-1"></i>{{ demande.clientEmail }}</span>
                        <span><i class="bi bi-telephone me-1"></i>{{ demande.clientTelephone }}</span>
                        <span><i class="bi bi-clock me-1"></i>{{ demande.dateDemande|date('d/m/Y H:i') }}</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    {# Statut actuel #}
                    {% if demande.statut == 'EN_ATTENTE' %}
                    <span class="badge rounded-pill px-3 py-2"
                          style="background:#fff3cd;color:#856404">
                        <i class="bi bi-hourglass-split me-1"></i>En attente
                    </span>
                    {# Boutons accepter / refuser #}
                    <form method="POST" action="{{ path('app_demande_accepter', {id: demande.id}) }}" class="d-inline">
                        <button type="submit" class="btn btn-sm rounded-pill px-3"
                                style="background:linear-gradient(135deg,#27ae60,#2ecc71);color:#fff">
                            <i class="bi bi-check-lg me-1"></i>Accepter
                        </button>
                    </form>
                    <form method="POST" action="{{ path('app_demande_refuser', {id: demande.id}) }}" class="d-inline">
                        <button type="submit" class="btn btn-sm rounded-pill px-3"
                                style="background:linear-gradient(135deg,#e74c3c,#c0392b);color:#fff"
                                onclick="return confirm('Confirmer le refus ?')">
                            <i class="bi bi-x-lg me-1"></i>Refuser
                        </button>
                    </form>

                    {% elseif demande.statut == 'ACCEPTEE' %}
                    <span class="badge rounded-pill px-3 py-2"
                          style="background:#d1f2eb;color:#1a7a4a">
                        <i class="bi bi-check-circle-fill me-1"></i>Acceptée
                    </span>
                    {% if demande.paiementEffectue %}
                    <span class="badge rounded-pill px-3 py-2"
                          style="background:#d1f2eb;color:#1a7a4a">
                        <i class="bi bi-cash-coin me-1"></i>Payé
                    </span>
                    {% endif %}

                    {% elseif demande.statut == 'REFUSEE' %}
                    <span class="badge rounded-pill px-3 py-2"
                          style="background:#fde8e8;color:#c0392b">
                        <i class="bi bi-x-circle-fill me-1"></i>Refusée
                    </span>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
