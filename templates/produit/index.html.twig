{% extends 'base.html.twig' %}
{% block title %}Boutique — TripShop{% endblock %}

{% block body %}

<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Boutique</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">

        {# SIDEBAR #}
        <div class="col-lg-3" data-aos="fade-right">
            <div class="filter-sidebar">
                <h6><i class="bi bi-grid me-2"></i>Catégories</h6>
                <div class="d-flex flex-column gap-2">
                    <a href="{{ path('app_produits') }}"
                       class="cat-pill {{ categorieId is null ? 'active' : '' }}">
                        <i class="bi bi-collection me-1"></i>Tous
                    </a>
                    {% for cat in categories %}
                    <a href="{{ path('app_produits', {categorie: cat.id}) }}"
                       class="cat-pill {{ categorieId == cat.id ? 'active' : '' }}">
                        {{ cat.nom }}
                    </a>
                    {% endfor %}
                </div>
                <hr style="border-color:#ede5ff">
                <h6><i class="bi bi-currency-dollar me-2"></i>Prix (TND)</h6>
                <div class="d-flex gap-2">
                    <input type="number" class="form-control form-control-sm" placeholder="Min">
                    <input type="number" class="form-control form-control-sm" placeholder="Max">
                </div>
                <button class="btn btn-sm w-100 mt-2 rounded-pill"
                        style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                    Filtrer
                </button>
            </div>
        </div>

        {# PRODUITS #}
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-left">
                <h2 class="section-title mb-0">Boutique</h2>
                <span class="badge rounded-pill px-3 py-2"
                      style="background:#f0ebff;color:var(--primary)">
                    {{ produits|length }} produit(s)
                </span>
            </div>

            <div class="row g-4">
                {% for produit in produits %}
                <div class="col-6 col-md-4" data-aos="fade-up" data-aos-delay="{{ (loop.index0 % 3) * 100 }}">
                    <div class="product-card card h-100">
                        <div class="img-wrap img-zoom" style="height:200px">
                            {% if produit.imagePrincipale %}
                            <img src="/uploads/produits/{{ produit.imagePrincipale }}"
                                 alt="{{ produit.nom }}"
                                 style="width:100%;height:100%;object-fit:cover">
                            {% else %}
                            <span class="emoji-img" style="font-size:4.5rem">🛍️</span>
                            {% endif %}
                            {% if produit.variants|length > 0 and produit.variants.first.prixPromo %}
                            <span class="position-absolute top-0 end-0 m-2 badge-new">Promo</span>
                            {% endif %}
                        </div>
                        <div class="card-body p-3">
                            <span class="badge-cat mb-2 d-inline-block">
                                {{ produit.sousCategorie ? produit.sousCategorie.nom : 'Produit' }}
                            </span>
                            <h6 class="card-title">{{ produit.nom }}</h6>
                            <p class="text-muted small mb-2" style="font-size:0.8rem">{{ produit.descriptionCourte }}</p>
                            <span class="price">{{ produit.prixMin ? produit.prixMin ~ ' TND' : 'N/A' }}</span>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-3 pt-0">
                            <a href="{{ path('app_produit_show', {id: produit.id}) }}" class="btn-add btn">
                                <i class="bi bi-eye me-1"></i>Voir le produit
                            </a>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="col-12" data-aos="fade-up">
                    <div class="text-center py-5 rounded-4" style="background:var(--white)">
                        <div style="font-size:4rem">🛒</div>
                        <p class="mt-3 text-muted">Aucun produit dans cette catégorie.</p>
                        <a href="{{ path('app_produits') }}" class="btn rounded-pill px-4"
                           style="background:var(--primary);color:#fff">Voir tous les produits</a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<style>
#chat-widget-btn {
    position: fixed; bottom: 28px; right: 28px; z-index: 9999;
    width: 58px; height: 58px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #fff; border: none; cursor: pointer;
    box-shadow: 0 6px 24px rgba(108,63,197,0.4);
    font-size: 1.5rem; display: flex; align-items: center; justify-content: center;
    transition: transform .2s, box-shadow .2s;
    animation: pulse-chat 2.5s infinite;
}
#chat-widget-btn:hover { transform: scale(1.1); }
@keyframes pulse-chat {
    0%,100% { box-shadow: 0 6px 24px rgba(108,63,197,0.4); }
    50%      { box-shadow: 0 6px 32px rgba(108,63,197,0.7); }
}
#chat-widget-badge {
    position: absolute; top: -4px; right: -4px;
    background: #e74c3c; color: #fff;
    width: 18px; height: 18px; border-radius: 50%;
    font-size: 0.65rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid #fff;
}
#chat-widget-panel {
    position: fixed; bottom: 100px; right: 28px; z-index: 9998;
    width: 360px; height: 500px;
    background: #fff; border-radius: 20px;
    box-shadow: 0 20px 60px rgba(108,63,197,0.2);
    border: 1px solid #ede5ff;
    display: none; flex-direction: column; overflow: hidden;
}
#chat-widget-panel.open { display: flex; animation: cwSlideUp .25s ease; }
@keyframes cwSlideUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
.cw-header {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    padding: 14px 18px; display: flex; align-items: center; gap: 10px; flex-shrink: 0;
}
.cw-title { color: #fff; font-weight: 700; font-size: 0.95rem; }
.cw-sub   { color: rgba(255,255,255,0.75); font-size: 0.75rem; }
.cw-close {
    margin-left: auto; background: rgba(255,255,255,0.2);
    border: none; color: #fff; width: 28px; height: 28px;
    border-radius: 50%; cursor: pointer; font-size: 1rem;
    display: flex; align-items: center; justify-content: center;
}
.cw-close:hover { background: rgba(255,255,255,0.35); }
.cw-messages {
    flex: 1; overflow-y: auto; padding: 14px;
    display: flex; flex-direction: column; gap: 10px; background: #faf8ff;
}
.cw-msg { display: flex; gap: 8px; align-items: flex-end; }
.cw-msg.user { flex-direction: row-reverse; }
.cw-bubble {
    max-width: 80%; padding: 9px 13px; border-radius: 14px;
    font-size: 0.83rem; line-height: 1.5; white-space: pre-wrap;
}
.cw-msg.bot  .cw-bubble { background: #fff; border: 1px solid #ede5ff; color: #333; border-bottom-left-radius: 4px; }
.cw-msg.user .cw-bubble { background: linear-gradient(135deg,var(--primary),var(--accent)); color: #fff; border-bottom-right-radius: 4px; }
.cw-typing span { display:inline-block;width:7px;height:7px;background:var(--primary-light);border-radius:50%;margin:0 2px;animation:cwb 1.2s infinite; }
.cw-typing span:nth-child(2){animation-delay:.2s}.cw-typing span:nth-child(3){animation-delay:.4s}
@keyframes cwb{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}
.cw-suggestions { padding: 8px 12px; display: flex; flex-wrap: wrap; gap: 6px; border-top: 1px solid #f0ebff; flex-shrink: 0; }
.cw-sug-btn { background:#f0ebff;border:none;border-radius:50px;padding:4px 12px;font-size:0.75rem;color:var(--primary);cursor:pointer;transition:all .15s; }
.cw-sug-btn:hover { background:var(--primary);color:#fff; }
.cw-input-area { display:flex;gap:8px;padding:10px 12px;border-top:1px solid #ede5ff;background:#fff;flex-shrink:0; }
.cw-input-area input { flex:1;border:1.5px solid #e0d5f5;border-radius:50px;padding:8px 14px;font-size:0.83rem;outline:none;transition:border-color .2s; }
.cw-input-area input:focus { border-color:var(--primary); }
.cw-send-btn { background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;border-radius:50%;width:36px;height:36px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:0.9rem; }
.cw-send-btn:disabled { opacity:.5;cursor:not-allowed; }
</style>

<button id="chat-widget-btn" onclick="toggleChatWidget()" title="Assistant boutique" style="position:fixed">
    <span id="chat-btn-icon">🤖</span>
    <span id="chat-widget-badge" style="display:none;position:absolute;top:-4px;right:-4px;background:#e74c3c;color:#fff;width:18px;height:18px;border-radius:50%;font-size:0.65rem;font-weight:700;align-items:center;justify-content:center;border:2px solid #fff">1</span>
</button>

<div id="chat-widget-panel">
    <div class="cw-header">
        <span style="font-size:1.4rem">🤖</span>
        <div>
            <div class="cw-title">Assistant NEXORA</div>
            <div class="cw-sub">Boutique · Toujours disponible</div>
        </div>
        <button class="cw-close" onclick="toggleChatWidget()">✕</button>
    </div>
    <div class="cw-messages" id="cw-messages">
        <div class="cw-msg bot">
            <div class="cw-bubble">Bonjour ! 👋 Je suis votre assistant boutique.

Je peux vous aider à :
• Trouver un produit selon votre budget
• Voir les codes promo actifs
• Parcourir le catalogue

Que cherchez-vous ?</div>
        </div>
    </div>
    <div class="cw-suggestions" id="cw-suggestions">
        <button class="cw-sug-btn" onclick="cwSuggest(this)">💰 Budget 50 TND</button>
        <button class="cw-sug-btn" onclick="cwSuggest(this)">🏷️ Codes promo</button>
        <button class="cw-sug-btn" onclick="cwSuggest(this)">📦 Catalogue</button>
    </div>
    <div class="cw-input-area">
        <input type="text" id="cw-input" placeholder="Votre question..." autocomplete="off"
               onkeydown="if(event.key==='Enter') cwSend()">
        <button class="cw-send-btn" id="cw-send-btn" onclick="cwSend()">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>
</div>

<script>
let cwOpen = false;
function toggleChatWidget() {
    cwOpen = !cwOpen;
    const panel = document.getElementById('chat-widget-panel');
    const badge = document.getElementById('chat-widget-badge');
    const icon  = document.getElementById('chat-btn-icon');
    if (cwOpen) {
        panel.classList.add('open');
        badge.style.display = 'none';
        icon.textContent = '✕';
        document.getElementById('cw-input').focus();
    } else {
        panel.classList.remove('open');
        icon.textContent = '🤖';
    }
}
function cwAddMsg(text, role) {
    const el = document.getElementById('cw-messages');
    const div = document.createElement('div');
    div.className = 'cw-msg ' + role;
    div.innerHTML = `<div class="cw-bubble">${text.replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>').replace(/\n/g,'<br>')}</div>`;
    el.appendChild(div);
    el.scrollTop = el.scrollHeight;
}
function cwShowTyping() {
    const el = document.getElementById('cw-messages');
    const div = document.createElement('div');
    div.className = 'cw-msg bot'; div.id = 'cw-typing';
    div.innerHTML = '<div class="cw-bubble cw-typing"><span></span><span></span><span></span></div>';
    el.appendChild(div); el.scrollTop = el.scrollHeight;
}
async function cwSend() {
    const input = document.getElementById('cw-input');
    const btn   = document.getElementById('cw-send-btn');
    const text  = input.value.trim();
    if (!text) return;
    cwAddMsg(text, 'user');
    input.value = ''; btn.disabled = true;
    document.getElementById('cw-suggestions').style.display = 'none';
    cwShowTyping();
    try {
        const res  = await fetch('/chatbot/message', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({message: text}) });
        const data = await res.json();
        document.getElementById('cw-typing')?.remove();
        cwAddMsg(data.reply || 'Désolé, je n\'ai pas pu répondre.', 'bot');
    } catch(e) {
        document.getElementById('cw-typing')?.remove();
        cwAddMsg('Erreur de connexion. Réessayez.', 'bot');
    }
    btn.disabled = false; input.focus();
}
function cwSuggest(btn) {
    document.getElementById('cw-input').value = btn.textContent.replace(/^[^\w]+/,'').trim();
    cwSend();
}
setTimeout(() => { if (!cwOpen) document.getElementById('chat-widget-badge').style.display = 'flex'; }, 3000);
</script>
{% endblock %}
