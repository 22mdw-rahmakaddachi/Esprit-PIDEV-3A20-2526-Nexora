{% extends 'base.html.twig' %}
{% block title %}{{ produit ? produit.nom : 'Produit' }} — Nexora{% endblock %}

{% block body %}
{% if not produit %}
<div class="container py-5 text-center text-muted">
    <i class="bi bi-bag-x" style="font-size:3rem;opacity:0.4"></i>
    <p class="mt-3">Produit introuvable.</p>
    <a href="{{ path('app_produits') }}" class="btn rounded-pill px-4 mt-2" style="background:var(--primary);color:#fff">Retour à la boutique</a>
</div>
{% else %}
<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_produits') }}">Boutique</a></li>
                <li class="breadcrumb-item active">{{ produit.nom }}</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5 align-items-start">
        <div class="col-md-5" data-aos="fade-right">
            <div class="rounded-4 d-flex align-items-center justify-content-center img-zoom"
                 style="height:400px;background:linear-gradient(135deg,#f0ebff,#e8d5ff);font-size:9rem">
                <span class="emoji-img">🛍️</span>
            </div>
        </div>
        <div class="col-md-7" data-aos="fade-left">
            <span class="badge-cat mb-3 d-inline-block">
                {{ produit.sousCategorie ? produit.sousCategorie.nom : 'Produit' }}
            </span>
            <h1 class="mb-2" style="font-family:'Playfair Display',serif">{{ produit.nom }}</h1>
            {% if produit.marque %}
            <p class="text-muted mb-3">Marque : <strong style="color:var(--primary)">{{ produit.marque }}</strong></p>
            {% endif %}

            <div class="my-3">
                <span class="price" style="font-size:2rem">{{ produit.prixMin ? produit.prixMin ~ ' TND' : 'N/A' }}</span>
            </div>

            <p class="text-muted">{{ produit.description }}</p>

            {% if produit.variants|length > 0 %}
            <div class="mb-4">
                <label class="fw-semibold mb-2 d-block" style="color:var(--primary)">
                    <i class="bi bi-layers me-1"></i>Variante :
                </label>
                <select class="form-select rounded-pill" style="max-width:300px;border-color:#ede5ff">
                    {% for v in produit.variants %}
                    <option value="{{ v.id }}">
                        {{ v.sku }} — {{ v.prixPromo ?? v.prixVente }} TND ({{ v.quantiteStock }} en stock)
                    </option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}

            <div class="d-flex gap-3 mt-4 flex-wrap">
                <button class="btn btn-lg rounded-pill px-4 btn-pulse"
                        style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff">
                    <i class="bi bi-cart-plus me-2"></i>Ajouter au panier
                </button>
                <a href="{{ path('app_produits') }}"
                   class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </a>
            </div>

            <div class="mt-4 p-4 rounded-4" style="background:#f9f7ff;border:1px solid #ede5ff">
                <div class="row text-center g-2">
                    <div class="col-4">
                        <i class="bi bi-truck fs-4" style="color:var(--primary)"></i>
                        <div class="small mt-1 fw-semibold">Livraison rapide</div>
                    </div>
                    <div class="col-4">
                        <i class="bi bi-shield-check fs-4" style="color:var(--primary)"></i>
                        <div class="small mt-1 fw-semibold">Paiement sécurisé</div>
                    </div>
                    <div class="col-4">
                        <i class="bi bi-arrow-return-left fs-4" style="color:var(--primary)"></i>
                        <div class="small mt-1 fw-semibold">Retour facile</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
