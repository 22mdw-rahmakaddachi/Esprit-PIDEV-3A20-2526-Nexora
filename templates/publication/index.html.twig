{% extends 'base.html.twig' %}
{% block title %}Publications — TripShop{% endblock %}

{% block stylesheets %}
<style>
.feed-wrap { max-width: 640px; margin: 0 auto; }

.pub-card {
    background: #fff; border-radius: 16px;
    box-shadow: 0 2px 16px rgba(108,63,197,0.08);
    border: 1px solid #ede5ff;
    transition: box-shadow 0.2s;
    /* PAS de overflow:hidden ici — sinon les commentaires sont coupés */
}
.pub-card:hover { box-shadow: 0 6px 28px rgba(108,63,197,0.13); }
/* Le contenu principal de la carte garde le border-radius */
.pub-card-body { border-radius: 16px 16px 0 0; overflow: hidden; }
.pub-card-body:last-child { border-radius: 16px; }

.pub-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #fff; font-weight: 700; font-size: 1rem;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

.reaction-bar {
    display: flex; gap: 4px; padding: 8px 16px;
    border-top: 1px solid #f0ebff;
}
.reaction-btn {
    position: relative; background: none; border: none;
    font-size: 1.3rem; cursor: pointer; padding: 4px 8px;
    border-radius: 50px; transition: transform 0.15s, background 0.15s; line-height: 1;
}
.reaction-btn:hover { transform: scale(1.35); background: #f0ebff; }
.reaction-btn.active { background: #ede5ff; }
.reaction-btn .r-count {
    position: absolute; top: -4px; right: -2px;
    background: var(--primary); color: #fff; font-size: 0.6rem; font-weight: 700;
    min-width: 16px; height: 16px; border-radius: 50px;
    display: flex; align-items: center; justify-content: center; padding: 0 3px;
}

/* Section commentaires */
.comments-section {
    border-top: 1px solid #ede5ff;
    border-radius: 0 0 16px 16px;
    background: #faf8ff;
    overflow: hidden;
}
.comment-item { display: flex; gap: 10px; align-items: flex-start; }
.comment-avatar {
    width: 32px; height: 32px; border-radius: 50%;
    background: linear-gradient(135deg, #a78bda, var(--accent));
    color: #fff; font-weight: 700; font-size: 0.78rem;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.comment-bubble {
    background: #fff; border-radius: 0 12px 12px 12px;
    padding: 8px 14px; font-size: 0.85rem; flex: 1;
    border: 1px solid #ede5ff;
}
.comment-bubble .c-author { font-weight: 700; color: var(--primary-dark); font-size: 0.82rem; }
.comment-bubble .c-text   { color: #444; margin-top: 2px; line-height: 1.5; }
.comment-bubble .c-date   { color: #aaa; font-size: 0.72rem; margin-top: 3px; }

.comment-input-wrap {
    display: flex; gap: 8px; align-items: center;
    padding: 10px 16px; background: #fff;
    border-top: 1px solid #ede5ff;
}
.comment-input {
    flex: 1; border: 1.5px solid #ede5ff; border-radius: 50px;
    padding: 8px 14px; font-size: 0.85rem; outline: none; transition: border-color 0.2s;
    background: #faf8ff;
}
.comment-input:focus { border-color: var(--primary-light); background: #fff; }
.comment-input.field-error { border-color: #e74c3c !important; }
.comment-send-btn {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #fff; border: none; border-radius: 50%;
    width: 36px; height: 36px; display: flex; align-items: center;
    justify-content: center; cursor: pointer; font-size: 0.9rem;
    transition: opacity 0.2s, transform 0.2s; flex-shrink: 0;
}
.comment-send-btn:hover { opacity: 0.85; transform: scale(1.08); }

/* Formulaire nouvelle publication */
.new-pub-card {
    background: #fff; border-radius: 16px;
    box-shadow: 0 2px 16px rgba(108,63,197,0.08);
    border: 1px solid #ede5ff; padding: 20px;
}
.new-pub-textarea {
    width: 100%; border: 1.5px solid #ede5ff; border-radius: 12px;
    padding: 12px 16px; font-size: 0.9rem; resize: none; outline: none;
    transition: border-color 0.2s; font-family: inherit;
}
.new-pub-textarea:focus { border-color: var(--primary-light); }
.new-pub-textarea.field-error { border-color: #e74c3c !important; box-shadow: 0 0 0 3px rgba(231,76,60,0.1); }

/* Image preview */
.img-preview-wrap { position: relative; display: inline-block; margin-top: 10px; }
.img-preview-wrap img { max-height: 160px; border-radius: 10px; border: 1px solid #ede5ff; }
.remove-img {
    position: absolute; top: -8px; right: -8px;
    background: #e74c3c; color: #fff; border: none; border-radius: 50%;
    width: 22px; height: 22px; font-size: 0.7rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center; line-height: 1;
}
.pub-image { width: 100%; max-height: 320px; object-fit: cover; display: block; }

.field-error-msg { color: #e74c3c; font-size: 0.78rem; margin-top: 4px; padding-left: 4px; display: none; }
.field-error-msg.show { display: block; }
/* ── DARK MODE ── */
[data-theme="dark"] .pub-card { background: var(--card-bg); border-color: var(--border); }
[data-theme="dark"] .pub-card-body { background: var(--card-bg); }
[data-theme="dark"] .new-pub-card { background: var(--card-bg); border-color: var(--border); }
[data-theme="dark"] .new-pub-textarea { background: var(--input-bg); color: var(--text); border-color: var(--border); }
[data-theme="dark"] .comment-bubble { background: #221f33; border-color: var(--border); }
[data-theme="dark"] .comment-bubble .c-text { color: var(--text); }
[data-theme="dark"] .comment-bubble .c-author { color: #c9b8f0; }
[data-theme="dark"] .comment-input { background: var(--input-bg); color: var(--text); border-color: var(--border); }
[data-theme="dark"] .comment-input-wrap { background: var(--card-bg); border-color: var(--border); }
[data-theme="dark"] .comments-section { background: #13111e; border-color: var(--border); }
[data-theme="dark"] .reaction-bar { border-color: var(--border); }
[data-theme="dark"] .text-muted { color: var(--text-muted) !important; }
[data-theme="dark"] .form-control,
[data-theme="dark"] .form-select { background: var(--input-bg); color: var(--text); border-color: var(--border); }
</style>
{% endblock %}

{% block body %}
<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Publications</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="feed-wrap">

        {# ── NOUVELLE PUBLICATION — vrai form HTML avec enctype ── #}
        <div class="new-pub-card mb-4" data-aos="fade-down">
            <form id="pub-form" method="POST" action="{{ path('app_publication_new') }}" enctype="multipart/form-data">

                <div class="d-flex align-items-center gap-3 mb-3">
                    {% if app.user %}
                        <div class="pub-avatar">{{ app.user.initials }}</div>
                        <div class="fw-semibold" style="color:var(--primary-dark)">
                            {{ app.user.fullName }}
                            <span class="ms-2 badge rounded-pill" style="background:#f0ebff;color:var(--primary);font-size:0.7rem">
                                <i class="bi bi-check-circle-fill me-1"></i>Connecté
                            </span>
                        </div>
                        <input type="hidden" name="auteur" value="{{ app.user.fullName }}">
                    {% else %}
                        <div class="pub-avatar" id="avatar-preview" style="background:#ccc">?</div>
                        <div class="flex-grow-1">
                            <input type="text" name="auteur" id="new-pub-auteur" placeholder="Votre nom..."
                                   class="form-control rounded-pill" style="border-color:#ede5ff;font-size:0.88rem"
                                   oninput="updateAvatar(this.value)">
                            <div class="field-error-msg" id="err-pub-auteur">
                                <i class="bi bi-exclamation-circle me-1"></i>Le nom est obligatoire (min. 2 caractères).
                            </div>
                        </div>
                    {% endif %}
                </div>

                <textarea name="contenu" id="new-pub-contenu" class="new-pub-textarea" rows="3"
                          placeholder="Quoi de neuf ? Partagez votre expérience TripShop..."
                          oninput="this.classList.remove('field-error')"></textarea>
                <div class="field-error-msg" id="err-pub-contenu">
                    <i class="bi bi-exclamation-circle me-1"></i>Le contenu est obligatoire (min. 2 caractères).
                </div>

                <div id="img-preview-container"></div>

                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="d-flex gap-2 align-items-center">
                        <label for="pub-image-input" class="btn btn-sm rounded-pill px-3"
                               style="border:1.5px solid #ede5ff;color:var(--primary);cursor:pointer;font-size:0.82rem;margin:0">
                            <i class="bi bi-image me-1"></i>Photo
                        </label>
                        <input type="file" name="image" id="pub-image-input" accept="image/*"
                               style="display:none" onchange="previewImage(this)">
                        <span class="text-muted" style="font-size:0.78rem">
                            <i class="bi bi-globe me-1"></i>Visible par tous
                        </span>
                    </div>
                    <button type="button" onclick="validerEtPublier()"
                            class="btn rounded-pill px-4 fw-semibold"
                            style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;font-size:0.88rem">
                        <i class="bi bi-send me-2"></i>Publier
                    </button>
                </div>
            </form>
        </div>

        {# ── LISTE DES PUBLICATIONS ── #}
        {% for pub in publications %}
        <div class="pub-card mb-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 60 }}" id="pub-{{ pub.id }}">

            <div class="pub-card-body">
                <div class="d-flex align-items-center gap-3 p-3">
                    <div class="pub-avatar">{{ pub.auteur|slice(0,1)|upper }}</div>
                    <div>
                        <div class="fw-bold" style="color:var(--primary-dark);font-size:0.95rem">{{ pub.auteur }}</div>
                    <div class="text-muted" style="font-size:0.75rem">
                            <i class="bi bi-clock me-1"></i>{{ pub.created_at|date('d/m/Y à H:i') }}
                        </div>
                    </div>
                </div>

                <div class="px-3 pb-3" style="font-size:0.92rem;line-height:1.7;color:var(--text,#333)">
                    {{ pub.contenu }}
                </div>

                {% if pub.image %}
                <img src="/uploads/publications/{{ pub.image }}" alt="photo" class="pub-image">
                {% endif %}
            </div>

            {% if pub.total_reactions > 0 %}
            <div class="px-3 py-1 d-flex gap-2 align-items-center" style="font-size:0.8rem;color:#888">
                <span id="summary-{{ pub.id }}">
                    {% for r in pub.reactions %}
                        {{ r.type_reaction == 'jaime'  ? '👍' :
                           r.type_reaction == 'jadore' ? '❤️' :
                           r.type_reaction == 'haha'   ? '😂' :
                           r.type_reaction == 'wow'    ? '😮' :
                           r.type_reaction == 'triste' ? '😢' : '😡' }}{{ r.total }}
                    {% endfor %}
                </span>
            </div>
            {% else %}
            <div id="summary-{{ pub.id }}" style="min-height:4px"></div>
            {% endif %}

            <div class="reaction-bar" id="reactions-{{ pub.id }}">
                {% set emojis = {'jaime':'👍','jadore':'❤️','haha':'😂','wow':'😮','triste':'😢','grrr':'😡'} %}
                {% for key, emoji in emojis %}
                    {% set count = 0 %}
                    {% for r in pub.reactions %}{% if r.type_reaction == key %}{% set count = r.total %}{% endif %}{% endfor %}
                    <button class="reaction-btn" data-pub="{{ pub.id }}" data-type="{{ key }}"
                            title="{{ key }}" onclick="reagir({{ pub.id }}, '{{ key }}', this)">
                        {{ emoji }}{% if count > 0 %}<span class="r-count">{{ count }}</span>{% endif %}
                    </button>
                {% endfor %}

                <button type="button"
                        class="ms-auto btn btn-sm rounded-pill px-3 btn-toggle-comments"
                        data-pubid="{{ pub.id }}"
                        style="font-size:0.8rem;color:var(--primary);border:1.5px solid #ede5ff">
                    <i class="bi bi-chat me-1"></i><span id="nb-comments-{{ pub.id }}">{{ pub.commentaires|length }}</span>
                </button>
            </div>

            {# ── SECTION COMMENTAIRES ── #}
            <div id="comments-{{ pub.id }}" class="comments-section" style="display:none">
                <div class="px-3 pt-3 pb-2 d-flex flex-column gap-3" id="comments-list-{{ pub.id }}">
                    {% for c in pub.commentaires %}
                    <div class="comment-item">
                        <div class="comment-avatar">{{ c.auteur|slice(0,1)|upper }}</div>
                        <div class="comment-bubble">
                            <div class="c-author">{{ c.auteur }}</div>
                            <div class="c-text">{{ c.contenu }}</div>
                            <div class="c-date">{{ c.created_at|date('d/m/Y H:i') }}</div>
                        </div>
                    </div>
                    {% else %}
                    <p class="text-muted small text-center py-2 mb-0" id="no-comment-{{ pub.id }}">
                        Aucun commentaire pour l'instant.
                    </p>
                    {% endfor %}
                </div>

                <div class="comment-input-wrap">
                    {% if app.user %}
                        <div class="comment-avatar">{{ app.user.initials }}</div>
                        <input type="hidden" id="c-auteur-{{ pub.id }}" value="{{ app.user.fullName }}">
                    {% else %}
                        <div class="comment-avatar" style="background:linear-gradient(135deg,#ccc,#aaa)" id="c-av-{{ pub.id }}">?</div>
                        <input type="text" class="comment-input" id="c-auteur-{{ pub.id }}"
                               placeholder="Votre nom" style="max-width:120px"
                               oninput="this.classList.remove('field-error');document.getElementById('c-av-{{ pub.id }}').textContent=this.value?this.value[0].toUpperCase():'?'">
                    {% endif %}
                    <input type="text" class="comment-input" id="c-text-{{ pub.id }}"
                           placeholder="Écrire un commentaire…"
                           onkeydown="if(event.key==='Enter'){event.preventDefault();envoyerCommentaire({{ pub.id }})}"
                           oninput="this.classList.remove('field-error')">
                    <button type="button" class="comment-send-btn"
                            onclick="envoyerCommentaire({{ pub.id }})" title="Envoyer">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
                <div id="err-comment-{{ pub.id }}"
                     style="color:#e74c3c;font-size:0.78rem;padding:0 16px 8px;display:none"></div>
            </div>

        </div>
        {% else %}
        <div class="text-center py-5 text-muted" data-aos="fade-up">
            <div style="font-size:4rem">📝</div>
            <p class="mt-3">Aucune publication. Soyez le premier à partager !</p>
        </div>
        {% endfor %}

    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const currentUser = {{ app.user ? '"' ~ app.user.fullName|e('js') ~ '"' : 'null' }};

// ── AVATAR (non connecté) ──
function updateAvatar(val) {
    const av = document.getElementById('avatar-preview');
    if (av) av.textContent = val.trim() ? val.trim()[0].toUpperCase() : '?';
}

// ── PREVIEW IMAGE ──
function previewImage(input) {
    const container = document.getElementById('img-preview-container');
    container.innerHTML = '';
    if (!input.files || !input.files[0]) return;
    if (input.files[0].size > 5 * 1024 * 1024) {
        alert('Image trop lourde (max 5 Mo).');
        input.value = '';
        return;
    }
    const reader = new FileReader();
    reader.onload = e => {
        container.innerHTML = `<div class="img-preview-wrap">
            <img src="${e.target.result}" alt="preview">
            <button type="button" class="remove-img" onclick="removeImage()">✕</button>
        </div>`;
    };
    reader.readAsDataURL(input.files[0]);
}

function removeImage() {
    document.getElementById('pub-image-input').value = '';
    document.getElementById('img-preview-container').innerHTML = '';
}

// ── VALIDER ET SOUMETTRE (le form HTML natif gère l'image) ──
function validerEtPublier() {
    let valid = true;

    if (!currentUser) {
        const auteurEl  = document.getElementById('new-pub-auteur');
        const errAuteur = document.getElementById('err-pub-auteur');
        if (!auteurEl || auteurEl.value.trim().length < 2) {
            if (auteurEl) auteurEl.style.borderColor = '#e74c3c';
            errAuteur.classList.add('show');
            valid = false;
        } else {
            auteurEl.style.borderColor = '#ede5ff';
            errAuteur.classList.remove('show');
        }
    }

    const contenuEl  = document.getElementById('new-pub-contenu');
    const errContenu = document.getElementById('err-pub-contenu');
    if (contenuEl.value.trim().length < 2) {
        contenuEl.classList.add('field-error');
        errContenu.classList.add('show');
        valid = false;
    } else {
        contenuEl.classList.remove('field-error');
        errContenu.classList.remove('show');
    }

    if (!valid) return;

    if (!currentUser) {
        const auteurEl = document.getElementById('new-pub-auteur');
        if (auteurEl) localStorage.setItem('tripshop_username', auteurEl.value.trim());
    }

    document.getElementById('pub-form').submit();
}

// ── TOGGLE COMMENTAIRES (délégation) ──
document.addEventListener('click', function(e) {
    const btn = e.target.closest('.btn-toggle-comments');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();

    const pubId = btn.getAttribute('data-pubid');
    const section = document.getElementById('comments-' + pubId);
    if (!section) return;

    const isHidden = section.style.display === 'none' || section.style.display === '';
    section.style.display = isHidden ? 'block' : 'none';

    if (isHidden) {
        // Pré-remplir nom si connu
        if (!currentUser) {
            const saved = localStorage.getItem('tripshop_username');
            const auteurInput = document.getElementById('c-auteur-' + pubId);
            if (auteurInput && auteurInput.type !== 'hidden' && saved) {
                auteurInput.value = saved;
                const av = document.getElementById('c-av-' + pubId);
                if (av) av.textContent = saved[0].toUpperCase();
            }
        }
        // Focus champ texte
        setTimeout(() => {
            const t = document.getElementById('c-text-' + pubId);
            if (t) t.focus();
        }, 50);
    }
});

// ── RÉAGIR ──
function reagir(pubId, type, btn) {
    let auteur = currentUser;
    if (!auteur) {
        auteur = localStorage.getItem('tripshop_username') || '';
        if (auteur.length < 2) {
            auteur = prompt('Votre prénom pour réagir ?', auteur);
            if (!auteur || auteur.trim().length < 2) return;
            auteur = auteur.trim();
            localStorage.setItem('tripshop_username', auteur);
        }
    }
    const fd = new FormData();
    fd.append('auteur', auteur);
    fd.append('type', type);
    fetch('/publications/' + pubId + '/reagir', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            if (data.error) return;
            document.querySelectorAll('#reactions-' + pubId + ' .reaction-btn').forEach(b => {
                const t = b.dataset.type;
                const found = data.reactions.find(r => r.type_reaction === t);
                let badge = b.querySelector('.r-count');
                if (found && parseInt(found.total) > 0) {
                    if (!badge) { badge = document.createElement('span'); badge.className = 'r-count'; b.appendChild(badge); }
                    badge.textContent = found.total;
                } else if (badge) badge.remove();
            });
            const emojis = {jaime:'👍',jadore:'❤️',haha:'😂',wow:'😮',triste:'😢',grrr:'😡'};
            document.getElementById('summary-' + pubId).innerHTML =
                data.reactions.filter(r => parseInt(r.total) > 0)
                    .map(r => emojis[r.type_reaction] + r.total).join(' ');
        });
}

// ── COMMENTER ──
function envoyerCommentaire(pubId) {
    const auteurEl  = document.getElementById('c-auteur-' + pubId);
    const contenuEl = document.getElementById('c-text-'   + pubId);
    const errEl     = document.getElementById('err-comment-' + pubId);
    const auteur    = auteurEl.value.trim();
    const contenu   = contenuEl.value.trim();
    let errMsg = '';

    if (!currentUser && auteur.length < 2) {
        auteurEl.classList.add('field-error');
        errMsg = '⚠ Le nom est obligatoire.';
    } else if (auteurEl.type !== 'hidden') {
        auteurEl.classList.remove('field-error');
    }

    if (contenu.length < 2) {
        contenuEl.classList.add('field-error');
        errMsg = errMsg || '⚠ Le commentaire est obligatoire.';
    } else {
        contenuEl.classList.remove('field-error');
    }

    if (errMsg) { errEl.textContent = errMsg; errEl.style.display = 'block'; return; }
    errEl.style.display = 'none';

    if (!currentUser) localStorage.setItem('tripshop_username', auteur);

    const fd = new FormData();
    fd.append('auteur', auteur || currentUser);
    fd.append('contenu', contenu);

    fetch('/publications/' + pubId + '/commenter', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            if (data.error) { errEl.textContent = '⚠ ' + data.error; errEl.style.display = 'block'; return; }
            contenuEl.value = '';
            const noC = document.getElementById('no-comment-' + pubId);
            if (noC) noC.remove();
            const list = document.getElementById('comments-list-' + pubId);
            const div  = document.createElement('div');
            div.className = 'comment-item';
            div.innerHTML = `<div class="comment-avatar">${data.auteur[0].toUpperCase()}</div>
                <div class="comment-bubble">
                    <div class="c-author">${data.auteur}</div>
                    <div class="c-text">${data.contenu}</div>
                    <div class="c-date">${data.created_at}</div>
                </div>`;
            list.appendChild(div);
            div.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            const nb = document.getElementById('nb-comments-' + pubId);
            if (nb) nb.textContent = parseInt(nb.textContent || 0) + 1;
        })
        .catch(() => { errEl.textContent = '⚠ Erreur réseau.'; errEl.style.display = 'block'; });
}

// ── INIT (pré-remplir nom si connu) ──
(function() {
    if (!currentUser) {
        const saved = localStorage.getItem('tripshop_username');
        if (saved) {
            const el = document.getElementById('new-pub-auteur');
            if (el) { el.value = saved; updateAvatar(saved); }
        }
    }
    // Correction automatique
    if (window.SpellCheck) SpellCheck.attach('new-pub-contenu', 'fr');
})();
</script>
{% endblock %}
