{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié — Nexora{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-center" style="min-height:80vh">
    <div class="w-100" style="max-width:420px" data-aos="fade-up">

        <div class="text-center mb-4">
            <div style="width:64px;height:64px;border-radius:20px;background:linear-gradient(135deg,#fff3e0,#ffe0b2);display:inline-flex;align-items:center;justify-content:center;font-size:1.8rem;margin-bottom:14px">
                🔑
            </div>
            <h2 style="font-family:'Playfair Display',serif;color:var(--primary-dark)">Mot de passe oublié</h2>
            <p class="text-muted small">Entrez votre email pour recevoir un code de réinitialisation</p>
        </div>

        {% if sent %}
        <div class="p-4 rounded-4 text-center" style="background:#f0fdf4;border:1.5px solid #86efac">
            <div style="font-size:2.5rem;margin-bottom:12px">📬</div>
            <div class="fw-bold mb-1" style="color:#166534">Email envoyé !</div>
            <p class="text-muted small mb-3">Si cet email est associé à un compte, vous recevrez un code dans quelques instants.</p>
            <a href="{{ path('app_reset_password') }}"
               class="btn w-100 rounded-pill fw-semibold"
               style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;padding:11px">
                <i class="bi bi-key-fill me-2"></i>Entrer mon code
            </a>
        </div>
        {% else %}
        <div class="p-4 rounded-4 bg-white shadow-sm" style="border:1px solid #ede5ff">
            <form method="post">
                <div class="mb-4">
                    <label class="form-label fw-semibold small" style="color:var(--primary-dark)">
                        <i class="bi bi-envelope me-1"></i>Adresse email
                    </label>
                    <input type="email" name="email" class="form-control rounded-3"
                           placeholder="votre@email.com" required autofocus>
                </div>
                <button type="submit" class="btn w-100 rounded-pill fw-semibold"
                        style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;padding:11px">
                    <i class="bi bi-send-fill me-2"></i>Envoyer le code
                </button>
            </form>
        </div>
        {% endif %}

        <p class="text-center text-muted small mt-4 mb-0">
            <a href="{{ path('app_login') }}" style="color:var(--primary);font-weight:600">
                <i class="bi bi-arrow-left me-1"></i>Retour à la connexion
            </a>
        </p>

    </div>
</div>
{% endblock %}
