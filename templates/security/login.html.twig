{% extends 'base.html.twig' %}
{% block title %}Connexion — Nexora{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-center" style="min-height:80vh">
    <div class="w-100" style="max-width:420px" data-aos="fade-up">

        <div class="text-center mb-4">
            <h2 style="font-family:'Playfair Display',serif;color:var(--primary-dark)">
                Connexion
            </h2>
            <p class="text-muted small">Accédez à votre espace Nexora</p>
        </div>

        {% if error %}
        <div class="alert rounded-3 small" style="background:#fde8e8;border:1px solid #f5b7b1;color:#c0392b" id="login-error">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span id="error-msg">{{ error.messageKey|trans(error.messageData, 'security') }}</span>

            {# Tentatives restantes avant blocage #}
            {% if remaining > 0 and tentatives > 0 %}
            <div class="mt-2 d-flex align-items-center gap-2" style="font-size:0.82rem">
                <span>Tentatives restantes avant blocage :</span>
                <div class="d-flex gap-1">
                    {% for i in 1..3 %}
                        <div style="width:10px;height:10px;border-radius:50%;background:{{ i <= remaining ? '#e74c3c' : '#ddd' }}"></div>
                    {% endfor %}
                </div>
                <span class="fw-bold" style="color:#c0392b">{{ remaining }}/3</span>
            </div>
            {% endif %}

            {# Countdown si bloqué #}
            {% set msg = error.messageKey|trans(error.messageData, 'security') %}
            {% if 'seconde' in msg %}
                {% set seconds = msg|split('dans ')|last|split(' seconde')|first|trim %}
                <div id="countdown-wrap" class="mt-2 fw-bold text-center" style="font-size:1.3rem;color:#c0392b">
                    ⏳ <span id="countdown">{{ seconds }}</span>s
                </div>
                <script>
                    (function(){
                        let t = {{ seconds }};
                        const el = document.getElementById('countdown');
                        const wrap = document.getElementById('countdown-wrap');
                        const btn = document.querySelector('button[type=submit]');
                        if(btn) btn.disabled = true;
                        const iv = setInterval(()=>{
                            t--;
                            if(el) el.textContent = t;
                            if(t <= 0){
                                clearInterval(iv);
                                if(wrap) wrap.innerHTML = '✅ Vous pouvez réessayer';
                                if(btn) btn.disabled = false;
                            }
                        }, 1000);
                    })();
                </script>
            {% endif %}
        </div>
        {% endif %}

        <div class="p-4 rounded-4 bg-white shadow-sm" style="border:1px solid #ede5ff">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold small" style="color:var(--primary-dark)">
                        <i class="bi bi-envelope me-1"></i>Email
                    </label>
                    <input type="email" name="email" value="{{ last_username }}"
                           class="form-control rounded-3"
                           placeholder="votre@email.com" required autofocus>
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label fw-semibold small mb-0" style="color:var(--primary-dark)">
                            <i class="bi bi-lock me-1"></i>Mot de passe
                        </label>
                        <a href="{{ path('app_forgot_password') }}" style="font-size:0.78rem;color:var(--primary)">
                            Mot de passe oublié ?
                        </a>
                    </div>
                    <div class="position-relative">
                        <input type="password" name="password" id="login-pwd"
                               class="form-control rounded-3"
                               placeholder="••••••••" required style="padding-right:44px">
                        <button type="button"
                                onclick="const i=document.getElementById('login-pwd');const e=document.getElementById('login-eye');i.type=i.type==='password'?'text':'password';e.className=i.type==='password'?'bi bi-eye':'bi bi-eye-slash'"
                                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:#aaa;cursor:pointer;padding:0;line-height:1">
                            <i class="bi bi-eye" id="login-eye"></i>
                        </button>
                    </div>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn w-100 rounded-pill fw-semibold"
                        style="background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;padding:11px">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                </button>
            </form>
        </div>

        <hr style="border-color:#ede5ff;margin:20px 0">

        {# ── CONNEXION PAR VISAGE ── #}
        <div class="text-center mb-3">
            <a href="{{ path('login_face_page') }}"
               class="btn w-100 rounded-pill fw-semibold"
               style="background:linear-gradient(135deg,#1a237e,#3949ab);color:#fff;padding:11px;border:none">
                <i class="bi bi-camera-fill me-2"></i>Se connecter avec la reconnaissance faciale
            </a>
        </div>

        {# ── CONNEXION PAR EMPREINTE ── #}
        <div class="text-center mb-3">
            <a href="{{ path('fingerprint_login_page') }}"
               class="btn w-100 rounded-pill fw-semibold"
               style="background:linear-gradient(135deg,#004d40,#00897b);color:#fff;padding:11px;border:none">
                <i class="bi bi-fingerprint me-2"></i>Se connecter avec l'empreinte digitale
            </a>
        </div>

        {# ── CONNEXION GOOGLE ── #}
        <div class="text-center mb-3">
            <a href="{{ path('auth_google_start') }}"
               class="btn w-100 rounded-pill fw-semibold d-flex align-items-center justify-content-center gap-2"
               style="background:#fff;color:#3c4043;border:1.5px solid #dadce0;padding:11px;font-size:0.95rem;box-shadow:0 1px 3px rgba(0,0,0,.08)">
                <svg width="20" height="20" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                Se connecter avec Google
            </a>
        </div>

        <hr style="border-color:#ede5ff;margin:20px 0">
        <p class="text-center text-muted small mb-0">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" style="color:var(--primary);font-weight:600">Créer un compte</a>
        </p>

    </div>
</div>
{% endblock %}
