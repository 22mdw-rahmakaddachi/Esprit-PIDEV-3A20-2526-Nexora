{% extends 'base.html.twig' %}
{% block title %}Inscription — TripShop{% endblock %}

{% block body %}
<div class="container py-5" style="max-width:500px">
    <div class="text-center mb-4">
        <h2 style="font-family:'Playfair Display',serif;color:var(--primary-dark)">
            <i class="bi bi-person-plus-fill me-2"></i>Créer un compte
        </h2>
        <p class="text-muted small">Rejoignez la communauté TripShop</p>
    </div>

    <div class="form-card">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

        <div class="row g-3 mb-3">
            <div class="col-6">
                <label class="form-label">{{ form_label(form.prenom) }}</label>
                {{ form_widget(form.prenom, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.prenom) }}
            </div>
            <div class="col-6">
                <label class="form-label">{{ form_label(form.nom) }}</label>
                {{ form_widget(form.nom, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.nom) }}
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <div class="input-group">
                <span class="input-group-text" style="background:#f9f7ff;border-color:#ddd">
                    <i class="bi bi-envelope" style="color:var(--primary)"></i>
                </span>
                {{ form_widget(form.email, {attr: {class: 'form-control', style: 'border-radius:0 10px 10px 0'}}) }}
            </div>
            {{ form_errors(form.email) }}
        </div>

        <div class="mb-3">
            <label class="form-label">Mot de passe</label>
            <div class="input-group">
                <span class="input-group-text" style="background:#f9f7ff;border-color:#ddd">
                    <i class="bi bi-lock" style="color:var(--primary)"></i>
                </span>
                {{ form_widget(form.plainPassword.first, {attr: {class: 'form-control', style: 'border-radius:0 10px 10px 0'}}) }}
            </div>
            {{ form_errors(form.plainPassword.first) }}
        </div>

        <div class="mb-4">
            <label class="form-label">Confirmer le mot de passe</label>
            <div class="input-group">
                <span class="input-group-text" style="background:#f9f7ff;border-color:#ddd">
                    <i class="bi bi-lock-fill" style="color:var(--primary)"></i>
                </span>
                {{ form_widget(form.plainPassword.second, {attr: {class: 'form-control', style: 'border-radius:0 10px 10px 0'}}) }}
            </div>
            {{ form_errors(form.plainPassword.second) }}
        </div>

        <button type="submit" class="btn btn-primary-admin w-100 py-2">
            <i class="bi bi-person-check-fill me-2"></i>Créer mon compte
        </button>

        {{ form_end(form) }}

        <hr class="my-4" style="border-color:#ede5ff">

        <p class="text-center text-muted small mb-0">
            Déjà un compte ?
            <a href="{{ path('app_login') }}" style="color:var(--primary);font-weight:600">
                Se connecter
            </a>
        </p>
    </div>
</div>

<style>
.form-card { background:#fff;border-radius:16px;padding:32px;box-shadow:0 4px 24px rgba(108,63,197,0.10);border:1px solid #ede5ff; }
.form-label { font-weight:600;font-size:0.85rem;color:var(--primary-dark); }
.form-control { border-color:#ddd;font-size:0.88rem;padding:10px 14px;border-radius:10px; }
.form-control:focus { border-color:var(--primary-light);box-shadow:0 0 0 3px rgba(108,63,197,0.12); }
.input-group-text { border-radius:10px 0 0 10px;border-color:#ddd; }
.btn-primary-admin { background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;border:none;border-radius:10px;font-weight:600;font-size:0.9rem;transition:opacity .2s,transform .2s; }
.btn-primary-admin:hover { opacity:.9;transform:translateY(-1px);color:#fff; }
</style>
{% endblock %}
