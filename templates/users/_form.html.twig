{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
<div class="form-card">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Prénom</label>
            {{ form_widget(form.prenom, {'attr': {'class': 'form-control' ~ (form.prenom.vars.errors|length ? ' is-invalid' : '')}}) }}
            {% if form.prenom.vars.errors|length %}
                <div class="invalid-feedback d-block">{{ form_errors(form.prenom) }}</div>
            {% endif %}
        </div>
        <div class="col-md-6">
            <label class="form-label">Nom</label>
            {{ form_widget(form.nom, {'attr': {'class': 'form-control' ~ (form.nom.vars.errors|length ? ' is-invalid' : '')}}) }}
            {% if form.nom.vars.errors|length %}
                <div class="invalid-feedback d-block">{{ form_errors(form.nom) }}</div>
            {% endif %}
        </div>
        <div class="col-md-6">
            <label class="form-label">Email</label>
            {{ form_widget(form.email, {'attr': {'class': 'form-control' ~ (form.email.vars.errors|length ? ' is-invalid' : '')}}) }}
            {% if form.email.vars.errors|length %}
                <div class="invalid-feedback d-block">{{ form_errors(form.email) }}</div>
            {% endif %}
        </div>
        <div class="col-md-6">
            <label class="form-label">Numéro</label>
            {{ form_widget(form.num, {'attr': {'class': 'form-control' ~ (form.num.vars.errors|length ? ' is-invalid' : '')}}) }}
            {% if form.num.vars.errors|length %}
                <div class="invalid-feedback d-block">{{ form_errors(form.num) }}</div>
            {% endif %}
        </div>
        <div class="col-md-6">
            <label class="form-label">Rôle</label>
            {{ form_widget(form.role, {'attr': {'class': 'form-control' ~ (form.role.vars.errors|length ? ' is-invalid' : '')}}) }}
            {% if form.role.vars.errors|length %}
                <div class="invalid-feedback d-block">{{ form_errors(form.role) }}</div>
            {% endif %}
        </div>
        <div class="col-md-6">
            <label class="form-label">
                Mot de passe
                {% if button_label is defined and button_label == 'Modifier' %}
                    <span class="text-muted fw-normal small">(laisser vide pour ne pas changer)</span>
                {% endif %}
            </label>
            {{ form_widget(form.mdp, {'attr': {'class': 'form-control' ~ (form.mdp.vars.errors|length ? ' is-invalid' : '')}}) }}
            {% if form.mdp.vars.errors|length %}
                <div class="invalid-feedback d-block">{{ form_errors(form.mdp) }}</div>
            {% endif %}
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary-admin">
            <i class="bi bi-check-lg me-1"></i>{{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('app_users_index') }}" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>
</div>
{{ form_end(form) }}
