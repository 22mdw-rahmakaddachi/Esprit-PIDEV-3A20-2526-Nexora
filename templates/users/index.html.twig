{% extends 'admin/base_admin.html.twig' %}
{% block title %}Gestion des utilisateurs{% endblock %}
{% block page_title %}Gestion des utilisateurs{% endblock %}

{% block body %}

{# ── HEADER ── #}
<div class="page-header mb-4">
    <h1><i class="bi bi-people-fill me-2" style="color:var(--primary)"></i>Utilisateurs</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-edit-admin" data-bs-toggle="modal" data-bs-target="#statsModal">
            <i class="bi bi-pie-chart-fill me-2"></i>Statistiques
        </button>
        <a href="{{ path('app_users_new') }}" class="btn btn-primary-admin">
            <i class="bi bi-person-plus-fill me-2"></i>Ajouter
        </a>
    </div>
</div>

{# ── MODAL STATISTIQUES ── #}
<div class="modal fade" id="statsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:20px;border:none">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color:var(--primary-dark)">
                    <i class="bi bi-pie-chart-fill me-2" style="color:var(--primary)"></i>Statistiques des rôles
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                {% set total = 0 %}
                {% for r, count in stats %}{% set total = total + count %}{% endfor %}

                {# Pie chart #}
                <div class="text-center mb-4">
                    <canvas id="roleChart" style="max-width:220px;max-height:220px"></canvas>
                </div>

                {# Légende détaillée #}
                {% set roleConfig = {
                    'ROLE_ADMIN':      {label: 'Admins',       color: '#c0392b', bg: '#fde8e8', icon: 'bi-shield-fill'},
                    'ROLE_PARTENAIRE': {label: 'Partenaires',  color: '#e67e22', bg: '#fff3cd', icon: 'bi-shop'},
                    'ROLE_USER':       {label: 'Utilisateurs', color: '#1a7a4a', bg: '#d1f2eb', icon: 'bi-person-fill'}
                } %}
                <div class="d-flex flex-column gap-2">
                    {% for role, cfg in roleConfig %}
                    {% set count = stats[role] ?? 0 %}
                    {% set pct = total > 0 ? ((count / total) * 100)|round : 0 %}
                    <div class="d-flex align-items-center gap-3 p-2 rounded-3" style="background:{{ cfg.bg }}">
                        <div style="width:36px;height:36px;border-radius:10px;background:{{ cfg.color }};color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi {{ cfg.icon }}"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold small" style="color:{{ cfg.color }}">{{ cfg.label }}</span>
                                <span class="fw-bold small" style="color:{{ cfg.color }}">{{ count }} ({{ pct }}%)</span>
                            </div>
                            <div style="height:6px;background:rgba(0,0,0,0.08);border-radius:3px;overflow:hidden">
                                <div style="height:100%;width:{{ pct }}%;background:{{ cfg.color }};border-radius:3px;transition:width 0.8s ease"></div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                    <div class="text-center mt-2 pt-2 border-top">
                        <span class="text-muted small">Total : </span>
                        <span class="fw-bold" style="color:var(--primary)">{{ total }} utilisateurs</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── BARRE RECHERCHE + FILTRES ── #}
<div class="admin-table mb-3 p-3">
    <form method="get" action="{{ path('app_users_index') }}" class="row g-2 align-items-end" id="search-form">
        <div class="col-md-5">
            <label class="form-label mb-1 small fw-bold" style="color:var(--primary-dark)">Recherche</label>
            <div class="input-group">
                <span class="input-group-text" style="background:#f0ebff;border-color:#ddd">
                    <i class="bi bi-search" style="color:var(--primary)"></i>
                </span>
                <input type="text" name="q" id="search-input" class="form-control"
                       placeholder="Nom, prénom, email..."
                       value="{{ q }}" autocomplete="off">
                {% if q %}
                <a href="{{ path('app_users_index', {role: roleActif}) }}" class="btn btn-outline-secondary">
                    <i class="bi bi-x"></i>
                </a>
                {% endif %}
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label mb-1 small fw-bold" style="color:var(--primary-dark)">Rôle</label>
            <select name="role" class="form-select" onchange="this.form.submit()">
                <option value="">Tous les rôles</option>
                {% for r in roles %}
                <option value="{{ r }}" {{ roleActif == r ? 'selected' : '' }}>{{ r }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary-admin w-100">
                <i class="bi bi-funnel-fill me-1"></i>Filtrer
            </button>
        </div>
        <div class="col-md-2">
            <a href="{{ path('app_users_new') }}" class="btn w-100"
               style="background:#d1f2eb;color:#1a7a4a;font-weight:600;border-radius:10px">
                <i class="bi bi-person-plus-fill me-1"></i>Ajouter
            </a>
        </div>
    </form>
</div>

{# ── RÉSULTATS ── #}
<div class="admin-table">
    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom" style="border-color:#ede5ff!important">
        <span class="small text-muted">
            <b style="color:var(--primary)">{{ users|length }}</b> utilisateur{{ users|length > 1 ? 's' : '' }} trouvé{{ users|length > 1 ? 's' : '' }}
            {% if q %} pour "<b>{{ q }}</b>"{% endif %}
            {% if roleActif %} · rôle <b>{{ roleActif }}</b>{% endif %}
        </span>
        {% if q or roleActif %}
        <a href="{{ path('app_users_index') }}" class="small text-decoration-none" style="color:var(--primary)">
            <i class="bi bi-x-circle me-1"></i>Réinitialiser
        </a>
        {% endif %}
    </div>
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Utilisateur</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Rôle</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="users-tbody">
        {% for user in users %}
            <tr>
                <td class="text-muted small">{{ user.id }}</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0">
                            {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
                        </div>
                        <div>
                            <div class="fw-semibold small">{{ user.prenom }} {{ user.nom }}</div>
                            {% if user.blockUntil > date().timestamp %}
                            <span style="font-size:0.7rem;color:#c0392b;font-weight:600">
                                <i class="bi bi-lock-fill me-1"></i>Bloqué
                            </span>
                            {% endif %}
                        </div>
                    </div>
                </td>
                <td class="small"><i class="bi bi-envelope me-1 text-muted"></i>{{ user.email }}</td>
                <td class="small text-muted">{{ user.num ?: '—' }}</td>
                <td>
                    {% if user.role == 'ROLE_ADMIN' %}
                        <span class="status-badge badge-complet"><i class="bi bi-shield-fill me-1"></i>Admin</span>
                    {% elseif user.role == 'ROLE_PARTENAIRE' %}
                        <span class="status-badge badge-attente"><i class="bi bi-shop me-1"></i>Partenaire</span>
                    {% else %}
                        <span class="status-badge badge-actif"><i class="bi bi-person-fill me-1"></i>Utilisateur</span>
                    {% endif %}
                </td>
                <td>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="{{ path('app_users_edit', {id: user.id}) }}" class="btn btn-edit-admin btn-sm">
                            <i class="bi bi-pencil-fill me-1"></i>Modifier
                        </a>

                        {# Bouton Bloquer / Débloquer #}
                        {% set isBlocked = user.blockUntil > date().timestamp %}
                        <form method="post" action="{{ path('app_users_toggle_block', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('block' ~ user.id) }}">
                            <button type="submit" class="btn btn-sm"
                                    style="background:{{ isBlocked ? '#d1f2eb' : '#fff3cd' }};color:{{ isBlocked ? '#1a7a4a' : '#856404' }};border:none;border-radius:8px;font-size:0.82rem"
                                    onclick="return confirm('{{ isBlocked ? 'Débloquer' : 'Bloquer' }} {{ user.prenom }} {{ user.nom }} ?')">
                                <i class="bi {{ isBlocked ? 'bi-unlock-fill' : 'bi-lock-fill' }} me-1"></i>
                                {{ isBlocked ? 'Débloquer' : 'Bloquer' }}
                            </button>
                        </form>

                        <form method="post" action="{{ path('app_users_delete', {id: user.id}) }}"
                              onsubmit="return confirm('Supprimer {{ user.prenom }} {{ user.nom }} ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button class="btn btn-danger-admin btn-sm">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>

                        {# Bouton Enregistrer le visage #}
                        <button class="btn btn-sm"
                                style="background:#e8f4fd;color:#1565c0;border:none;border-radius:8px;font-size:0.82rem"
                                onclick="openFaceModal({{ user.id }}, '{{ user.prenom }} {{ user.nom }}')"
                                title="Enregistrer le visage de {{ user.prenom }}">
                            <i class="bi bi-camera-fill me-1"></i>Visage
                        </button>

                        {# Bouton Enregistrer l'empreinte #}
                        <button class="btn btn-sm"
                                style="background:#e8f5e9;color:#2e7d32;border:none;border-radius:8px;font-size:0.82rem"
                                onclick="openFingerModal({{ user.id }}, '{{ user.prenom }} {{ user.nom }}')"
                                title="Enregistrer l'empreinte de {{ user.prenom }}">
                            <i class="bi bi-fingerprint me-1"></i>Empreinte
                        </button>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center text-muted py-5">
                    <i class="bi bi-search" style="font-size:2.5rem;opacity:0.2"></i>
                    <p class="mt-2 mb-0">Aucun utilisateur trouvé</p>
                    {% if q or roleActif %}
                    <a href="{{ path('app_users_index') }}" class="btn btn-sm mt-2 btn-edit-admin">
                        Réinitialiser les filtres
                    </a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}

{# ── MODAL ENREGISTREMENT EMPREINTE ── #}
<div class="modal fade" id="fingerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px">
        <div class="modal-content" style="border-radius:20px;border:none">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color:#1b5e20">
                    <i class="bi bi-fingerprint me-2" style="color:#2e7d32"></i>
                    Empreinte de <span id="finger-modal-name"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="cancelFingerEnroll()"></button>
            </div>
            <div class="modal-body text-center px-4 pb-4">

                {# Icône principale #}
                <div id="fmg-icon" style="font-size:5rem;margin:16px 0;transition:all .3s">🖐️</div>

                {# Message principal #}
                <div id="fmg-title" class="fw-bold mb-1" style="font-size:1.1rem;color:#1b5e20">
                    Prêt à enregistrer
                </div>
                <div id="fmg-subtitle" class="text-muted mb-3" style="font-size:0.88rem">
                    Cliquez sur Démarrer pour commencer
                </div>

                {# Barre de progression par étapes #}
                <div class="d-flex gap-2 justify-content-center mb-4">
                    <div id="fmg-step1" style="height:6px;width:80px;border-radius:3px;background:#e0e0e0;transition:background .4s"></div>
                    <div id="fmg-step2" style="height:6px;width:80px;border-radius:3px;background:#e0e0e0;transition:background .4s"></div>
                    <div id="fmg-step3" style="height:6px;width:80px;border-radius:3px;background:#e0e0e0;transition:background .4s"></div>
                </div>

                {# Bouton principal #}
                <button id="fmg-btn" class="btn w-100 fw-bold rounded-pill"
                        style="background:linear-gradient(135deg,#2e7d32,#4caf50);color:#fff;border:none;padding:13px;font-size:0.95rem"
                        onclick="startFingerEnroll()">
                    <i class="bi bi-fingerprint me-2"></i>Démarrer l'enregistrement
                </button>

            </div>
        </div>
    </div>
</div>

{# ── MODAL ENREGISTREMENT VISAGE ── #}
<div class="modal fade" id="faceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:460px">
        <div class="modal-content" style="border-radius:20px;border:none">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color:#1a237e">
                    <i class="bi bi-camera-fill me-2" style="color:#1565c0"></i>
                    Visage de <span id="modal-user-name"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="stopFaceCamera()"></button>
            </div>
            <div class="modal-body">
                <div style="position:relative;border-radius:14px;overflow:hidden;background:#0a0f2c;aspect-ratio:4/3;margin-bottom:14px">
                    <video id="face-video" autoplay playsinline muted style="width:100%;height:100%;object-fit:cover;transform:scaleX(-1)"></video>
                    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none">
                        <div id="face-frame-modal" style="width:180px;height:220px;border:3px solid rgba(255,255,255,0.5);border-radius:50% 50% 45% 45%;box-shadow:0 0 0 2000px rgba(0,0,0,0.35)"></div>
                    </div>
                    <div id="face-status-modal" style="position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,0.7);color:#fff;padding:8px 14px;font-size:0.8rem;text-align:center">
                        Initialisation...
                    </div>
                </div>
                <div id="face-result-modal" style="display:none;margin-bottom:12px;padding:12px 14px;border-radius:10px;font-size:0.85rem"></div>
                <button id="face-capture-btn" class="btn w-100 fw-bold" disabled
                        style="background:linear-gradient(135deg,#1a237e,#3949ab);color:#fff;border:none;border-radius:10px;padding:11px"
                        onclick="captureFaceAdmin()">
                    <i class="bi bi-camera-fill me-2"></i>Capturer et enregistrer
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// ── Gestion du modal empreinte ──
let currentFingerUserId = null;
let fingerEnrolling = false;

function fmg(id) { return document.getElementById(id); }

function setStep(step) {
    const colors = ['#e0e0e0','#e0e0e0','#e0e0e0'];
    for (let i = 0; i < step; i++) colors[i] = '#4caf50';
    fmg('fmg-step1').style.background = colors[0];
    fmg('fmg-step2').style.background = colors[1];
    fmg('fmg-step3').style.background = colors[2];
}

function setUI(icon, title, subtitle, btnText, btnColor, btnDisabled, iconAnim) {
    fmg('fmg-icon').textContent      = icon;
    fmg('fmg-icon').style.animation  = iconAnim || '';
    fmg('fmg-title').textContent     = title;
    fmg('fmg-subtitle').textContent  = subtitle;
    fmg('fmg-btn').innerHTML         = btnText;
    fmg('fmg-btn').style.background  = btnColor;
    fmg('fmg-btn').disabled          = btnDisabled;
}

function openFingerModal(userId, userName) {
    currentFingerUserId = userId;
    fmg('finger-modal-name').textContent = userName;
    // Reset
    setStep(0);
    setUI('🖐️', 'Prêt à enregistrer', 'Cliquez sur Démarrer pour commencer',
          '<i class="bi bi-fingerprint me-2"></i>Démarrer l\'enregistrement',
          'linear-gradient(135deg,#2e7d32,#4caf50)', false, '');
    fmg('fmg-btn').onclick = startFingerEnroll;
    fingerEnrolling = false;
    new bootstrap.Modal(fmg('fingerModal')).show();
}

async function startFingerEnroll() {
    if (fingerEnrolling) return;
    fingerEnrolling = true;

    try { await fetch('/api/fingerprint/bridge/start', { method: 'POST' }); } catch {}
    await new Promise(r => setTimeout(r, 1500));

    setStep(1);
    setUI('\uD83D\uDC46', 'Posez votre doigt', '1\u00e8re capture \u2014 placez votre doigt sur le lecteur',
          '<span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px"></span>En attente...',
          'linear-gradient(135deg,#1565c0,#1976d2)', true, 'pulse-fp 1s infinite');

    const pollInterval = setInterval(async () => {
        try {
            const r = await fetch('/api/fingerprint/enroll/status');
            const d = await r.json();
            if (d.step === 2) {
                clearInterval(pollInterval);
                setStep(2);
                setUI('\u261D\uFE0F', 'Reposez le m\u00eame doigt', '2\u00e8me capture \u2014 replacez votre doigt sur le lecteur',
                      '<span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px"></span>En attente...',
                      'linear-gradient(135deg,#1565c0,#1976d2)', true, 'pulse-fp 1s infinite');
            }
        } catch {}
    }, 800);

    try {
        const response = await fetch('/api/fingerprint/bridge/enroll', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_id: currentFingerUserId }),
            signal: AbortSignal.timeout(150000)  // 2.5 minutes
        });
        clearInterval(pollInterval);

        // Lire la réponse comme texte d'abord pour déboguer
        const text = await response.text();
        let data;
        try { data = JSON.parse(text); }
        catch(e) {
            setStep(0);
            setUI('\u274C', 'Erreur serveur', text.substring(0, 100),
                  '<i class="bi bi-fingerprint me-2"></i>R\u00e9essayer',
                  'linear-gradient(135deg,#c0392b,#e74c3c)', false, '');
            fmg('fmg-btn').onclick = () => { fingerEnrolling = false; startFingerEnroll(); };
            return;
        }

        if (data.already_exists) {
            setStep(0);
            setUI('\u26A0\uFE0F', 'Doigt d\u00e9j\u00e0 enregistr\u00e9', 'Ce doigt est d\u00e9j\u00e0 associ\u00e9 \u00e0 un compte',
                  '<i class="bi bi-fingerprint me-2"></i>Essayer un autre doigt',
                  'linear-gradient(135deg,#e67e22,#f39c12)', false, '');
            fmg('fmg-btn').onclick = () => { fingerEnrolling = false; startFingerEnroll(); };
            return;
        }
        if (!data.success) {
            setStep(0);
            // Message spécial si port occupé
            const msg = data.message || 'Veuillez r\u00e9essayer';
            const isPortBusy = msg.toLowerCase().includes('occupe') || msg.toLowerCase().includes('arduino ide');
            setUI(isPortBusy ? '\uD83D\uDD12' : '\u274C',
                  isPortBusy ? 'Arduino IDE ouvert' : '\u00C9chec',
                  isPortBusy ? 'Fermez l\'Arduino IDE puis r\u00e9essayez' : msg,
                  '<i class="bi bi-fingerprint me-2"></i>R\u00e9essayer',
                  'linear-gradient(135deg,#c0392b,#e74c3c)', false, '');
            fmg('fmg-btn').onclick = () => { fingerEnrolling = false; startFingerEnroll(); };
            return;
        }

        setStep(2);
        setUI('\u23F3', 'Enregistrement...', 'Sauvegarde de votre empreinte',
              '<span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px"></span>Enregistrement...',
              'linear-gradient(135deg,#2e7d32,#4caf50)', true, '');

        await fetch('/api/fingerprint/enroll_success', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_id: currentFingerUserId, finger_id: data.finger_id })
        });

        setStep(3);
        setUI('\u2705', 'Votre doigt est enregistr\u00e9 avec succ\u00e8s !',
              'Vous pouvez maintenant vous connecter avec votre empreinte',
              '<i class="bi bi-check-circle-fill me-2"></i>Termin\u00e9',
              'linear-gradient(135deg,#1a7a4a,#2e7d32)', false, '');
        fmg('fmg-btn').onclick = () => bootstrap.Modal.getInstance(fmg('fingerModal')).hide();

    } catch (err) {
        clearInterval(pollInterval);
        setStep(0);
        setUI('\uD83D\uDD0C', 'Lecteur non disponible', 'V\u00e9rifiez que le lecteur est bien connect\u00e9',
              '<i class="bi bi-fingerprint me-2"></i>R\u00e9essayer',
              'linear-gradient(135deg,#c0392b,#e74c3c)', false, '');
        fmg('fmg-btn').onclick = () => { fingerEnrolling = false; startFingerEnroll(); };
    }
}
function cancelFingerEnroll() { fingerEnrolling = false; }
async function startBridge() {}
async function checkFingerReader() {}

// ── Gestion du modal visage ──
let faceStream = null;
let currentUserId = null;

async function openFaceModal(userId, userName) {
    currentUserId = userId;
    document.getElementById('modal-user-name').textContent = userName;
    document.getElementById('face-result-modal').style.display = 'none';
    document.getElementById('face-frame-modal').style.borderColor = 'rgba(255,255,255,0.5)';
    const btn = document.getElementById('face-capture-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-camera-fill me-2"></i>Capturer et enregistrer';
    btn.style.background = 'linear-gradient(135deg,#1a237e,#3949ab)';

    new bootstrap.Modal(document.getElementById('faceModal')).show();

    try {
        faceStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
        const video = document.getElementById('face-video');
        video.srcObject = faceStream;
        video.onloadedmetadata = () => {
            document.getElementById('face-status-modal').textContent = '✅ Positionnez le visage dans le cadre';
            btn.disabled = false;
        };
    } catch (err) {
        document.getElementById('face-status-modal').textContent = '❌ Caméra non accessible : ' + err.message;
    }
}

function stopFaceCamera() {
    if (faceStream) { faceStream.getTracks().forEach(t => t.stop()); faceStream = null; }
}

document.getElementById('faceModal').addEventListener('hidden.bs.modal', stopFaceCamera);

async function captureFaceAdmin() {
    const btn    = document.getElementById('face-capture-btn');
    const result = document.getElementById('face-result-modal');
    const video  = document.getElementById('face-video');
    const frame  = document.getElementById('face-frame-modal');

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px"></span>Analyse...';

    const canvas = document.createElement('canvas');
    canvas.width  = video.videoWidth  || 640;
    canvas.height = video.videoHeight || 480;
    const ctx = canvas.getContext('2d');
    ctx.scale(-1, 1);
    ctx.drawImage(video, -canvas.width, 0, canvas.width, canvas.height);

    canvas.toBlob(async (blob) => {
        const formData = new FormData();
        formData.append('face_image', blob, 'face.jpg');

        try {
            const response = await fetch('/admin/users/' + currentUserId + '/register-face', {
                method: 'POST',
                body: formData
            });
            
            // Lire la réponse comme texte d'abord pour déboguer
            const text = await response.text();
            let data;
            try {
                data = JSON.parse(text);
            } catch (e) {
                // La réponse n'est pas du JSON — afficher l'erreur PHP
                result.style.cssText = 'display:block;background:#fde8e8;border:1px solid #f5b7b1;border-radius:10px;padding:12px 14px;font-size:0.78rem;max-height:200px;overflow:auto';
                result.innerHTML = '<strong style="color:#c0392b">Erreur serveur :</strong><br><pre style="font-size:0.72rem;white-space:pre-wrap">' + text.substring(0, 500) + '</pre>';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-camera-fill me-2"></i>Réessayer';
                return;
            }
            result.style.display = 'block';
            if (data.success) {
                frame.style.borderColor = '#4caf50';
                result.style.cssText = 'display:block;background:#d1f2eb;border:1px solid #a9dfbf;border-radius:10px;padding:12px 14px;font-size:0.85rem';
                result.innerHTML = '<i class="bi bi-check-circle-fill me-2" style="color:#1a7a4a"></i><strong>Visage enregistré avec succès !</strong>';
                document.getElementById('face-status-modal').textContent = '✅ Enregistrement réussi';
                btn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>Enregistré !';
                btn.style.background = '#1a7a4a';
            } else {
                frame.style.borderColor = '#e74c3c';
                result.style.cssText = 'display:block;background:#fde8e8;border:1px solid #f5b7b1;border-radius:10px;padding:12px 14px;font-size:0.85rem';
                result.innerHTML = '<i class="bi bi-x-circle-fill me-2" style="color:#c0392b"></i>' + data.message;
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-camera-fill me-2"></i>Réessayer';
            }
        } catch (err) {
            result.style.cssText = 'display:block;background:#fde8e8;border:1px solid #f5b7b1;border-radius:10px;padding:12px 14px;font-size:0.85rem';
            result.innerHTML = '❌ Erreur réseau.';
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-camera-fill me-2"></i>Réessayer';
        }
    }, 'image/jpeg', 0.9);
}
// Init pie chart à l'ouverture du modal
let chartInstance = null;
document.getElementById('statsModal').addEventListener('shown.bs.modal', () => {
    const ctx = document.getElementById('roleChart');
    if (!ctx) return;
    if (chartInstance) { chartInstance.destroy(); }
    chartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Admins', 'Partenaires', 'Utilisateurs'],
            datasets: [{
                data: [
                    {{ stats['ROLE_ADMIN'] ?? 0 }},
                    {{ stats['ROLE_PARTENAIRE'] ?? 0 }},
                    {{ stats['ROLE_USER'] ?? 0 }}
                ],
                backgroundColor: ['#c0392b', '#e67e22', '#1a7a4a'],
                borderColor: ['#fff','#fff','#fff'],
                borderWidth: 3,
                hoverOffset: 12
            }]
        },
        options: {
            responsive: true,
            cutout: '55%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: c => ` ${c.label} : ${c.parsed} (${Math.round(c.parsed / [{{ stats['ROLE_ADMIN'] ?? 0 }}, {{ stats['ROLE_PARTENAIRE'] ?? 0 }}, {{ stats['ROLE_USER'] ?? 0 }}].reduce((a,b)=>a+b,0) * 100)}%)`
                    }
                }
            },
            animation: { animateRotate: true, duration: 900 }
        }
    });
});

// Recherche dynamique debounce 300ms
const input = document.getElementById('search-input');
if (input) {
    let timer;
    input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => document.getElementById('search-form').submit(), 300);
    });
}
</script>
{% endblock %}
