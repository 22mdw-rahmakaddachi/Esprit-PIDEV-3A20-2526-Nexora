{% extends 'admin/base_admin.html.twig' %}
{% block title %}Gestion des utilisateurs{% endblock %}
{% block page_title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="bi bi-people-fill me-2" style="color:var(--primary)"></i>Utilisateurs</h1>
    <a href="{{ path('app_users_new') }}" class="btn btn-primary-admin">
        <i class="bi bi-person-plus-fill me-2"></i>Ajouter utilisateur
    </a>
</div>

<div class="admin-table">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Prénom</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td class="text-muted">{{ user.id }}</td>
                <td class="fw-semibold">{{ user.prenom }}</td>
                <td>{{ user.nom }}</td>
                <td><i class="bi bi-envelope me-1 text-muted"></i>{{ user.email }}</td>
                <td>
                    <span class="status-badge
                        {% if user.role == 'ROLE_ADMIN' %}badge-complet
                        {% elseif user.role == 'ROLE_PARTENAIRE' %}badge-attente
                        {% else %}badge-actif{% endif %}">
                        {{ user.role }}
                    </span>
                </td>
                <td>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_users_edit', {'id': user.id}) }}" class="btn btn-edit-admin">
                            <i class="bi bi-pencil-fill me-1"></i>Modifier
                        </a>
                        <form method="post" action="{{ path('app_users_delete', {'id': user.id}) }}"
                              onsubmit="return confirm('Supprimer cet utilisateur ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button class="btn btn-danger-admin">
                                <i class="bi bi-trash-fill me-1"></i>Supprimer
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-people" style="font-size:2rem;opacity:0.3"></i>
                    <p class="mt-2 mb-0">Aucun utilisateur trouvé</p>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
